+/* HENGE_SGI_ALARM: 两点告警链 —— SGI 发送时记录，目标 5 ms 未消费则 dump。
+   间歇性竞态用单点快照抓不住；这里只对"已发送未消费"的目标报一次。 */
+void henge_gic_dump(int cpu_index)
+{
+    CPUState *csq = qemu_get_cpu(cpu_index);
+    if (!csq) return;
+    CPUARMState *env = &ARM_CPU(csq)->env;
+    GICv3CPUState *cs = env->gicv3state;
+    if (!cs) { fprintf(stderr, "henge-gic-dump: cpu%d no gicv3state\n", cpu_index); return; }
+    fprintf(stderr,
+        "henge-gic-dump: cpu%d bit1(is=%d pend=%d act=%d prio=%u grp=%d) "
+        "bit27(is=%d pend=%d act=%d prio=%u) igrpen1=%llu pmr=%llu "
+        "ctlr=%llx eoimode=%d hppi=%u/%u vt_cval=%llx vt_ctl=%llx\n",
+        cpu_index,
+        !!(cs->gicr_ienabler0 & (1u << 1)),
+        !!(cs->gicr_ipendr0 & (1u << 1)),
+        !!(cs->gicr_iactiver0 & (1u << 1)),
+        cs->gicr_ipriorityr[1], !!(cs->gicr_igroupr0 & (1u << 1)),
+        !!(cs->gicr_ienabler0 & (1u << 27)),
+        !!(cs->gicr_ipendr0 & (1u << 27)),
+        !!(cs->gicr_iactiver0 & (1u << 27)),
+        cs->gicr_ipriorityr[27],
+        (unsigned long long)cs->icc_igrpen[GICV3_G1NS],
+        (unsigned long long)cs->icc_pmr_el1,
+        (unsigned long long)cs->icc_ctlr_el1[0],
+        (int)((cs->icc_ctlr_el1[0] & 2) != 0),
+        cs->hppi.irq, cs->hppi.prio,
+        (unsigned long long)env->cp15.c14_timer[GTIMER_VIRT].cval,
+        (unsigned long long)env->cp15.c14_timer[GTIMER_VIRT].ctl);
