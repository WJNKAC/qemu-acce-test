+#ifndef HENGEVM_SYSREG_H
+#define HENGEVM_SYSREG_H
+
+#include <stdint.h>
+
+#include "cpu.h"
+
+/* MRS, MSR (register and immediate), and SYS (DC, IC, TLBI, AT).
+   Each returns 1 if the block must leave. */
+int hv_sysreg_mrs(HvCpu *cpu, uint32_t insn, uint64_t pc);
+int hv_sysreg_msr(HvCpu *cpu, uint32_t insn, uint64_t pc);
+int hv_sysreg_sys(HvCpu *cpu, uint32_t insn, uint64_t pc);
+
+/* The guest's counter (CNTPCT): host mach_absolute_time, which runs at 24 MHz. */
+uint64_t hv_counter(void);
+
+/* counter() converted into the guest's CNTFRQ domain, before the epoch is
+   subtracted.  Takes the CPU rather than the machine so this header stays
+   free of machine.h (which is where HvMachine is defined).  The host uses it
+   to calibrate; the guest never sees it. */
+uint64_t hv_guest_ticks(struct HvMachine *m);
+
+/* One TLBI on one CPU's own TLB and branch cache. */
+void hv_tlbi_apply(HvCpu *cpu, uint32_t op1, uint32_t crn, uint32_t crm, uint32_t op2, uint64_t xt);
+
+#endif
diff --git a/accel/henge/engine/core/translate.c b/accel/henge/engine/core/translate.c
new file mode 100644
index 0000000000..5ecd57e039
--- /dev/null
+++ b/accel/henge/engine/core/translate.c
@@ -0,0 +1,2272 @@
+#include "translate.h"
+
+#include <string.h>
+#include <stdlib.h>
+
+#include "classify.h"
+#include "memop.h"
+#include "mmu.h"
+#include "operands.h"
+
+/* A block has two parts. The hot part is the code that runs every time: the translated
+   instructions. The cold part is what hardly ever does: exits not chained yet, memory slow
+   paths, branch-cache misses, and the literal pool. In a region of 1 MB (the reach of the
+   short branches between them) hot parts grow from the bottom and cold parts from the top,
+   so code that runs sits together. What runs is a small part of what a translation holds,
+   and macOS runs so much code, so thinly, that how much fits in the CPU's caches and branch
+   tables is a large part of how fast it goes. HV_K2=1: one part, in the order written.
+
+   Each part is built in a static buffer and copied into the JIT region once. Branches between
+   them are put right when it is known where they went (rel, hv_translate_place). */
+
+#define MAX_WORDS 16384
+#define MAX_LITS 2048
+#define MAX_OOL 1024
+#define WORDS_PER_INSN_MAX 96 /* stop the block before the buffer could overflow */
+#define MAX_RELS 8192
+#define JIT_CHUNK_WORDS (256u * 1024) /* 1 MB: CBZ, B.cond and LDR (literal) reach both ways from anywhere in it */
+
+enum { FIX_LDR, FIX_ADR };
+
+typedef struct {
+    uint32_t at, kind, idx;
+    uint8_t cold; /* the instruction is in the cold part */
+} LitFix;
+
+enum { OOL_EXIT, OOL_SLOW, OOL_SYS, OOL_MRS, OOL_GROUP };
+
+typedef struct {
+    uint32_t at;        /* the branch that jumps here */
+    uint32_t join;      /* slow paths come back here */
+    uint64_t pc;        /* exit target, or the guest PC of the slow-path instruction */
+    uint32_t insn;
+    uint8_t kind;
+    uint8_t nrestore;
+    uint8_t restore[4]; /* scratch registers to reload from cpu->spill first */
+    /* Loads and stores: redo the TLB check exactly (the fast one rejects an
+       access in a page's last HV_TLB_ADJ bytes) and go back if it passes. */
+    uint8_t recheck, addr, t, u, bytes;
+    uint32_t tag_off;
+    uint64_t site;      /* guest PC of the instruction that branches out of line */
+    uint32_t retry;     /* loads and stores: where their translation starts, to run again after a refill */
+    uint32_t rflags;    /* hv_tlb_refill's flags for it (0: no refill, straight to the helper) */
+    uint8_t plain;      /* exits: an ordinary branch (see put_branch_exit) */
+} Ool;
+
+/* Loads and stores on one base register, close together in a block: the first
+   checks the TLB once for the whole range they touch and leaves the page's
+   host addend in cpu->gaddend[slot]; the rest use it with no check of their
+   own. If that check fails, the block runs a plain translation of the
+   instructions from the first through `end` instead (copy_at) and comes back
+   after them. See plan_groups. */
+#define MAX_GROUPS 8
+#define GROUP_SLOTS 4
+#define GROUP_SPAN 2048   /* bytes one group may cover (strictly below 4 KB page - HV_TLB_ADJ) */
+#define GROUP_INSNS 48    /* and instructions */
+typedef struct {
+    int32_t lo, hi;       /* bytes touched, relative to the base at the first access */
+    uint8_t store, base, slot, live;
+    uint16_t first, last, end;
+    uint32_t copy_at;
+} Group;
+
+typedef struct {
+    uint32_t hot[MAX_WORDS], cold[MAX_WORDS];
+    uint32_t *w;        /* the part being written */
+    uint32_t n;         /* its words so far */
+    uint32_t other_n;   /* the other part's */
+    int in_cold;        /* writing what belongs in the cold part */
+    int flat;           /* HV_K2: all in one, in the order written */
+    struct { uint32_t at, target; uint8_t from_cold; } rel[MAX_RELS]; /* a branch in one part to a word in the other */
+    uint32_t nrel;
+    uint32_t nhot, ncold; /* the finished block's parts in words, ncold with the pool */
+    uint64_t pool[MAX_LITS];
+    uint32_t npool;
+    LitFix fix[MAX_LITS];
+    uint32_t nfix;
+    Ool ool[MAX_OOL];
+    uint32_t nool;
+    struct { uint32_t slot, at, flags, stub, cond_at; uint64_t target; uint8_t cold, stub_cold, has_cond; } site[MAX_OOL]; /* chainable exits: their slot, the B chaining patches, its stub, where to; the hot part's conditional branch to it if chaining may patch that too */
+    int site_direct;    /* the exit just written needs nothing done before its B: no check, no restores */
+    uint32_t nsite;
+    uint32_t pool_at;    /* where the literal pool is, in the cold part */
+    uint32_t flags;
+    int slow_mem;
+    uint64_t page;       /* guest VA of the 16 KB page the block is in */
+    int no_ijc;          /* indirect branches always go to the dispatcher (breakpoints, tests' stop PC) */
+    HvMachine *m;
+    uint64_t cur_pc;     /* guest PC of the instruction being translated (or whose out-of-line exit is) */
+    /* Grouped accesses (Group). */
+    Group grp[MAX_GROUPS];
+    uint32_t ngrp;
+    int8_t gid[HV_MAX_BLOCK_INSNS];     /* the group an instruction is in, or -1 */
+    uint8_t grole[HV_MAX_BLOCK_INSNS];  /* 1: its first access, 2: a later one */
+    int32_t goff[HV_MAX_BLOCK_INSNS];   /* the access's address minus the base at the group's first */
+    uint32_t after[HV_MAX_BLOCK_INSNS]; /* where each instruction's translation ends */
+    uint32_t cur_i;
+    int nogroup;                        /* translating plain (copies, or the retry when they do not fit) */
+    int u_live, u_prev;                 /* slot + 1 when x15 holds that group's addend after the last instruction */
+    int overflow;
+} Emit;
+
+static __thread Emit E; /* each CPU translates on its own thread, outside the translation lock */
+
+/* ---- encodings ---- */
+
+static inline uint32_t stp_ldp_x(uint32_t op, uint32_t t1, uint32_t t2, uint32_t n, uint32_t off) {
+    if (off >= 512 || (off & 7) != 0) __builtin_trap();
+    return op | (((off / 8) & 0x7f) << 15) | (t2 << 10) | (n << 5) | t1;
+}
+#define STR_X(t, n, off) (0xf9000000u | ((uint32_t)(off) / 8) << 10 | (n) << 5 | (t))
+#define LDR_X(t, n, off) (0xf9400000u | ((uint32_t)(off) / 8) << 10 | (n) << 5 | (t))
+#define STP_X(t1, t2, n, off) stp_ldp_x(0xa9000000u, (t1), (t2), (n), (uint32_t)(off))
+#define LDP_X(t1, t2, n, off) stp_ldp_x(0xa9400000u, (t1), (t2), (n), (uint32_t)(off))
+#define BR_X(n) (0xd61f0000u | (n) << 5)
+#define BLR_X(n) (0xd63f0000u | (n) << 5)
+#define SBFM_X(d, n, immr, imms) (0x93400000u | (immr) << 16 | (imms) << 10 | (n) << 5 | (d))
+#define UBFM_X(d, n, immr, imms) (0xd3400000u | (immr) << 16 | (imms) << 10 | (n) << 5 | (d))
+#define BFM_X(d, n, immr, imms) (0xb3400000u | (immr) << 16 | (imms) << 10 | (n) << 5 | (d))
+#define B_OP 0x14000000u
+#define MOV_X(d, m) (0xaa0003e0u | (m) << 16 | (d))
+#define ADD_SP_TO(d) (0x910003e0u | (d)) /* add xd, sp, #0: what mov from SP is (an ORR would read XZR) */
+#define ADD_LSL(d, n, m, sh) (0x8b000000u | (m) << 16 | (sh) << 10 | (n) << 5 | (d))
+#define SUB_X(d, n, m) (0xcb000000u | (m) << 16 | (n) << 5 | (d))
+#define ADD_EXT(d, n, m, opt, sh) (0x8b200000u | (m) << 16 | (opt) << 13 | (sh) << 10 | (n) << 5 | (d))
+
+static void put(Emit *e, uint32_t w);
+
+/* T = where the TLB entry for the page of the address in register va is, for table `table` (0 EL0, 1 EL1, 2 EL1 with PAN),
+   in the layout in force (hv_tlb_tmajor, cpu.h). Returns the offset from T of the entry's first field. */
+static uint32_t put_tlb_slot(Emit *e, int T, int va, int table) {
+    put(e, UBFM_X(T, va, HV_TLB_PAGE_BITS, HV_TLB_PAGE_BITS + HV_TLB_BITS - 1));
+    if (hv_tlb_tmajor) {
+        put(e, ADD_LSL(T, 28, T, 5));
+        if (table) put(e, 0x91400000u | (uint32_t)table * (HV_TLB_SIZE * 32 / 4096) << 10 | (uint32_t)T << 5 | (uint32_t)T); /* add T, T, #table's offset */
+        return HV_CPU_TLB;
+    }
+    put(e, ADD_LSL(T, 28, T, 7));
+    return HV_CPU_TLB + (uint32_t)table * HV_CPU_TLB_EL;
+}
+#define CBNZ_X(t) (0xb5000000u | (t))
+#define CBZ_X(t) (0xb4000000u | (t))
+
+static void patch_branch(uint32_t *w, int64_t off);
+
+static inline int64_t sext(uint64_t v, int bits) {
+    return (int64_t)(v << (64 - bits)) >> (64 - bits);
+}
+
+static void put(Emit *e, uint32_t w) {
+    if (e->n < MAX_WORDS) e->w[e->n] = w;
+    e->n++;
+}
+
+/* Write the cold part for a while. */
+static void cold_on(Emit *e) {
+    e->in_cold = 1;
+    if (e->flat) return;
+    uint32_t n = e->n;
+    e->n = e->other_n, e->other_n = n;
+    e->w = e->cold;
+}
+
+static void cold_off(Emit *e) {
+    e->in_cold = 0;
+    if (e->flat) return;
+    uint32_t n = e->n;
+    e->n = e->other_n, e->other_n = n;
+    e->w = e->hot;
+}
+
+/* The branch at `at` in one part goes to `target` in that part or the other. */
+static void plink(Emit *e, uint32_t at, int from_cold, uint32_t target, int to_cold) {
+    if (e->flat || from_cold == to_cold) {
+        uint32_t *w = e->flat || !from_cold ? e->hot : e->cold;
+        patch_branch(&w[at], (int64_t)target - at);
+        return;
+    }
+    if (e->nrel < MAX_RELS) {
+        e->rel[e->nrel].at = at, e->rel[e->nrel].target = target, e->rel[e->nrel].from_cold = (uint8_t)from_cold;
+        e->nrel++;
+    } else {
+        e->overflow = 1;
+    }
+}
+
+/* To the next word to be written. */
+static void link_here(Emit *e, uint32_t at, int from_cold) {
+    plink(e, at, from_cold, e->n, e->in_cold);
+}
+
+/* ldr xR, =value */
+static void put_lit(Emit *e, int reg, uint64_t value) {
+    e->pool[e->npool] = value;
+    e->fix[e->nfix++] = (LitFix){e->n, FIX_LDR, e->npool++, (uint8_t)(e->in_cold && !e->flat)};
+    put(e, 0x58000000u | reg);
+}
+
+/* adr xR, <16-byte HvHelperInfo in the pool> */
+
+static void put_ool(Emit *e, Ool o) {
+    o.at = e->n - 1; /* the branch just emitted */
+    o.site = e->cur_pc;
+    e->ool[e->nool++] = o;
+}
+
+/* Guest x0/x1 are saved, x0 = target = cpu->pc. Jumps to the target block
+   through the indirect-branch cache for this block's flags if it is there and
+   nobody asked the CPU to leave, else leaves for the dispatcher (which fills
+   the cache). A hit reloads guest x0 and x1, which the hash used as scratch,
+   and enters the block directly: no block has a prologue. Tags are VA ^ salt;
+   the salt changes when mappings or code do. */
+/* Jump to the guest VA in host x15 through the indirect-branch cache for this
+   block's flags. Guest x0/x1 stay in their registers on the hit path, and
+   nothing is stored: the target block just runs. A miss (or exit_req) saves
+   x0/x1 and pc and leaves for the dispatcher, which fills the cache. */
+static void put_ijc_jump(Emit *e, int check) {
+    if (e->no_ijc) {
+        put(e, STP_X(0, 1, 28, 0));
+        put(e, MOV_X(0, 15));
+        put(e, STR_X(0, 28, HV_CPU_PC));
+        put(e, LDR_X(1, 28, HV_CPU_EXIT));
+        put(e, BR_X(1));
+        return;
+    }
+    int p0 = e->in_cold;
+    uint32_t to_exit = 0;
+    if (check) {
+        put(e, 0xb9400000u | (HV_CPU_EXIT_REQ / 4) << 10 | 28 << 5 | 6); /* ldr w6, [x28, #exit_req] */
+        to_exit = e->n;
+        put(e, 0x35000000u | 6);                            /* cbnz w6, exit (x15 still the VA) */
+    }
+    /* The tag, VA ^ salt, also picks the slot (hv_ijc_index), so each address
+       space's copy of shared library code gets its own slots. */
+    uint32_t salt = HV_CPU_IJC_SALT + 8 * (e->flags & HV_BLOCK_EL1);
+    put(e, LDR_X(6, 28, salt));
+    put(e, 0xca000000u | 6 << 16 | 15 << 5 | 15);           /* eor x15, x15, x6: the tag */
+    put(e, 0xca400000u | 15 << 16 | 16 << 10 | 15 << 5 | 7); /* eor x7, x15, x15, lsr #16 */
+    put(e, 0xca400000u | 15 << 16 | 46 << 10 | 7 << 5 | 7);  /* eor x7, x7, x15, lsr #46 */
+    put(e, UBFM_X(7, 7, 2, 2 + HV_IJC_BITS - 2));           /* ubfx x7, x7, #2, #bits - 1: the set */
+    put(e, LDR_X(6, 28, HV_CPU_IJC_TAB + 8 * (e->flags & (HV_IJC_TABLES - 1))));
+    put(e, ADD_LSL(6, 6, 7, 5));
+    put(e, LDR_X(7, 6, 0));                                 /* way 0's tag */
+    put(e, 0xca000000u | 15 << 16 | 7 << 5 | 7);            /* eor x7, x7, x15 */
+    uint32_t to_way1 = e->n;
+    put(e, CBNZ_X(7));
+    put(e, LDR_X(6, 6, 8));
+    put(e, BR_X(6));                                        /* hit: x0, x1 are the guest's */
+    if (!p0) cold_on(e);
+    link_here(e, to_way1, p0);
+    put(e, LDR_X(7, 6, 16));                                /* way 1's */
+    put(e, 0xca000000u | 15 << 16 | 7 << 5 | 7);
+    uint32_t to_miss = e->n;
+    put(e, CBNZ_X(7));
+    put(e, LDR_X(6, 6, 24));
+    put(e, BR_X(6));
+    patch_branch(&e->w[to_miss], (int64_t)e->n - to_miss);  /* miss: x15 is the tag, so the VA is x15 ^ salt */
+    put(e, LDR_X(7, 28, salt));
+    put(e, 0xca000000u | 15 << 16 | 7 << 5 | 7);            /* eor x7, x7, x15: the VA */
+    put(e, STR_X(30, 28, HV_CPU_X(30)));
+    put(e, LDR_X(15, 28, HV_CPU_IJC_THUNK));
+    put(e, BLR_X(15));                                      /* the block exists? then the thunk goes there */
+    put(e, e->flags);
+    put(e, STP_X(0, 1, 28, 0));
+    put(e, MOV_X(0, 7));
+    if (check) {
+        uint32_t to_common = e->n;
+        put(e, B_OP);
+        link_here(e, to_exit, p0);                          /* exit_req: x15 is the VA */
+        put(e, STP_X(0, 1, 28, 0));
+        put(e, MOV_X(0, 15));
+        patch_branch(&e->w[to_common], (int64_t)e->n - to_common);
+    }
+    put(e, STR_X(0, 28, HV_CPU_PC));
+    put_lit(e, 1, e->cur_pc);                               /* say where, for --stats */
+    put(e, STR_X(1, 28, HV_CPU_MISS_SITE));
+    put(e, LDR_X(1, 28, HV_CPU_EXIT));
+    put(e, BR_X(1));
+    if (!p0) cold_off(e);
+}
+
+/* A direct branch to another page through hv_xjump_thunk (the cache lookup in
+   one shared copy): a BR, so the CPU's own stack of return addresses gets nothing it
+   would use on the guest's next return. check: test exit_req first. */
+static void put_xjump(Emit *e, uint64_t target, int check) {
+    if (e->no_ijc) {
+        put_lit(e, 15, target);
+        put_ijc_jump(e, 1);
+        return;
+    }
+    if (!(e->n & 1)) put(e, 0xd503201f); /* nop: the data after the br starts 8-byte aligned */
+    put(e, 0x10000007u | 3u << 5);       /* adr x7, data */
+    put(e, LDR_X(15, 28, HV_CPU_XJUMP_THUNK));
+    put(e, BR_X(15));
+    put(e, (e->flags & 0x7fffffffu) | (check ? 1u << 31 : 0));
+    put(e, 0);
+    put(e, (uint32_t)target);
+    put(e, (uint32_t)(target >> 32));
+}
+
+/* Leave the block with pc = target. */
+static void put_exit(Emit *e, uint64_t target) {
+    put(e, STP_X(0, 1, 28, 0));
+    put_lit(e, 0, target);
+    put(e, STR_X(0, 28, HV_CPU_PC));
+    put(e, LDR_X(1, 28, HV_CPU_EXIT));
+    put(e, BR_X(1));
+}
+
+/* A direct branch to target. Within the block's own 16 KB page the exit is
+   chainable: it jumps to the block whose entry the dispatcher stored in this
+   exit's slot (plain data, so chaining never rewrites code), as long as nobody
+   has asked the CPU to leave. The hit path touches only the free scratch
+   registers, so guest x0/x1 stay live and the target needs no prologue. An
+   empty slot leaves with its address in last_stub so the dispatcher can fill
+   it. A same-page target always has the same physical mapping as this block,
+   so the chain stays correct across page-table changes. Other pages go through
+   the indirect-branch cache. */
+/* plain: an ordinary branch, not an exit that synchronises (ISB, a system
+   register write, an interrupt let through). One going forward (to a higher
+   address than the branch) skips the exit_req check: blocks only run forward
+   that way, so any loop of chained blocks still has a checked edge, and a CPU
+   asked to leave reaches one soon. */
+static int check_exits_always(void) {
+    static int v = -1; /* HV_EXIT_CHECKS: check on every exit (debugging) */
+    if (v < 0) v = getenv("HV_EXIT_CHECKS") != NULL;
+    return v;
+}
+
+/* A direct branch to another page can chain too, if a check that the target
+   page is still mapped where it was comes first: its TLB entry (the slot is
+   known now, as the VA is) must allow fetching and hold the host addend the
+   page had when this block was translated. The block the dispatcher chains
+   it to must be in that physical page (chain() in dispatch.c). The addend is
+   looked up now, in the translating CPU's page tables; 0 if it cannot be. */
+static uint64_t cross_addend(Emit *e, uint64_t target) {
+    static int off = -1; /* HV_NO_XCHAIN: exits to other pages always look the target up */
+    if (off < 0) off = getenv("HV_NO_XCHAIN") != NULL;
+    HvCpu *cpu = hv_self;
+    if (off || !cpu || e->no_ijc || !e->m->chain) return 0;
+    /* This CPU's TLB first: an entry there is the mapping now. */
+    int table = !(e->flags & HV_BLOCK_EL1) ? 0 : (e->flags & HV_BLOCK_PAN) ? 2 : 1;
+    const HvTlbEntry *te = hv_tlb_ent(cpu, (target >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1), table);
+    uint64_t tpage = target & ~((1ull << HV_TLB_PAGE_BITS) - 1);
+    if (te->exec_tag == hv_exec_key(tpage, te->addend)) return (uint64_t)te->addend;
+    HvWalk w;
+    hv_mmu_walk(cpu, target, HV_ACC_EXEC, (e->flags & HV_BLOCK_EL1) ? 1 : 0, &w);
+    if (w.fsc || w.block_size < (1ull << HV_TLB_PAGE_BITS)) return 0;
+    uint64_t page_pa = w.pa & ~((1ull << HV_TLB_PAGE_BITS) - 1);
+    HvRam *ram = hv_ram_lookup(e->m, page_pa);
+    if (!ram || page_pa + (1ull << HV_TLB_PAGE_BITS) - ram->pa > ram->size) return 0;
+    return (uint64_t)(uintptr_t)(ram->host + (page_pa - ram->pa)) - (target & ~((1ull << HV_TLB_PAGE_BITS) - 1));
+}
+
+static int use_xjump(void) {
+    static int v = -1; /* HV_INLINE_XJUMP: each direct branch to another page has its own cache lookup */
+    if (v < 0) v = getenv("HV_INLINE_XJUMP") == NULL;
+    return v;
+}
+
+static void put_branch_exit(Emit *e, uint64_t target, int plain) {
+    int check = !(plain && target > e->cur_pc && !check_exits_always());
+    int p0 = e->in_cold;
+    e->site_direct = 0;
+    uint32_t slot_index = ~0u;
+    int same_page = (target & ~((1ull << HV_TLB_PAGE_BITS) - 1)) == e->page;
+    uint64_t xa = same_page ? 0 : cross_addend(e, target);
+    if (same_page || xa) {
+        slot_index = __atomic_fetch_add(&e->m->nslots, 1, __ATOMIC_RELAXED); /* translations run in parallel */
+        if (slot_index >= e->m->max_slots) slot_index = ~0u; /* out of slots until the next flush: no chaining */
+    }
+    if (slot_index == ~0u) {
+        /* Another page may be remapped under us, so look it up by VA instead of chaining. */
+        if (!same_page && use_xjump()) put_xjump(e, target, check);
+        else {
+            put_lit(e, 15, target);
+            put_ijc_jump(e, check);
+        }
+        return;
+    }
+    uint64_t *slot = &e->m->slots[slot_index];
+    *slot = 0;
+    e->m->slot_site[slot_index] = NULL; /* until placed: what it held is a dropped block's */
+    e->m->slot_cond[slot_index] = NULL;
+    e->m->slot_xa[slot_index] = xa;
+    e->m->slot_xpa[slot_index] = 0;
+    uint32_t to_exit = ~0u;
+    if (check) {
+        put(e, 0xb9400000u | (HV_CPU_EXIT_REQ / 4) << 10 | 28 << 5 | 15); /* ldr w15, [x28, #exit_req] */
+        to_exit = e->n;
+        put(e, 0x35000000u | 15);                                         /* cbnz w15, slow (patched below) */
+    }
+    uint32_t to_miss = ~0u;
+    if (xa) {
+        /* The target page's fetch tag: its VA and addend, against what they were. */
+        int table = !(e->flags & HV_BLOCK_EL1) ? 0 : (e->flags & HV_BLOCK_PAN) ? 2 : 1;
+        uint32_t off = HV_CPU_TLB + hv_tlb_code((uint32_t)(target >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1), table) * (uint32_t)sizeof(HvTlbEntry) + 16;
+        put(e, 0x91400000u | (off >> 12) << 10 | 28 << 5 | 7);  /* add x7, x28, #off & ~0xfff */
+        put(e, LDR_X(7, 7, off & 0xfff));
+        put_lit(e, 15, hv_exec_key(target & ~((1ull << HV_TLB_PAGE_BITS) - 1), (int64_t)xa));
+        put(e, 0xca000000u | 15 << 16 | 7 << 5 | 7);            /* eor x7, x7, x15 */
+        to_miss = e->n;
+        put(e, CBNZ_X(7));                                      /* not mapped so now: the branch cache */
+    }
+    /* Chaining rewrites this B to go straight to the target block (one aligned
+       B may be rewritten while other CPUs run it); until then, or when the
+       target is out of B's range, it goes to the stub, into hv_chain_thunk. */
+    uint32_t site_at = e->n;
+    put(e, B_OP | 1);
+    if (!p0) cold_on(e);
+    link_here(e, site_at, p0);
+    if (e->nsite < MAX_OOL) {
+        e->site[e->nsite].slot = slot_index;
+        e->site[e->nsite].flags = e->flags;
+        e->site[e->nsite].target = target;
+        e->site[e->nsite].at = site_at;
+        e->site[e->nsite].cold = (uint8_t)(p0 && !e->flat);
+        e->site[e->nsite].stub = e->n;
+        e->site[e->nsite].has_cond = 0;
+        e->site[e->nsite++].stub_cold = (uint8_t)(e->in_cold && !e->flat);
+        e->site_direct = !check && !xa;
+    }
+    if (check) link_here(e, to_exit, p0);
+    put(e, STR_X(30, 28, HV_CPU_X(30)));
+    put(e, LDR_X(15, 28, HV_CPU_CHAIN_THUNK));
+    if ((e->n & 1) == 0) put(e, 0xd503201f);                         /* nop: the data starts 8-byte aligned */
+    put(e, BLR_X(15));
+    put(e, (uint32_t)(uintptr_t)slot);
+    put(e, (uint32_t)((uintptr_t)slot >> 32));
+    put(e, (uint32_t)target);
+    put(e, (uint32_t)(target >> 32));
+    if (xa) {
+        link_here(e, to_miss, p0);
+        if (use_xjump()) put_xjump(e, target, 0); /* exit_req was checked above if it had to be */
+        else {
+            put_lit(e, 15, target);
+            put_ijc_jump(e, 0);
+        }
+    }
+    if (!p0) cold_off(e);
+}
+
+/* Call hv_helper(cpu, info) and continue unless it leaves. */
+/* Call hv_helper: guest x30 saved, a blr to hv_helper_thunk with x6 = its HvHelperInfo,
+   and x0 reloaded when it comes back. Host x6 and x15 are clobbered. */
+static void put_helper(Emit *e, uint64_t pc, uint32_t insn, uint32_t op);
+
+/* A memory slow path whose thunk may refill the TLB and resume at `retry`:
+   the op word carries the refill flags (bits 18..8) and how far back retry is
+   from where the helper would resume (bits 31..19, in words). */
+static void put_helper_refill(Emit *e, uint64_t pc, uint32_t insn, uint32_t rflags, uint32_t retry) {
+    put_helper(e, pc, insn, HV_OP_MEM);
+    uint32_t resume = e->n - 1; /* the ldr x0, [x28] the helper comes back to */
+    uint32_t back = resume - retry;
+    if (back < (1u << 13) && rflags < (1u << 11)) e->pool[e->npool - 1] = (uint64_t)insn | (uint64_t)(HV_OP_MEM | rflags << 8 | back << 19) << 32;
+}
+
+/* The return address is where it goes back to, so the thunk's RET goes where the CPU expects
+   and leaves its stack of return addresses as it was. The HvHelperInfo is in the pool. */
+static void put_helper(Emit *e, uint64_t pc, uint32_t insn, uint32_t op) {
+    uint32_t info = e->npool;
+    e->pool[info] = pc;
+    e->pool[info + 1] = (uint64_t)insn | (uint64_t)op << 32;
+    e->npool += 2;
+    put(e, STR_X(30, 28, HV_CPU_X(30)));
+    if (getenv("HENGE_SP_PROBE")) { put(e, ADD_SP_TO(15)); put(e, STR_X(15, 28, 0x130)); } /* spill[3] = host sp */
+    put(e, LDR_X(15, 28, HV_CPU_HELPER_THUNK));
+    e->fix[e->nfix++] = (LitFix){e->n, FIX_ADR, info, (uint8_t)(e->in_cold && !e->flat)};
+    put(e, 0x10000006u); /* adr x6, info */
+    put(e, BLR_X(15));
+    put(e, LDR_X(0, 28, 0));
+}
+
+/* d = n + imm for |imm| < 2^24; n and d are general registers, never SP. */
+static void put_add_imm(Emit *e, int d, int n, int64_t imm) {
+    if (imm == 0) {
+        if (d != n) put(e, MOV_X(d, n));
+        return;
+    }
+    uint32_t op = imm < 0 ? 0xd1000000u : 0x91000000u;
+    uint64_t a = imm < 0 ? (uint64_t)-imm : (uint64_t)imm;
+    if (a < 4096) {
+        put(e, op | (uint32_t)a << 10 | n << 5 | d);
+        return;
+    }
+    put(e, op | 1u << 22 | (uint32_t)(a >> 12) << 10 | n << 5 | d);
+    if (a & 0xfff) put(e, op | (uint32_t)(a & 0xfff) << 10 | d << 5 | d);
+}
+
+/* ---- scratch registers ---- */
+
+/* Host registers that can be borrowed: any guest-allocated one, saved in cpu->spill. */
+/* Host x6, x7 and x15 hold no guest register (guest x6, x7, x15 live in the
+   HvCpu, like x18 and x28: they are the least used in compiled code), so they
+   are free scratch: picked first and never spilled. */
+static const uint8_t candidates[] = {6, 7, 15, 9, 10, 11, 12, 13, 14, 0, 1, 2, 3, 4, 5, 8,
+                                     16, 17, 19, 20, 21, 22, 23, 24, 25, 26, 27, 29, 30};
+
+static int is_free(int reg) {
+    return reg == 6 || reg == 7 || reg == 15;
+}
+
+static int pick(uint32_t *used) {
+    for (unsigned i = 0; i < sizeof candidates; i++) {
+        int r = candidates[i];
+        if (!(*used & (1u << r))) {
+            *used |= 1u << r;
+            return r;
+        }
+    }
+    return -1;
+}
+
+/* Free scratch registers need no saving; the rest go to cpu->spill in order. */
+static int need_spill(const uint8_t *regs, int n, uint8_t *out) {
+    int k = 0;
+    for (int i = 0; i < n; i++)
+        if (!is_free(regs[i])) out[k++] = regs[i];
+    return k;
+}
+
+static void spill(Emit *e, const uint8_t *regs, int n) {
+    uint8_t r[4];
+    n = need_spill(regs, n, r);
+    int i = 0;
+    for (; i + 1 < n; i += 2) put(e, STP_X(r[i], r[i + 1], 28, HV_CPU_SPILL(i)));
+    if (i < n) put(e, STR_X(r[i], 28, HV_CPU_SPILL(i)));
+}
+
+static void unspill(Emit *e, const uint8_t *regs, int n) {
+    uint8_t r[4];
+    n = need_spill(regs, n, r);
+    int i = 0;
+    for (; i + 1 < n; i += 2) put(e, LDP_X(r[i], r[i + 1], 28, HV_CPU_SPILL(i)));
+    if (i < n) put(e, LDR_X(r[i], 28, HV_CPU_SPILL(i)));
+}
+
+/* Where a register the translator does not keep in a host register lives. */
+static int is_stolen(int reg) {
+    return reg == 18 || reg == 28 || is_free(reg);
+}
+
+static uint32_t slot_of(int reg) {
+    return reg == 31 ? HV_CPU_SP : HV_CPU_X(reg);
+}
+
+/* ---- instruction groups ---- */
+
+static void translate_copy(Emit *e, uint32_t insn) {
+    uint32_t fields = hv_gpr_fields(insn);
+    if (!fields) {
+        put(e, insn);
+        return;
+    }
+    int stolen[4] = {-1, -1, -1, -1}; /* per field: the guest register to rename, or -1 */
+    uint32_t used = 0;
+    int any = 0;
+    for (int f = 0; f < 4; f++) {
+        if (!(fields & (1u << f))) continue;
+        int r = hv_field_reg(insn, f);
+        used |= 1u << r;
+        if (is_stolen(r)) { /* guest SP is the host SP while blocks run: copied as it is */
+            stolen[f] = r;
+            any = 1;
+        }
+    }
+    if (!any) {
+        put(e, insn);
+        return;
+    }
+    /* One scratch per distinct stolen register; x6, x7 and x15 use their own host register. */
+    int guest_of[4] = {-1, -1, -1, -1}, scratch_of[4];
+    uint8_t regs[4];
+    int n = 0;
+    for (int f = 0; f < 4; f++) {
+        if (stolen[f] < 0) continue;
+        int k = 0;
+        while (k < n && guest_of[k] != stolen[f]) k++;
+        if (k == n) {
+            guest_of[n] = stolen[f];
+            scratch_of[n] = is_free(stolen[f]) ? stolen[f] : pick(&used);
+            regs[n] = scratch_of[n];
+            n++;
+        }
+    }
+    spill(e, regs, n);
+    /* All copied forms only write Rd but for MOVK and BFM (BFI, BFXIL), so what is in Rd alone
+       needs no loading first. */
+    int rd_read = (insn & 0x7f800000) == 0x72800000 || (insn & 0x7f800000) == 0x33000000 || hv_knob[HV_K_TEST3];
+    for (int k = 0; k < n; k++) {
+        int read = 0;
+        for (int f = 0; f < 4; f++)
+            if (stolen[f] == guest_of[k] && (f || rd_read)) read = 1;
+        if (read) put(e, LDR_X(scratch_of[k], 28, slot_of(guest_of[k])));
+    }
+    uint32_t out = insn;
+    for (int f = 0; f < 4; f++) {
+        if (stolen[f] < 0) continue;
+        int k = 0;
+        while (guest_of[k] != stolen[f]) k++;
+        out = hv_field_set(out, f, scratch_of[k]);
+    }
+    put(e, out);
+    if (stolen[0] >= 0) { /* Rd was renamed: every copied form with an Rd field writes it */
+        int k = 0;
+        while (guest_of[k] != stolen[0]) k++;
+        put(e, STR_X(scratch_of[k], 28, slot_of(stolen[0])));
+    }
+    unspill(e, regs, n);
+}
+
+/* Write a translation-time constant to guest register rd (31 is XZR here). */
+static void put_const_to(Emit *e, int rd, uint64_t value) {
+    if (rd == 31) return;
+    if (!is_stolen(rd)) {
+        put_lit(e, rd, value);
+        return;
+    }
+    uint8_t s = 15; /* free scratch: the spill below is empty */
+    spill(e, &s, 1);
+    put_lit(e, s, value);
+    put(e, STR_X(s, 28, slot_of(rd)));
+    unspill(e, &s, 1);
+}
+
+static void translate_pcrel(Emit *e, uint32_t insn, uint64_t pc) {
+    int64_t imm = sext(((insn >> 5) & 0x7ffff) << 2 | ((insn >> 29) & 3), 21);
+    uint64_t value = (insn >> 31) ? (pc & ~0xfffull) + ((uint64_t)imm << 12) : pc + imm;
+    put_const_to(e, insn & 0x1f, value);
+}
+
+/* Bits 54..48 take bit 55's value. Guest pointers are never signed, so for a
+   canonical pointer this changes nothing; it only clears a stray PAC field. */
+static void put_strip(Emit *e, int r) {
+    if (r == 31) return;
+    uint32_t used = 1u << r;
+    if (!is_stolen(r)) {
+        uint8_t t = pick(&used);
+        spill(e, &t, 1);
+        put(e, SBFM_X(t, r, 55, 55));
+        put(e, BFM_X(r, t, 16, 6));
+        unspill(e, &t, 1);
+        return;
+    }
+    uint8_t regs[2];
+    regs[0] = pick(&used);
+    regs[1] = pick(&used);
+    spill(e, regs, 2);
+    put(e, LDR_X(regs[0], 28, slot_of(r)));
+    put(e, SBFM_X(regs[1], regs[0], 55, 55));
+    put(e, BFM_X(regs[0], regs[1], 16, 6));
+    put(e, STR_X(regs[0], 28, slot_of(r)));
+    unspill(e, regs, 2);
+}
+
+static void translate_pac(Emit *e, uint32_t insn) {
+    if ((insn & 0xfffff01f) == 0xd503201f) { /* hint space */
+        uint32_t imm = ((insn >> 8) & 0xf) << 3 | ((insn >> 5) & 7);
+        if (imm == 7 || imm >= 28) put_strip(e, 30);       /* XPACLRI, AUTIASP and friends */
+        else if (imm == 12 || imm == 14) put_strip(e, 17); /* AUTIA1716, AUTIB1716 */
+        return;                                            /* PAC*: no-op */
+    }
+    int rd = insn & 0x1f;
+    if ((insn & 0xffe0fc00) == 0x9ac03000) { /* PACGA: a fixed code keeps sign/verify pairs consistent */
+        if (rd == 31) return;
+        if (is_stolen(rd)) put(e, STR_X(31, 28, slot_of(rd)));
+        else put(e, 0xd2800000u | rd); /* movz xd, #0 */
+        return;
+    }
+    uint32_t opcode = (insn >> 10) & 0x3f;
+    if (opcode >= 16 || (opcode & 4)) put_strip(e, rd); /* XPAC*, AUT* */
+}
+
+/* HV_SUPERBLOCKS=1: a conditional branch does not end its block; the block goes
+   on with the instruction after it (the taken side leaves out of line). */
+static int superblocks(void) {
+    return hv_knob[HV_K_SUPERBLOCKS];
+}
+
+/* The block may go on past a conditional branch at pc: the next instruction is
+   in the same page and the block is not long already. */
+static int go_on(Emit *e, uint64_t pc) {
+    return ((pc + 4) & ~((1ull << HV_TLB_PAGE_BITS) - 1)) == e->page && e->cur_i + 1 < 48;
+}
+
+/* Calls and returns the way the host's CPU can predict them. It keeps a stack of return
+   addresses of its own, filled by its BL and used by its RET, and those are right nearly
+   always, even in code run for the first time. A return reached through a register-indirect
+   branch gets none of that, and a mispredicted branch costs some twenty instructions' time.
+   So a guest call is a host BL, whose return address (H: the code for what follows the call)
+   goes in a table by the guest's return address; a guest return that finds its own address
+   there is a host RET to H. Otherwise the indirect-branch cache, as ever.
+
+   A table and not a stack, so calls and returns don't wait for each other: a stack's top has
+   to go through memory from each to the next. One table per block-flags value, so what H
+   assumes about the CPU's state still holds; tags are VA ^ ret_salt, which changes whenever
+   what is in the table may have gone out of date (see ret_new in mmu.c). Host x6, x7 and x15
+   are free at a call and a return, and x30 is about to be set.
+
+       bl   L
+    H: (exit to the block after the call)
+    L: add  x7, x28, #entry, lsl #12
+       str  x30, [x7, #entry & 0xfff + 8]
+       ldr  x30, =return address
+       ldr  x6, [x28, #salt]
+       eor  x6, x6, x30
+       str  x6, [x7, #entry & 0xfff]                                    */
+static int use_ras(const Emit *e) {
+    return !hv_knob[HV_K_NO_RAS] && !e->no_ijc; /* HV_NO_RAS: every return through the indirect-branch cache */
+}
+
+static void put_call(Emit *e, uint64_t ret) {
+    uint32_t off = HV_CPU_RET_TAB + (e->flags & (HV_IJC_TABLES - 1)) * HV_RET_TAB_BYTES + (((uint32_t)ret >> 2) & ((1u << HV_RET_BITS) - 1)) * 16;
+    uint32_t to_l = e->n;
+    put(e, 0x94000000u); /* bl L */
+    put_branch_exit(e, ret, 1);
+    patch_branch(&e->w[to_l], (int64_t)e->n - to_l);
+    put(e, 0x91400000u | (off >> 12) << 10 | 28 << 5 | 7);                /* add x7, x28, #off, lsl #12 */
+    put(e, STR_X(30, 7, (off & 0xfff) + 8));
+    put_lit(e, 30, ret);
+    put(e, LDR_X(6, 28, HV_CPU_RET_SALT + 8 * (e->flags & HV_BLOCK_EL1)));
+    put(e, 0xca000000u | 30 << 16 | 6 << 5 | 6);                          /* eor x6, x6, x30 */
+    put(e, STR_X(6, 7, off & 0xfff));
+}
+
+/* The other half: a return. A miss goes through the indirect-branch cache. */
+static void put_return(Emit *e) {
+    uint32_t tab = HV_CPU_RET_TAB + (e->flags & (HV_IJC_TABLES - 1)) * HV_RET_TAB_BYTES;
+    put(e, UBFM_X(7, 30, 2, 2 + HV_RET_BITS - 1));                        /* ubfx x7, x30, #2, #bits */
+    put(e, ADD_LSL(7, 28, 7, 4));
+    put(e, 0x91400000u | (tab >> 12) << 10 | 7 << 5 | 7);                 /* add x7, x7, #tab, lsl #12 */
+    put(e, 0xa9400000u | 6 << 10 | 7 << 5 | 15);                          /* ldp x15, x6, [x7] */
+    put(e, LDR_X(7, 28, HV_CPU_RET_SALT + 8 * (e->flags & HV_BLOCK_EL1)));
+    put(e, 0xca000000u | 30 << 16 | 7 << 5 | 7);                          /* eor x7, x7, x30 */
+    put(e, 0xca000000u | 7 << 16 | 15 << 5 | 15);                         /* eor x15, x15, x7 */
+    uint32_t to_miss = e->n;
+    put(e, CBNZ_X(15));
+    put(e, 0xd65f0000u | 6 << 5);                                         /* ret x6 */
+    int p0 = e->in_cold;
+    if (!p0) cold_on(e);
+    link_here(e, to_miss, p0);
+    put(e, MOV_X(15, 30));
+    put_ijc_jump(e, 1);
+    if (!p0) cold_off(e);
+}
+
+/* Ends the block (returns 1), or 0 for a conditional branch the block goes on past. */
+static int translate_branch(Emit *e, uint32_t insn, uint64_t pc) {
+    if ((insn & 0x7c000000) == 0x14000000) { /* B, BL */
+        uint64_t target = pc + (sext(insn & 0x3ffffff, 26) << 2);
+        if (insn >> 31) {
+            if (use_ras(e)) put_call(e, pc + 4);
+            else put_const_to(e, 30, pc + 4);
+        }
+        put_branch_exit(e, target, 1);
+        return 1;
+    }
+    if ((insn & 0xff000000) == 0x54000000) { /* B.cond, BC.cond */
+        uint64_t target = pc + (sext((insn >> 5) & 0x7ffff, 19) << 2);
+        uint32_t cond = insn & 0xf;
+        if (cond >= 14) {
+            put_branch_exit(e, target, 1);
+            return 1;
+        }
+        put(e, 0x54000000u | cond);
+        put_ool(e, (Ool){.kind = OOL_EXIT, .pc = target, .plain = 1});
+        if (superblocks() && go_on(e, pc)) return 0;
+        put_branch_exit(e, pc + 4, 1);
+        return 1;
+    }
+    /* CBZ/CBNZ (imm19) and TBZ/TBNZ (imm14) */
+    int tb = (insn & 0x7e000000) == 0x36000000;
+    uint64_t target = pc + (tb ? sext((insn >> 5) & 0x3fff, 14) << 2 : sext((insn >> 5) & 0x7ffff, 19) << 2);
+    uint32_t bare = tb ? insn & ~(0x3fffu << 5) : insn & ~(0x7ffffu << 5);
+    int rt = insn & 0x1f;
+    if (!is_stolen(rt)) {
+        put(e, bare);
+        put_ool(e, (Ool){.kind = OOL_EXIT, .pc = target, .plain = 1});
+        if (superblocks() && go_on(e, pc)) return 0;
+        put_branch_exit(e, pc + 4, 1);
+        return 1;
+    }
+    uint8_t s = 15; /* free scratch: the spill below is empty */
+    spill(e, &s, 1);
+    put(e, LDR_X(s, 28, slot_of(rt)));
+    put(e, (bare & ~0x1fu) | s);
+    put_ool(e, (Ool){.kind = OOL_EXIT, .pc = target, .nrestore = 1, .restore = {s}, .plain = 1});
+    unspill(e, &s, 1);
+    if (superblocks() && go_on(e, pc)) return 0;
+    put_branch_exit(e, pc + 4, 1);
+    return 1;
+}
+
+/* BR, BLR, RET and their PAC forms. Ends the block. The target is looked up
+   inline in the indirect-branch cache for this block's flags: a hit jumps
+   straight to the target block's first entry (which reloads guest x1 and x0);
+   a miss leaves for the dispatcher, which fills the cache. Tags are VA ^ salt,
+   and the salt changes whenever mappings or code change. */
+static void translate_branch_reg(Emit *e, uint32_t insn, uint64_t pc) {
+    uint32_t opc = (insn >> 21) & 3;
+    int rn = (insn >> 5) & 0x1f;
+    if (opc == 2 && ((insn >> 11) & 0x1f) == 1) rn = 30; /* RETAA, RETAB: the Rn field is all ones, the target is x30 */
+    if (opc == 2 && rn == 30 && use_ras(e)) { /* RET, the usual way out of a function */
+        put_return(e);
+        return;
+    }
+    if (is_stolen(rn)) put(e, LDR_X(15, 28, slot_of(rn)));
+    else put(e, MOV_X(15, rn));                             /* 31 is XZR here */
+    if (opc == 1) {                                         /* BLR: after reading Rn */
+        if (use_ras(e)) put_call(e, pc + 4);
+        else put_lit(e, 30, pc + 4);
+    }
+    put_ijc_jump(e, 1);
+}
+
+/* Loads and stores. A, T and U are borrowed host registers: A holds the guest
+   address and then the host address, T and U index the TLB and then stand in
+   for x18/x28 operands. A miss goes out of line to hv_mem_emulate, which does
+   the whole instruction (writeback included) and comes back to the join. */
+static void translate_mem(Emit *e, uint32_t insn, uint64_t pc);
+static void translate_mem_impl(Emit *e, uint32_t insn, uint64_t pc, int from_excl);
+static void put_load_field(Emit *e, int rt, uint32_t off);
+static void put_store_field(Emit *e, int rt, uint32_t off);
+
+/* LDXP/LDAXP and STXP/STLXP (64-bit or 128-bit exclusive pairs): Windows 11
+   SLISTs (ExInterlockedPopEntrySList / PushEntrySList) execute these 400K+/s.
+   Uses free scratch x6, x7, x15 (plus one spilled even pair on 128-bit STXP)
+   and native host LDP / CASAL / CASPAL after a single aligned TLB check. */
+static void translate_excl_pair(Emit *e, uint32_t insn, uint64_t pc) {
+    uint32_t sz = (insn >> 30) & 1; /* 0: two 32-bit words (8B), 1: two 64-bit words (16B) */
+    uint32_t bytes = 8u << sz, k = 3u + sz;
+    int rn = (insn >> 5) & 0x1f, rt = insn & 0x1f, rt2 = (insn >> 10) & 0x1f, rs = (insn >> 16) & 0x1f;
+    int load = (insn >> 22) & 1, acqrel = (insn >> 15) & 1;
+    if ((load && rt == rt2 && rt != 31) || (!load && (rs == 31 || rs == rt || rs == rt2 || rs == rn))) {
+        put_helper(e, pc, insn, HV_OP_MEM);
+        return;
+    }
+    int g_el = !(e->flags & HV_BLOCK_EL1) ? 0 : (e->flags & HV_BLOCK_PAN) ? 2 : 1;
+    uint32_t retry = e->n;
+    if (rn == 31) put(e, ADD_SP_TO(6));
+    else if (is_stolen(rn)) put(e, LDR_X(6, 28, slot_of(rn)));
+    else put(e, MOV_X(6, rn));
+    uint32_t tlb = put_tlb_slot(e, 7, 6, g_el);
+    put(e, LDR_X(15, 7, tlb + (load ? 0 : 8)));
+    put(e, SUB_X(15, 6, 15));
+    put(e, 0xd1000000u | HV_TLB_ADJ << 10 | 15 << 5 | 15); /* sub x15, x15, #ADJ */
+    put(e, 0x92400000u | (64u - HV_TLB_PAGE_BITS) << 16 | (63u - HV_TLB_PAGE_BITS + k) << 10 | 15 << 5 | 15);
+    put(e, CBNZ_X(15));
+    uint32_t rflags = 1u << 9 | 1u << 10 | (uint32_t)(load ? 0 : 1) | (uint32_t)g_el << 1 | (bytes - 1) << 3;
+    put_ool(e, (Ool){.kind = OOL_SLOW, .pc = pc, .insn = insn, .addr = 6, .retry = retry, .rflags = rflags});
+    uint32_t slow = e->nool - 1;
+    put(e, LDR_X(15, 7, tlb + 24));
+    put(e, ADD_LSL(15, 6, 15, 0)); /* x15 = aligned host pointer, x6 = guest VA */
+
+    if (load) {
+        put(e, STR_X(6, 28, HV_CPU_EXCL_ADDR));
+        put(e, 0x52800007u | bytes << 5);
+        put(e, 0xb9000000u | (HV_CPU_EXCL_SIZE / 4) << 10 | 28 << 5 | 7);
+        if (!sz) {
+            put(e, acqrel ? (0xc8dffc06u | 15u << 5) : LDR_X(6, 15, 0)); /* ldar / ldr x6, [x15] */
+            put(e, UBFM_X(7, 6, 32, 63));
+            put(e, UBFM_X(6, 6, 0, 31));
+        } else {
+            put(e, LDP_X(6, 7, 15, 0)); /* 16B-aligned LDP is single-copy atomic on Apple Silicon (FEAT_LSE2) */
+            if (acqrel) put(e, 0xd50339bfu); /* dmb ishld */
+        }
+        put(e, STR_X(6, 28, HV_CPU_EXCL_VAL));
+        put(e, STR_X(7, 28, HV_CPU_EXCL_VAL + 8));
+        if (rt != 31) put(e, is_stolen(rt) ? STR_X(6, 28, slot_of(rt)) : MOV_X(rt, 6));
+        if (rt2 != 31) put(e, is_stolen(rt2) ? STR_X(7, 28, slot_of(rt2)) : MOV_X(rt2, 7));
+        e->ool[slow].join = e->n;
+        return;
+    }
+
+    /* STXP / STLXP: check excl_addr == va && excl_size == bytes */
+    put(e, LDR_X(7, 28, HV_CPU_EXCL_ADDR));
+    put(e, 0xca000000u | 6u << 16 | 7u << 5 | 7u); /* eor x7, x7, x6 */
+    uint32_t to_fail1 = e->n;
+    put(e, CBNZ_X(7));
+    put(e, 0xb9400000u | (HV_CPU_EXCL_SIZE / 4) << 10 | 28 << 5 | 7); /* ldr w7, [x28, #excl_size] */
+    put(e, 0xd1000000u | bytes << 10 | 7u << 5 | 7u);                 /* sub x7, x7, #bytes */
+    uint32_t to_fail2 = e->n;
+    put(e, CBNZ_X(7));
+    put(e, 0x92800007u); /* movn x7, #0 */
+    put(e, STR_X(7, 28, HV_CPU_EXCL_ADDR));
+
+    /* Borrow an even non-stolen pair (p0, p1) != rs for CASPAL (w6/x6, w7/x7, wp0/xp0, wp1/xp1, [x15]). */
+    int p0 = (rs == 0 || rs == 1) ? 2 : 0, p1 = p0 + 1;
+    if (rt == 31) put(e, 0xd2800006u);
+    else if (is_stolen(rt)) put(e, LDR_X(6, 28, slot_of(rt)));
+    else put(e, MOV_X(6, rt));
+    if (rt2 == 31) put(e, 0xd2800007u);
+    else if (is_stolen(rt2)) put(e, LDR_X(7, 28, slot_of(rt2)));
+    else put(e, MOV_X(7, rt2));
+    put(e, STP_X(p0, p1, 28, HV_CPU_SPILL(0)));
+    put(e, MOV_X(p0, 6));
+    put(e, MOV_X(p1, 7));
+    put(e, LDR_X(6, 28, HV_CPU_EXCL_VAL));
+    put(e, LDR_X(7, 28, HV_CPU_EXCL_VAL + 8));
+    put(e, sz << 30 | 0x0860fc00u | 6u << 16 | 15u << 5 | (uint32_t)p0); /* caspal w/x6, w/x7, w/xp0, w/xp1, [x15] */
+    put(e, LDR_X(p0, 28, HV_CPU_EXCL_VAL));
+    put(e, LDR_X(p1, 28, HV_CPU_EXCL_VAL + 8));
+    put(e, 0xca000000u | (uint32_t)p0 << 16 | 6u << 5 | 6u); /* eor x6, x6, xp0 */
+    put(e, 0xca000000u | (uint32_t)p1 << 16 | 7u << 5 | 7u); /* eor x7, x7, xp1 */
+    put(e, 0xaa0700c6u);                                      /* orr x6, x6, x7 */
+    put(e, LDP_X(p0, p1, 28, HV_CPU_SPILL(0)));
+    uint32_t to_lost = e->n;
+    put(e, CBNZ_X(6));
+    put_const_to(e, rs, 0);
+    uint32_t to_done = e->n;
+    put(e, B_OP);
+    patch_branch(&e->w[to_fail1], (int64_t)e->n - to_fail1);
+    patch_branch(&e->w[to_fail2], (int64_t)e->n - to_fail2);
+    put(e, 0x92800007u);
+    put(e, STR_X(7, 28, HV_CPU_EXCL_ADDR));
+    patch_branch(&e->w[to_lost], (int64_t)e->n - to_lost);
+    put_const_to(e, rs, 1);
+    patch_branch(&e->w[to_done], (int64_t)e->n - to_done);
+    e->ool[slow].join = e->n;
+}
+
+/* LDXR/LDAXR and STXR/STLXR (not the pairs), the way QEMU does them: LDXR is
+   an ordinary load that records the address, size and value; STXR, if the
+   address still matches, is a compare-and-swap of that value (CASAL, through
+   the ordinary fast path), and succeeds if memory still held it. Another CPU's
+   store in between makes it fail, and so does an exception (which clears the
+   address), as on hardware; only an ABA change goes unnoticed. */
+static void translate_excl(Emit *e, uint32_t insn, uint64_t pc) {
+    uint32_t size = insn >> 30;
+    int rn = (insn >> 5) & 0x1f, rt = insn & 0x1f, rs = (insn >> 16) & 0x1f;
+    int load = (insn >> 22) & 1;
+    if (!load && (rs == 31 || rs == rt || rs == rn)) { /* the status register is the CAS's compare value: keep these in C */
+        put_helper(e, pc, insn, HV_OP_MEM);
+        return;
+    }
+    if (load) {
+        int g_el = !(e->flags & HV_BLOCK_EL1) ? 0 : (e->flags & HV_BLOCK_PAN) ? 2 : 1;
+        uint32_t bytes = 1u << size;
+        uint32_t retry = e->n;
+        if (rn == 31) put(e, ADD_SP_TO(6));
+        else if (is_stolen(rn)) put(e, LDR_X(6, 28, slot_of(rn)));
+        else put(e, MOV_X(6, rn));
+        uint32_t tlb = put_tlb_slot(e, 7, 6, g_el);
+        put(e, LDR_X(15, 7, tlb));
+        put(e, SUB_X(15, 6, 15));
+        put(e, 0xd1000000u | HV_TLB_ADJ << 10 | 15 << 5 | 15);
+        if (size == 0)
+            put(e, UBFM_X(15, 15, HV_TLB_PAGE_BITS, 63));
+        else
+            put(e, 0x92400000u | (64u - HV_TLB_PAGE_BITS) << 16 | (63u - HV_TLB_PAGE_BITS + size) << 10 | 15 << 5 | 15);
+        put(e, CBNZ_X(15));
+        uint32_t rflags = 1u << 9 | (size ? 1u << 10 : 0) | (uint32_t)g_el << 1 | (bytes - 1) << 3;
+        put_ool(e, (Ool){.kind = OOL_SLOW, .pc = pc, .insn = insn, .addr = 6, .retry = retry, .rflags = rflags});
+        uint32_t slow = e->nool - 1;
+        put(e, LDR_X(15, 7, tlb + 24));
+        put(e, ADD_LSL(15, 6, 15, 0));
+        put(e, STR_X(6, 28, HV_CPU_EXCL_ADDR));
+        put(e, 0x52800007u | bytes << 5);
+        put(e, 0xb9000000u | (HV_CPU_EXCL_SIZE / 4) << 10 | 28 << 5 | 7);
+        if ((insn >> 15) & 1)
+            put(e, size << 30 | 0x08dffc06u | 15u << 5); /* ldar{b,h,w,x} w6/x6, [x15] */
+        else
+            put(e, size << 30 | 0x39400006u | 15u << 5); /* ldr{b,h,w,x} w6/x6, [x15] */
+        put(e, STR_X(6, 28, HV_CPU_EXCL_VAL));
+        if (rt != 31) put(e, is_stolen(rt) ? STR_X(6, 28, slot_of(rt)) : MOV_X(rt, 6));
+        e->ool[slow].join = e->n;
+        return;
+    }
+    int a = rn;
+    if (rn == 31) {
+        put(e, ADD_SP_TO(15));
+        a = 15;
+    } else if (is_stolen(rn)) {
+        put(e, LDR_X(15, 28, slot_of(rn)));
+        a = 15;
+    }
+    put(e, LDR_X(6, 28, HV_CPU_EXCL_ADDR));
+    put(e, 0xca000000u | (uint32_t)a << 16 | 6 << 5 | 6); /* eor x6, x6, xa */
+    uint32_t to_fail = e->n;
+    put(e, CBNZ_X(6));
+    put(e, 0x92800006u);                                   /* movn x6, #0: the monitor clears either way */
+    put(e, STR_X(6, 28, HV_CPU_EXCL_ADDR));
+    put_load_field(e, rs, HV_CPU_EXCL_VAL);                /* rs = the value LDXR saw */
+    translate_mem_impl(e, size << 30 | 0x08e0fc00u | (uint32_t)rs << 16 | (uint32_t)rn << 5 | (uint32_t)rt, pc, 1); /* casal */
+    /* rs now holds what memory held: success if that is what LDXR saw. */
+    if (is_stolen(rs)) put(e, LDR_X(7, 28, slot_of(rs)));
+    else put(e, MOV_X(7, rs));
+    put(e, LDR_X(6, 28, HV_CPU_EXCL_VAL));
+    put(e, 0xca000000u | 7 << 16 | 6 << 5 | 6);            /* eor x6, x6, x7 */
+    uint32_t to_lost = e->n;
+    put(e, CBNZ_X(6));
+    put_const_to(e, rs, 0);
+    uint32_t to_done = e->n;
+    put(e, B_OP);
+    patch_branch(&e->w[to_fail], (int64_t)e->n - to_fail);
+    put(e, 0x92800006u);
+    put(e, STR_X(6, 28, HV_CPU_EXCL_ADDR));
+    patch_branch(&e->w[to_lost], (int64_t)e->n - to_lost);
+    put_const_to(e, rs, 1);
+    patch_branch(&e->w[to_done], (int64_t)e->n - to_done);
+}
+
+static void translate_mem(Emit *e, uint32_t insn, uint64_t pc) {
+    translate_mem_impl(e, insn, pc, 0);
+}
+
+static void translate_mem_impl(Emit *e, uint32_t insn, uint64_t pc, int from_excl) {
+    HvMemOp op;
+    if (hv_mem_decode(insn, &op) != 0) {
+        put_helper(e, pc, insn, HV_OP_UNDEF);
+        return;
+    }
+    /*
+     * LSE gate: only HV_MEM_ATOMIC (LDADD/LDCLR/LDEOR/LDSET/LDSMAX/LDSMIN/
+     * LDUMAX/LDUMIN/SWP) and the two CAS forms are ARMv8.1.  Nothing else here
+     * may be gated, and getting that wrong is not a small mistake:
+     *
+     *   - HV_MEM_EXCL is LDXR/STXR -- ARMv8.0 baseline, always legal.
+     *   - HV_MEM_CAS / HV_MEM_CASP are the *decode* kinds that
+     *     decode_exclusive() also produces for the pair forms, so an earlier
+     *     version of this gate that listed them rejected STXR/STXP on a v8.0
+     *     CPU model.  Measured with work/probe/llsc.S: the kernel stopped
+     *     booting entirely (no serial output at all) and the probe died at its
+     *     first STXR, while the gate's own trace showed it had never fired for
+     *     an LSE instruction.
+     *
+     * The predicate is therefore HV_MEM_ATOMIC only.  CAS/CASA/CASL/CASAL are
+     * architecturally LSE too, but they share a decode kind with the
+     * pair-exclusive forms, so gating them costs more than it buys: a guest
+     * that gets CAS executed on a v8.0 model is a fidelity gap, while a guest
+     * whose STXR is rejected does not boot at all.  Narrow and correct beats
+     * complete and broken.
+     *
+     * Measured with the narrow predicate: probe A (LDXR/STXR) and B
+     * (LDXP/STXP) pass, C (LDADD) is rejected -- exactly the architecture's
+     * line -- and the Linux baseline reaches userspace in 18.36 s with the gate
+     * active.
+     */
+    if (!e->m->feat_lse &&
+        (op.kind == HV_MEM_ATOMIC)) {
+        put_helper(e, pc, insn, HV_OP_UNDEF);
+        return;
+    }
+    static int c_excl = -1; /* HV_C_EXCL: keep every exclusive on the C path (debugging) */
+    if (c_excl < 0) c_excl = getenv("HV_C_EXCL") != NULL;
+    if (op.kind == HV_MEM_EXCL && !e->slow_mem && !c_excl) {
+        if (op.bytes == 1u << op.size) translate_excl(e, insn, pc);
+        else translate_excl_pair(e, insn, pc);
+        return;
+    }
+    int inline_casp = op.kind == HV_MEM_CASP && !e->slow_mem && op.rs < 30 && op.rt < 30 &&
+                      !is_stolen(op.rs) && !is_stolen(op.rs + 1) && !is_stolen(op.rt) && !is_stolen(op.rt + 1);
+    if (e->slow_mem || op.kind == HV_MEM_EXCL || (op.kind == HV_MEM_CASP && !inline_casp)) {
+        put_helper(e, pc, insn, HV_OP_MEM);
+        return;
+    }
+    int literal = op.mode == HV_ADDR_LITERAL;
+    int vec_kind = op.kind == HV_MEM_VEC_MULTI || op.kind == HV_MEM_VEC_SINGLE;
+    int pair = op.kind == HV_MEM_PAIR;
+    int rmw = op.kind == HV_MEM_CAS || op.kind == HV_MEM_ATOMIC;
+    int rm_used = op.mode == HV_ADDR_REG || (vec_kind && op.mode == HV_ADDR_POST && op.rm != 31);
+
+    uint32_t used = 0;
+    if (!literal) used |= 1u << op.rn;
+    if (!op.vec) used |= 1u << op.rt | (pair ? 1u << op.rt2 : 0) | (inline_casp ? 1u << (op.rt + 1) : 0);
+    if (rm_used) used |= 1u << op.rm;
+    if (rmw) used |= 1u << op.rs;
+    if (inline_casp) used |= 3u << op.rs;
+    /* Guest x6, x7 and x15 live in the HvCpu: their host registers are as free as ever. */
+    if (!hv_knob[HV_K_TEST3]) used &= ~(1u << 6 | 1u << 7 | 1u << 15);
+    uint8_t s[3];
+    for (int i = 0; i < 3; i++) s[i] = pick(&used);
+    int A = s[0], T = s[1], U = s[2];
+    uint32_t retry = e->n; /* a refilled TLB miss runs the access again from here */
+    spill(e, s, 3);
+
+    /* Grouped (see Group): plan_groups only puts plain single and pair accesses
+       with an immediate offset on SP or an ordinary register here. */
+    int role = 0;
+    Group *grp = NULL;
+    if (!e->nogroup && e->cur_i < HV_MAX_BLOCK_INSNS && e->gid[e->cur_i] >= 0 && e->grp[e->gid[e->cur_i]].live) {
+        role = e->grole[e->cur_i];
+        grp = &e->grp[e->gid[e->cur_i]];
+    }
+    int g_el = op.unpriv || !(e->flags & HV_BLOCK_EL1) ? 0 : (e->flags & HV_BLOCK_PAN) ? 2 : 1;
+    if (role == 1) {
+        /* The whole range: A = base + lo, then the usual check for hi - lo bytes. */
+        int64_t lo = grp->lo, len = grp->hi - grp->lo;
+        int ch = A; /* the register the check reads: base + lo */
+        if (op.rn == 31) {
+            if (lo) put_add_imm(e, A, 31, lo); /* ADD/SUB (immediate) read SP as register 31 */
+            else put(e, ADD_SP_TO(A));
+        } else if (lo) {
+            put_add_imm(e, A, op.rn, lo);
+        } else {
+            ch = op.rn;
+        }
+        uint32_t gtlb = put_tlb_slot(e, T, ch, g_el);
+        put(e, LDR_X(U, T, gtlb + (grp->store ? 8 : 0)));
+        put(e, SUB_X(U, ch, U));
+        if (len > HV_TLB_ADJ + 1) put_add_imm(e, U, U, len - 1 - HV_TLB_ADJ);
+        put(e, UBFM_X(U, U, HV_TLB_PAGE_BITS, 63));
+        put(e, CBNZ_X(U));
+        put_ool(e, (Ool){.kind = OOL_GROUP, .pc = (uint64_t)(grp - e->grp), .nrestore = 3, .restore = {A, T, U}});
+        put(e, LDR_X(U, T, gtlb + 24));
+        put(e, STR_X(U, 28, HV_CPU_GADDEND + 8 * grp->slot));
+        put(e, ADD_LSL(A, ch, U, 0)); /* host address of base + lo */
+    } else if (role == 2) {
+        if (!(e->u_prev == grp->slot + 1 && U == 15)) put(e, LDR_X(U, 28, HV_CPU_GADDEND + 8 * grp->slot));
+        put(e, op.rn == 31 ? ADD_EXT(A, 31, U, 3, 0) : ADD_LSL(A, op.rn, U, 0)); /* host address of the base */
+    }
+    /* Grouped: A + gimm is the host address (the access encodes gimm when it can). */
+    int64_t gimm = role ? (op.mode == HV_ADDR_POST ? 0 : op.imm) - (role == 1 ? grp->lo : 0) : 0;
+
+    /* Effective address into A, or used where it is: a guest base register with nothing added. */
+    int sp_base = !literal && op.rn == 31; /* the guest SP, which is the host SP while blocks run */
+    int base_stolen = !literal && (sp_base || is_stolen(op.rn));
+    int direct = !literal && !base_stolen &&
+                 (op.mode == HV_ADDR_POST || ((op.mode == HV_ADDR_OFFSET || op.mode == HV_ADDR_PRE) && op.imm == 0));
+    int addr = direct ? op.rn : A;
+    int base = op.rn;
+    if (role) {
+        /* the address is in A already */
+    } else if (literal) {
+        put_lit(e, A, pc + op.imm);
+    } else {
+        if (base_stolen) {
+            put(e, sp_base ? ADD_SP_TO(A) : LDR_X(A, 28, slot_of(op.rn)));
+            base = A;
+        }
+        switch (op.mode) {
+        case HV_ADDR_OFFSET:
+        case HV_ADDR_PRE:
+            if (!direct) put_add_imm(e, A, base, op.imm);
+            break;
+        case HV_ADDR_REG: {
+            int rm = op.rm;
+            if (is_stolen(rm)) {
+                put(e, LDR_X(T, 28, slot_of(rm)));
+                rm = T;
+            }
+            put(e, ADD_EXT(A, base, rm, op.ext, op.shift));
+            break;
+        }
+        default:
+            if (!direct && base != A) put(e, MOV_X(A, base));
+            break;
+        }
+    }
+
+    /* TLB: index from the first byte; the tag check (see HvTlbEntry) also
+       makes an access that runs into the next page miss. Uses no flags. */
+    int el_idx = g_el;
+    uint32_t slow = ~0u;
+    if (!role) {
+    uint32_t tlb = put_tlb_slot(e, T, addr, el_idx);
+    put(e, LDR_X(U, T, tlb + (op.store ? 8 : 0)));
+    put(e, SUB_X(U, addr, U));
+    int host_align = (op.align || op.kind == HV_MEM_ORDERED) && op.bytes > 1;
+    if (host_align) {
+        /* and U, U, #~(((1 << HV_TLB_PAGE_BITS) - 1) & ~(bytes-1)) after taking the adjustment back off:
+           zero only if same page and aligned */
+        uint32_t k = __builtin_ctz(op.bytes);
+        put(e, 0xd1000000u | HV_TLB_ADJ << 10 | U << 5 | U); /* sub U, U, #ADJ */
+        put(e, 0x92400000u | (64u - HV_TLB_PAGE_BITS) << 16 | (63u - HV_TLB_PAGE_BITS + k) << 10 | U << 5 | U);
+    } else {
+        if (op.bytes > HV_TLB_ADJ + 1) put_add_imm(e, U, U, op.bytes - 1 - HV_TLB_ADJ);
+        put(e, UBFM_X(U, U, HV_TLB_PAGE_BITS, 63));
+    }
+    put(e, CBNZ_X(U));
+    /* Writeback forms change their base, and the retry recomputes it: those
+       (and synthetic excl CAS or vector forms) go straight to the helper. */
+    int can_refill = !vec_kind && (!rmw || !from_excl) && op.mode != HV_ADDR_PRE && op.mode != HV_ADDR_POST && op.bytes <= 64 && !e->slow_mem;
+    /* hv_tlb_refill's flags: bit 9 set (so never 0), bit 10 align, bit 0 write, bits 2..1 the table, 8..3 bytes - 1 */
+    uint32_t rflags = can_refill ? 1u << 9 | (uint32_t)(host_align ? 1u << 10 : 0) |
+                                   (uint32_t)(op.store ? 1 : 0) | (uint32_t)el_idx << 1 | (op.bytes - 1) << 3 : 0;
+    put_ool(e, (Ool){.kind = OOL_SLOW, .pc = pc, .insn = insn, .nrestore = 3, .restore = {A, T, U},
+                     /* The exact recheck for a page's last 15 bytes costs 6 words in every access's slow path; without it
+                        (HV_RECHECK=0, the default) such an access takes the refill, which sends it to the helper. */
+                     .recheck = hv_knob[HV_K_RECHECK] && !host_align && op.bytes <= HV_TLB_ADJ + 1, .addr = (uint8_t)addr,
+                     .t = (uint8_t)T, .u = (uint8_t)U, .bytes = (uint8_t)op.bytes,
+                     .tag_off = tlb + (op.store ? 8 : 0), .retry = retry, .rflags = rflags});
+    slow = e->nool - 1;
+    put(e, LDR_X(U, T, tlb + 24));
+    }
+    /* Single loads and stores take [addr, addend] directly; the rest want the host address in A. */
+    int reg_offset = op.kind == HV_MEM_SINGLE || op.kind == HV_MEM_LITERAL || op.kind == HV_MEM_LDRA;
+    if (!reg_offset && !role) put(e, ADD_LSL(A, addr, U, 0));
+    if (role) {
+        int64_t scale = 1ll << op.size;
+        int fits = pair ? gimm % scale == 0 && gimm / scale >= -64 && gimm / scale < 64
+                        : (gimm >= 0 && gimm % scale == 0 && gimm / scale < 4096) || (gimm >= -256 && gimm < 256);
+        if (!fits) {
+            put_add_imm(e, A, A, gimm);
+            gimm = 0;
+        }
+    }
+
+    /* Stand-ins for x18/x28 operands: Rt (or Rs for RMW) in T, the other in U. */
+    int rt = op.rt, rt2 = op.rt2, rs = op.rs;
+    int rt_stolen = !op.vec && is_stolen(op.rt);
+    int rt2_stolen = pair && !op.vec && is_stolen(op.rt2);
+    int rs_stolen = rmw && is_stolen(op.rs);
+    if (rmw) {
+        if (rs_stolen) rs = T;
+        if (rt_stolen) rt = (op.rt == op.rs) ? T : U;
+    } else {
+        if (rt_stolen) rt = T;
+        if (rt2_stolen) rt2 = (op.rt2 == op.rt) ? T : U;
+    }
+    if (rs_stolen) put(e, LDR_X(rs, 28, slot_of(op.rs)));
+    /* Only RMW forms have an Rs; elsewhere bits 20..16 are immediate bits. */
+    int plain_load = op.load && !rmw && !hv_knob[HV_K_TEST3]; /* it only overwrites them */
+    if (rt_stolen && !plain_load && !(rmw && rs_stolen && rt == rs)) put(e, LDR_X(rt, 28, slot_of(op.rt)));
+    if (rt2_stolen && rt2 != rt && !plain_load) put(e, LDR_X(rt2, 28, slot_of(op.rt2)));
+
+    uint32_t out;
+    switch (op.kind) {
+    case HV_MEM_PAIR: {
+        uint32_t opc = op.vec ? op.size - 2u : (op.sign ? 1u : op.size == 3 ? 2u : 0u);
+        out = opc << 30 | 0x29000000u | (uint32_t)op.vec << 26 | (uint32_t)op.load << 22 | rt2 << 10 | A << 5 | rt;
+        if (role) out |= ((uint32_t)(gimm >> op.size) & 0x7f) << 15;
+        break;
+    }
+    case HV_MEM_SINGLE:
+    case HV_MEM_LITERAL:
+    case HV_MEM_LDRA: {
+        uint32_t size, opc;
+        if (op.vec) {
+            size = op.size == 4 ? 0 : op.size;
+            opc = (op.size == 4 ? 2u : 0u) | op.load;
+        } else {
+            size = op.size;
+            opc = op.store ? 0 : op.sign == 64 ? 2 : op.sign == 32 ? 3 : 1;
+        }
+        if (role && gimm >= 0 && gimm % (1ll << op.size) == 0 && (gimm >> op.size) < 4096) /* [A, #gimm] */
+            out = size << 30 | 0x39000000u | (uint32_t)op.vec << 26 | opc << 22 | (uint32_t)(gimm >> op.size) << 10 | (uint32_t)A << 5 | rt;
+        else if (role) /* LDUR/STUR [A, #gimm] */
+            out = size << 30 | 0x38000000u | (uint32_t)op.vec << 26 | opc << 22 | ((uint32_t)gimm & 0x1ff) << 12 | (uint32_t)A << 5 | rt;
+        else /* LDR/STR (register), LSL #0: [addr, U] */
+            out = size << 30 | 0x38206800u | (uint32_t)op.vec << 26 | opc << 22 | (uint32_t)U << 16 | (uint32_t)addr << 5 | rt;
+        break;
+    }
+    case HV_MEM_VEC_MULTI:
+    case HV_MEM_VEC_SINGLE:
+        out = (insn & ~(1u << 23) & ~(0x1fu << 16) & ~(0x1fu << 5)) | A << 5;
+        break;
+    case HV_MEM_CASP:
+        out = (insn & ~(0x1fu << 5)) | A << 5;
+        break;
+    default: /* ORDERED, CAS, ATOMIC: same instruction on the host address */
+        out = (insn & ~(0x1fu << 5) & ~0x1fu) | A << 5 | rt;
+        if ((insn & 0x3f200c00) == 0x19000000) out &= ~(0x1ffu << 12); /* LDAPUR/STLUR: drop imm9 */
+        if (rmw) out = (out & ~(0x1fu << 16)) | rs << 16;
+        break;
+    }
+    put(e, out);
+
+    if (rmw) {
+        if (rs_stolen && op.kind == HV_MEM_CAS) put(e, STR_X(rs, 28, slot_of(op.rs)));
+        if (rt_stolen && op.kind == HV_MEM_ATOMIC) put(e, STR_X(rt, 28, slot_of(op.rt)));
+    } else if (op.load) {
+        if (rt_stolen) put(e, STR_X(rt, 28, slot_of(op.rt)));
+        if (rt2_stolen) put(e, STR_X(rt2, 28, slot_of(op.rt2)));
+    }
+
+    /* Base writeback. */
+    if (op.mode == HV_ADDR_PRE || op.mode == HV_ADDR_POST) {
+        int b = op.rn;
+        if (base_stolen && !sp_base) {
+            put(e, LDR_X(T, 28, slot_of(op.rn)));
+            b = T;
+        }
+        if (vec_kind && op.rm != 31) {
+            int rm = op.rm;
+            if (is_stolen(rm)) {
+                put(e, LDR_X(U, 28, slot_of(rm)));
+                rm = U;
+            }
+            put(e, sp_base ? ADD_EXT(31, 31, rm, 3, 0) : ADD_LSL(b, b, rm, 0)); /* add sp, sp, rm, uxtx */
+        } else {
+            put_add_imm(e, b, b, op.imm); /* the immediate forms take SP as it is */
+        }
+        if (base_stolen && !sp_base) put(e, STR_X(T, 28, slot_of(op.rn)));
+    }
+    unspill(e, s, 3);
+    if (slow != ~0u) e->ool[slow].join = e->n;
+    /* Stand-ins for x18/x28 and writeback may have used U. */
+    if (role && U == 15 && !rt2_stolen && !(rt_stolen && rt == U) && op.mode == HV_ADDR_OFFSET) e->u_live = grp->slot + 1;
+}
+
+/* DC ZVA: zero the 64-byte block holding Xt, on the host's own copy when the
+   TLB maps it writable (xnu's bzero does this a million times a second).
+   The host's DC ZVA block is 64 bytes too (checked at translation time);
+   a miss, a code page or a device takes the SYS helper. */
+static int host_zva_is_64(void) {
+    static int known = -1;
+    if (known < 0) {
+        uint64_t dczid;
+        __asm__ volatile("mrs %0, dczid_el0" : "=r"(dczid));
+        known = (dczid & 0x1f) == 4;
+    }
+    return known;
+}
+
+/* IC IVAU at EL1 (xnu: 100K+ a second), without the helper when the page holds
+   no translated code: look the address up like a load, find its host page, and
+   check the main RAM's code-page flags. A TLB miss, another RAM region or a
+   code page take the helper, which invalidates. */
+static void translate_ic_ivau(Emit *e, uint32_t insn, uint64_t pc) {
+    HvRam *ram = e->m->main_ram;
+    int rt = insn & 0x1f;
+    uint32_t used = 1u << rt;
+    uint8_t s[3];
+    for (int i = 0; i < 3; i++) s[i] = pick(&used);
+    int A = s[0], T = s[1], U = s[2];
+    spill(e, s, 3);
+    if (is_stolen(rt)) put(e, LDR_X(A, 28, slot_of(rt)));
+    else put(e, MOV_X(A, rt)); /* rt 31 is XZR here */
+    int el_idx = (e->flags & HV_BLOCK_PAN) ? 2 : 1;
+    uint32_t tlb = put_tlb_slot(e, T, A, el_idx);
+    put(e, LDR_X(U, T, tlb + 0)); /* read tag */
+    put(e, SUB_X(U, A, U));
+    put(e, UBFM_X(U, U, HV_TLB_PAGE_BITS, 63));
+    put(e, CBNZ_X(U));
+    put_ool(e, (Ool){.kind = OOL_SYS, .pc = pc, .insn = insn, .nrestore = 3, .restore = {A, T, U}});
+    uint32_t o1 = e->nool - 1;
+    put(e, LDR_X(U, T, tlb + 24));
+    put(e, ADD_LSL(A, A, U, 0));                                   /* host address */
+    put_lit(e, U, (uint64_t)(uintptr_t)ram->host);
+    put(e, SUB_X(A, A, U));
+    put(e, UBFM_X(A, A, HV_TLB_PAGE_BITS, 63));                    /* page index in the main RAM */
+    put(e, UBFM_X(U, A, ram->pages_log2, 63));
+    put(e, CBNZ_X(U));                                             /* not in it */
+    put_ool(e, (Ool){.kind = OOL_SYS, .pc = pc, .insn = insn, .nrestore = 3, .restore = {A, T, U}});
+    uint32_t o2 = e->nool - 1;
+    put_lit(e, U, (uint64_t)(uintptr_t)ram->code_pages);
+    put(e, 0x38606800u | (uint32_t)A << 16 | (uint32_t)U << 5 | (uint32_t)U); /* ldrb wU, [xU, xA] */
+    put(e, CBNZ_X(U) & ~(1u << 31));                               /* cbnz wU: code there */
+    put_ool(e, (Ool){.kind = OOL_SYS, .pc = pc, .insn = insn, .nrestore = 3, .restore = {A, T, U}});
+    uint32_t o3 = e->nool - 1;
+    unspill(e, s, 3);
+    e->ool[o1].join = e->ool[o2].join = e->ool[o3].join = e->n;
+}
+
+static void translate_dc_zva(Emit *e, uint32_t insn, uint64_t pc) {
+    int rt = insn & 0x1f;
+    uint32_t used = 1u << rt;
+    uint8_t s[3];
+    for (int i = 0; i < 3; i++) s[i] = pick(&used);
+    int A = s[0], T = s[1], U = s[2];
+    spill(e, s, 3);
+    if (is_stolen(rt)) put(e, LDR_X(A, 28, slot_of(rt)));
+    else put(e, MOV_X(A, rt)); /* rt 31 is XZR here */
+    put(e, 0x92400000u | 58u << 16 | 57u << 10 | A << 5 | A); /* and A, A, #~63 */
+    int el_idx = !(e->flags & HV_BLOCK_EL1) ? 0 : (e->flags & HV_BLOCK_PAN) ? 2 : 1;
+    uint32_t tlb = put_tlb_slot(e, T, A, el_idx);
+    put(e, LDR_X(U, T, tlb + 8)); /* write tag */
+    put(e, SUB_X(U, A, U));
+    put(e, UBFM_X(U, U, HV_TLB_PAGE_BITS, 63));
+    put(e, CBNZ_X(U));
+    put_ool(e, (Ool){.kind = OOL_SYS, .pc = pc, .insn = insn, .nrestore = 3, .restore = {A, T, U}});
+    uint32_t slow = e->nool - 1;
+    put(e, LDR_X(U, T, tlb + 24));
+    put(e, ADD_LSL(A, A, U, 0));
+    put(e, 0xd50b7420u | A); /* dc zva, A */
+    unspill(e, s, 3);
+    e->ool[slow].join = e->n;
+}
+
+/* System registers that are plain storage, or host registers that already
+   hold the guest's value: MRS/MSR to these need no helper and do not end the
+   block. Anything with side effects (DAIF, SPSel writes, the MMU, timers, GIC)
+   still goes through the helper. Returns 1 if handled. */
+#define SR(op0, op1, crn, crm, op2) ((op0) << 14 | (op1) << 11 | (crn) << 7 | (crm) << 3 | (op2))
+
+static void put_load_field(Emit *e, int rt, uint32_t off) {
+    if (rt == 31) return;
+    if (!is_stolen(rt)) {
+        put(e, LDR_X(rt, 28, off));
+        return;
+    }
+    uint8_t s = 15; /* free scratch: the spill below is empty */
+    spill(e, &s, 1);
+    put(e, LDR_X(s, 28, off));
+    put(e, STR_X(s, 28, slot_of(rt)));
+    unspill(e, &s, 1);
+}
+
+static void put_store_field(Emit *e, int rt, uint32_t off) {
+    if (!is_stolen(rt)) {
+        put(e, STR_X(rt, 28, off)); /* 31 stores XZR */
+        return;
+    }
+    uint8_t s = 15; /* free scratch: the spill below is empty */
+    spill(e, &s, 1);
+    put(e, LDR_X(s, 28, slot_of(rt)));
+    put(e, STR_X(s, 28, off));
+    unspill(e, &s, 1);
+}
+
+/* MRS/MSR of NZCV, FPCR, FPSR: the host registers are the guest's. */
+static void put_native_sysreg(Emit *e, uint32_t insn, int read) {
+    int rt = insn & 0x1f;
+    if (!is_stolen(rt)) {
+        put(e, insn);
+        return;
+    }
+    uint8_t s = 15; /* free scratch: the spill below is empty */
+    spill(e, &s, 1);
+    if (read) {
+        put(e, (insn & ~0x1fu) | s);
+        put(e, STR_X(s, 28, slot_of(rt)));
+    } else {
+        put(e, LDR_X(s, 28, slot_of(rt)));
+        put(e, (insn & ~0x1fu) | s);
+    }
+    unspill(e, &s, 1);
+}
+
+/* MRS/MSR of a PSTATE bit kept in cpu->pstate_extra at the same position as in the register. */
+static void put_pstate_bit(Emit *e, int rt, int bit, int read) {
+    uint32_t used = 1u << rt;
+    uint8_t s[3];
+    for (int i = 0; i < 3; i++) s[i] = pick(&used);
+    int t = s[0], u = s[1], v = s[2];
+    spill(e, s, 3);
+    put(e, LDR_X(t, 28, HV_CPU_PSTATE_EXTRA));
+    if (read) {
+        put(e, UBFM_X(t, t, bit, bit));                       /* ubfx t, t, #bit, #1 */
+        put(e, UBFM_X(t, t, (64 - bit) & 63, 63 - bit));      /* lsl t, t, #bit */
+        if (rt != 31) put(e, is_stolen(rt) ? STR_X(t, 28, slot_of(rt)) : MOV_X(rt, t));
+    } else {
+        int r = rt;
+        if (rt == 31) {
+            put(e, 0xd2800000u | v);                          /* movz v, #0 */
+            r = v;
+        } else if (is_stolen(rt)) {
+            put(e, LDR_X(v, 28, slot_of(rt)));
+            r = v;
+        }
+        put(e, 0xca000000u | (uint32_t)r << 16 | (uint32_t)t << 5 | (uint32_t)u); /* eor u, t, r */
+        put(e, UBFM_X(u, u, bit, bit));                       /* the bit that differs */
+        put(e, 0xca000000u | (uint32_t)u << 16 | (uint32_t)bit << 10 | (uint32_t)t << 5 | (uint32_t)t); /* eor t, t, u, lsl #bit */
+        put(e, STR_X(t, 28, HV_CPU_PSTATE_EXTRA));
+    }
+    unspill(e, s, 3);
+}
+
+/* The commonest PSTATE writes, at EL1, without the helper. DAIF: a masked
+   interrupt let through is taken before the next instruction (leave if either
+   line is up; the dispatcher sorts out masking). SPSel: the guest SP is the
+   host SP, so the switch swaps it with the banked one, then continues through
+   the new flags' branch cache. PAN: the bit, then likewise. Returns 0 if not
+   handled, 1 if the block carries on, 2 if it ended. */
+static int translate_msr_inline(Emit *e, uint32_t insn, uint64_t pc) {
+    if (!(e->flags & HV_BLOCK_EL1) || e->no_ijc) return 0;
+    int imm_form = ((insn >> 19) & 3) == 0;
+    uint32_t field = ((insn >> 16) & 7) << 3 | ((insn >> 5) & 7), imm = (insn >> 8) & 0xf;
+    uint32_t reg = (insn >> 5) & 0xffff;
+    int daif_reg = !imm_form && reg == (3u << 14 | 3u << 11 | 4u << 7 | 2u << 3 | 1u); /* MSR DAIF, Xt */
+    if ((imm_form && (field == 036 || field == 037)) || daif_reg) {
+        if (daif_reg) {
+            int rt = insn & 0x1f;
+            if (rt == 31) put(e, 0xd2800006u);                                        /* movz x6, #0 */
+            else if (is_stolen(rt)) put(e, LDR_X(6, 28, slot_of(rt)));
+            else put(e, MOV_X(6, rt));
+            put(e, 0x92400000u | 58u << 16 | 3u << 10 | 6 << 5 | 6);                 /* and x6, x6, #0x3c0 */
+        } else {
+            put(e, LDR_X(6, 28, HV_CPU_DAIF));
+            put(e, 0xd2800007u | (imm << 6) << 5);                                   /* movz x7, #imm << 6 */
+            put(e, (field == 036 ? 0xaa000000u : 0x8a200000u) | 7 << 16 | 6 << 5 | 6); /* orr / bic x6, x6, x7 */
+        }
+        put(e, STR_X(6, 28, HV_CPU_DAIF));
+        /*
+         * 事件门 第五版（2026-11-21）：DAIFClr（或可能解屏蔽的 MSR DAIF）之后，
+         * 若此刻“已解屏蔽”且 sticky 字非零，立即 OOL 出口回 dispatcher ——
+         * 这是资格迁移的最后一个检查点（内联 unmask 是唯一绕过 dispatcher 的 unmask）。
+         * 只读两样：同线程 tracked daif（x6，刚写入）+ 单字 wake word（HvCpu.exit_req）。
+         * 不读 copy、不读 env cpsr。门控出口 ≈ 事件率，不是无条件 exit。
+         */
+        static int gate_on = -1;
+        if (gate_on < 0) gate_on = getenv("HENGE_NO_DAIF_GATE") == NULL;  /* 默认开，可关 */
+        if (gate_on && (field != 036 || daif_reg)) {
+            /* 只用 x6/x7（本块已用的 scratch），不碰 x8/x9：它们可能装着 guest 寄存器。
+               word = 线电平 copy（lines_ptr，O1/O2 只在线变迁时写），不是 exit_req：
+               门条件 = word != 0 && 本次写入后 I 为 0。 */
+            put(e, LDR_X(7, 28, HV_CPU_LINES_PTR));
+            put(e, LDR_X(7, 7, 0));
+            put(e, 0x12071cc6u);                                              /* and w6, w6, #0x80 (I) */
+            put(e, 0x52071cc6u);                                              /* eor w6, w6, #0x80 (unmasked->0x80) */
+            put(e, 0x0a0600e7u);                                              /* and w7, w7, w6 */
+            put(e, 0x35000007u);                                              /* cbnz w7, exit */
+            put_ool(e, (Ool){.kind = OOL_EXIT, .pc = pc + 4});
+        }
+        /*
+         * STRUCTURAL BOUNDARY (2026-11-19 第四版, 2026-11-20 修法):
+         *
+         * 这里原本有一个基于 copy（HvPerCpu.irq_line）的 exit 启发式。它已删除：
+         *   - 生产侧不再维护 copy（push site 0/2 退役），copy 会长期陈旧；
+         *   - 由它驱动的 exit 只是把块边界打成噪声，真正的投递判定在宿主侧
+         *     （hv_check_interrupts 读权威电平）；
+         *   - 有界汇合改由链节 thunk 的 sticky 字（CPU_EXIT_REQ）承担 —— O1/O2 在
+         *     每次线变化时置位，引擎回到宿主检查一次，见 henge-engine.c
+         *     hv_engine_note_irq()。
+         * 边界因此改写为：JIT 不做任何中断状态判断，只执行；投递与唤醒全在宿主。
+         */
+        return 1;
+    }
+    if (!imm_form && reg == (3u << 14 | 0u << 11 | 4u << 7 | 2u << 3 | 0u)) { /* MSR SPSel, Xt: bit 0 picks, at run time */
+        int rt = insn & 0x1f;
+        uint32_t flags = e->flags, to_set = 0;
+        if (rt != 31) {
+            if (is_stolen(rt)) put(e, LDR_X(7, 28, slot_of(rt)));
+            else put(e, MOV_X(7, rt));
+            to_set = e->n;
+            put(e, 0x37000007u);                                                     /* tbnz x7, #0, set (patched) */
+        }
+        for (uint32_t on = 0; on < (rt == 31 ? 1u : 2u); on++) {
+            if (on) patch_branch(&e->w[to_set], (int64_t)e->n - to_set);
+            if (!!(flags & HV_BLOCK_SPX) != on) {
+                put(e, ADD_SP_TO(6));
+                put(e, STR_X(6, 28, on ? HV_CPU_SP_EL0 : HV_CPU_SP_EL1));
+                put(e, LDR_X(6, 28, on ? HV_CPU_SP_EL1 : HV_CPU_SP_EL0));
+                put(e, 0x910000dfu);                                                 /* mov sp, x6 */
+                put(e, on ? 0x52800026u : 0x52800006u);
+                put(e, 0xb9000000u | (HV_CPU_SPSEL / 4) << 10 | 28 << 5 | 6);
+            }
+            put_lit(e, 15, pc + 4);
+            e->flags = on ? flags | HV_BLOCK_SPX : flags & ~HV_BLOCK_SPX;
+            put_ijc_jump(e, 1);
+            e->flags = flags;
+        }
+        return 2;
+    }
+    if (imm_form && (field == 005 || field == 004)) { /* SPSel, PAN */
+        uint32_t flags = e->flags, bit = field == 005 ? HV_BLOCK_SPX : HV_BLOCK_PAN, on = imm & 1;
+        if (!!(flags & bit) == on) return 1; /* already so: nothing changes */
+        if (field == 005) {
+            put(e, ADD_SP_TO(6));                                                    /* mov x6, sp */
+            put(e, STR_X(6, 28, on ? HV_CPU_SP_EL0 : HV_CPU_SP_EL1));                /* the one in use goes to its bank */
+            put(e, LDR_X(6, 28, on ? HV_CPU_SP_EL1 : HV_CPU_SP_EL0));
+            put(e, 0x910000dfu);                                                     /* mov sp, x6 */
+            put(e, on ? 0x52800026u : 0x52800006u);                                  /* movz w6, #on */
+            put(e, 0xb9000000u | (HV_CPU_SPSEL / 4) << 10 | 28 << 5 | 6);            /* str w6, [x28, #spsel] */
+        } else {
+            put(e, LDR_X(6, 28, HV_CPU_PSTATE_EXTRA));
+            put(e, 0xd2a00807u);                                                     /* movz x7, #0x40, lsl #16: PAN */
+            put(e, (on ? 0xaa000000u : 0x8a200000u) | 7 << 16 | 6 << 5 | 6);
+            put(e, STR_X(6, 28, HV_CPU_PSTATE_EXTRA));
+        }
+        put_lit(e, 15, pc + 4);
+        e->flags = on ? flags | bit : flags & ~bit;
+        put_ijc_jump(e, 1);
+        e->flags = flags;
+        return 2;
+    }
+    return 0;
+}
+
+/* The guest's counter is the host's mach_absolute_time (CNTVOFF is 0): the
+   counter register the commpage names plus the commpage's offset, read the way
+   libsystem does. EL0 reads check CNTKCTL_EL1's enables and trap through the
+   helper when they are off. */
+#define COMMPAGE_TIMEBASE_OFFSET 0xfffffc088ull
+#define COMMPAGE_TIMEBASE_TYPE   0xfffffc090ull
+static int translate_counter(Emit *e, uint32_t insn, uint64_t pc, int physical) {
+    static int type = -1;
+    if (type < 0) type = *(volatile uint8_t *)(uintptr_t)COMMPAGE_TIMEBASE_TYPE;
+    if (type == 0) return 0; /* the kernel's own path: leave it to the helper */
+    int rt = insn & 0x1f;
+    if (rt == 31) return 1;
+    if (!(e->flags & HV_BLOCK_EL1)) {
+        put(e, 0xb9400000u | (HV_CPU_EL0_CNT / 4) << 10 | 28 << 5 | 6); /* ldr w6, [x28, #el0_cnt] */
+        put(e, 0x36000000u | (physical ? 0u : 1u) << 19 | 6);         /* tbz w6, #enable, helper (patched) */
+        put_ool(e, (Ool){.kind = OOL_MRS, .pc = pc, .insn = insn});
+    }
+    uint32_t slow = e->nool - 1;
+    int el0 = !(e->flags & HV_BLOCK_EL1);
+    int r = is_stolen(rt) ? 15 : rt;
+    if (type == 1) put(e, 0xd5033fdfu);                                  /* isb; then CNTVCT_EL0 */
+    put(e, (type == 1 ? 0xd53be040u : type == 2 ? 0xd53be0c0u : 0xd53cfac0u) | (uint32_t)r);
+    put_lit(e, 6, COMMPAGE_TIMEBASE_OFFSET);
+    put(e, LDR_X(6, 6, 0));
+    put(e, ADD_LSL(r, r, 6, 0));
+    if (r != rt) put(e, STR_X(r, 28, slot_of(rt)));
+    if (el0) e->ool[slow].join = e->n;
+    return 1;
+}
+
+static int translate_sysreg_inline(Emit *e, uint32_t insn, uint64_t pc) {
+    if (((insn >> 19) & 3) == 0) return 0; /* MSR (immediate) */
+    int read = (insn >> 21) & 1, rt = insn & 0x1f;
+    uint32_t reg = (insn >> 5) & 0xffff;
+    int el1 = (e->flags & HV_BLOCK_EL1) != 0, spx = (e->flags & HV_BLOCK_SPX) != 0;
+    int fp_ok = !(e->flags & HV_BLOCK_FPOFF);
+    switch (reg) {
+    case SR(3, 3, 14, 0, 2): /* CNTVCT_EL0 */
+    case SR(3, 3, 14, 0, 6): /* CNTVCTSS_EL0 */
+    case SR(3, 3, 14, 0, 1): /* CNTPCT_EL0 */
+    case SR(3, 3, 14, 0, 5): /* CNTPCTSS_EL0 */
+        if (!read) return 0;
+        return translate_counter(e, insn, pc, reg == SR(3, 3, 14, 0, 1) || reg == SR(3, 3, 14, 0, 5));
+    case SR(3, 3, 9, 13, 0): { /* PMCCNTR_EL0: read on every Windows 11 KiSwapContext */
+        if (!read) return 0;
+        if (rt == 31) return 1;
+        int r = is_stolen(rt) ? 15 : rt;
+        put(e, 0xd53be040u | (uint32_t)r);                        /* mrs xr, cntvct_el0 */
+        put(e, 0xd379e000u | (uint32_t)r << 5 | (uint32_t)r);     /* lsl xr, xr, #7 (~3.072 GHz) */
+        if (r != rt) put(e, STR_X(r, 28, slot_of(rt)));
+        return 1;
+    }
+    case SR(3, 3, 4, 2, 0): /* NZCV */
+        put_native_sysreg(e, insn, read);
+        return 1;
+    case SR(3, 3, 4, 4, 0): /* FPCR */
+    case SR(3, 3, 4, 4, 1): /* FPSR */
+        if (!fp_ok) return 0; /* traps: leave it to the helper */
+        put_native_sysreg(e, insn, read);
+        return 1;
+    case SR(3, 3, 13, 0, 2): /* TPIDR_EL0 */
+        if (read) put_load_field(e, rt, HV_CPU_TPIDR_EL0);
+        else put_store_field(e, rt, HV_CPU_TPIDR_EL0);
+        return 1;
+    case SR(3, 3, 13, 0, 3): /* TPIDRRO_EL0: EL0 may only read it */
+        if (read) put_load_field(e, rt, HV_CPU_TPIDRRO_EL0);
+        else if (el1) put_store_field(e, rt, HV_CPU_TPIDRRO_EL0);
+        else return 0;
+        return 1;
+    case SR(3, 0, 13, 0, 4): /* TPIDR_EL1 */
+    case SR(3, 0, 4, 0, 1):  /* ELR_EL1 */
+    case SR(3, 0, 4, 0, 0): { /* SPSR_EL1 */
+        if (!el1) return 0;
+        uint32_t off = reg == SR(3, 0, 13, 0, 4) ? HV_CPU_TPIDR_EL1 : reg == SR(3, 0, 4, 0, 1) ? HV_CPU_ELR_EL1 : HV_CPU_SPSR_EL1;
+        if (read) put_load_field(e, rt, off);
+        else put_store_field(e, rt, off);
+        return 1;
+    }
+    case SR(3, 0, 1, 0, 0): /* SCTLR_EL1, ESR_EL1, FAR_EL1: reads (writes have side effects or are rare) */
+    case SR(3, 0, 5, 2, 0):
+    case SR(3, 0, 6, 0, 0): {
+        if (!read || !el1) return 0;
+        uint32_t off = reg == SR(3, 0, 1, 0, 0) ? HV_CPU_SCTLR_EL1 : reg == SR(3, 0, 5, 2, 0) ? HV_CPU_ESR_EL1 : HV_CPU_FAR_EL1;
+        put_load_field(e, rt, off);
+        return 1;
+    }
+    case SR(3, 0, 2, 0, 0): /* TTBR0_EL1, TTBR1_EL1, VBAR_EL1: reads */
+    case SR(3, 0, 2, 0, 1):
+    case SR(3, 0, 12, 0, 0): {
+        if (!el1) return 0;
+        if (!read) {
+            if (reg != SR(3, 0, 12, 0, 0)) return 0;
+            /* MSR VBAR_EL1, Xt: mask ~0x7ff */
+            if (rt == 31) put(e, 0xd2800006u);
+            else if (is_stolen(rt)) put(e, LDR_X(6, 28, slot_of(rt)));
+            else put(e, MOV_X(6, rt));
+            put(e, 0x92400000u | 53u << 16 | 52u << 10 | 6u << 5 | 6u); /* and x6, x6, #~0x7ff */
+            put(e, STR_X(6, 28, HV_CPU_VBAR_EL1));
+            return 1;
+        }
+        uint32_t off = reg == SR(3, 0, 2, 0, 0) ? HV_CPU_TTBR0_EL1 : reg == SR(3, 0, 2, 0, 1) ? HV_CPU_TTBR1_EL1 : HV_CPU_VBAR_EL1;
+        put_load_field(e, rt, off);
+        return 1;
+    }
+    case SR(2, 0, 0, 2, 2):  /* MDSCR_EL1: read/written 90K+/s in Windows KiSwapContext */
+    case SR(3, 0, 13, 0, 1): { /* CONTEXTIDR_EL1 */
+        if (!el1) return 0;
+        uint32_t off = reg == SR(2, 0, 0, 2, 2) ? HV_CPU_MDSCR_EL1 : HV_CPU_CONTEXTIDR_EL1;
+        if (read) put_load_field(e, rt, off);
+        else put_store_field(e, rt, off);
+        return 1;
+    }
+    case SR(3, 3, 0, 0, 7): /* DCZID_EL0: 64-byte DC ZVA */
+        if (!read) return 0;
+        put_const_to(e, rt, 4);
+        return 1;
+    case SR(3, 0, 4, 1, 0): /* SP_EL0: only while it is banked (SPSel = 1) */
+        if (!el1 || !spx) return 0;
+        if (read) put_load_field(e, rt, HV_CPU_SP_EL0);
+        else put_store_field(e, rt, HV_CPU_SP_EL0);
+        return 1;
+    case SR(3, 3, 4, 2, 1): /* DAIF: reads only; writes can unmask interrupts */
+        if (!read || !el1) return 0;
+        put_load_field(e, rt, HV_CPU_DAIF);
+        return 1;
+    case SR(3, 0, 4, 2, 0): /* SPSel */
+        if (!read || !el1) return 0;
+        put_const_to(e, rt, (uint64_t)spx);
+        return 1;
+    case SR(3, 0, 4, 2, 2): /* CurrentEL */
+        if (!read || !el1) return 0;
+        put_const_to(e, rt, 4);
+        return 1;
+    case SR(3, 3, 4, 2, 5): /* DIT: one bit of PSTATE, nothing depends on it here */
+    case SR(3, 3, 4, 2, 6): /* SSBS */
+        put_pstate_bit(e, rt, reg == SR(3, 3, 4, 2, 5) ? 24 : 12, read);
+        return 1;
+    default:
+        return 0;
+    }
+}
+
+static int is_fp_insn(uint32_t insn) {
+    uint32_t op0 = (insn >> 25) & 0xf;
+    if ((op0 & 0x7) == 0x7) return 1;                        /* SIMD and FP data processing */
+    if ((op0 & 0x5) == 0x4 && ((insn >> 26) & 1)) return 1;  /* SIMD and FP loads and stores */
+    return 0;
+}
+
+/* Returns 1 if the instruction ends the block. */
+static int translate_one(Emit *e, uint32_t insn, uint64_t pc) {
+    HvInsnKind kind = hv_classify(insn);
+    if ((e->flags & HV_BLOCK_FPOFF) && kind != HV_INSN_UNDEFINED && is_fp_insn(insn)) {
+        put_helper(e, pc, insn, HV_OP_FPTRAP);
+        return 1;
+    }
+    switch (kind) {
+    case HV_INSN_COPY:
+        translate_copy(e, insn);
+        return 0;
+    case HV_INSN_PCREL:
+        translate_pcrel(e, insn, pc);
+        return 0;
+    case HV_INSN_BRANCH:
+        return translate_branch(e, insn, pc);
+    case HV_INSN_BRANCH_REG:
+        translate_branch_reg(e, insn, pc);
+        return 1;
+    case HV_INSN_PAC:
+        translate_pac(e, insn);
+        return 0;
+    case HV_INSN_PREFETCH:
+        return 0;
+    case HV_INSN_LOAD_LITERAL:
+    case HV_INSN_MEMORY:
+        translate_mem(e, insn, pc);
+        return 0;
+    case HV_INSN_SYSREG:
+        if (translate_sysreg_inline(e, insn, pc)) return 0;
+        if (((insn >> 21) & 1) && ((insn >> 19) & 3)) { /* MRS */
+            put_helper(e, pc, insn, HV_OP_MRS);
+            return 0;
+        }
+        {
+            int r = translate_msr_inline(e, insn, pc);
+            if (r) return r - 1; /* 1: carries on, 2: the block ended */
+        }
+        put_helper(e, pc, insn, HV_OP_MSR); /* state blocks depend on may change */
+        if (((insn >> 19) & 3) == 0 && (e->flags & HV_BLOCK_EL1)) {
+            /* MSR SPSel/PAN, #imm at EL1: the flags of the next block are known, so
+               go to it through that flags' indirect-branch cache instead of the dispatcher. */
+            uint32_t op1 = (insn >> 16) & 7, op2 = (insn >> 5) & 7, imm = (insn >> 8) & 1;
+            uint32_t bit = op1 == 0 && op2 == 5 ? HV_BLOCK_SPX : op1 == 0 && op2 == 4 ? HV_BLOCK_PAN : 0;
+            if (bit) {
+                uint32_t flags = e->flags;
+                put_lit(e, 15, pc + 4);
+                e->flags = imm ? flags | bit : flags & ~bit;
+                put_ijc_jump(e, 1);
+                e->flags = flags;
+                return 1;
+            }
+        }
+        {
+            /* Writes blocks are translated against (the flags: FP enable, PAN,
+               SPSel) or that change translation leave for the dispatcher. The
+               rest carry on: DAIF writes inside the block (the helper asks to
+               leave if an interrupt is now due), others through a chainable exit,
+               which still notices exit_req. */
+            uint32_t reg = (insn >> 5) & 0xffff;
+#define SR(op0, op1, crn, crm, op2) ((op0) << 14 | (op1) << 11 | (crn) << 7 | (crm) << 3 | (op2))
+            int imm_form = ((insn >> 19) & 3) == 0;
+            uint32_t field = ((insn >> 16) & 7) << 3 | ((insn >> 5) & 7);
+            if ((imm_form && (field == 036 || field == 037)) || (!imm_form && reg == SR(3, 3, 4, 2, 1))) {
+                /* An interrupt this let through is taken before the next instruction. */
+                put(e, 0xb9400000u | (HV_CPU_EXIT_REQ / 4) << 10 | 28 << 5 | 6); /* ldr w6, [x28, #exit_req] */
+                put(e, 0x35000000u | 6);                                         /* cbnz w6, out of line */
+                put_ool(e, (Ool){.kind = OOL_EXIT, .pc = pc + 4});
+                return 0;
+            }
+            if (!imm_form && reg == SR(3, 0, 4, 2, 0) && (e->flags & HV_BLOCK_EL1) && !e->no_ijc) {
+                /* MSR SPSel, Xt at EL1: bit 0 of Xt picks the next block's flags, so pick the
+                   cache at run time (the immediate form knows it now). */
+                int rt = insn & 0x1f, r = rt;
+                if (rt != 31 && is_stolen(rt)) {
+                    put(e, LDR_X(15, 28, slot_of(rt)));
+                    r = 15;
+                }
+                uint32_t flags = e->flags, to_set = 0;
+                if (rt != 31) {
+                    to_set = e->n;
+                    put(e, 0x37000000u | (uint32_t)r); /* tbnz xr, #0, set (patched below) */
+                }
+                for (int set = 0; set < (rt == 31 ? 1 : 2); set++) {
+                    if (set) patch_branch(&e->w[to_set], (int64_t)e->n - to_set);
+                    put_lit(e, 15, pc + 4);
+                    e->flags = set ? flags | HV_BLOCK_SPX : flags & ~HV_BLOCK_SPX;
+                    put_ijc_jump(e, 1);
+                    e->flags = flags;
+                }
+                return 1;
+            }
+            /* TTBR0 (a process switch) and SCTLR carry on too: the indirect-branch
+               cache reads the new salt at run time, and a change that matters to
+               chained exits sets exit_req. */
+            if (!imm_form && reg != SR(3, 0, 1, 0, 2) && reg != SR(3, 0, 4, 2, 3) && reg != SR(3, 0, 4, 2, 0) &&
+                reg != SR(3, 0, 2, 0, 1) && reg != SR(3, 0, 2, 0, 2) && !e->no_ijc) {
+                put_branch_exit(e, pc + 4, 0);
+                return 1;
+            }
+#undef SR
+        }
+        put_exit(e, pc + 4);
+        return 1;
+    case HV_INSN_SYS: {
+        uint32_t crn = (insn >> 12) & 0xf, crm = (insn >> 8) & 0xf, op1 = (insn >> 16) & 7, op2 = (insn >> 5) & 7;
+        /* Data-cache maintenance by VA or set/way: memory here is coherent, so
+           there is nothing to do. DC ZVA writes memory and AT translates, so
+           those still go to the helper. */
+        int dc_zva = op1 == 3 && crm == 4 && op2 == 1;
+        int at = crm == 8 || crm == 9;
+        if (crn == 7 && crm != 1 && crm != 5 && !dc_zva && !at) return 0;
+        if (dc_zva && !e->slow_mem && host_zva_is_64()) {
+            translate_dc_zva(e, insn, pc);
+            return 0;
+        }
+        if (crn == 7 && op1 == 3 && crm == 5 && op2 == 1 && !hv_ic_ivau_drops()) return 0; /* IC IVAU: nothing to do, see there */
+        if (crn == 7 && op1 == 3 && crm == 5 && op2 == 1 && (e->flags & HV_BLOCK_EL1) && !e->slow_mem && e->m->main_ram) {
+            translate_ic_ivau(e, insn, pc);
+            return 0;
+        }
+        put_helper(e, pc, insn, HV_OP_SYS);
+        /* DC and AT continue, and so does IC IVAU: invalidating code sets exit_req,
+           so the block leaves at its next exit if it mattered. So do TLBIs: the
+           helper leaves itself when one may cover the page this block runs from
+           (see hv_helper). IC IALLU leaves. */
+        if (crn == 7 && ((crm != 1 && crm != 5) || (op1 == 3 && crm == 5 && op2 == 1))) return 0;
+        static int tlbi_leaves = -1; /* HV_TLBI_LEAVES: every TLBI ends its block, as before */
+        if (tlbi_leaves < 0) tlbi_leaves = getenv("HV_TLBI_LEAVES") != NULL;
+        if (crn == 8 && !e->no_ijc && !tlbi_leaves) return 0;
+        put_exit(e, pc + 4);
+        return 1;
+    }
+    case HV_INSN_BARRIER: {
+        uint32_t op2 = (insn >> 5) & 7;
+        if (op2 == 2) {
+            put_helper(e, pc, insn, HV_OP_CLREX);
+            return 0;
+        }
+        if (op2 == 6) { /* ISB: later instructions must see earlier system register writes */
+            /* Writes that change how blocks are translated already left. What is
+               left to synchronise is code invalidation, which sets exit_req: the
+               chainable exit checks it. */
+            if (e->no_ijc) put_exit(e, pc + 4);
+            else put_branch_exit(e, pc + 4, 0);
+            return 1;
+        }
+        put(e, insn); /* DSB, DMB, SB */
+        return 0;
+    }
+    case HV_INSN_WAIT:
+        if (((insn >> 5) & 7) == 3 || ((insn >> 12) & 0xf) == 1) put_helper(e, pc, insn, HV_OP_WFI); /* WFI, WFIT, WFET */
+        else { /* WFE: waiting for another CPU; the helper waits for the monitored word, then the block goes on */
+            put_helper(e, pc, insn, HV_OP_WFE);
+            if (e->no_ijc) put_exit(e, pc + 4);
+            else put_branch_exit(e, pc + 4, 0); /* checks exit_req: the wait may have ended for a request */
+            return 1;
+        }
+        put_exit(e, pc + 4);
+        return 1;
+    case HV_INSN_EXCEPTION:
+        put_helper(e, pc, insn, HV_OP_EXCEPTION);
+        if ((insn & 0xffe0001f) == 0xd4000002 && (e->flags & HV_BLOCK_EL1)) return 0; /* HVC returns like a call */
+        put_exit(e, pc + 4);
+        return 1;
+    case HV_INSN_ERET:
+        put_helper(e, pc, insn, HV_OP_ERET);
+        put_exit(e, pc + 4);
+        return 1;
+    case HV_INSN_UNDEFINED:
+        put_helper(e, pc, insn, HV_OP_UNDEF);
+        put_exit(e, pc + 4);
+        return 1;
+    }
+    return 1;
+}
+
+static void patch_branch(uint32_t *w, int64_t off) {
+    uint32_t op = *w;
+    if ((op & 0x7c000000) == B_OP) *w = (op & 0xfc000000) | (off & 0x3ffffff);
+    else if ((op & 0x7e000000) == 0x36000000) *w = (op & ~(0x3fffu << 5)) | (uint32_t)(off & 0x3fff) << 5;
+    else *w = (op & ~(0x7ffffu << 5)) | (uint32_t)(off & 0x7ffff) << 5; /* B.cond, CBZ, LDR literal */
+}
+
+/* The hot-part branch at `at` to the next cold word. TBZ and TBNZ reach only 32 KB, so they
+   go through one word at the end of the hot part. */
+static uint32_t link_site(Emit *e, uint32_t at) {
+    if (!e->flat && (e->hot[at] & 0x7e000000) == 0x36000000) {
+        uint32_t v = e->other_n++;
+        if (v < MAX_WORDS) e->hot[v] = B_OP;
+        patch_branch(&e->hot[at], (int64_t)v - at);
+        at = v;
+    }
+    link_here(e, at, 0);
+    return at;
+}
+
+/* Written in the cold part; everything it branches back to is in the hot one. */
+static void emit_ool(Emit *e) {
+    for (uint32_t i = 0; i < e->nool; i++) {
+        Ool *o = &e->ool[i];
+        int refill = o->kind == OOL_SLOW && o->rflags;
+        uint32_t retry = o->retry;
+        if (refill && !e->flat) { /* the refill's way back counts words, so a word near it to go on from */
+            retry = e->n;
+            put(e, B_OP);
+            plink(e, retry, 1, o->retry, 0);
+        }
+        uint32_t site_at = link_site(e, o->at);
+        if (o->recheck) { /* the fast check refuses a page's last 15 bytes: check exactly, and go back if it fits */
+            put(e, LDR_X(o->u, o->t, o->tag_off));
+            put(e, SUB_X(o->u, o->addr, o->u));
+            put_add_imm(e, o->u, o->u, (int64_t)o->bytes - 1 - HV_TLB_ADJ);
+            put(e, UBFM_X(o->u, o->u, HV_TLB_PAGE_BITS, 63));
+            put(e, CBNZ_X(o->u) | 2u << 5); /* cbnz u, +2: a real miss */
+            put(e, B_OP);
+            plink(e, e->n - 1, 1, o->at + 1, 0);
+        }
+        if (o->kind == OOL_GROUP) {
+            unspill(e, o->restore, o->nrestore);
+            put(e, B_OP);
+            plink(e, e->n - 1, 1, e->grp[o->pc].copy_at, 0);
+            continue;
+        }
+        if (refill) {
+            /* A TLB miss: hv_helper_thunk tries the light refill first (x7 = the
+               address; x7 is never a guest register) and, if it filled the TLB,
+               comes back to run the access again; else it is the usual helper. */
+            put(e, MOV_X(7, o->addr));
+            unspill(e, o->restore, o->nrestore);
+            put_helper_refill(e, o->pc, o->insn, o->rflags, retry);
+            put(e, B_OP);
+            plink(e, e->n - 1, 1, o->join, 0);
+            continue;
+        }
+        unspill(e, o->restore, o->nrestore);
+        if (o->kind == OOL_EXIT) {
+            e->cur_pc = o->site;
+            put_branch_exit(e, o->pc, o->plain); /* branches, and exits for interrupts let through */
+            /* With nothing to do on the way, chaining can take the hot part's own branch there:
+               a taken branch that goes where it means to, like the guest's, in place of two. */
+            if (e->site_direct && !o->nrestore && (e->flat || (e->hot[site_at] & 0x7e000000) != 0x36000000)) {
+                e->site[e->nsite - 1].has_cond = 1;
+                e->site[e->nsite - 1].cond_at = site_at;
+            }
+        } else {
+            put_helper(e, o->pc, o->insn, o->kind == OOL_SYS ? HV_OP_SYS : o->kind == OOL_MRS ? HV_OP_MRS : HV_OP_MEM);
+            put(e, B_OP);
+            plink(e, e->n - 1, 1, o->join, 0);
+        }
+    }
+}
+
+/* Find the groups (see Group) in the instructions a block may hold. Only
+   instructions whose effect on general registers is plain are walked through:
+   ALU and SIMD (writing at most Rd), PC-relative, PAC, prefetches and other
+   loads and stores; anything else ends every group. */
+static int group_op(const HvMemOp *op) {
+    return (op->kind == HV_MEM_SINGLE || op->kind == HV_MEM_PAIR) && !op->align && !op->unpriv &&
+           (op->mode == HV_ADDR_OFFSET || op->mode == HV_ADDR_PRE || op->mode == HV_ADDR_POST) &&
+           (op->rn == 31 || !is_stolen(op->rn)) && op->bytes <= 64;
+}
+
+static void plan_groups(Emit *e, const uint32_t *code, uint32_t max, uint64_t va) {
+    e->ngrp = 0;
+    memset(e->gid, -1, sizeof e->gid);
+    if (e->nogroup || e->slow_mem) return;
+    int cur[32];
+    int64_t delta[32];
+    for (int r = 0; r < 32; r++) cur[r] = -1, delta[r] = 0;
+#define KILL(r) (cur[(r) & 31] = -1)
+    for (uint32_t i = 0; i < max && i < HV_MAX_BLOCK_INSNS; i++) {
+        uint32_t insn = code[i];
+        if (i > 0 && (va + 4ull * i == e->m->stop_pc || va + 4ull * i == e->m->stop_pc2)) break;
+        HvInsnKind kind = hv_classify(insn);
+        if ((e->flags & HV_BLOCK_FPOFF) && kind != HV_INSN_UNDEFINED && is_fp_insn(insn)) break;
+        if (kind == HV_INSN_COPY && (insn & 0xfffff01fu) == 0xd503201fu) continue; /* hints (NOP, BTI): no register */
+        if (kind == HV_INSN_COPY || kind == HV_INSN_PCREL || kind == HV_INSN_LOAD_LITERAL) {
+            KILL(insn);
+            continue;
+        }
+        if (kind == HV_INSN_PAC) {
+            KILL(insn), KILL(30), KILL(17), KILL(16);
+            continue;
+        }
+        if (kind == HV_INSN_PREFETCH) continue;
+        if (kind != HV_INSN_MEMORY) break;
+        HvMemOp op;
+        if (hv_mem_decode(insn, &op) != 0) break;
+        if (group_op(&op)) {
+            int b = op.rn;
+            int64_t off = delta[b] + (op.mode == HV_ADDR_POST ? 0 : op.imm);
+            Group *g = cur[b] >= 0 ? &e->grp[cur[b]] : NULL;
+            if (g) {
+                int64_t lo = off < g->lo ? off : g->lo, hi = off + op.bytes > g->hi ? off + op.bytes : g->hi;
+                if (hi - lo > GROUP_SPAN || i - g->first > GROUP_INSNS) g = NULL;
+                else {
+                    g->lo = (int32_t)lo, g->hi = (int32_t)hi, g->last = (uint16_t)i, g->store |= op.store;
+                    e->gid[i] = (int8_t)cur[b], e->grole[i] = 2, e->goff[i] = (int32_t)off;
+                }
+            }
+            if (!g && e->ngrp < MAX_GROUPS) {
+                cur[b] = (int)e->ngrp;
+                delta[b] = 0;
+                off = op.mode == HV_ADDR_POST ? 0 : op.imm;
+                e->grp[e->ngrp++] = (Group){.lo = (int32_t)off, .hi = (int32_t)(off + op.bytes), .store = op.store,
+                                            .base = (uint8_t)b, .first = (uint16_t)i, .last = (uint16_t)i};
+                e->gid[i] = (int8_t)cur[b], e->grole[i] = 1, e->goff[i] = (int32_t)off;
+            } else if (!g) {
+                cur[b] = -1;
+            }
+            if (op.mode == HV_ADDR_PRE || op.mode == HV_ADDR_POST) delta[b] += op.imm;
+            if (op.load && !op.vec) {
+                KILL(op.rt);
+                if (op.kind == HV_MEM_PAIR) KILL(op.rt2);
+            }
+            continue;
+        }
+        /* Another load or store: what it may write. */
+        if (op.load && !op.vec) KILL(op.rt), KILL(op.rt2);
+        KILL(op.rs);
+        if (op.mode == HV_ADDR_PRE || op.mode == HV_ADDR_POST || op.mode == HV_ADDR_REG) KILL(op.rn);
+        if (op.kind == HV_MEM_VEC_MULTI || op.kind == HV_MEM_VEC_SINGLE) KILL(op.rn);
+    }
+#undef KILL
+    /* A group needs a second access; then a slot of its own while it lives. */
+    uint16_t slot_free[GROUP_SLOTS] = {0};
+    for (uint32_t k = 0; k < e->ngrp; k++) {
+        Group *g = &e->grp[k];
+        g->live = 0;
+        if (g->last == g->first) continue;
+        for (int s = 0; s < GROUP_SLOTS; s++)
+            if (slot_free[s] <= g->first) {
+                g->slot = (uint8_t)s, g->live = 1;
+                slot_free[s] = (uint16_t)(g->last + 1);
+                break;
+            }
+    }
+    /* A failed group runs its instructions plain, through its last access and
+       through every later-starting group that runs on past it (whose first
+       access the plain copy then makes too). */
+    for (uint32_t k = 0; k < e->ngrp; k++) {
+        Group *g = &e->grp[k];
+        if (!g->live) continue;
+        uint16_t end = g->last;
+        for (int again = 1; again;) {
+            again = 0;
+            for (uint32_t j = 0; j < e->ngrp; j++) {
+                Group *h = &e->grp[j];
+                if (h->live && h->first > g->first && h->first <= end && h->last > end) end = h->last, again = 1;
+            }
+        }
+        g->end = end;
+    }
+}
+
+/* After the block: each live group's plain copy. Returns -1 if they do not fit. */
+static int emit_group_copies(Emit *e, const uint32_t *code, uint64_t va, uint32_t ntrans) {
+    e->nogroup = 1;
+    for (uint32_t k = 0; k < e->ngrp; k++) {
+        Group *g = &e->grp[k];
+        if (!g->live || g->first >= ntrans) continue;
+        uint32_t end = g->end < ntrans ? g->end : ntrans - 1;
+        g->copy_at = e->n;
+        for (uint32_t i = g->first; i <= end; i++) {
+            if (e->n + WORDS_PER_INSN_MAX * 2 > MAX_WORDS || e->npool + 8 > MAX_LITS || e->nool + 4 > MAX_OOL) return -1;
+            e->cur_pc = va + 4ull * i;
+            e->cur_i = i;
+            e->u_prev = e->u_live = 0;
+            if (translate_one(e, code[i], va + 4ull * i)) return -1; /* cannot happen: groups hold no block ends */
+        }
+        put(e, B_OP);
+        patch_branch(&e->w[e->n - 1], (int64_t)e->after[end] - (e->n - 1));
+    }
+    return 0;
+}
+
+static int translate_emit(HvMachine *m, HvBlock *b, const uint32_t *code, uint32_t avail, int nogroup);
+
+int hv_translate_emit(HvMachine *m, HvBlock *b, const uint32_t *code, uint32_t avail) {
+    /* HV_GROUPS=1: group accesses (off by default: measured no faster, and the
+       plain copies make the code about 15% bigger, so the JIT region fills sooner). */
+    if (hv_knob[HV_K_GROUPS] && translate_emit(m, b, code, avail, 0) == 0) return 0;
+    return translate_emit(m, b, code, avail, 1);
+}
+
+static int translate_emit(HvMachine *m, HvBlock *b, const uint32_t *code, uint32_t avail, int nogroup) {
+    Emit *e = &E;
+    e->n = e->other_n = e->npool = e->nfix = e->nool = e->nsite = e->nrel = 0;
+    e->w = e->hot;
+    e->in_cold = 0;
+    e->flat = hv_knob[HV_K_TEST2];
+    e->overflow = 0;
+    e->flags = b->flags;
+    e->slow_mem = m->slow_mem;
+    e->page = b->va & ~((1ull << HV_TLB_PAGE_BITS) - 1);
+    e->no_ijc = !m->chain;
+    e->m = m;
+    e->nogroup = nogroup;
+    e->u_live = e->u_prev = 0;
+
+    /* No prologue: hv_enter, chained exits and the indirect-branch cache all
+       enter with guest x0 and x1 live. */
+    uint32_t max = avail < HV_MAX_BLOCK_INSNS ? avail : HV_MAX_BLOCK_INSNS;
+    plan_groups(e, code, max, b->va);
+    uint32_t i = 0;
+    int ended = 0;
+    while (i < max && !ended) {
+        uint64_t pc = b->va + 4ull * i;
+        if (i > 0 && (pc == m->stop_pc || pc == m->stop_pc2)) break; /* so the dispatcher sees stop_pc at a block start */
+        e->cur_pc = pc;
+        e->cur_i = i;
+        e->u_prev = e->u_live, e->u_live = 0;
+        uint32_t n0 = e->n;
+        ended = translate_one(e, code[i], pc);
+        if (m->stats_interval) {
+            HvInsnKind k = hv_classify(code[i]);
+            m->stats.kind_insns[k & 15]++;
+            m->stats.kind_words[k & 15] += e->n - n0;
+        }
+        e->after[i] = e->n;
+        i++;
+        if (e->n + WORDS_PER_INSN_MAX * 2 > MAX_WORDS || e->other_n + WORDS_PER_INSN_MAX * 2 > MAX_WORDS || e->npool + 8 > MAX_LITS || e->nool + 4 > MAX_OOL || e->nrel + 256 > MAX_RELS) break;
+    }
+    if (!ended) put_branch_exit(e, b->va + 4ull * i, 1);
+    b->ninsns = i;
+    uint32_t inline_words = e->n;
+    if (!e->nogroup && e->ngrp && emit_group_copies(e, code, b->va, i) != 0) return -1;
+    cold_on(e);
+    emit_ool(e);
+    if (m->stats_interval) {
+        m->stats.words_inline += inline_words;
+        m->stats.words_ool += e->n - (e->flat ? inline_words : 0);
+        m->stats.words_pool += e->npool * 2;
+    }
+
+    /* Pool after the cold code, 8-byte aligned; both parts start 8-byte aligned. */
+    if (e->n & 1) put(e, 0xd503201f);
+    uint32_t pool_at = e->n;
+    uint32_t ncold = e->n + e->npool * 2;
+    cold_off(e);
+    if (e->n & 1) put(e, 0xd503201f);
+    if (e->flat) e->ncold = 0, e->nhot = ncold;
+    else e->ncold = ncold, e->nhot = e->n;
+    if (e->nhot > MAX_WORDS || e->ncold > MAX_WORDS || e->overflow) return -1;
+
+    for (uint32_t k = 0; k < e->nfix; k++) {
+        LitFix *f = &e->fix[k];
+        plink(e, f->at, f->cold, pool_at + f->idx * 2, !e->flat);
+    }
+
+    e->pool_at = pool_at;
+    return 0;
+}
+
+uint32_t hv_translate_last_words(void) { return E.flat ? E.pool_at : E.nhot; } /* hot words (no pool) of this thread's last block */
+
+/* A B, B.cond, CBZ or CBNZ now going off words away, if it reaches. 1 if it does. */
+int hv_branch_retarget(uint32_t *w, int64_t off) {
+    uint32_t op = *w;
+    if ((op & 0x7c000000) == B_OP) {
+        if (off < -(1 << 25) || off >= (1 << 25)) return 0;
+        *w = (op & 0xfc000000) | (off & 0x3ffffff);
+        return 1;
+    }
+    if (off < -(1 << 18) || off >= (1 << 18)) return 0;
+    *w = (op & ~(0x7ffffu << 5)) | (uint32_t)(off & 0x7ffff) << 5;
+    return 1;
+}
+
+/* Each CPU places code in its own 1 MB at a time. */
+static __thread struct {
+    HvMachine *m;
+    uint64_t gen;
+    uint32_t *hot, *cold;
+} chunk;
+
+static int chunk_take(HvMachine *m, uint32_t hot, uint32_t cold, uint32_t **hot_at, uint32_t **cold_at) {
+    uint64_t gen = __atomic_load_n(&m->jit_gen, __ATOMIC_SEQ_CST);
+    if (chunk.m != m || chunk.gen != gen || !chunk.hot || (size_t)(chunk.cold - chunk.hot) < (size_t)hot + cold) {
+        size_t want = JIT_CHUNK_WORDS;
+        if (want > m->jit.capacity) want = m->jit.capacity;
+        if (want < (size_t)hot + cold) want = (size_t)hot + cold;
+        uint32_t *p = hv_jit_reserve(&m->jit, want);
+        if (!p) {
+            chunk.hot = NULL;
+            return -1;
+        }
+        chunk.m = m, chunk.gen = gen, chunk.hot = p, chunk.cold = p + ((want + 1) & ~(size_t)1);
+    }
+    *hot_at = chunk.hot;
+    chunk.hot += hot;
+    chunk.cold -= cold;
+    *cold_at = chunk.cold;
+    return 0;
+}
+
+int hv_translate_place(HvMachine *m, HvBlock *b) {
+    Emit *e = &E;
+    uint32_t pad = hv_knob[HV_K_TEST1] & ~1u; /* HV_K1: words of nothing after each block's hot part, to see what density is worth */
+    uint32_t *dst, *cold;
+    if (chunk_take(m, e->nhot + pad, e->ncold, &dst, &cold) != 0) return -1;
+    for (uint32_t k = 0; k < e->nrel; k++) {
+        uint32_t at = e->rel[k].at, target = e->rel[k].target;
+        if (e->rel[k].from_cold) patch_branch(&e->cold[at], (dst + target) - (cold + at));
+        else patch_branch(&e->hot[at], (cold + target) - (dst + at));
+    }
+    /* Exits in the page to blocks that exist already (or back to this one's
+       start) are chained now, in the copy about to be written: no trip through
+       the dispatcher to do it. As chain() does for the rest. */
+    for (uint32_t k = 0; k < e->nsite && !m->trace; k++) { /* tracing logs every block entry */
+        uint32_t slot = e->site[k].slot;
+        uint64_t t = e->site[k].target;
+        if (m->slot_xa[slot] || e->site[k].flags != b->flags || t == m->stop_pc || t == m->stop_pc2) continue; /* the dispatcher stops there */
+        const uint32_t *code = NULL;
+        if (t == b->va) code = dst;
+        else {
+            uint64_t pa = (b->pa & ~((1ull << HV_TLB_PAGE_BITS) - 1)) | (t & ((1ull << HV_TLB_PAGE_BITS) - 1));
+            HvBlock *tb = hv_block_find(m, hv_block_hash(t, pa, b->flags), t, pa, b->flags, b->gen);
+            /* Only to this CPU's own blocks: one another CPU just wrote must be
+               entered through an isb first (the dispatcher, a light lookup). */
+            if (tb && tb->maker == b->maker) code = tb->code;
+        }
+        if (!code) continue;
+        m->slots[slot] = (uint64_t)(uintptr_t)code;
+        uint32_t at = e->site[k].at;
+        int64_t off = code - ((e->site[k].cold ? cold : dst) + at);
+        if (off >= -(1 << 25) && off < (1 << 25)) (e->site[k].cold ? e->cold : e->hot)[at] = 0x14000000u | (uint32_t)(off & 0x3ffffff);
+        if (e->site[k].has_cond) hv_branch_retarget(&e->hot[e->site[k].cond_at], code - (dst + e->site[k].cond_at));
+        if (m->stats_interval) m->stats.chained_early++;
+    }
+    if (e->flat) {
+        hv_jit_write(&m->jit, dst, e->hot, e->pool_at * 4);
+        hv_jit_write(&m->jit, dst + e->pool_at, e->pool, e->npool * 8);
+    } else {
+        hv_jit_write(&m->jit, dst, e->hot, e->nhot * 4);
+        hv_jit_write(&m->jit, cold, e->cold, e->pool_at * 4);
+        hv_jit_write(&m->jit, cold + e->pool_at, e->pool, e->npool * 8);
+        hv_jit_finish(&m->jit, cold, e->ncold);
+    }
+    hv_jit_finish(&m->jit, dst, e->nhot);
+    b->code = dst;
+    for (uint32_t k = 0; k < e->nsite; k++) {
+        m->slot_site[e->site[k].slot] = (e->site[k].cold ? cold : dst) + e->site[k].at;
+        m->slot_stub[e->site[k].slot] = (e->site[k].stub_cold ? cold : dst) + e->site[k].stub;
+        m->slot_cond[e->site[k].slot] = e->site[k].has_cond ? dst + e->site[k].cond_at : NULL;
+    }
+    return 0;
+}
+
+int hv_translate_block(HvMachine *m, HvBlock *b, const uint32_t *code, uint32_t avail) {
+    if (hv_translate_emit(m, b, code, avail) != 0) return -1;
+    return hv_translate_place(m, b);
+}
diff --git a/accel/henge/engine/core/translate.h b/accel/henge/engine/core/translate.h
new file mode 100644
index 0000000000..ec52d6db06
--- /dev/null
+++ b/accel/henge/engine/core/translate.h
@@ -0,0 +1,45 @@
+#ifndef HENGEVM_TRANSLATE_H
+#define HENGEVM_TRANSLATE_H
+
+#include <stdint.h>
+
+#include "machine.h"
+
+/* What a block passes to hv_helper. Lives in the block's literal pool. */
+typedef struct HvHelperInfo {
+    uint64_t pc;
+    uint32_t insn;
+    uint32_t op;
+} HvHelperInfo;
+
+enum {
+    HV_OP_MEM = 1,     /* a load or store the fast path did not handle: emulate it whole */
+    HV_OP_MRS,
+    HV_OP_MSR,         /* MSR (register) or MSR (immediate); always leaves the block */
+    HV_OP_SYS,         /* DC, IC, TLBI, AT */
+    HV_OP_EXCEPTION,   /* SVC, HVC, SMC, BRK, HLT */
+    HV_OP_ERET,
+    HV_OP_UNDEF,
+    HV_OP_FPTRAP,      /* FP/SIMD while CPACR_EL1.FPEN traps it */
+    HV_OP_CLREX,
+    HV_OP_WFI,
+    HV_OP_WFE,         /* waits for the exclusive monitor's word to change (or a request); the block carries on */
+};
+
+#define HV_MAX_BLOCK_INSNS 128
+
+/* Translates guest code starting at b->va (b->pa, b->flags filled in) into the
+   machine's JIT region. `code` is the host copy of the guest instructions and
+   `avail` how many may be read before the end of the guest page.
+   Returns -1 if the JIT region is full. */
+int hv_translate_block(HvMachine *m, HvBlock *b, const uint32_t *code, uint32_t avail);
+/* The same in two steps, so CPUs translate in parallel: emit into this
+   thread's buffer (no lock needed), then place it in the JIT region (under the
+   translation lock). place returns -1 if the region is full. */
+int hv_translate_emit(HvMachine *m, HvBlock *b, const uint32_t *code, uint32_t avail);
+int hv_translate_place(HvMachine *m, HvBlock *b);
+uint32_t hv_translate_last_words(void);
+
+int hv_branch_retarget(uint32_t *w, int64_t off);
+
+#endif
diff --git a/accel/henge/engine/devices/gicv3.c b/accel/henge/engine/devices/gicv3.c
new file mode 100644
index 0000000000..9464beac87
--- /dev/null
+++ b/accel/henge/engine/devices/gicv3.c
@@ -0,0 +1,1092 @@
+/*
+ * ============================================================================
+ *  复原基线、未接管（RESTORED BASELINE — NOT WIRED）
+ *
+ *  本文件从 WindowsPixel/devices/gicv3.c 原样移植，只为了：
+ *    (a) 证明老引擎 GIC 可以在本树编译（模板可用、工作量可控）；
+ *    (b) 作为"设备线切口"交接层的改造基线。
+ *
+ *  它当前**没有任何调用者**：QEMU 的 hw/intc/arm_gic* 仍是唯一权威，
+ *  客机 ICC/GICD 访问仍走 seam，设备 IRQ 仍走 qemu_set_irq。
+ *
+ *  禁止零碎接线：接管必须走设计文档（labs/DESIGN-degraft.md）的
+ *  影子 → 翻权威 → 拆旧路径三步，每步带全矩阵；半搬（只 ICC）会在
+ *  GICD 与 ICC 之间造出内部边界，比现状更糟。
+ *
+ *  豁免条款（治理）：
+ *    - **只读影子豁免**：影子期允许本文件被调用（BQL 下镜像输入、只算线不叫醒）；
+ *    - **翻权威需过 census 重推门**（引擎锁序下 parked ⇒ 无 pending 的重推完成）；
+ *    - 禁止用"影子豁免"正当化任何真接线；也禁止用"禁止零碎接线"反对只读影子。
+ *
+ *  另：搬回去时必须带上事件门（DAIFClr unmask + line），
+ *  老版的无条件 exit 是风暴的价格，门控版是事件率的价格。
+ * ============================================================================
+ */
+#include "gicv3.h"
+
+uint64_t hv_gicv3_sgi_targets[8];
+uint64_t hv_gicv3_sgi_rx[8][16];   /* 投递台账：per-target per-intid 接受计数 */
+#include "mmu.h"
+
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Register layout follows the GICv3 architecture specification (IHI 0069);
+   behaviour is checked against QEMU's hw/intc/arm_gicv3*. */
+
+#define GICD_CTLR_EN_GRP0 1u
+#define GICD_CTLR_EN_GRP1 2u
+#define GICD_CTLR_ARE     (1u << 4)
+#define GICD_CTLR_DS      (1u << 6)
+#define SPURIOUS 1023
+#define IDLE_PRIORITY 0x100
+
+#define R(op0, op1, crn, crm, op2) ((op0) << 14 | (op1) << 11 | (crn) << 7 | (crm) << 3 | (op2))
+
+/* INTID i's state as CPU c sees it: banked below 32, shared above. */
+void hv_gicv3_update(HvGic *g);
+
+#define F(g, c, field, i) (*((i) < 32 ? &(g)->cpu[c].field[i] : &(g)->field[i]))
+
+static int ncpus(HvGic *g) {
+    return g->m->ncpus ? g->m->ncpus : 1;
+}
+
+static int pending(HvGic *g, int c, int i) {
+    return F(g, c, latch, i) || (!F(g, c, edge, i) && F(g, c, level, i));
+}
+
+static int group_enabled(HvGic *g, int c, int grp) {
+    return grp ? (g->ctlr & GICD_CTLR_EN_GRP1) && (g->cpu[c].igrpen1 & 1) : (g->ctlr & GICD_CTLR_EN_GRP0) && (g->cpu[c].igrpen0 & 1);
+}
+
+static int running_priority(HvGic *g, int c) {
+    return g->cpu[c].depth ? g->cpu[c].stack[g->cpu[c].depth - 1].prio : IDLE_PRIORITY;
+}
+
+/* Which CPU an SPI goes to: IROUTER's Aff0 (one cluster), or CPU 0 for "any" (IRM). */
+static int target_of(HvGic *g, int i) {
+    uint64_t r = g->route[i];
+    if ((r >> 31) & 1) return 0;
+    int c = (int)(r & 0xff);
+    return c < ncpus(g) ? c : 0;
+}
+
+/* Read 1-byte LPI configuration entry from GICR_PROPBASER (bit 0 = enable, bits 7:2 = priority). */
+static int lpi_prop_read(HvGic *g, int c, int intid, uint8_t *out_prio) {
+    uint64_t prop_pa = g->cpu[c].propbaser & 0x000ffffffffff000ULL;
+    if (!prop_pa || intid < HV_GIC_LPI_BASE || intid >= HV_GIC_LPI_BASE + HV_GIC_MAX_LPIS) return 0;
+    uint8_t prop = 0;
+    if (hv_phys_read(g->m, prop_pa + (uint64_t)(intid - HV_GIC_LPI_BASE), &prop, 1) != 0) return 0;
+    if (!(prop & 1u)) return 0;
+    *out_prio = (uint8_t)(prop & 0xfcu);
+    return 1;
+}
+
+/* CPU c's highest-priority pending interrupt; with `masked`, only one PMR and the running priority let through. */
+static int hppi_ex(HvGic *g, int c, int masked, uint8_t *out_prio, int *out_grp) {
+    int best = SPURIOUS, best_prio = 0x100, best_grp = 1;
+    /* SGIs and PPIs, then only the SPIs that are enabled: there are 256 of them and a few are in use. */
+    for (int i = 0; i < 32; i++) {
+        if (!F(g, c, enabled, i) || F(g, c, active, i) || !pending(g, c, i)) continue;
+        if (!group_enabled(g, c, F(g, c, group, i))) continue;
+        if (F(g, c, priority, i) < best_prio) {
+            best = i;
+            best_prio = F(g, c, priority, i);
+            best_grp = F(g, c, group, i);
+        }
+    }
+    for (int w = 0; w < (HV_GIC_NUM_IRQS + 63) / 64; w++)
+        for (uint64_t bits = g->spi_on[w]; bits; bits &= bits - 1) {
+            int i = w * 64 + __builtin_ctzll(bits);
+            if (i < 32 || i >= HV_GIC_NUM_IRQS) continue;
+            if (!g->enabled[i] || g->active[i] || !pending(g, c, i)) continue;
+            if (target_of(g, i) != c) continue;
+            if (!group_enabled(g, c, g->group[i])) continue;
+            if (g->priority[i] < best_prio) {
+                best = i;
+                best_prio = g->priority[i];
+                best_grp = g->group[i];
+            }
+        }
+    /* LPIs (INTIDs >= 8192): always Non-secure Group 1, edge-triggered, no active state. */
+    if ((g->cpu[c].gicr_ctlr & 1u) && group_enabled(g, c, 1)) {
+        for (int w = 0; w < HV_GIC_MAX_LPIS / 64; w++) {
+            for (uint64_t bits = g->cpu[c].lpi_pending[w]; bits; bits &= bits - 1) {
+                int lpi = HV_GIC_LPI_BASE + w * 64 + __builtin_ctzll(bits);
+                uint8_t lprio = 0;
+                if (lpi_prop_read(g, c, lpi, &lprio) && (int)lprio < best_prio) {
+                    best = lpi;
+                    best_prio = lprio;
+                    best_grp = 1;
+                }
+            }
+        }
+    }
+    if (best == SPURIOUS) return SPURIOUS;
+    if (masked && (best_prio >= (int)(g->cpu[c].pmr & 0xff) || best_prio >= running_priority(g, c))) return SPURIOUS;
+    if (out_prio) *out_prio = (uint8_t)best_prio;
+    if (out_grp) *out_grp = best_grp;
+    return best;
+}
+
+uint64_t hv_gicv3_hppi_eval;
+uint64_t hv_line_rises[8];
+
+static uint64_t hv_now_us(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000ull + (uint64_t)ts.tv_nsec / 1000;
+}
+/* 漏斗：SGI 生成与送达、PPI 取走（权威模式诊断）。 */
+uint64_t hv_gicv3_sgi_sent, hv_gicv3_sgi_accept[8];
+uint64_t hv_gicv3_ppi_taken[8];
+
+/* ---- A5: line-rise -> IAR latency, the authority-architecture number ----
+ *
+ * The pre-flip instrument lived in QEMU's GIC (HENGE_IAR_SPLIT, gicv3_cpuif.c)
+ * because the ICC access was a seam exit.  In authority mode the ICC is in the
+ * engine, so the measurement has to live here: stamp the line's 0->1 edge per
+ * CPU in hv_gicv3_update_body(), and consume the stamp at the guest's IAR.
+ * Buckets are the pre-registered ones: <2, <10, <20, <50, <160, >=160 us.
+ */
+static uint64_t g_rise_ns[HV_MAX_CPUS];
+static int g_iar_lat_on = -1;
+static uint64_t g_iar_b[HV_MAX_CPUS][6], g_iar_n[HV_MAX_CPUS], g_iar_sum[HV_MAX_CPUS];
+
+static uint64_t gic_now_ns(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ull + (uint64_t)ts.tv_nsec;
+}
+
+static void iar_lat_note(int c, uint64_t intid)
+{
+    if (c < 0 || c >= HV_MAX_CPUS || intid == SPURIOUS || !g_rise_ns[c]) return;
+    uint64_t d = gic_now_ns() - g_rise_ns[c];
+    g_rise_ns[c] = 0;
+    g_iar_n[c]++;
+    g_iar_sum[c] += d;
+    int b = d < 2000 ? 0 : d < 10000 ? 1 : d < 20000 ? 2 : d < 50000 ? 3 : d < 160000 ? 4 : 5;
+    g_iar_b[c][b]++;
+}
+
+void hv_gicv3_iar_lat_dump(void)
+{
+    if (g_iar_lat_on < 0) g_iar_lat_on = getenv("HENGE_IAR_LAT") != NULL;
+    if (!g_iar_lat_on) return;
+    for (int c = 0; c < HV_MAX_CPUS; c++) {
+        if (!g_iar_n[c]) continue;
+        fprintf(stderr, "henge-iarlat: cpu%d n=%llu avg=%lluns "
+                "hist(<2us/<10/<20/<50/<160/>=160)=%llu/%llu/%llu/%llu/%llu/%llu\n",
+                c, (unsigned long long)g_iar_n[c],
+                (unsigned long long)(g_iar_sum[c] / g_iar_n[c]),
+                (unsigned long long)g_iar_b[c][0], (unsigned long long)g_iar_b[c][1],
+                (unsigned long long)g_iar_b[c][2], (unsigned long long)g_iar_b[c][3],
+                (unsigned long long)g_iar_b[c][4], (unsigned long long)g_iar_b[c][5]);
+    }
+}
+
+static void hv_gicv3_update_body(HvGic *g) {
+    hv_gicv3_hppi_eval++;
+    for (int c = 0; c < ncpus(g); c++) {
+        int grp = 1;
+        int i = hppi_ex(g, c, 1, NULL, &grp);
+        HvPerCpu *p = &g->m->percpu[c];
+        int irq = i != SPURIOUS && grp == 1, fiq = i != SPURIOUS && grp == 0;
+        if (!g->m->shadow && getenv("HENGE_AUTH_TRACE") && c == 0) {
+            static int last_line = -1, last_hppi = -2, n;
+            if (n < 60 && (irq != last_line || i != last_hppi)) {
+                n++;
+                fprintf(stderr, "auth-line: g=%p m=%p p=%p t=%llu hppi=%d line=%d lvl27=%d lat27=%d act27=%d pmr=%llu ig1=%llu "
+                        "g27=%d p27=%u\n",
+                        (void *)g, (void *)g->m, (void *)p,
+                        (unsigned long long)hv_now_us(),
+                        i, irq, g->cpu[0].level[27], g->cpu[0].latch[27], g->cpu[0].active[27],
+                        (unsigned long long)g->cpu[0].pmr,
+                        (unsigned long long)g->cpu[0].igrpen1,
+                        g->cpu[0].group[27], g->cpu[0].priority[27]);
+            }
+            last_line = irq;
+            last_hppi = i;
+        }
+        int raised = (irq && !p->irq_line) || (fiq && !p->fiq_line);
+        if (irq && !p->irq_line && c < 8) {
+            hv_line_rises[c]++;
+            if (g_iar_lat_on < 0) g_iar_lat_on = getenv("HENGE_IAR_LAT") != NULL;
+            if (g_iar_lat_on && c < HV_MAX_CPUS) g_rise_ns[c] = gic_now_ns();
+        }
+        __atomic_store_n(&p->irq_line, irq, __ATOMIC_RELEASE);
+        __atomic_store_n(&p->fiq_line, fiq, __ATOMIC_RELEASE);
+        if (!g->m->shadow && getenv("HENGE_AUTH_TRACE") && c == 0 && irq) {
+            static int n;
+            static uint64_t seq;
+            int back;
+            __asm__ volatile("ldr %w0, [%1]" : "=r"(back) : "r"(&p->irq_line) : "memory");
+            __atomic_store_n(&seq, seq + 1, __ATOMIC_RELAXED);
+            if (n++ < 4)
+                fprintf(stderr, "auth-id: TU=writer base=%p field=%p off=%zu size=%zu seq=%llu "
+                        "wrote=%d readback=%d\n",
+                        (void *)p, (void *)&p->irq_line,
+                        offsetof(HvPerCpu, irq_line), sizeof(HvPerCpu),
+                        (unsigned long long)seq, irq, back);
+        }
+        if (!g->m->shadow && raised && g->m->cpus[c] && g->m->ncpus > 1)
+            hv_cpu_wake(g->m->cpus[c]); /* it may be asleep in WFI, or running */
+    }
+}
+
+static void hv_gicv3_set_irq_body(HvGic *g, int intid, int level) {
+    if (intid < 32 || intid >= HV_GIC_NUM_IRQS) return;
+    level = level != 0;
+    if (g->level[intid] == level) return; /* nothing changed: skip the rescan */
+    if (g->edge[intid] && level) g->latch[intid] = 1;
+    g->level[intid] = (uint8_t)level;
+    hv_gicv3_update(g);
+}
+
+static void hv_gicv3_set_ppi_body(HvGic *g, int c, int intid, int level) {
+    if (intid < 16 || intid >= 32 || c >= HV_MAX_CPUS) return;
+    HvGicCpu *k = &g->cpu[c];
+    level = level != 0;
+    if (k->level[intid] == level) return; /* the timer re-asserts every tick */
+    if (k->edge[intid] && level) k->latch[intid] = 1;
+    k->level[intid] = (uint8_t)level;
+    hv_gicv3_update(g);
+}
+
+static void hv_gicv3_pend_body(HvGic *g, int intid) {
+    if (intid < 32 || intid >= HV_GIC_NUM_IRQS) return;
+    g->latch[intid] = 1;
+    hv_gicv3_update(g);
+}
+
+/* ---- the CPU interface ---- */
+
+static uint64_t acknowledge(HvGic *g, int c, int grp) {
+    uint8_t prio = 0;
+    int igrp = 1;
+    int i = hppi_ex(g, c, 1, &prio, &igrp);
+    if (i == SPURIOUS || igrp != grp) return SPURIOUS;
+    if (i >= HV_GIC_LPI_BASE) {
+        int idx = i - HV_GIC_LPI_BASE;
+        g->cpu[c].lpi_pending[idx / 64] &= ~(1ull << (idx % 64));
+    } else {
+        F(g, c, active, i) = 1;
+        F(g, c, latch, i) = 0;
+    }
+    HvGicCpu *k = &g->cpu[c];
+    if (i < 32) {
+        hv_gicv3_ppi_taken[c]++;
+        if (!g->m->shadow && getenv("HENGE_AUTH_TRACE")) {
+            static int n;
+            if (n++ < 6)
+                fprintf(stderr, "auth-ack: cpu%d intid=%d taken=%llu\n",
+                        c, i, (unsigned long long)hv_gicv3_ppi_taken[c]);
+        }
+    }
+    if (k->depth < 32) k->stack[k->depth++] = (HvGicActive){(uint16_t)i, prio, (uint8_t)grp};
+    hv_gicv3_update(g);
+    return (uint64_t)i;
+}
+
+static void end_of_interrupt(HvGic *g, int c, int intid) {
+    if (intid >= HV_GIC_NUM_IRQS && intid < HV_GIC_LPI_BASE) return;
+    if (intid >= HV_GIC_LPI_BASE + HV_GIC_MAX_LPIS) return;
+    HvGicCpu *k = &g->cpu[c];
+    if (k->depth) k->depth--; /* priority drop: the most recent acknowledge */
+    if (intid < HV_GIC_NUM_IRQS && !(k->icc_ctlr & 2)) F(g, c, active, intid) = 0; /* EOImode 0 also deactivates */
+    hv_gicv3_update(g);
+}
+
+static uint64_t icc_read_body(HvMachine *m, HvCpu *cpu, uint32_t reg) {
+    HvGic *g = m->gic;
+    int c = (int)cpu->index;
+    HvGicCpu *k = &g->cpu[c];
+    int h, hgrp = 1;
+    switch (reg) {
+    case R(3, 0, 4, 6, 0): return k->pmr;
+    case R(3, 0, 12, 12, 0): {                                          /* IAR1 */
+        uint64_t v = acknowledge(g, c, 1);
+        if (g_iar_lat_on) iar_lat_note(c, v);
+        return v;
+    }
+    case R(3, 0, 12, 8, 0): {                                           /* IAR0 */
+        uint64_t v = acknowledge(g, c, 0);
+        if (g_iar_lat_on) iar_lat_note(c, v);
+        return v;
+    }
+    case R(3, 0, 12, 12, 2):                                           /* HPPIR1 */
+        h = hppi_ex(g, c, 0, NULL, &hgrp);
+        return h != SPURIOUS && hgrp == 1 ? (uint64_t)h : SPURIOUS;
+    case R(3, 0, 12, 8, 2):                                            /* HPPIR0 */
+        h = hppi_ex(g, c, 0, NULL, &hgrp);
+        return h != SPURIOUS && hgrp == 0 ? (uint64_t)h : SPURIOUS;
+    case R(3, 0, 12, 11, 3): return running_priority(g, c) == IDLE_PRIORITY ? 0xff : (uint64_t)running_priority(g, c); /* RPR */
+    case R(3, 0, 12, 8, 3): return k->bpr0;
+    case R(3, 0, 12, 12, 3): return k->bpr1;
+    case R(3, 0, 12, 12, 4): return k->icc_ctlr | 7u << 8 | 1u << 14;  /* CTLR: 8 priority bits, 16-bit IDs, SEIS 0, RSS */
+    case R(3, 0, 12, 12, 5): return 7;                                 /* SRE: system registers only */
+    case R(3, 0, 12, 12, 6): return k->igrpen0;
+    case R(3, 0, 12, 12, 7): return k->igrpen1;
+    case R(3, 0, 12, 8, 4): return (uint32_t)k->ap0r;
+    case R(3, 0, 12, 9, 0): return (uint32_t)k->ap1r;
+    default: return 0;                                                 /* AP*R1-3 and the rest */
+    }
+}
+
+static void icc_write_body(HvMachine *m, HvCpu *cpu, uint32_t reg, uint64_t v) {
+    HvGic *g = m->gic;
+    int c = (int)cpu->index;
+    HvGicCpu *k = &g->cpu[c];
+    switch (reg) {
+    case R(3, 0, 4, 6, 0):
+        if (!m->shadow && getenv("HENGE_AUTH_TRACE"))
+            fprintf(stderr, "auth-pmr: cpu%d <- 0x%llx\n", c, (unsigned long long)v);
+        k->pmr = v & 0xff; break;
+    case R(3, 0, 12, 12, 1): case R(3, 0, 12, 8, 1): end_of_interrupt(g, c, (int)(v & 0xffffff)); break; /* EOIR1/0 */
+    case R(3, 0, 12, 11, 1):                                           /* DIR */
+        if ((v & 0xffffff) < HV_GIC_NUM_IRQS) F(g, c, active, (int)(v & 0xffffff)) = 0;
+        break;
+    case R(3, 0, 12, 8, 3): k->bpr0 = v & 7; break;
+    case R(3, 0, 12, 12, 3): k->bpr1 = v & 7; break;
+    case R(3, 0, 12, 12, 4): k->icc_ctlr = v & 3; break;              /* CBPR, EOImode */
+    case R(3, 0, 12, 12, 6): k->igrpen0 = v & 1; break;
+    case R(3, 0, 12, 12, 7): k->igrpen1 = v & 1; break;
+    case R(3, 0, 12, 8, 4): k->ap0r = (uint32_t)v; break;
+    case R(3, 0, 12, 9, 0): k->ap1r = (uint32_t)v; break;
+    case R(3, 0, 12, 11, 5): case R(3, 0, 12, 11, 6): case R(3, 0, 12, 11, 7): { /* SGI1R, ASGI1R, SGI0R */
+        hv_gicv3_sgi_sent++;
+        if (!m->shadow && getenv("HENGE_AUTH_TRACE"))
+            fprintf(stderr, "auth-sgi-write: from cpu%d reg=%x v=%llx\n",
+                    c, reg, (unsigned long long)v);
+        int intid = (v >> 24) & 0xf;
+        int irm = (v >> 40) & 1;
+        uint64_t aff = (v >> 16 & 0xff) | (v >> 32 & 0xff) << 8 | (v >> 48 & 0xff) << 16; /* Aff1, Aff2, Aff3 */
+        uint32_t rs = (v >> 44) & 0xf;
+        for (int t = 0; t < ncpus(g); t++) {
+            uint64_t mp = m->cpus[t] ? m->cpus[t]->mpidr & 0xffffff : (uint64_t)t;
+            int hit = irm ? t != c : aff == (mp >> 8) && rs == (mp & 0xff) >> 4 && ((v >> (mp & 0xf)) & 1);
+            if (hit) {
+                hv_gicv3_sgi_accept[t]++;
+                if (!g->m->shadow && getenv("HENGE_AUTH_TRACE"))
+                    fprintf(stderr, "auth-sgi: target cpu%d intid=%d\n", t, intid);
+                g->cpu[t].latch[intid] = 1;
+                hv_gicv3_sgi_targets[t]++;
+                if (intid >= 0 && intid < 16) hv_gicv3_sgi_rx[t][intid]++;
+            }
+        }
+        break;
+    }
+    default: break;
+    }
+    hv_gicv3_update(g);
+}
+
+/* ---- MMIO: bitmap, byte and route registers shared by GICD and GICR ---- */
+
+/* Registers indexed by INTID, starting at `first` for this frame, as CPU c sees them. */
+static uint32_t bank_read(HvGic *g, int c, uint32_t off, int first, int count) {
+    uint32_t v = 0;
+    int base;
+    if (off >= 0x400 && off < 0x800) { /* IPRIORITYR: one byte each */
+        base = first + (int)(off - 0x400);
+        for (int b = 0; b < 4; b++)
+            if (base + b - first < count) v |= (uint32_t)F(g, c, priority, base + b) << (b * 8);
+        return v;
+    }
+    if (off >= 0xc00 && off < 0xd00) { /* ICFGR: two bits each */
+        base = first + (int)(off - 0xc00) * 4;
+        for (int b = 0; b < 16; b++)
+            if (base + b - first < count && F(g, c, edge, base + b)) v |= 2u << (b * 2);
+        return v;
+    }
+    uint32_t reg = off & ~0x7fu, idx = (off & 0x7f) / 4;
+    base = first + (int)idx * 32;
+    for (int b = 0; b < 32; b++) {
+        int i = base + b;
+        if (i - first >= count) break;
+        int bit = 0;
+        switch (reg) {
+        case 0x080: bit = F(g, c, group, i); break;
+        case 0x100: case 0x180: bit = F(g, c, enabled, i); break;
+        case 0x200: case 0x280: bit = pending(g, c, i); break;
+        case 0x300: case 0x380: bit = F(g, c, active, i); break;
+        case 0xd00: bit = F(g, c, grpmod, i); break;
+        default: break;
+        }
+        v |= (uint32_t)bit << b;
+    }
+    return v;
+}
+
+/* mask has ones in the bytes that were written. */
+static void bank_write(HvGic *g, int c, uint32_t off, uint32_t v, uint32_t mask, int first, int count, int sgi_ppi) {
+    int base;
+    if (off >= 0x400 && off < 0x800) {
+        base = first + (int)(off - 0x400);
+        for (int b = 0; b < 4; b++)
+            if ((mask >> (b * 8)) & 0xff && base + b - first < count) F(g, c, priority, base + b) = (uint8_t)(v >> (b * 8));
+        return;
+    }
+    if (off >= 0xc00 && off < 0xd00) {
+        base = first + (int)(off - 0xc00) * 4;
+        for (int b = 0; b < 16; b++) {
+            int i = base + b;
+            if (i - first >= count || !((mask >> (b * 2)) & 3)) continue;
+            if (sgi_ppi && i < 16) continue; /* SGIs are always edge */
+            F(g, c, edge, i) = (v >> (b * 2 + 1)) & 1;
+        }
+        return;
+    }
+    uint32_t reg = off & ~0x7fu, idx = (off & 0x7f) / 4;
+    base = first + (int)idx * 32;
+    for (int b = 0; b < 32; b++) {
+        int i = base + b;
+        if (i - first >= count) break;
+        if (!((mask >> b) & 1)) continue;
+        int bit = (v >> b) & 1;
+        switch (reg) {
+        case 0x080: F(g, c, group, i) = (uint8_t)bit; break;
+        case 0x100:
+            if (bit) {
+                F(g, c, enabled, i) = 1;
+                if (i >= 32) g->spi_on[i / 64] |= 1ull << (i % 64);
+            }
+            break;
+        case 0x180:
+            if (bit) {
+                F(g, c, enabled, i) = 0;
+                if (i >= 32) g->spi_on[i / 64] &= ~(1ull << (i % 64));
+            }
+            break;
+        case 0x200: if (bit) F(g, c, latch, i) = 1; break;
+        case 0x280: if (bit) F(g, c, latch, i) = 0; break;
+        case 0x300: if (bit) F(g, c, active, i) = 1; break;
+        case 0x380: if (bit) F(g, c, active, i) = 0; break;
+        case 0xd00: F(g, c, grpmod, i) = (uint8_t)bit; break;
+        default: break;
+        }
+    }
+}
+
+static uint32_t size_mask(uint64_t off, unsigned size) {
+    uint32_t m = size >= 4 ? 0xffffffffu : (1u << (size * 8)) - 1;
+    return m << ((off & 3) * 8);
+}
+
+/* Registers for INTIDs 0-31. In the distributor they are reserved (ARE is set);
+   the redistributor's SGI frame has only these. */
+static int bank0(uint32_t a) {
+    if (a >= 0x400 && a < 0x800) return a < 0x420;
+    if (a >= 0xc00 && a < 0xd00) return a < 0xc08;
+    return (a & 0x7f) < 4;
+}
+
+static uint64_t dist_read_body(void *opaque, uint64_t off, unsigned size) {
+    HvGic *g = opaque;
+    if (off >= 0x6100 && off < 0x6100 + 8 * HV_GIC_NUM_IRQS) { /* IROUTER<n>, n >= 32 */
+        uint64_t v = g->route[(off - 0x6000) / 8];
+        return size == 8 ? v : (uint32_t)(v >> ((off & 4) * 8));
+    }
+    uint32_t word, a = (uint32_t)off & ~3u;
+    switch (a) {
+    case 0x0000: word = g->ctlr | GICD_CTLR_ARE | GICD_CTLR_DS; break;
+    case 0x0004: word = (HV_GIC_NUM_IRQS / 32 - 1) | (1u << 17) | (15u << 19); break; /* ITLinesNumber, LPIS, 16 ID bits */
+    case 0x0008: word = 0x0300043b; break;                             /* IIDR: Arm, GICv3 */
+    case 0xffe8: word = 0x3b; break;                                   /* PIDR2: ArchRev 3 */
+    default:
+        word = a >= 0x80 && a < 0x1000 && !bank0(a) ? bank_read(g, 0, a, 0, HV_GIC_NUM_IRQS) : 0;
+        break;
+    }
+    return (word >> ((off & 3) * 8)) & (size >= 4 ? 0xffffffffu : (1u << (size * 8)) - 1);
+}
+
+static void dist_write_body(void *opaque, uint64_t off, uint64_t v, unsigned size) {
+    HvGic *g = opaque;
+    if (off >= 0x6100 && off < 0x6100 + 8 * HV_GIC_NUM_IRQS) {
+        uint64_t *r = &g->route[(off - 0x6000) / 8];
+        if (size == 8) *r = v;
+        else if (off & 4) *r = (*r & 0xffffffffull) | v << 32;
+        else *r = (*r & ~0xffffffffull) | (uint32_t)v;
+        return;
+    }
+    uint32_t a = (uint32_t)off & ~3u, mask = size_mask(off, size);
+    uint32_t word = (uint32_t)(v << ((off & 3) * 8));
+    if (a == 0) {
+        g->ctlr = (g->ctlr & ~mask) | (word & mask & (GICD_CTLR_EN_GRP0 | GICD_CTLR_EN_GRP1));
+    } else if (a >= 0x80 && a < 0x1000) {
+        if (!bank0(a)) bank_write(g, 0, a, word, mask, 0, HV_GIC_NUM_IRQS, 0);
+    }
+    hv_gicv3_update(g);
+}
+
+static void write_slice64(uint64_t *dst, uint64_t off, uint64_t val, unsigned size) {
+    if (size >= 8) {
+        *dst = val;
+        return;
+    }
+    unsigned sh = (unsigned)((off & 7ull) * 8u);
+    uint64_t m = ((1ull << (size * 8u)) - 1ull) << sh;
+    *dst = (*dst & ~m) | ((val << sh) & m);
+}
+
+/* One redistributor per CPU, 128 KB apart: RD_base at 0, SGI_base at 0x10000. */
+static uint64_t redist_read_body(void *opaque, uint64_t off, unsigned size) {
+    HvGic *g = opaque;
+    uint64_t v = 0;
+    int c = (int)(off >> 17);
+    off &= 0x1ffff;
+    if (c >= ncpus(g)) return 0;
+    if (off < 0x10000) {
+        uint64_t mp = g->m->cpus[c] ? g->m->cpus[c]->mpidr : (uint64_t)c;
+        switch (off & ~7ull) {
+        case 0x0000: v = ((uint64_t)0x0300043b << 32) | g->cpu[c].gicr_ctlr; break; /* CTLR, IIDR */
+        case 0x0008: /* TYPER: PLPIS=1, Last on final frame, processor number, affinity */
+            v = (mp & 0xffffff) << 32 | (uint64_t)c << 8 | (c == ncpus(g) - 1 ? 1u << 4 : 0) | 1ull;
+            break;
+        case 0x0010: v = (uint64_t)g->cpu[c].waker << 32; break;        /* STATUSR, WAKER */
+        case 0x0070: v = g->cpu[c].propbaser; break;                    /* PROPBASER */
+        case 0x0078: v = g->cpu[c].pendbaser; break;                    /* PENDBASER */
+        case 0x00c0: v = 0; break;                                      /* SYNCR */
+        case 0xffe8: v = 0x3b; break;
+        default: break;
+        }
+        v >>= (off & 7) * 8;
+    } else {
+        uint32_t a = (uint32_t)(off - 0x10000) & ~3u;
+        if (a >= 0x80 && a < 0x1000 && bank0(a))
+            v = bank_read(g, c, a, 0, 32) >> ((off & 3) * 8);
+    }
+    return size == 8 ? v : v & ((1ull << (size * 8)) - 1);
+}
+
+static void redist_write_body(void *opaque, uint64_t off, uint64_t v, unsigned size) {
+    HvGic *g = opaque;
+    int c = (int)(off >> 17);
+    off &= 0x1ffff;
+    if (c >= ncpus(g)) return;
+    if (off < 0x10000) {
+        uint64_t a8 = off & ~7ull;
+        if (off < 4) {
+            g->cpu[c].gicr_ctlr = (uint32_t)(v & 1u);
+            hv_gicv3_update(g);
+        } else if ((off & ~3ull) == 0x14) {
+            /* WAKER: clearing ProcessorSleep wakes it; ChildrenAsleep follows at once. */
+            uint32_t sleep = (v >> (8 * (off & 3))) & 2;
+            g->cpu[c].waker = sleep ? 6 : 0;
+        } else if (a8 == 0x0070) {
+            write_slice64(&g->cpu[c].propbaser, off, v, size);
+            hv_gicv3_update(g);
+        } else if (a8 == 0x0078) {
+            write_slice64(&g->cpu[c].pendbaser, off, v, size);
+            if (g->cpu[c].pendbaser & (1ull << 62)) {
+                memset(g->cpu[c].lpi_pending, 0, sizeof g->cpu[c].lpi_pending);
+                g->cpu[c].pendbaser &= ~(1ull << 62);
+            }
+            hv_gicv3_update(g);
+        } else if (a8 == 0x00a0 || a8 == 0x00b0) {
+            hv_gicv3_update(g);
+        }
+        return;
+    }
+    uint32_t a = (uint32_t)(off - 0x10000) & ~3u, mask = size_mask(off, size);
+    uint32_t word = (uint32_t)(v << ((off & 3) * 8));
+    if (a >= 0x80 && a < 0x1000 && bank0(a)) bank_write(g, c, a, word, mask, 0, 32, 1);
+    hv_gicv3_update(g);
+}
+
+/* Every way in takes the GIC's own lock (recursive: the bodies call hv_gicv3_update).
+   Devices call in holding the device lock; the CPUs' ICC registers and timers do not need it. */
+void hv_gicv3_update(HvGic *g) {
+    pthread_mutex_lock(&g->mu);
+    hv_gicv3_update_body(g);
+    pthread_mutex_unlock(&g->mu);
+}
+
+void hv_gicv3_set_irq(HvGic *g, int intid, int level) {
+    pthread_mutex_lock(&g->mu);
+    hv_gicv3_set_irq_body(g, intid, level);
+    pthread_mutex_unlock(&g->mu);
+}
+
+void hv_gicv3_set_ppi(HvGic *g, int c, int intid, int level) {
+    /* The timer re-asserts its level at every tick, and only CPU c sets its own
+       PPIs: an unchanged level needs no lock (the GIC's is shared by all). */
+    if (intid >= 16 && intid < 32 && c < HV_MAX_CPUS &&
+        __atomic_load_n(&g->cpu[c].level[intid], __ATOMIC_RELAXED) == (level != 0))
+        return;
+    pthread_mutex_lock(&g->mu);
+    hv_gicv3_set_ppi_body(g, c, intid, level);
+    pthread_mutex_unlock(&g->mu);
+}
+
+void hv_gicv3_pend(HvGic *g, int intid) {
+    pthread_mutex_lock(&g->mu);
+    hv_gicv3_pend_body(g, intid);
+    pthread_mutex_unlock(&g->mu);
+}
+
+static uint64_t icc_read(HvMachine *m, HvCpu *cpu, uint32_t reg) {
+    pthread_mutex_lock(&((HvGic *)m->gic)->mu);
+    uint64_t v_ = icc_read_body(m, cpu, reg);
+    pthread_mutex_unlock(&((HvGic *)m->gic)->mu);
+    return v_;
+}
+
+static void icc_write(HvMachine *m, HvCpu *cpu, uint32_t reg, uint64_t v) {
+    pthread_mutex_lock(&((HvGic *)m->gic)->mu);
+    icc_write_body(m, cpu, reg, v);
+    pthread_mutex_unlock(&((HvGic *)m->gic)->mu);
+}
+
+static uint64_t dist_read(void *opaque, uint64_t off, unsigned size) {
+    pthread_mutex_lock(&((HvGic *)opaque)->mu);
+    uint64_t v_ = dist_read_body(opaque, off, size);
+    pthread_mutex_unlock(&((HvGic *)opaque)->mu);
+    return v_;
+}
+
+static void dist_write(void *opaque, uint64_t off, uint64_t v, unsigned size) {
+    pthread_mutex_lock(&((HvGic *)opaque)->mu);
+    dist_write_body(opaque, off, v, size);
+    pthread_mutex_unlock(&((HvGic *)opaque)->mu);
+}
+
+static uint64_t redist_read(void *opaque, uint64_t off, unsigned size) {
+    pthread_mutex_lock(&((HvGic *)opaque)->mu);
+    uint64_t v_ = redist_read_body(opaque, off, size);
+    pthread_mutex_unlock(&((HvGic *)opaque)->mu);
+    return v_;
+}
+
+static void redist_write(void *opaque, uint64_t off, uint64_t v, unsigned size) {
+    pthread_mutex_lock(&((HvGic *)opaque)->mu);
+    redist_write_body(opaque, off, v, size);
+    pthread_mutex_unlock(&((HvGic *)opaque)->mu);
+}
+
+typedef struct HvGicV2m {
+    HvGic *g;
+    int spi_base; /* GIC INTID of first MSI SPI (>= 32) */
+    int num_spi;
+} HvGicV2m;
+
+static uint64_t v2m_read(void *opaque, uint64_t off, unsigned size) {
+    HvGicV2m *v = opaque;
+    uint32_t word = 0;
+    switch (off & ~3ull) {
+    case 0x008: word = ((uint32_t)v->spi_base << 16) | (uint32_t)v->num_spi; break; /* MSI_TYPER */
+    case 0xfcc: word = 0x0002043bu; break; /* MSI_IIDR: ARM GICv2m */
+    case 0xfe0: word = 0x22; break;
+    case 0xfe4: word = 0xb0; break;
+    case 0xfe8: word = 0x0b; break;
+    case 0xff0: word = 0x0d; break;
+    case 0xff4: word = 0xf0; break;
+    case 0xff8: word = 0x05; break;
+    case 0xffc: word = 0xb1; break;
+    default: break;
+    }
+    return (word >> ((off & 3) * 8)) & (size >= 4 ? 0xffffffffu : (1u << (size * 8)) - 1);
+}
+
+static void v2m_write(void *opaque, uint64_t off, uint64_t val, unsigned size) {
+    (void)size;
+    HvGicV2m *v = opaque;
+    if ((off & ~3ull) == 0x040) { /* MSI_SETSPI_NS */
+        int intid = (int)(val & 0x3ff);
+        if (intid >= v->spi_base && intid < v->spi_base + v->num_spi)
+            hv_gicv3_pend(v->g, intid);
+    }
+}
+
+void hv_gicv2m_create(HvMachine *m, HvGic *g, uint64_t pa, int spi_base, int num_spi) {
+    HvGicV2m *v = calloc(1, sizeof *v);
+    v->g = g;
+    v->spi_base = spi_base;
+    v->num_spi = num_spi;
+    hv_machine_add_mmio(m, pa, 0x10000, v, v2m_read, v2m_write, "gicv2m");
+    m->mmio[m->nmmio - 1].self_locked = 1;
+}
+
+/* ---- GICv3 Interrupt Translation Service (ITS, 128 KB frame: 0x00000 ctrl + 0x10000 translater) ---- */
+
+#define HV_ITS_MAX_ITES  1024
+#define HV_ITS_MAX_COLLS 1024
+
+typedef struct HvItsIte {
+    uint32_t devid;
+    uint32_t eventid;
+    uint32_t pintid;
+    uint16_t icid;
+    uint8_t valid;
+} HvItsIte;
+
+struct HvGicIts {
+    HvMachine *m;
+    HvGic *g;
+    uint32_t ctlr;       /* bit 0: Enabled, bit 31: Quiescent (always 1) */
+    uint64_t typer;
+    uint64_t cbaser;
+    uint64_t cwriter;
+    uint64_t creadr;
+    uint64_t baser[8];
+    uint16_t coll_cpu[HV_ITS_MAX_COLLS];
+    HvItsIte ite[HV_ITS_MAX_ITES];
+};
+
+static int rdbase_to_cpu(HvGicIts *its, uint64_t rdbase) {
+    int n = ncpus(its->g);
+    uint64_t pa = rdbase << 16;
+    if (pa >= 0x080a0000ULL && pa < 0x080a0000ULL + (uint64_t)n * 0x20000ULL)
+        return (int)((pa - 0x080a0000ULL) >> 17);
+    return (int)rdbase < n ? (int)rdbase : 0;
+}
+
+static void its_deliver_locked(HvGicIts *its, uint32_t devid, uint32_t eventid) {
+    static int traced;
+    if (!(its->ctlr & 1u)) {
+        if (getenv("HV_ITS_LOG") && traced++ < 4)
+            fprintf(stderr, "its door: devid=0x%x eventid=0x%x ctlr=0x%x (disabled)\n",
+                    devid, eventid, its->ctlr);
+        return;
+    }
+    int hit = 0;
+    for (int i = 0; i < HV_ITS_MAX_ITES; i++) {
+        if (!its->ite[i].valid) continue;
+        if (its->ite[i].devid == devid && its->ite[i].eventid == eventid) {
+            uint32_t pintid = its->ite[i].pintid;
+            uint16_t icid = its->ite[i].icid;
+            int c = icid < HV_ITS_MAX_COLLS ? its->coll_cpu[icid] : 0;
+            if (c >= ncpus(its->g)) c = 0;
+            if (pintid >= HV_GIC_LPI_BASE && pintid < HV_GIC_LPI_BASE + HV_GIC_MAX_LPIS) {
+                uint32_t idx = pintid - HV_GIC_LPI_BASE;
+                its->g->cpu[c].lpi_pending[idx / 64] |= 1ull << (idx % 64);
+                hv_gicv3_update_body(its->g);
+            }
+            hit = 1;
+            if (getenv("HENGE_LPI_TRACE") && traced < 4) {
+                uint8_t pr = 0;
+                int ok = lpi_prop_read(its->g, c, pintid, (uint8_t *)&pr);
+                fprintf(stderr, "lpi-trace: shadow prop cpu=%d propbaser=%llx prop_ok=%d prop=0x%x\n",
+                        c, (unsigned long long)its->g->cpu[c].propbaser, ok, pr);
+            }
+            if (getenv("HV_ITS_LOG") && traced++ < 8)
+                fprintf(stderr, "its door: devid=0x%x eventid=0x%x -> pintid=%d c=%d HIT\n",
+                        devid, eventid, pintid, c);
+            return;
+        }
+    }
+    if (!hit && getenv("HV_ITS_LOG") && traced++ < 8) {
+        int nv = 0;
+        for (int i = 0; i < HV_ITS_MAX_ITES; i++) if (its->ite[i].valid) nv++;
+        fprintf(stderr, "its door: devid=0x%x eventid=0x%x (MISS, valid ites=%d)\n",
+                devid, eventid, nv);
+    }
+}
+
+void hv_gicv3_its_msi(HvGicIts *its, uint32_t devid, uint32_t eventid) {
+    if (!its) return;
+    pthread_mutex_lock(&its->g->mu);
+    its_deliver_locked(its, devid, eventid);
+    pthread_mutex_unlock(&its->g->mu);
+}
+
+static void its_map_ite(HvGicIts *its, uint32_t devid, uint32_t eventid, uint32_t pintid, uint16_t icid) {
+    int free_slot = -1;
+    for (int i = 0; i < HV_ITS_MAX_ITES; i++) {
+        if (its->ite[i].valid && its->ite[i].devid == devid && its->ite[i].eventid == eventid) {
+            its->ite[i].pintid = pintid;
+            its->ite[i].icid = icid;
+            return;
+        }
+        if (!its->ite[i].valid && free_slot < 0) free_slot = i;
+    }
+    if (free_slot >= 0) {
+        its->ite[free_slot] = (HvItsIte){.devid = devid, .eventid = eventid, .pintid = pintid, .icid = icid, .valid = 1};
+    }
+}
+
+static void its_clear_ite(HvGicIts *its, uint32_t devid, uint32_t eventid, int discard) {
+    for (int i = 0; i < HV_ITS_MAX_ITES; i++) {
+        if (!its->ite[i].valid || its->ite[i].devid != devid || its->ite[i].eventid != eventid) continue;
+        uint32_t pintid = its->ite[i].pintid;
+        uint16_t icid = its->ite[i].icid;
+        int c = icid < HV_ITS_MAX_COLLS ? its->coll_cpu[icid] : 0;
+        if (c < ncpus(its->g) && pintid >= HV_GIC_LPI_BASE && pintid < HV_GIC_LPI_BASE + HV_GIC_MAX_LPIS) {
+            uint32_t idx = pintid - HV_GIC_LPI_BASE;
+            its->g->cpu[c].lpi_pending[idx / 64] &= ~(1ull << (idx % 64));
+        }
+        if (discard) its->ite[i].valid = 0;
+        hv_gicv3_update_body(its->g);
+        return;
+    }
+}
+
+static void its_process_commands(HvGicIts *its) {
+    if (!(its->ctlr & 1u) || !(its->cbaser >> 63)) return;
+    uint64_t ring_pa = its->cbaser & 0x000ffffffffff000ULL;
+    uint64_t ring_sz = ((its->cbaser & 0xffull) + 1ull) * 4096ull;
+    uint64_t target = its->cwriter & 0xfffe0ull;
+    if (target >= ring_sz) target %= ring_sz;
+
+    int guard = 0;
+    while (its->creadr != target && guard++ < 8192) {
+        uint64_t dw[4] = {0};
+        if (hv_phys_read(its->m, ring_pa + its->creadr, dw, 32) != 0) {
+            if (getenv("HV_ITS_LOG"))
+                fprintf(stderr, "its cmd read FAIL pa=%llx cbaser=%llx cwriter=%llx creadr=%llx\n",
+                        (unsigned long long)(ring_pa + its->creadr),
+                        (unsigned long long)its->cbaser, (unsigned long long)its->cwriter,
+                        (unsigned long long)its->creadr);
+            break;
+        }
+        its->creadr = (its->creadr + 32ull) % ring_sz;
+
+        uint8_t cmd = (uint8_t)(dw[0] & 0xffu);
+        uint32_t devid = (uint32_t)(dw[0] >> 32);
+        uint32_t eventid = (uint32_t)(dw[1] & 0xffffffffu);
+        if (getenv("HV_ITS_LOG"))
+            fprintf(stderr, "its cmd 0x%02x: dw0=%llx dw1=%llx dw2=%llx dw3=%llx\n",
+                    cmd, (unsigned long long)dw[0], (unsigned long long)dw[1],
+                    (unsigned long long)dw[2], (unsigned long long)dw[3]);
+        switch (cmd) {
+        case 0x01: { /* MOVALL */
+            int c1 = rdbase_to_cpu(its, (dw[2] >> 16) & 0x7ffffffffULL);
+            int c2 = rdbase_to_cpu(its, (dw[3] >> 16) & 0x7ffffffffULL);
+            for (int i = 0; i < HV_ITS_MAX_COLLS; i++)
+                if (its->coll_cpu[i] == c1) its->coll_cpu[i] = (uint16_t)c2;
+            hv_gicv3_update_body(its->g);
+            break;
+        }
+        case 0x03: /* INT */
+            its_deliver_locked(its, devid, eventid);
+            break;
+        case 0x04: /* CLEAR */
+            its_clear_ite(its, devid, eventid, 0);
+            break;
+        case 0x05: /* SYNC */
+        case 0x0c: /* INV */
+        case 0x0d: /* INVALL */
+            hv_gicv3_update_body(its->g);
+            break;
+        case 0x08: /* MAPD */
+            if (!((dw[2] >> 63) & 1u)) {
+                for (int i = 0; i < HV_ITS_MAX_ITES; i++)
+                    if (its->ite[i].valid && its->ite[i].devid == devid) its->ite[i].valid = 0;
+            }
+            break;
+        case 0x09: { /* MAPC */
+            uint16_t icid = (uint16_t)(dw[2] & 0xffffu);
+            if (icid < HV_ITS_MAX_COLLS && ((dw[2] >> 63) & 1u))
+                its->coll_cpu[icid] = (uint16_t)rdbase_to_cpu(its, (dw[2] >> 16) & 0x7ffffffffULL);
+            break;
+        }
+        case 0x0a: /* MAPTI */
+            its_map_ite(its, devid, eventid, (uint32_t)(dw[1] >> 32), (uint16_t)(dw[2] & 0xffffu));
+            break;
+        case 0x0b: /* MAPI */
+            its_map_ite(its, devid, eventid, eventid, (uint16_t)(dw[2] & 0xffffu));
+            break;
+        case 0x0e: { /* MOVI */
+            uint16_t icid = (uint16_t)(dw[2] & 0xffffu);
+            for (int i = 0; i < HV_ITS_MAX_ITES; i++)
+                if (its->ite[i].valid && its->ite[i].devid == devid && its->ite[i].eventid == eventid)
+                    its->ite[i].icid = icid;
+            hv_gicv3_update_body(its->g);
+            break;
+        }
+        case 0x0f: /* DISCARD */
+            its_clear_ite(its, devid, eventid, 1);
+            break;
+        default:
+            break;
+        }
+    }
+}
+
+static void its_write(void *opaque, uint64_t off, uint64_t val, unsigned size);
+
+/* 读客机 PENDBASER 表里的 LPI pending 位（QEMU 的真值住在这里；影子内部位图是私有模型）。 */
+int hv_gicv3_lpi_guest_pending(HvGic *g, int cpu, int intid)
+{
+    if (!g || cpu < 0 || cpu >= HV_MAX_CPUS) return -1;
+    uint64_t pt = g->cpu[cpu].pendbaser;
+    if (!(pt & (1ull << 62))) return -1;   /* VALID 位 */
+    uint64_t idx = (uint64_t)(intid - HV_GIC_LPI_BASE);
+    uint64_t addr = (pt & 0x000ffffffffff000ull) + idx / 8;
+    uint8_t pend = 0;
+    if (hv_phys_read(g->m, addr, &pend, 1) != 0) return -1;
+    return (pend >> (idx & 7)) & 1;
+}
+
+void hv_gicv3_its_mmio(HvGicIts *its, uint64_t off, uint64_t v, unsigned size)
+{
+    its_write(its, off, v, size);
+}
+
+static uint64_t its_read(void *opaque, uint64_t off, unsigned size) {
+    HvGicIts *its = opaque;
+    if (off >= 0x10000) return 0;
+    pthread_mutex_lock(&its->g->mu);
+    uint64_t v = 0, a8 = off & ~7ull;
+    if (a8 == 0x0000) v = ((uint64_t)0x0000043bu << 32) | its->ctlr; /* CTLR, IIDR */
+    else if (a8 == 0x0008) v = its->typer;
+    else if (a8 == 0x0080) v = its->cbaser;
+    else if (a8 == 0x0088) v = its->cwriter;
+    else if (a8 == 0x0090) v = its->creadr;
+    else if (a8 >= 0x0100 && a8 < 0x0140) v = its->baser[(a8 - 0x0100) / 8];
+    else if (a8 == 0xffe8) v = 0x30ull; /* GITS_PIDR2: ArchRev 3 */
+    pthread_mutex_unlock(&its->g->mu);
+    v >>= (off & 7ull) * 8u;
+    uint64_t ret = size >= 8 ? v : v & ((1ull << (size * 8u)) - 1ull);
+    if (getenv("HV_ITS_LOG"))
+        fprintf(stderr, "its read %04llx (%u) = %llx\n", (unsigned long long)off, size, (unsigned long long)ret);
+    return ret;
+}
+
+static void its_write(void *opaque, uint64_t off, uint64_t val, unsigned size) {
+    HvGicIts *its = opaque;
+    if (getenv("HV_ITS_LOG"))
+        fprintf(stderr, "its write %04llx (%u) = %llx\n", (unsigned long long)off, size, (unsigned long long)val);
+    pthread_mutex_lock(&its->g->mu);
+    if (off == 0x10040) { /* GITS_TRANSLATER direct MMIO fallback */
+        its_deliver_locked(its, 0, (uint32_t)val);
+        pthread_mutex_unlock(&its->g->mu);
+        return;
+    }
+    if (off >= 0x10000) {
+        pthread_mutex_unlock(&its->g->mu);
+        return;
+    }
+    uint64_t a8 = off & ~7ull;
+    if (off < 4) {
+        its->ctlr = ((uint32_t)val & 1u) | (1u << 31);
+        its_process_commands(its);
+    } else if (a8 == 0x0080) {
+        write_slice64(&its->cbaser, off, val, size);
+        its->creadr = 0;
+    } else if (a8 == 0x0088) {
+        write_slice64(&its->cwriter, off, val, size);
+        its->cwriter &= ~0x1full;
+        its_process_commands(its);
+    } else if (a8 >= 0x0100 && a8 < 0x0110) {
+        int idx = (int)((a8 - 0x0100) / 8);
+        const uint64_t ro = (7ull << 56) | (0x1full << 48);
+        uint64_t cur = its->baser[idx];
+        write_slice64(&cur, off, val, size);
+        its->baser[idx] = (its->baser[idx] & ro) | (cur & ~ro);
+    }
+    pthread_mutex_unlock(&its->g->mu);
+}
+
+HvGicIts *hv_gicv3_its_create(HvMachine *m, HvGic *g, uint64_t pa) {
+    HvGicIts *its = calloc(1, sizeof *its);
+    its->m = m;
+    its->g = g;
+    its->ctlr = 1u << 31; /* Quiescent = 1, Enabled = 0 */
+    /* Physical=1, ITT_entry_size=7 (8B), IDbits=15 (16b), Devbits=15 (16b), PTA=0, CIDbits=15 (16b), CIL=1 */
+    its->typer = 1ull | (7ull << 4) | (15ull << 8) | (15ull << 13) | (15ull << 32) | (1ull << 36);
+    its->baser[0] = (1ull << 56) | (7ull << 48); /* Type 1: Devices, EntrySize=8B */
+    its->baser[1] = (4ull << 56) | (7ull << 48); /* Type 4: Interrupt Collections, EntrySize=8B */
+    hv_machine_add_mmio(m, pa, 0x20000, its, its_read, its_write, "gicv3-its");
+    m->mmio[m->nmmio - 1].self_locked = 1;
+    return its;
+}
+
+void hv_gicv3_its_reset(HvGicIts *its) {
+    if (!its) return;
+    pthread_mutex_lock(&its->g->mu);
+    its->ctlr = 1u << 31;
+    its->cbaser = 0;
+    its->cwriter = 0;
+    its->creadr = 0;
+    its->baser[0] = (1ull << 56) | (7ull << 48);
+    its->baser[1] = (4ull << 56) | (7ull << 48);
+    memset(its->coll_cpu, 0, sizeof its->coll_cpu);
+    memset(its->ite, 0, sizeof its->ite);
+    pthread_mutex_unlock(&its->g->mu);
+}
+
+/* ---- 影子期公开包装（只读/镜像用；见文件头豁免条款） ---- */
+void hv_gicv3_dist_mmio(HvGic *g, uint64_t off, uint64_t v, unsigned size) {
+    dist_write_body(g, off, v, size);
+}
+
+void hv_gicv3_redist_mmio(HvGic *g, int cpu, int kind, uint64_t off, uint64_t v, unsigned size) {
+    /* 身份路由：kind=0 RD_base、1 SGI_base；引擎侧布局在此收口，两侧解耦。 */
+    redist_write_body(g, ((uint64_t)cpu << 17) | (kind ? 0x10000u : 0) | (off & 0xffff), v, size);
+}
+
+void hv_gicv3_dump_inputs(HvGic *g, int c, int intid, uint64_t tag)
+{
+    if (!g || c < 0 || c >= HV_MAX_CPUS) return;
+    HvGicCpu *k = &g->cpu[c];
+    int h = hppi_ex(g, c, 1, NULL, NULL);
+    fprintf(stderr, "auth-dump[%llu]: cpu%d id%d size=%zu pend=%d lat=%d is=%d grp=%d "
+            "ig0=%llu ig1=%llu prio=%u pmr=%llu hppi=%d eval=%llu\n",
+            (unsigned long long)tag, c, intid, sizeof(HvGicCpu),
+            k->level[intid], k->latch[intid], k->enabled[intid], k->group[intid],
+            (unsigned long long)k->igrpen0, (unsigned long long)k->igrpen1,
+            k->priority[intid], (unsigned long long)k->pmr, h,
+            (unsigned long long)hv_gicv3_hppi_eval);
+}
+
+int hv_gicv3_hppi(HvGic *g, int c)
+{
+    return hppi_ex(g, c, 1, NULL, NULL);
+}
+
+/* 同 TU 的 hppi 判决读：一次读全 hppi 的输入与输出（权威模式诊断）。 */
+void hv_gicv3_hppi_inputs(HvGic *g, int c, int intid, int *pending, int *isen,
+                          int *grp, int *igrpen0, int *igrpen1, int *prio,
+                          uint64_t *pmr, int *hppi, uint64_t *evals)
+{
+    HvGicCpu *k = &g->cpu[c];
+    pthread_mutex_lock(&g->mu);
+    if (pending) *pending = k->level[intid] || k->latch[intid];
+    if (isen) *isen = k->enabled[intid];
+    if (grp) *grp = k->group[intid];
+    if (igrpen0) *igrpen0 = (int)k->igrpen0;
+    if (igrpen1) *igrpen1 = (int)k->igrpen1;
+    if (prio) *prio = (int)k->priority[intid];
+    if (pmr) *pmr = k->pmr;
+    if (hppi) *hppi = hppi_ex(g, c, 1, NULL, NULL);
+    if (evals) *evals = hv_gicv3_hppi_eval;
+    pthread_mutex_unlock(&g->mu);
+}
+
+uint64_t hv_gicv3_icc_read(HvGic *g, HvCpu *cpu, uint32_t reg) {
+    return icc_read(g->m, cpu, reg);
+}
+
+void hv_gicv3_icc_write(HvGic *g, HvCpu *cpu, uint32_t reg, uint64_t v) {
+    icc_write(g->m, cpu, reg, v);
+}
+
+HvGic *hv_gicv3_create(HvMachine *m, uint64_t dist_pa, uint64_t redist_pa) {
+    HvGic *g = calloc(1, sizeof *g);
+    pthread_mutexattr_t ra;
+    pthread_mutexattr_init(&ra);
+    pthread_mutexattr_settype(&ra, PTHREAD_MUTEX_RECURSIVE);
+    pthread_mutex_init(&g->mu, &ra);
+    g->m = m;
+    for (int c = 0; c < HV_MAX_CPUS; c++) {
+        g->cpu[c].waker = 6; /* ProcessorSleep and ChildrenAsleep until the guest wakes it */
+        for (int i = 0; i < 16; i++) g->cpu[c].edge[i] = 1;
+    }
+    m->gic = g;
+    m->icc_read = icc_read;
+    m->icc_write = icc_write;
+    hv_machine_add_mmio(m, dist_pa, 0x10000, g, dist_read, dist_write, "gicv3-dist");
+    m->mmio[m->nmmio - 1].self_locked = 1;
+    /* One 128 KB frame per CPU; 0xf60000 would cover the UART and virtio-mmio
+       on virt and route their accesses to the redistributor. */
+    hv_machine_add_mmio(m, redist_pa, 0x20000ull * 8, g, redist_read, redist_write, "gicv3-redist");
+    m->mmio[m->nmmio - 1].self_locked = 1;
+    return g;
+}
diff --git a/accel/henge/engine/devices/gicv3.h b/accel/henge/engine/devices/gicv3.h
new file mode 100644
index 0000000000..3cfc4466e9
--- /dev/null
+++ b/accel/henge/engine/devices/gicv3.h
@@ -0,0 +1,79 @@
+#ifndef HENGEVM_GICV3_H
+#define HENGEVM_GICV3_H
+
+#include <pthread.h>
+#include <stdint.h>
+
+#include "machine.h"
+
+/* GICv3 with one security state (DS=1), no LPIs or ITS: the distributor, one
+   redistributor per CPU, and each CPU's ICC_* system registers. INTIDs 0-15
+   are SGIs, 16-31 PPIs (both banked per CPU), 32 and up SPIs. */
+#define HV_GIC_NUM_IRQS (256 + 32) /* vmapple / virt: 256 SPIs */
+#define HV_GIC_LPI_BASE 8192
+#define HV_GIC_MAX_LPIS 4096
+
+typedef struct HvGicIts HvGicIts;
+
+typedef struct HvGicActive {
+    uint16_t intid;
+    uint8_t prio, group;
+} HvGicActive;
+
+/* One CPU's redistributor (its SGIs, PPIs, and LPIs) and CPU interface. */
+typedef struct HvGicCpu {
+    uint8_t group[32], grpmod[32], enabled[32], latch[32], level[32], active[32], priority[32], edge[32];
+    uint32_t gicr_ctlr;          /* bit 0: EnableLPIs */
+    uint32_t waker;
+    uint64_t propbaser;          /* GICR_PROPBASER */
+    uint64_t pendbaser;          /* GICR_PENDBASER */
+    uint64_t lpi_pending[HV_GIC_MAX_LPIS / 64];
+    uint64_t pmr, bpr0, bpr1, icc_ctlr, igrpen0, igrpen1, sre;
+    uint64_t ap0r, ap1r;         /* active priority bits, one per priority level >> 3 */
+    HvGicActive stack[32];       /* acknowledged, not yet priority-dropped */
+    int depth;
+} HvGicCpu;
+
+typedef struct HvGic {
+    HvMachine *m;
+    pthread_mutex_t mu;            /* the GIC's own lock (see gicv3.c) */
+    uint32_t ctlr;                 /* GICD_CTLR */
+    /* SPIs (INTIDs 32 and up; entries below 32 are unused: see HvGicCpu) */
+    uint8_t group[HV_GIC_NUM_IRQS];
+    uint8_t grpmod[HV_GIC_NUM_IRQS];
+    uint8_t enabled[HV_GIC_NUM_IRQS];
+    uint8_t latch[HV_GIC_NUM_IRQS];  /* edge or software pending */
+    uint8_t level[HV_GIC_NUM_IRQS];  /* input line */
+    uint8_t active[HV_GIC_NUM_IRQS];
+    uint8_t priority[HV_GIC_NUM_IRQS];
+    uint8_t edge[HV_GIC_NUM_IRQS];   /* ICFGR: 1 = edge-triggered */
+    uint64_t route[HV_GIC_NUM_IRQS];
+    uint64_t spi_on[(HV_GIC_NUM_IRQS + 63) / 64]; /* SPIs that may be enabled (a superset: hppi checks each) */
+    HvGicCpu cpu[HV_MAX_CPUS];
+} HvGic;
+
+HvGic *hv_gicv3_create(HvMachine *m, uint64_t dist_pa, uint64_t redist_pa);
+/* Optional GICv2m MSI frame (64 KB at pa, e.g. 0x08080000 on virt) for MSI/MSI-X without ITS. */
+void hv_gicv2m_create(HvMachine *m, HvGic *g, uint64_t pa, int spi_base, int num_spi);
+/* GICv3 Interrupt Translation Service (128 KB at pa, e.g. 0x08080000 on virt) for LPI MSI/MSI-X. */
+HvGicIts *hv_gicv3_its_create(HvMachine *m, HvGic *g, uint64_t pa);
+void hv_gicv3_its_msi(HvGicIts *its, uint32_t devid, uint32_t eventid);
+void hv_gicv3_its_mmio(HvGicIts *its, uint64_t off, uint64_t v, unsigned size);
+int hv_gicv3_lpi_guest_pending(HvGic *g, int cpu, int intid);
+void hv_gicv3_its_reset(HvGicIts *its);
+/* Drive an SPI's input line (32+). */
+void hv_gicv3_set_irq(HvGic *g, int intid, int level);
+/* Drive one CPU's PPI (16-31). */
+void hv_gicv3_set_ppi(HvGic *g, int cpu, int intid, int level);
+/* Make an SPI pending, as an MSI write does. */
+void hv_gicv3_pend(HvGic *g, int intid);
+/* Recompute every CPU's IRQ and FIQ inputs (waking any that just got one). */
+void hv_gicv3_update(HvGic *g);
+
+/* 影子期包装（DECRAFTER：只读影子用，见 gicv3.c 头部豁免条款） */
+void hv_gicv3_dist_mmio(HvGic *g, uint64_t off, uint64_t v, unsigned size);
+void hv_gicv3_redist_mmio(HvGic *g, int cpu, int kind, uint64_t off, uint64_t v, unsigned size);
+uint64_t hv_gicv3_icc_read(HvGic *g, HvCpu *cpu, uint32_t reg);
+void hv_gicv3_icc_write(HvGic *g, HvCpu *cpu, uint32_t reg, uint64_t v);
+
+#endif
diff --git a/accel/henge/engine/host/enter_elf.S b/accel/henge/engine/host/enter_elf.S
new file mode 100644
index 0000000000..cd96597ca0
--- /dev/null
+++ b/accel/henge/engine/host/enter_elf.S
@@ -0,0 +1,434 @@
+// Entering and leaving translated code.
+//
+// hv_enter(HvCpu *cpu, void *block) saves the host's callee-saved registers,
+// loads the guest registers, and jumps to the block. Blocks have no prologue:
+// x0 and x1 are already guest values, so a chained block can jump straight in.
+// The block leaves through cpu->exit_routine, which is hv_exit below: by then
+// the block has stored guest x0, x1 and pc into the HvCpu.
+//
+// Host x6, x7 and x15 are free scratch: guest x6, x7 and x15 live in the HvCpu
+// (they are the least used guest registers), so the translator never spills
+// them and hv_exit does not save them.
+//
+// hv_helper_entry is how a block calls C without leaving: the block stores
+// guest x0, x1 and x30, puts a HvHelperInfo pointer in x0 and does `blr` to it.
+// Everything else is saved here, hv_helper(cpu, info) runs on the host stack,
+// and either every guest register is reloaded and the block resumes (it then
+// reloads x0 itself), or the helper asked to leave and we go out through hv_exit.
+
+#define CPU_NZCV 0x108
+#define CPU_V 0x140
+#define CPU_FPCR 0x340
+#define CPU_FPSR 0x348
+#define CPU_HELPER_RET 0x358
+#define CPU_HELPER_FROM 0x510
+#define CPU_SP 0xf8
+#define CPU_HOST_SP 0x410
+#define CPU_PC 0x100
+#define CPU_EXIT 0x110
+#define CPU_EXIT_REQ 0x3c0
+#define CPU_LAST_STUB 0x3c8
+#define CPU_REFILL_RET 0x438
+#define CPU_IJC_SALT 0x3d8
+#define CPU_IJC_TAB 0x440
+#define CPU_MISS_SITE 0x3e8
+#define IJC_BITS 18
+
+    .text
+    .p2align 2
+    .globl hv_enter
+    .globl hv_exit
+    .globl hv_helper_entry
+    .globl hv_helper_thunk
+    .globl hv_chain_thunk
+    .globl hv_ijc_thunk
+    .globl hv_xjump_thunk
+    .globl hv_fp_enter
+    .globl hv_fp_leave
+
+// Not x6, x7, x15: guest x6, x7 and x15 live in the HvCpu, the host registers are scratch.
+.macro SAVE_X2_X29
+    stp x2, x3, [x28, #16]
+    stp x4, x5, [x28, #32]
+    stp x8, x9, [x28, #64]
+    stp x10, x11, [x28, #80]
+    stp x12, x13, [x28, #96]
+    str x14, [x28, #112]
+    stp x16, x17, [x28, #128]
+    stp x19, x20, [x28, #152]
+    stp x21, x22, [x28, #168]
+    stp x23, x24, [x28, #184]
+    stp x25, x26, [x28, #200]
+    str x27, [x28, #216]
+    str x29, [x28, #232]
+.endm
+
+// Uses x0 as a temporary, so x0 must already be saved.
+.macro SAVE_FLAGS_FP
+    mrs x0, nzcv
+    str x0, [x28, #CPU_NZCV]
+    stp q0, q1, [x28, #320]
+    stp q2, q3, [x28, #352]
+    stp q4, q5, [x28, #384]
+    stp q6, q7, [x28, #416]
+    stp q8, q9, [x28, #448]
+    stp q10, q11, [x28, #480]
+    stp q12, q13, [x28, #512]
+    stp q14, q15, [x28, #544]
+    stp q16, q17, [x28, #576]
+    stp q18, q19, [x28, #608]
+    stp q20, q21, [x28, #640]
+    stp q22, q23, [x28, #672]
+    stp q24, q25, [x28, #704]
+    stp q26, q27, [x28, #736]
+    stp q28, q29, [x28, #768]
+    stp q30, q31, [x28, #800]
+.endm
+
+// Uses x0 and x1 as temporaries. FPCR and FPSR are not here: reading or writing
+// them stalls the pipeline, so the guest's values simply stay in the host
+// registers for as long as hv_run runs (see hv_fp_enter/hv_fp_leave).
+.macro LOAD_FLAGS_FP
+    ldp q0, q1, [x28, #320]
+    ldp q2, q3, [x28, #352]
+    ldp q4, q5, [x28, #384]
+    ldp q6, q7, [x28, #416]
+    ldp q8, q9, [x28, #448]
+    ldp q10, q11, [x28, #480]
+    ldp q12, q13, [x28, #512]
+    ldp q14, q15, [x28, #544]
+    ldp q16, q17, [x28, #576]
+    ldp q18, q19, [x28, #608]
+    ldp q20, q21, [x28, #640]
+    ldp q22, q23, [x28, #672]
+    ldp q24, q25, [x28, #704]
+    ldp q26, q27, [x28, #736]
+    ldp q28, q29, [x28, #768]
+    ldp q30, q31, [x28, #800]
+    ldr x0, [x28, #CPU_NZCV]
+    msr nzcv, x0
+.endm
+
+.macro LOAD_X1_X30
+    ldr x1, [x28, #8]
+    ldp x2, x3, [x28, #16]
+    ldp x4, x5, [x28, #32]
+    ldp x8, x9, [x28, #64]
+    ldp x10, x11, [x28, #80]
+    ldp x12, x13, [x28, #96]
+    ldr x14, [x28, #112]
+    ldp x16, x17, [x28, #128]
+    ldp x19, x20, [x28, #152]
+    ldp x21, x22, [x28, #168]
+    ldp x23, x24, [x28, #184]
+    ldp x25, x26, [x28, #200]
+    ldr x27, [x28, #216]
+    ldp x29, x30, [x28, #232]
+.endm
+
+hv_enter:
+    stp x29, x30, [sp, #-176]!
+    stp x19, x20, [sp, #16]
+    stp x21, x22, [sp, #32]
+    stp x23, x24, [sp, #48]
+    stp x25, x26, [sp, #64]
+    stp x27, x28, [sp, #80]
+    stp d8, d9, [sp, #96]
+    stp d10, d11, [sp, #112]
+    stp d12, d13, [sp, #128]
+    stp d14, d15, [sp, #144]
+    str x1, [sp, #160]
+
+    mov x28, x0
+    LOAD_FLAGS_FP
+    LOAD_X1_X30
+    ldr x15, [sp, #160]
+    // From here the SP register holds the guest's SP (a guest address: nothing
+    // may push onto it). The host's is kept in the HvCpu until the block leaves.
+    mov x0, sp
+    str x0, [x28, #CPU_HOST_SP]
+    ldr x0, [x28, #CPU_SP]
+    mov sp, x0
+    ldr x0, [x28, #0]
+    // Another CPU may have just written the block: its writes and cache
+    // invalidation are done, but this core must not run what it fetched before.
+    isb
+    br x15
+
+hv_exit:
+    // x0, x1 and pc are already in the HvCpu. Back to the host's stack first.
+    mov x0, sp
+    str x0, [x28, #CPU_SP]
+    ldr x0, [x28, #CPU_HOST_SP]
+    mov sp, x0
+    SAVE_X2_X29
+    str x30, [x28, #240]
+    SAVE_FLAGS_FP
+Lrestore_host:
+    ldp d14, d15, [sp, #144]
+    ldp d12, d13, [sp, #128]
+    ldp d10, d11, [sp, #112]
+    ldp d8, d9, [sp, #96]
+    ldp x27, x28, [sp, #80]
+    ldp x25, x26, [sp, #64]
+    ldp x23, x24, [sp, #48]
+    ldp x21, x22, [sp, #32]
+    ldp x19, x20, [sp, #16]
+    ldp x29, x30, [sp], #176
+    ret
+
+hv_helper_entry:
+    // Guest x0, x1 and x30 are saved; x0 = HvHelperInfo *, x30 = resume address.
+    str x30, [x28, #CPU_HELPER_RET]
+    str x30, [x28, #CPU_HELPER_FROM]
+    mov x1, x0
+    SAVE_X2_X29
+    // The guest's SP into the HvCpu (C reads and changes it: exceptions, SPSel), the host's stack back.
+    mov x2, sp
+    str x2, [x28, #CPU_SP]
+    ldr x2, [x28, #CPU_HOST_SP]
+    mov sp, x2
+    SAVE_FLAGS_FP
+    mov x0, x28
+    bl hv_helper
+    cbnz w0, Lrestore_host
+    ldr x15, [x28, #CPU_HELPER_RET]
+    ldr x0, [x28, #CPU_HELPER_FROM]
+    eor x15, x15, x0
+    LOAD_FLAGS_FP
+    LOAD_X1_X30
+    ldr x0, [x28, #CPU_SP]
+    mov sp, x0
+    // Back into the block, or (after an SVC or ERET) to the start of the next
+    // one, which wants guest x0 live as well; host x15 is scratch.
+    cbnz x15, 1f
+    ldr x15, [x28, #CPU_HELPER_RET]
+    ldr x0, [x28]
+    ret x15
+1:  ldr x15, [x28, #CPU_HELPER_RET]
+    ldr x0, [x28]
+    isb                           // the next block may be one another CPU just wrote (see hv_enter)
+    ret x15
+
+// Shared tails of translated code, so each call site is a few words (the
+// stub's data follows its blr; blocks reach these through HvCpu, not BL, since
+// the JIT region may be further away than a BL goes).
+//
+// hv_helper_thunk: a helper call. The site did `str x30, [x28, #x30]`, `adr x6, info`
+// and `blr`; x6 is its HvHelperInfo, x30 where the block resumes (`ldr x0, [x28]` there
+// reloads guest x0). Everything that goes back to the block goes by RET, popping what
+// the BLR pushed on the CPU's own stack of return addresses.
+hv_helper_thunk:
+    // A memory access whose op word names refill flags (bits 18..8): try the
+    // light TLB refill (hv_tlb_refill) with x7 = the address before the helper.
+    ldr w15, [x6, #12]
+    ubfx w15, w15, #8, #11
+    cbz w15, 3f
+    str x30, [x28, #CPU_REFILL_RET]
+    str x6, [x28, #0x130]         // spill[3]: free in a slow path, its registers are back
+    stp x0, x1, [x28, #0]
+    stp x2, x3, [x28, #16]
+    stp x4, x5, [x28, #32]
+    stp x8, x9, [x28, #64]
+    stp x10, x11, [x28, #80]
+    stp x12, x13, [x28, #96]
+    str x14, [x28, #112]
+    stp x16, x17, [x28, #128]
+    mov w2, w15
+    mrs x15, nzcv
+    str x15, [x28, #CPU_NZCV]
+    mov x15, sp
+    str x15, [x28, #CPU_SP]
+    ldr x15, [x28, #CPU_HOST_SP]
+    mov sp, x15
+    mov x0, x28
+    mov x1, x7
+    bl hv_tlb_refill
+    mov x7, x0
+    ldr x0, [x28, #CPU_SP]
+    mov sp, x0
+    ldr x0, [x28, #CPU_NZCV]
+    msr nzcv, x0
+    ldp x0, x1, [x28, #0]
+    ldp x2, x3, [x28, #16]
+    ldp x4, x5, [x28, #32]
+    ldp x8, x9, [x28, #64]
+    ldp x10, x11, [x28, #80]
+    ldp x12, x13, [x28, #96]
+    ldr x14, [x28, #112]
+    ldp x16, x17, [x28, #128]
+    ldr x30, [x28, #CPU_REFILL_RET]
+    ldr x6, [x28, #0x130]
+    cbnz x7, 3f
+    // Filled: back to the start of the access, (op >> 19) words before where the helper would resume.
+    ldr w15, [x6, #12]
+    lsr w15, w15, #19
+    sub x6, x30, x15, lsl #2
+    ldr x30, [x28, #240]
+    ret x6
+3:  stp x0, x1, [x28]
+    mov x0, x6
+    b hv_helper_entry
+
+// hv_chain_thunk: a chainable exit's slow side. The site did `str x30, [x28, #x30]`
+// and `blr`; x30 points at {slot address, target VA}. Follows the slot when
+// chained beyond the stub's B (out of range), else leaves for the dispatcher,
+// naming the slot (last_stub) unless an exit was asked for.
+hv_chain_thunk:
+    mov x7, x30
+    ldr x30, [x28, #240]
+    ldr w15, [x28, #CPU_EXIT_REQ]
+    cbnz w15, 1f
+    ldr x6, [x7]
+    ldr x15, [x6]
+    cbz x15, 2f
+    ret x15
+2:  str x6, [x28, #CPU_LAST_STUB]
+1:  stp x0, x1, [x28]
+    ldr x0, [x7, #8]
+    str x0, [x28, #CPU_PC]
+    ldr x1, [x28, #CPU_EXIT]
+    br x1
+
+// hv_ijc_thunk: an indirect-branch cache miss, before the dispatcher. x7 = the
+// target VA, x30 = the site's flags word (guest x30 already saved). Jumps to
+// the target block if hv_ijc_resolve found it; else returns after the word,
+// with x7 still the VA. Saves only what C may clobber, as the refill does.
+hv_ijc_thunk:
+    str x30, [x28, #CPU_REFILL_RET]
+    stp x0, x1, [x28, #0]
+    stp x2, x3, [x28, #16]
+    stp x4, x5, [x28, #32]
+    stp x8, x9, [x28, #64]
+    stp x10, x11, [x28, #80]
+    stp x12, x13, [x28, #96]
+    str x14, [x28, #112]
+    stp x16, x17, [x28, #128]
+    str x7, [x28, #0x130]   // spill[3]: free at a block's end, where these lookups are
+    mrs x15, nzcv
+    str x15, [x28, #CPU_NZCV]
+    mov x15, sp
+    str x15, [x28, #CPU_SP]
+    ldr x15, [x28, #CPU_HOST_SP]
+    mov sp, x15
+    mov x0, x28
+    mov x1, x7
+    ldr w2, [x30]
+    bl hv_ijc_resolve
+    mov x6, x0
+    ldr x0, [x28, #CPU_SP]
+    mov sp, x0
+    ldr x0, [x28, #CPU_NZCV]
+    msr nzcv, x0
+    ldp x0, x1, [x28, #0]
+    ldp x2, x3, [x28, #16]
+    ldp x4, x5, [x28, #32]
+    ldp x8, x9, [x28, #64]
+    ldp x10, x11, [x28, #80]
+    ldp x12, x13, [x28, #96]
+    ldr x14, [x28, #112]
+    ldp x16, x17, [x28, #128]
+    ldr x7, [x28, #0x130]
+    ldr x30, [x28, #240]
+    cbz x6, 1f
+    isb                           // a block found in the hash may be one another CPU just wrote
+    ret x6
+1:  ldr x15, [x28, #CPU_REFILL_RET]
+    add x15, x15, #4
+    ret x15
+
+// hv_xjump_thunk: a direct branch to another page that is not chained, looked
+// up in the indirect-branch cache here instead of in the block (one copy of the
+// lookup for all of them). x7 = the site's data: .word flags (bit 31: check
+// exit_req first), .word 0, .quad the target VA. x30 is still the guest's. A
+// cache miss tries hv_ijc_resolve, then leaves for the dispatcher.
+hv_xjump_thunk:
+    ldr w15, [x7]
+    tbz w15, #31, 2f
+    ldr w6, [x28, #CPU_EXIT_REQ]
+    cbnz w6, 3f
+2:  str x7, [x28, #CPU_REFILL_RET]
+    and x6, x15, #1
+    add x6, x28, x6, lsl #3
+    ldr x6, [x6, #CPU_IJC_SALT]
+    and x15, x15, #15
+    add x15, x28, x15, lsl #3
+    ldr x15, [x15, #CPU_IJC_TAB]  // this flags value's table
+    ldr x7, [x7, #8]
+    eor x7, x7, x6                // the tag
+    eor x6, x7, x7, lsr #16
+    eor x6, x6, x7, lsr #46
+    ubfx x6, x6, #2, #(IJC_BITS - 1)
+    add x6, x15, x6, lsl #5       // the set: two entries
+    ldr x15, [x6]
+    eor x15, x15, x7
+    cbnz x15, 6f
+    ldr x6, [x6, #8]
+    br x6
+6:  ldr x15, [x6, #16]
+    eor x15, x15, x7
+    cbnz x15, 1f
+    ldr x6, [x6, #24]
+    br x6
+1:  // a miss: as hv_ijc_thunk, then leave if the block is not made yet
+    ldr x7, [x28, #CPU_REFILL_RET]
+    str x30, [x28, #240]
+    stp x0, x1, [x28, #0]
+    stp x2, x3, [x28, #16]
+    stp x4, x5, [x28, #32]
+    stp x8, x9, [x28, #64]
+    stp x10, x11, [x28, #80]
+    stp x12, x13, [x28, #96]
+    str x14, [x28, #112]
+    stp x16, x17, [x28, #128]
+    mrs x15, nzcv
+    str x15, [x28, #CPU_NZCV]
+    mov x15, sp
+    str x15, [x28, #CPU_SP]
+    ldr x15, [x28, #CPU_HOST_SP]
+    mov sp, x15
+    mov x0, x28
+    ldr x1, [x7, #8]
+    ldr w2, [x7]
+    and w2, w2, #0x7fffffff
+    bl hv_ijc_resolve
+    mov x6, x0
+    ldr x0, [x28, #CPU_SP]
+    mov sp, x0
+    ldr x0, [x28, #CPU_NZCV]
+    msr nzcv, x0
+    ldp x0, x1, [x28, #0]
+    ldp x2, x3, [x28, #16]
+    ldp x4, x5, [x28, #32]
+    ldp x8, x9, [x28, #64]
+    ldp x10, x11, [x28, #80]
+    ldp x12, x13, [x28, #96]
+    ldr x14, [x28, #112]
+    ldp x16, x17, [x28, #128]
+    ldr x30, [x28, #240]
+    ldr x7, [x28, #CPU_REFILL_RET]
+    cbz x6, 3f
+    isb                           // as in hv_ijc_thunk
+    br x6
+3:  stp x0, x1, [x28]             // leave with pc = the target (and the guest's x30: hv_exit saves it)
+    ldr x0, [x7, #8]
+    str x0, [x28, #CPU_PC]
+    str xzr, [x28, #CPU_MISS_SITE]
+    ldr x1, [x28, #CPU_EXIT]
+    br x1
+
+// hv_fp_enter(cpu): the guest's FPCR and FPSR into the host registers.
+hv_fp_enter:
+    ldr x1, [x0, #CPU_FPCR]
+    msr fpcr, x1
+    ldr x1, [x0, #CPU_FPSR]
+    msr fpsr, x1
+    ret
+
+// hv_fp_leave(cpu): and back into the HvCpu.
+hv_fp_leave:
+    mrs x1, fpcr
+    str x1, [x0, #CPU_FPCR]
+    mrs x1, fpsr
+    str x1, [x0, #CPU_FPSR]
+    ret
diff --git a/accel/henge/engine/host/jit_region.h b/accel/henge/engine/host/jit_region.h
new file mode 100644
index 0000000000..5158dc6d40
--- /dev/null
+++ b/accel/henge/engine/host/jit_region.h
@@ -0,0 +1,39 @@
+#ifndef HENGEVM_JIT_REGION_H
+#define HENGEVM_JIT_REGION_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+/* One executable region for translated blocks. Blocks are appended and never
+   freed one by one; the whole region is reset when it fills.
+
+   Two shapes. macOS: one MAP_JIT mapping, made writable per thread while code
+   is copied in (rw_diff is 0). iOS: an executable mapping a debugger granted
+   (StikDebug or the built-in helper) plus a writable alias of the same pages
+   made with vm_remap; code is written through base + rw_diff and runs at base.
+   Everything outside this file and the final copy in the translator sees only
+   the executable addresses. HV_JIT_SPLIT=1 makes the macOS build use the iOS
+   shape, to test it. */
+typedef struct HvJitRegion {
+    uint32_t *base;     /* executable addresses */
+    intptr_t rw_diff;   /* writable alias = base + rw_diff (bytes), or 0 */
+    size_t capacity;    /* in instructions */
+    size_t used;        /* in instructions */
+    size_t limit;       /* in instructions; 0: all of it (HV_JIT_CAP: a smaller cache in the same region, to compare) */
+    int owned;          /* mapped here (closed here) rather than handed in */
+} HvJitRegion;
+
+int hv_jit_region_open(HvJitRegion *region, size_t bytes);
+/* Use memory the host already has: rx executable, rw a writable alias of it (or rx itself on macOS MAP_JIT). */
+int hv_jit_region_attach(HvJitRegion *region, void *rx, void *rw, size_t bytes);
+void hv_jit_region_close(HvJitRegion *region);
+
+/* Copy `words` instructions to start (an executable address) and make them runnable. */
+void hv_jit_write(HvJitRegion *region, uint32_t *start, const void *src, size_t bytes);
+void hv_jit_finish(HvJitRegion *region, uint32_t *start, size_t words);
+
+/* Space for `words` instructions, or NULL when the region is full. */
+uint32_t *hv_jit_reserve(HvJitRegion *region, size_t words);
+void hv_jit_reset(HvJitRegion *region);
+
+#endif
diff --git a/accel/henge/engine/host/jit_region_linux.c b/accel/henge/engine/host/jit_region_linux.c
new file mode 100644
index 0000000000..091a7bfc98
--- /dev/null
+++ b/accel/henge/engine/host/jit_region_linux.c
@@ -0,0 +1,139 @@
+/* Linux/Android 上的可写可执行代码区。
+   原版在 iOS 上要靠调试器给 RX 页、再用 vm_remap 做 RW 别名；这里是普通
+   Linux，直接 mmap 一份 RWX 就够。若内核或 SELinux 拒绝 RWX（某些机型会），
+   退回 memfd + 双映射：同一份物理页，一个 RW 别名、一个 RX 别名，
+   就是对 iOS 那个 split 形状的原样再现。 */
+#include "jit_region.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/auxv.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#ifndef MAP_ANONYMOUS
+#define MAP_ANONYMOUS MAP_ANON
+#endif
+
+static int open_rwx(HvJitRegion *region, size_t bytes) {
+    void *p = mmap(NULL, bytes, PROT_READ | PROT_WRITE | PROT_EXEC,
+                   MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (p == MAP_FAILED) return -1;
+    region->base = p;
+    region->rw_diff = 0; /* 同一份映射：写和跑是同一个地址 */
+    region->capacity = bytes / sizeof(uint32_t);
+    region->used = 0;
+    region->limit = 0;
+    region->owned = 1;
+    return 0;
+}
+
+static int open_split_memfd(HvJitRegion *region, size_t bytes) {
+    int fd = memfd_create("hv-jit", MFD_CLOEXEC);
+    if (fd < 0) return -1;
+    if (ftruncate(fd, (off_t)bytes) != 0) { close(fd); return -1; }
+    void *rx = mmap(NULL, bytes, PROT_READ | PROT_EXEC, MAP_SHARED, fd, 0);
+    void *rw = mmap(NULL, bytes, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+    close(fd);
+    if (rx == MAP_FAILED || rw == MAP_FAILED) {
+        if (rx != MAP_FAILED) munmap(rx, bytes);
+        if (rw != MAP_FAILED) munmap(rw, bytes);
+        return -1;
+    }
+    if (hv_jit_region_attach(region, rx, rw, bytes) != 0) return -1;
+    region->owned = 1;
+    return 0;
+}
+
+int hv_jit_region_open(HvJitRegion *region, size_t bytes) {
+    memset(region, 0, sizeof *region);
+    if (bytes < 4096) bytes = 4096;
+    bytes = (bytes + 4095) & ~(size_t)4095;
+    if (getenv("HV_JIT_SPLIT")) return open_split_memfd(region, bytes);
+    if (open_rwx(region, bytes) == 0) return 0;
+    return open_split_memfd(region, bytes);
+}
+
+int hv_jit_region_attach(HvJitRegion *region, void *rx, void *rw, size_t bytes) {
+    memset(region, 0, sizeof *region);
+    if (!rx || !rw || bytes < 4096) return -1;
+    region->base = rx;
+    region->rw_diff = (intptr_t)((uint8_t *)rw - (uint8_t *)rx);
+    region->capacity = bytes / sizeof(uint32_t);
+    return 0;
+}
+
+void hv_jit_region_close(HvJitRegion *region) {
+    if (region->owned && region->base) {
+        size_t bytes = region->capacity * sizeof(uint32_t);
+        if (region->rw_diff) munmap((uint8_t *)region->base + region->rw_diff, bytes);
+        munmap(region->base, bytes);
+    }
+    memset(region, 0, sizeof *region);
+}
+
+void hv_jit_write(HvJitRegion *region, uint32_t *start, const void *src, size_t bytes) {
+    /* 4 字节要原子：另一个 CPU 可能正在执行这条分支，取到半新半旧就是跳进虚空。 */
+    if (bytes == 4) {
+        uint32_t word;
+        memcpy(&word, src, 4);
+        __atomic_store_n((uint32_t *)((uint8_t *)start + region->rw_diff), word, __ATOMIC_RELEASE);
+        return;
+    }
+    memcpy((uint8_t *)start + region->rw_diff, src, bytes);
+}
+
+/* ---- 宿主没有 SB 时，把 SB 改写成 DSB NSH ----
+ *
+ * core/sysreg.c 把 ID_AA64ISAR1_EL1 固定成 0x0000001100211001，最低 4 位（SB 字段）
+ * 是 1，等于告诉 guest "这台机器有 ARMv8.5 的 SB 指令"。原项目跑在 Apple Silicon
+ * （ARMv8.5+，真有 SB）上，所以没问题。
+ *
+ * Linux 会照这个声明做 alternatives：arch/arm64/include/asm/barrier.h
+ *     #define spec_bar() ALTERNATIVE("dsb nsh; isb", SB_BARRIER_INSN"nop", ARM64_HAS_SB)
+ * 启动时把 KPTI trampoline（__bp_harden_el1_vectors）里的 dsb nsh 就地补丁成 sb。
+ * 这台机器是 Cortex-A76（ARMv8.2），执行 sb 直接 SIGILL —— 实测崩在
+ * guest_pc 0xffff800080012c14 之后，宿主指令 0xd50330ff。
+ *
+ * 改写成 dsb nsh 与 Linux 自己在 HAS_SB 为假时生成的序列完全一致，语义只会更强。
+ * 宿主真有 SB 时（getauxval 的 HWCAP_SB）一次都不用改。 */
+#define HV_A64_SB      0xd50330ffu  /* sb                (ARMv8.5) */
+#define HV_A64_DSB_NSH 0xd503379fu  /* dsb nsh           (ARMv8.0) */
+#define HV_HWCAP_SB    (1ul << 29)
+
+static int host_has_sb(void) {
+    static int cached = -1;
+    if (cached < 0) cached = (getauxval(AT_HWCAP) & HV_HWCAP_SB) != 0;
+    return cached;
+}
+
+static size_t rewrite_unsupported(uint32_t *rw, size_t words) {
+    size_t n = 0;
+    for (size_t i = 0; i < words; i++)
+        if (rw[i] == HV_A64_SB) rw[i] = HV_A64_DSB_NSH, n++;
+    return n;
+}
+
+void hv_jit_finish(HvJitRegion *region, uint32_t *start, size_t words) {
+    if (!start || !words) return;
+    if (!host_has_sb()) rewrite_unsupported((uint32_t *)((uint8_t *)start + region->rw_diff), words);
+    /* 写的是别名、跑的是主映射：两边的 VA 都做一次维护，PIPT D-cache 下
+       清一次物理行就够，但多做一次只花几十纳秒，不值得去赌。 */
+    __builtin___clear_cache((char *)start, (char *)start + words * 4);
+    if (region->rw_diff) {
+        char *rw = (char *)start + region->rw_diff;
+        __builtin___clear_cache(rw, rw + words * 4);
+    }
+}
+
+uint32_t *hv_jit_reserve(HvJitRegion *region, size_t words) {
+    words = (words + 1) & ~(size_t)1;
+    size_t at = __atomic_fetch_add(&region->used, words, __ATOMIC_RELAXED);
+    size_t cap = region->limit && region->limit < region->capacity ? region->limit : region->capacity;
+    if (at + words > cap) return NULL;
+    return region->base + at;
+}
+
+void hv_jit_reset(HvJitRegion *region) { region->used = 0; }
diff --git a/accel/henge/engine/local-edits.patch b/accel/henge/engine/local-edits.patch
new file mode 100644
index 0000000000..0ee529ab9a
--- /dev/null
+++ b/accel/henge/engine/local-edits.patch
@@ -0,0 +1,784 @@
+--- a/core/cpu.h	2026-11-17 18:12:23.408882608 +0800
++++ b/core/cpu.h	2026-11-17 18:12:23.416205048 +0800
+@@ -274,6 +274,11 @@
+     HV_EXIT_HALT,        /* PSCI off, or a test asked to stop */
+     HV_EXIT_FLUSH,       /* translated code was invalidated (IC, self-modifying code) */
+     HV_EXIT_FAULT_LOOP,  /* fetching the exception vector itself faulted: the guest is dead */
++    /* The two seams a hosted build adds (see the flags in machine.h). Appended
++       rather than inserted: the values are part of the host contract, and
++       renumbering would silently turn "unknown sysreg" into "branched". */
++    HV_EXIT_SYSREG_EXT,  /* an MRS/MSR the engine does not model, handed to the host */
++    HV_EXIT_PSCI_EXT,    /* SMC/HVC handed to the host's PSCI conduit */
+ };
+ 
+ /* PSTATE bits as laid out in SPSR. */
+--- a/core/dispatch.c	2026-11-17 18:12:23.409343624 +0800
++++ b/core/dispatch.c	2026-11-17 18:12:23.414894304 +0800
+@@ -17,10 +17,28 @@
+ 
+ void hv_flush_blocks(HvMachine *m) {
+     /* Every other CPU is parked (stop_the_world): the one moment the TLB layout can change. */
+-    if ((hv_knob[HV_K_TLBT] != 0) != hv_tlb_tmajor) {
++    if ((hv_knob[HV_K_TLBT] != 0) != hv_tlb_tmajor || m->need_tlb_flush) {
+         hv_tlb_tmajor = hv_knob[HV_K_TLBT] != 0;
++        /* A host RAM change also invalidates the entries themselves, not just
++         * their layout: each holds an addend into memory the guest may no
++         * longer read directly (romd turned off) or that is gone.  Ordered
++         * before the flag is cleared so a later request cannot be swallowed. */
++        m->need_tlb_flush = 0;
+         for (int i = 0; i < m->ncpus; i++)
+             if (m->cpus[i]) hv_tlb_flush(m->cpus[i]);
++        if (m->dbg_flush && m->flush_req_ns) {
++            uint64_t d = mach_absolute_time() - m->flush_req_ns;
++            m->flush_sum_ns += d;
++            if (d > m->flush_max_ns) m->flush_max_ns = d;
++            m->flush_req_ns = 0;
++            /* 24 MHz on Darwin, and the same unit on the Linux port: report
++               both the raw delta and microseconds so the number is checkable. */
++            fprintf(stderr, "henge: deferred flush took %llu ticks (~%llu us), "
++                    "max %llu us over %llu requests\n",
++                    (unsigned long long)d, (unsigned long long)(d / 24),
++                    (unsigned long long)(m->flush_max_ns / 24),
++                    (unsigned long long)m->flush_reqs);
++        }
+     }
+     m->stats.block_flushes++;
+     __atomic_add_fetch(&m->jit_gen, 1, __ATOMIC_SEQ_CST);
+@@ -123,7 +141,43 @@
+     uint32_t j = (uint32_t)((va >> 2) ^ (va >> 18) ^ ((uint64_t)flags << 13)) & ((1u << HV_JC_BITS) - 1);
+     __typeof__(cpu->pc_state->jc[0]) *jc = cpu->pc_state->jc;
+     HvBlock *c = jc[j].va == va ? jc[j].b : NULL;
+-    if (c && c->pa == pa && c->flags == flags && c->ram->page_gen[c->pg] == c->gen) return c;
++    /*
++     * Two tests read the same invariant -- "the window this block was
++     * translated from is still the window at this pa" -- and both must come
++     * before page_gen[] is dereferenced, because in a retired slot that array
++     * is NULL.
++     *
++     *   c->ram->size != 0        structural: del_ram() zeroes size
++     *   ram_epoch == ram->epoch  the counter add_ram() and del_ram() bump
