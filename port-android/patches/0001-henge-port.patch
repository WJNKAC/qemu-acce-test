++    case R(3, 3, 14, 0, 1): case R(3, 3, 14, 0, 5): *v = guest_ticks(cpu); return 0;
++    case R(3, 3, 14, 0, 2): case R(3, 3, 14, 0, 6): *v = guest_ticks(cpu) - cpu->cntvoff; return 0;
