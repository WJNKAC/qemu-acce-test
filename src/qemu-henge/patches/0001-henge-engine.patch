+         */
+        fprintf(stderr, "  slots: ram_reuse %llu, retired_hit %llu, epoch_stale %llu, epoch_high_water %llu\n",
+                (unsigned long long)m->stats.ram_reuse,
+                (unsigned long long)m->stats.retired_hit,
+                (unsigned long long)m->stats.epoch_stale,
+                (unsigned long long)m->stats.epoch_high_water);
+        fprintf(stderr, "  fast resume refused/s: state %.0f, exit request %.0f, interrupt %.0f, timer %.0f, not cached %.0f\n", RATE(fr_fail[0]),
+                RATE(fr_fail[1]), RATE(fr_fail[2]), RATE(fr_fail[3]), RATE(fr_fail[4]));
+        fprintf(stderr, "  WFE waits in place %.0f/s; exits chained as placed %.0f/s; SVC/ERET resumed in place %.0f/s\n", RATE(wfe_waits),
+                RATE(chained_early), RATE(fast_resumes));
+        fprintf(stderr, "  exit requests/s: TLBI posts %.0f, wakes %.0f (of them device work %.0f), kick all %.0f, own %.0f\n",
+                RATE(kick_src[0]), RATE(kick_src[1]), RATE(kick_src[3]), RATE(kick_src[2]), RATE(kick_src[4]));
+        fprintf(stderr, "  light refills %.0fK/s, light branch-cache fills %.0fK/s, chained to other pages %.0f/s\n", RATE(refills) / 1e3,
+                RATE(ijc_light) / 1e3, RATE(xchained));
+        fprintf(stderr, "  process switches: %.0f/s saved, %.0f/s restored (%.0f entries each)\n", RATE(stash_saves), RATE(stash_hits),
+                s->stash_hits - last.stash_hits ? (double)(s->stash_entries - last.stash_entries) / (s->stash_hits - last.stash_hits) : 0.0);
+        fprintf(stderr, "  tlb misses K/s: el0 empty %.0f el0 conflict %.0f el1 empty %.0f el1 conflict %.0f\n",
+                RATE(tlb_miss_kind[0]) / 1e3, RATE(tlb_miss_kind[1]) / 1e3, RATE(tlb_miss_kind[2]) / 1e3, RATE(tlb_miss_kind[3]) / 1e3);
+        fprintf(stderr, "  slow mem causes K/s: mmio %.0f code-page write %.0f page end %.0f tlb miss %.0f other %.0f entry-but-tag %.0f\n",
+                RATE(slow_why[0]) / 1e3, RATE(slow_why[1]) / 1e3, RATE(slow_why[2]) / 1e3, RATE(slow_why[3]) / 1e3,
+                RATE(slow_why[4]) / 1e3, RATE(slow_why[5]) / 1e3);
+        fprintf(stderr, "  slow mem K/s: single %.0f pair %.0f literal %.0f ldra %.0f ordered %.0f excl %.0f cas %.0f casp %.0f atomic %.0f vec %.0f/%.0f\n",
+                RATE(slow_kind[0]) / 1e3, RATE(slow_kind[1]) / 1e3, RATE(slow_kind[2]) / 1e3, RATE(slow_kind[3]) / 1e3,
+                RATE(slow_kind[4]) / 1e3, RATE(slow_kind[5]) / 1e3, RATE(slow_kind[6]) / 1e3, RATE(slow_kind[7]) / 1e3,
+                RATE(slow_kind[8]) / 1e3, RATE(slow_kind[9]) / 1e3, RATE(slow_kind[10]) / 1e3);
+        fprintf(stderr, "  ijc fills into: empty %.0fK/s, live other salt %.0fK/s, dead salt %.0fK/s, same salt %.0fK/s\n",
+                RATE(fill_kind[0]) / 1e3, RATE(fill_kind[1]) / 1e3, RATE(fill_kind[3]) / 1e3, RATE(fill_kind[2]) / 1e3);
+        fprintf(stderr, "  light fills into: empty %.0fK/s, live other salt %.0fK/s, dead salt %.0fK/s, same salt %.0fK/s\n",
+                RATE(light_kind[0]) / 1e3, RATE(light_kind[1]) / 1e3, RATE(light_kind[3]) / 1e3, RATE(light_kind[2]) / 1e3);
+        fprintf(stderr, "  misses at: RET %.0fK/s, BR/BLR %.0fK/s, B/BL %.0fK/s, conditional %.0fK/s, MSR %.0fK/s, other %.0fK/s, unknown %.0fK/s\n",
+                RATE(miss_kind[0]) / 1e3, RATE(miss_kind[1]) / 1e3, RATE(miss_kind[2]) / 1e3, RATE(miss_kind[3]) / 1e3,
+                RATE(miss_kind[4]) / 1e3, RATE(miss_kind[5]) / 1e3, RATE(miss_kind[6]) / 1e3);
+        fprintf(stderr, "  entries %.2fM/s: chain fill %.0f%%, kick %.0f%%, exception/sysreg %.0f%%, interrupt %.0f%%, cached target %.0f%%, cache miss %.0f%%\n",
+                tot / 1e6, 100 * RATE(why[0]) / tot, 100 * RATE(why[1]) / tot, 100 * RATE(why[2]) / tot,
+                100 * RATE(why[3]) / tot, 100 * RATE(why[4]) / tot, 100 * RATE(why[5]) / tot);
+    }
+#undef RATE
+    if (m->prof) print_profile(m);
+    /* The five busiest system registers or SYS operations (reads + writes) this interval. */
+    for (int k = 0; k < 14; k++) {
+        uint64_t best = 0;
+        uint32_t bi = 0;
+        for (uint32_t r = 0; r < 65536; r++) {
+            uint64_t n = (reg_hist[r] & 0xffffffff) + (reg_hist[r] >> 32);
+            if (n > best) best = n, bi = r;
+        }
+        if (!best) break;
+        fprintf(stderr, "   S%u_%u_C%u_C%u_%u: %.0f reads %.0f writes/sys per s\n", bi >> 14, (bi >> 11) & 7, (bi >> 7) & 15,
+                (bi >> 3) & 15, bi & 7, (double)(reg_hist[bi] & 0xffffffff) / dt, (double)(reg_hist[bi] >> 32) / dt);
+        reg_hist[bi] = 0;
+    }
+    memset(reg_hist, 0, sizeof reg_hist);
+    last = *s;
+    last_t = now;
+    hv_fp_enter(cpu);
+}
+
+/* Fill the slot of the chainable exit a block just left through, so it jumps
+   straight to b next time. Chains never need undoing: both blocks are in the
+   same 16 KB page, so when that page's code is invalidated the stale blocks are
+   only reachable from each other, and the exit_req check before every chained
+   jump gets a block that just wrote its own page back to the dispatcher. */
+static void chain(HvMachine *m, uint64_t *slot, HvBlock *b) {
+    uint32_t idx = (uint32_t)(slot - m->slots);
+    if (m->gen_checks && (b->jit_gen != m->jit_gen || (m->slot_site[idx] && (uint64_t)(m->slot_site[idx] - m->jit.base) >= m->jit.used)))
+        fprintf(stderr, "hengevm: chain slot %u site %p to rx+%llx va %llx: block gen %u now %u\n", idx, (void *)m->slot_site[idx], (unsigned long long)(b->code - m->jit.base) * 4, (unsigned long long)b->va, b->jit_gen, m->jit_gen);
+    uint64_t xa = m->slot_xa[idx];
+    if (xa) {
+        /* From another page: only to the block in the physical page the exit's
+           check names, and not a stale one (see hv_invalidate_code). */
+        uint64_t page_pa = b->pa & ~((1ull << HV_TLB_PAGE_BITS) - 1);
+        uint64_t host = (uint64_t)(uintptr_t)(b->ram->host + (page_pa - b->ram->pa));
+        if (host - (b->va & ~((1ull << HV_TLB_PAGE_BITS) - 1)) != xa) return;
+        pthread_mutex_lock(&m->tr_mu);
+        if (b->ram->size == 0 ||
+            b->ram_epoch != b->ram->epoch ||
+            __atomic_load_n(&b->ram->page_gen[b->pg], __ATOMIC_ACQUIRE) != b->gen ||
+            m->slot_xpa[idx]) {
+            /* Same invariant as the fast path, and it matters more here: a
+               chained exit jumps straight to b->code with no lookup in
+               between, so a stale target is a jump into code translated
+               against host memory the guest no longer owns. */
+            if (b->ram_epoch != b->ram->epoch) {
+                m->stats.epoch_stale++;
+                if (b->ram->epoch - b->ram_epoch > m->stats.epoch_high_water)
+                    m->stats.epoch_high_water = b->ram->epoch - b->ram_epoch;
+            }
+            pthread_mutex_unlock(&m->tr_mu);
+            return;
+        }
+        m->slot_xpa[idx] = page_pa | 1;
+        m->xchained[m->nxchained++] = idx;
+        __atomic_store_n(slot, (uint64_t)(uintptr_t)b->code, __ATOMIC_RELEASE);
+        uint32_t *site = m->slot_site[idx];
+        int64_t off = site ? b->code - site : 0;
+        if (site && off >= -(1 << 25) && off < (1 << 25)) {
+            uint32_t insn = 0x14000000u | (uint32_t)(off & 0x3ffffff);
+            hv_jit_write(&m->jit, site, &insn, 4);
+            hv_jit_finish(&m->jit, site, 1);
+        }
+        m->stats.chained++;
+        if (m->stats_interval) m->stats.xchained++;
+        pthread_mutex_unlock(&m->tr_mu);
+        return;
+    }
+    __atomic_store_n(slot, (uint64_t)(uintptr_t)b->code, __ATOMIC_RELEASE);
+    /* And the stub's B, when the target is in its range: a direct branch, no load. */
+    uint32_t *site = m->slot_site[slot - m->slots];
+    int64_t off = site ? b->code - site : 0;
+    if (site && off >= -(1 << 25) && off < (1 << 25)) {
+        uint32_t insn = 0x14000000u | (uint32_t)(off & 0x3ffffff);
+        hv_jit_write(&m->jit, site, &insn, 4);
+        hv_jit_finish(&m->jit, site, 1);
+    }
+    uint32_t *cond = m->slot_cond[idx];
+    if (cond) { /* the conditional branch to that stub, too */
+        uint32_t insn = *cond;
+        if (hv_branch_retarget(&insn, b->code - cond)) {
+            hv_jit_write(&m->jit, cond, &insn, 4);
+            hv_jit_finish(&m->jit, cond, 1);
+        }
+    }
+    m->stats.chained++;
+}
+
+static int run_loop(HvCpu *cpu, int one);
+
+static int run(HvCpu *cpu, int one) {
+    int r = run_loop(cpu, one);
+    park(cpu);
+    hv_self = NULL;
+    return r;
+}
+
+/* A powered-off CPU waits here, without the big lock, for PSCI CPU_ON. */
+static void wait_while_off(HvCpu *cpu) {
+    HvMachine *m = cpu->m;
+    HvPerCpu *p = cpu->pc_state;
+    hv_big_unlock(m);
+    park(cpu);
+    pthread_mutex_lock(&p->wake_mu);
+    __atomic_store_n(&cpu->parked_off, 1, __ATOMIC_SEQ_CST);
+    while (__atomic_load_n(&cpu->off, __ATOMIC_ACQUIRE) && !cpu->halted) {
+        p->wake_pending = 0;
+        pthread_cond_wait(&p->wake_cv, &p->wake_mu);
+    }
+    __atomic_store_n(&cpu->parked_off, 0, __ATOMIC_SEQ_CST);
+    pthread_mutex_unlock(&p->wake_mu);
+    unpark(cpu);
+    hv_big_lock(m);
+}
+
+/* Dropping every translation: the CPU that finds a flush pending waits until
+   all the others have parked (at this barrier, asleep or off), flushes, and
+   lets them go. Nobody holds a lock while waiting here. */
+static void stop_the_world(HvCpu *cpu) {
+    HvMachine *m = cpu->m;
+    pthread_mutex_lock(&m->stw_mu);
+    if (__atomic_load_n(&m->flush_pending, __ATOMIC_SEQ_CST) && !m->stw_active) {
+        __atomic_store_n(&m->stw_active, 1, __ATOMIC_SEQ_CST);
+        __atomic_store_n(&m->flush_pending, 0, __ATOMIC_SEQ_CST);
+        pthread_mutex_unlock(&m->stw_mu);
+        hv_machine_kick_all(m);
+        for (uint32_t spins = 0;; spins++) {
+            int busy = 0;
+            for (int i = 0; i < m->ncpus; i++)
+                if (m->cpus[i] && m->cpus[i] != cpu && __atomic_load_n(&m->cpus[i]->pc_state->active, __ATOMIC_SEQ_CST)) busy = 1;
+            if (!busy) break;
+            hv_cpu_process_requests(cpu); /* one of them may be waiting on a TLBI of ours */
+            if (spins > 100) sched_yield();
+        }
+        if (m->gen_checks) for (int i = 0; i < m->ncpus; i++) if (m->cpus[i] && m->cpus[i] != cpu && m->cpus[i]->pc_state->active) fprintf(stderr, "hengevm: flush while cpu %d is active\n", i);
+        pthread_mutex_lock(&m->tr_mu);
+        hv_flush_blocks(m);
+        pthread_mutex_unlock(&m->tr_mu);
+        pthread_mutex_lock(&m->stw_mu);
+        __atomic_store_n(&m->stw_active, 0, __ATOMIC_SEQ_CST);
+        pthread_cond_broadcast(&m->stw_cv);
+        pthread_mutex_unlock(&m->stw_mu);
+    } else if (m->stw_active) {
+        park(cpu);
+        while (m->stw_active) pthread_cond_wait(&m->stw_cv, &m->stw_mu);
+        pthread_mutex_unlock(&m->stw_mu);
+        unpark(cpu);
+    } else {
+        pthread_mutex_unlock(&m->stw_mu);
+    }
+}
+
+int hv_run(HvCpu *cpu) {
+    hv_big_lock(cpu->m);
+    hv_fp_enter(cpu);
+    int r = run(cpu, 0);
+    hv_fp_leave(cpu);
+    hv_big_unlock(cpu->m);
+    return r;
+}
+
+int hv_run_one(HvCpu *cpu) {
+    hv_big_lock(cpu->m);
+    hv_fp_enter(cpu);
+    int r = run(cpu, 1);
+    hv_fp_leave(cpu);
+    hv_big_unlock(cpu->m);
+    return r;
+}
+
+/* Bring-up aid (log >= 4): report the first block entered with a host address
+   in a guest register, which means the translator leaked one. */
+static int host_pointer_check(HvCpu *cpu, uint64_t prev_pc) {
+    HvMachine *m = cpu->m;
+    for (int r = 0; r < 31; r++) {
+        uint64_t v = cpu->x[r];
+        const char *what = NULL;
+        for (int i = 0; i < m->nram && !what; i++)
+            if (v - (uint64_t)(uintptr_t)m->ram[i].host < m->ram[i].size && m->ram[i].pa != (uint64_t)(uintptr_t)m->ram[i].host)
+                what = "host copy of guest RAM";
+        if (v - (uint64_t)(uintptr_t)m->jit.base < m->jit.capacity * 4) what = "JIT region";
+        if (v - (uint64_t)(uintptr_t)cpu < sizeof *cpu) what = "HvCpu";
+        if (what) {
+            fprintf(stderr, "host pointer: x%d = %llx (%s) entering %llx, previous block %llx\n", r,
+                    (unsigned long long)v, what, (unsigned long long)cpu->pc, (unsigned long long)prev_pc);
+            return 1;
+        }
+    }
+    return 0;
+}
+
+static int run_loop(HvCpu *cpu, int one) {
+    HvMachine *m = cpu->m;
+    uint32_t since_tick = 0;
+    uint64_t next_due = 0; /* host time of this CPU's next timer event, from its last tick (0: none armed) */
+    uint64_t last_fault = ~0ull, prev_pc = 0;
+    HvBlock *prev_b = NULL;
+    uint64_t *pending_chain = NULL;
+    uint64_t chain_pc = 0;    /* where that exit was going, and in which state */
+    uint32_t chain_flags = 0;
+    uint32_t last_reason = HV_EXIT_BRANCH;
+    hv_self = cpu;
+    unpark(cpu);
+    for (;;) {
+        if (__atomic_load_n(&m->flush_pending, __ATOMIC_SEQ_CST) || __atomic_load_n(&m->stw_active, __ATOMIC_SEQ_CST)) {
+            stop_the_world(cpu);
+            pending_chain = NULL;
+            prev_b = NULL;
+            continue;
+        }
+        hv_cpu_process_requests(cpu);
+        if (cpu->halted) return HV_EXIT_HALT;
+        if (cpu->off) {
+            wait_while_off(cpu); /* comes back after CPU_ON, reset to its entry point */
+            pending_chain = NULL;
+            last_reason = HV_EXIT_EXCEPTION;
+            continue;
+        }
+        /* Someone asked the CPU to leave (the 1 ms kicker, a device, an invalidation): service devices now. */
+        int kicked = __atomic_exchange_n(&cpu->exit_req, 0, __ATOMIC_RELAXED) != 0;
+        if (kicked && m->big_lock_on) {
+            /* Give another CPU its turn. Whatever it does in between may touch
+               what this CPU's exclusive monitor watches, so the monitor clears. */
+            cpu->excl_addr = ~0ull;
+            hv_big_yield(m);
+        }
+        /* Ticks take the device lock, so not every few blocks: on a kick (the 1 ms
+           kicker, a device with work for CPU 0, an interrupt raised for this
+           CPU) or once this CPU's own timer is due. */
+        if (m->tick && (kicked || (++since_tick >= 64 && (since_tick = 0, next_due && mach_absolute_time() >= next_due)))) {
+            since_tick = 0;
+            next_due = m->tick(m, cpu);
+            cpu->timer_due = next_due;
+        }
+        int why = pending_chain ? 0 : kicked ? 1 : last_reason != HV_EXIT_BRANCH ? 2 : 5;
+        if (hv_check_interrupts(cpu)) {
+            pending_chain = NULL;
+            why = 3;
+        }
+        /* 影子 settle 点 #1：块边界（BQL 区内；影子期奢侈品，翻权威后由 census 配对替代）。 */
+        extern int henge_gic_instr_active(void);
+        extern int henge_shadow_bb(HvCpu *cpu);
+        if (henge_gic_instr_active()) henge_shadow_bb(cpu);
+        if (cpu->pc == m->stop_pc || cpu->pc == m->stop_pc2) {
+            if (!m->stop_hook) return HV_EXIT_HALT;
+            m->stop_hook(cpu);
+            pending_chain = NULL; /* every call must come back through here */
+        }
+
+        if ((m->log || m->gen_checks) && cpu->el && (cpu->sctlr_el1 & 1) && !((cpu->pc >> 55) & 1) && cpu->pc >= 0x100000000ull) { /* EL1 at a user address: how did we get here? */
+            static int reported;
+            if (reported++ < 4) {
+                fprintf(stderr, "hengevm: el1 at user pc %llx: previous block %llx flags %x (%u insns), exit reason %u, why %d, "
+                                "miss site %llx, elr %llx spsr %llx x30 %llx, fast resumes %llu\n  recent:",
+                        (unsigned long long)cpu->pc, (unsigned long long)prev_pc, prev_b ? prev_b->flags : 0, prev_b ? prev_b->ninsns : 0,
+                        last_reason, why, (unsigned long long)cpu->miss_site, (unsigned long long)cpu->elr_el1,
+                        (unsigned long long)cpu->spsr_el1, (unsigned long long)cpu->x[30], (unsigned long long)m->stats.fast_resumes);
+                for (int k = 0; k < 16; k++)
+                    fprintf(stderr, " %llx", (unsigned long long)m->stats.recent[(m->stats.nrecent + k) & 15]);
+                fprintf(stderr, "\n");
+            }
+        }
+        if (m->log && !cpu->el && ((cpu->pc >> 55) & 1)) { /* EL0 can never run kernel code: say how we got here */
+            static int reported;
+            if (reported++ < 4)
+                fprintf(stderr, "hengevm: el0 at kernel pc %llx: previous block %llx, exit reason %u, why %d, miss site %llx, "
+                                "elr %llx spsr %llx x30 %llx\n",
+                        (unsigned long long)cpu->pc, (unsigned long long)prev_pc, last_reason, why,
+                        (unsigned long long)cpu->miss_site, (unsigned long long)cpu->elr_el1,
+                        (unsigned long long)cpu->spsr_el1, (unsigned long long)cpu->x[30]);
+        }
+        uint64_t pa;
+        uint32_t avail;
+        const uint32_t *code = hv_mmu_fetch(cpu, cpu->pc, &pa, &avail);
+        if (!code) { /* the instruction abort was taken */
+            /* The pc is the vector now, not the branch target: the exit that got
+               here must not be chained to whatever runs next (that put EL0 code
+               on a path straight into the kernel's vector code). */
+            pending_chain = NULL;
+            if (cpu->pc == last_fault) return HV_EXIT_FAULT_LOOP;
+            last_fault = cpu->pc;
+            continue;
+        }
+        last_fault = ~0ull;
+        uint64_t flushes = m->stats.block_flushes;
+        HvBlock *b = lookup(cpu, cpu->pc, pa, block_flags(cpu), code, avail);
+        /* A full flush while translating freed the slot the last exit came through,
+           and new blocks may have it now: chaining it would rewrite one of theirs. */
+        if (m->stats.block_flushes != flushes) pending_chain = NULL;
+        if (!b) {
+            /* Everything is about to be dropped, or just was (another CPU may have
+               done the flush this lookup asked for): try again after. */
+            if (m->flush_pending || __atomic_load_n(&m->stw_active, __ATOMIC_SEQ_CST) || m->stats.block_flushes != flushes) continue;
+            fprintf(stderr, "hengevm: cannot translate block at %llx\n", (unsigned long long)cpu->pc);
+            park(cpu);
+            return HV_EXIT_UNSUPPORTED;
+        }
+        /* Remember it for indirect branches (not the tests' stop PC: that must reach us). */
+        /* EL0 tables only hold user VAs and EL1 tables kernel VAs, so each half has its own salt. */
+        int kernel = b->flags & HV_BLOCK_EL1;
+        if (m->chain && b->va != m->stop_pc && b->va != m->stop_pc2 && (int)((b->va >> 55) & 1) == kernel) {
+            HvPerCpu *pcs = cpu->pc_state;
+            uint64_t *t = pcs->ijc + (size_t)(b->flags & (HV_IJC_TABLES - 1)) * (HV_IJC_TABLE_BYTES / 8);
+            uint64_t tag = b->va ^ cpu->ijc_salt[kernel];
+            uint64_t *ent = t + (size_t)hv_ijc_index(tag) * 2;
+            if (why == 5 && (ent[0] == tag || ent[2] == tag)) {
+                why = 4; /* it was cached: not a miss */
+                static int dbg = -1, shown;
+                if (dbg < 0) dbg = getenv("HV_IJC_DEBUG") != NULL;
+                if (dbg) { /* what instruction came just before the target (put_exit leaves with pc + 4) */
+                    static uint64_t hist[4], total;
+                    uint32_t before = 0;
+                    uint64_t off = b->pa - b->ram->pa;
+                    if (off & ((1ull << HV_TLB_PAGE_BITS) - 1)) memcpy(&before, b->ram->host + off - 4, 4);
+                    int k = cpu->miss_site ? 0 : before == 0xd5033fdf ? 1 : (before & 0xfff00000u) == 0xd5100000u ? 2 : 3;
+                    hist[k]++;
+                    if (++total % 200000 == 0)
+                        fprintf(stderr, "ijc cached-miss kinds: ijc site %llu, after ISB %llu, after MSR %llu, other %llu\n",
+                                (unsigned long long)hist[0], (unsigned long long)hist[1], (unsigned long long)hist[2],
+                                (unsigned long long)hist[3]);
+                    static uint64_t msrs;
+                    if (k == 2 && ++msrs % 20000 == 0)
+                        fprintf(stderr, "ijc cached-miss msr: S%u_%u_C%u_C%u_%u\n", 2 + ((before >> 19) & 1), (before >> 16) & 7,
+                                (before >> 12) & 15, (before >> 8) & 15, (before >> 5) & 7);
+                    static uint64_t others;
+                    if (k == 3 && ++others % 50000 == 0 && shown < 60) {
+                        shown++;
+                        fprintf(stderr, "ijc cached-miss other: target %llx el%u reason %u, insn before %08x\n", (unsigned long long)b->va, cpu->el, last_reason, before);
+                    }
+                }
+                if (0) {
+                    shown++;
+                    uint32_t last = 0;
+                    if (prev_b && prev_b->ninsns)
+                        memcpy(&last, prev_b->ram->host + (prev_b->pa - prev_b->ram->pa) + 4 * (prev_b->ninsns - 1), 4);
+                    fprintf(stderr, "ijc cached-miss: target %llx flags %x from site %llx (prev block %llx flags %x, %u insns, last %08x, reason %u)\n",
+                            (unsigned long long)b->va, b->flags, (unsigned long long)cpu->miss_site,
+                            (unsigned long long)prev_pc, prev_b ? prev_b->flags : 0, prev_b ? prev_b->ninsns : 0, last, last_reason);
+                }
+            }
+            if (m->stats_interval) { /* what the fill replaces: nothing (cold), another salt's entry, or another target */
+                uint64_t old = ent[0];
+                int kind = !old ? 0 : (old >> 48) != (tag >> 48) ? 1 : 2;
+                if (kind == 1) { /* another salt: is it still in use, or dead (dropped address space, reset)? */
+                    uint32_t c = (uint32_t)(old >> 48);
+                    int alive = kernel ? (c ^ 0xffff) == cpu->kernel_gen : cpu->asid_cid[cpu->cid_asid[c]] == c;
+                    if (!alive) kind = 3;
+                }
+                m->stats.fill_kind[kind]++;
+            }
+            if (hv_ijc_fill_checked(cpu, b) && m->stats_interval) m->stats.ijc_fills++;
+        }
+        /* The block before left through a chainable direct branch to this one: link them. */
+        /* Only if nothing in between (an abort, an interrupt) sent the CPU elsewhere. */
+        if (pending_chain && !m->trace && b->va == chain_pc && b->flags == chain_flags) chain(m, pending_chain, b);
+        pending_chain = NULL;
+        if (m->trace) fprintf(stderr, "block %llx el%u\n", (unsigned long long)cpu->pc, cpu->el);
+        /* -kernel 二级核窗口：HV_BOOT_TRACE=1 时，CPU1 落在 PSCI 给的入口附近就逐块打印。 */
+        /* -kernel/GICv2 诊断：每 10 万块采一次，长期挂住也能看到热循环 PC。 */
+        {
+            static int bt_on = -1, bt_printed[HV_MAX_CPUS];
+            static uint64_t bt_n[HV_MAX_CPUS];
+            if (bt_on < 0) bt_on = getenv("HV_BOOT_TRACE") != NULL;
+            if (bt_on) {
+                unsigned ci = cpu->index < HV_MAX_CPUS ? cpu->index : 0;
+                if ((bt_n[ci] % 100000) == 0 && bt_printed[ci] < 12) {
+                    fprintf(stderr, "henge-bt: cpu%u #%llu pc=%llx flags=%x el=%u why=%d\n",
+                            ci, (unsigned long long)bt_n[ci],
+                            (unsigned long long)cpu->pc, b->flags, cpu->el, why);
+                    bt_printed[ci]++;
+                }
+                bt_n[ci]++;
+            }
+        }
+        if (m->log >= 4 && host_pointer_check(cpu, prev_pc)) return HV_EXIT_UNSUPPORTED;
+        prev_pc = cpu->pc;
+        prev_b = b;
+        if (cpu->index < HV_MAX_CPUS) {
+            m->stats.blocks_n[cpu->index]++;
+            {
+                static int diag_on = -1;
+                if (diag_on < 0) diag_on = getenv("HENGE_SGI_ALARM") != NULL;
+                if (diag_on) {
+                    extern uint64_t henge_engine_pc[HV_MAX_CPUS];
+                    extern uint64_t henge_engine_daif[HV_MAX_CPUS];
+                    henge_engine_pc[cpu->index] = cpu->pc;
+                    henge_engine_daif[cpu->index] = cpu->daif;
+                }
+            }
+            if (cpu->vbar_el1 && (cpu->pc & ~0x7ffull) == (cpu->vbar_el1 & ~0x7ffull)
+                && (cpu->pc & 0x7ffull) < 0x800) {
+                m->stats.vec_n[cpu->index]++;
+                m->stats.vec_bucket[(cpu->pc >> 7) & 0xf]++;
+            }
+            if (wfi_ring_pending[cpu->index]) {
+                unsigned i = cpu->index, k = (wfi_ring_n[i] - 1) % 32;
+                wfi_ring[i][k].next_va = cpu->pc;
+                wfi_ring_pending[i] = 0;
+            }
+        }
+        if (m->stats_interval) m->stats.why[why]++;
+        m->stats.recent[m->stats.nrecent++ & 15] = cpu->pc | cpu->el;
+        if (why == 5 && m->stats_interval) {
+            int kind = 6;
+            /* A plain walk: fetching could raise an abort in the guest. */
+            HvWalk w;
+            uint32_t i = 0;
+            if (cpu->miss_site) hv_mmu_walk(cpu, cpu->miss_site, HV_ACC_EXEC, cpu->el, &w);
+            if (cpu->miss_site && !w.fsc && hv_phys_read(m, w.pa, &i, 4) == 0) {
+                if ((i & 0xfffffc1fu) == 0xd65f0000u || (i & 0xfffffbffu) == 0xd65f0bffu) kind = 0;         /* RET, RETAA/AB */
+                else if ((i & 0xfe9f0000u) == 0xd61f0000u) kind = 1; /* BR, BLR and their PAC forms (bit 24) */
+                else if ((i & 0x7c000000u) == 0x14000000u) kind = 2;                                         /* B, BL */
+                else if ((i & 0xff000010u) == 0x54000000u || (i & 0x7e000000u) == 0x34000000u ||
+                         (i & 0x7e000000u) == 0x36000000u) kind = 3;                                        /* B.cond, CB(N)Z, TB(N)Z */
+                else if ((i & 0xfff8f01fu) == 0xd500401fu) kind = 4;                                         /* MSR (immediate) */
+                else kind = 5;
+            }
+            m->stats.miss_kind[kind]++;
+        }
+        cpu->miss_site = 0; /* only the next lookup miss sets it again */
+        cpu->exit_reason = HV_EXIT_BRANCH;
+        cpu->last_stub = 0;
+        cpu->icount++;
+        m->stats.blocks++;
+        if (m->stats_interval && cpu->index == 0 && (m->stats.blocks & 0xfff) == 0) print_stats(cpu, 0);
+        if (m->gen_checks && ((uint64_t)(b->code - m->jit.base) >= m->jit.used || b->jit_gen != __atomic_load_n(&m->jit_gen, __ATOMIC_SEQ_CST)))
+            fprintf(stderr, "hengevm: cpu %u entering %p (rx+%llx, used %llx) for va %llx: block gen %u, now %u, maker %u\n", cpu->index, (void *)b->code, (unsigned long long)(b->code - m->jit.base) * 4, (unsigned long long)m->jit.used * 4, (unsigned long long)b->va, b->jit_gen, m->jit_gen, b->maker);
+        {
+            int inw = (cpu->pc >= 0xffff8000810a7000ull && cpu->pc < 0xffff8000810a7700ull) || cpu->pc == 0xffff8000800244e8ull;
+            if (inw && getenv("HENGE_AUTH_TRACE")) {
+                static int n;
+                if (n++ < 30)
+                    fprintf(stderr, "blk-enter: pc=%llx sp=%llx spsel=%u\n",
+                            (unsigned long long)cpu->pc, (unsigned long long)cpu->sp, cpu->spsel);
+            }
+            hv_enter(cpu, b->code);
+            if (inw && getenv("HENGE_AUTH_TRACE")) {
+                static int n;
+                if (n++ < 30)
+                    fprintf(stderr, "blk-exit: pc=%llx sp=%llx spsel=%u reason=%d\n",
+                            (unsigned long long)cpu->pc, (unsigned long long)cpu->sp, cpu->spsel,
+                            cpu->exit_reason);
+            }
+        }
+
+        if (cpu->exit_reason == HV_EXIT_BRANCH && cpu->last_stub && m->chain) {
+            pending_chain = (uint64_t *)cpu->last_stub;
+            chain_pc = cpu->pc;
+            chain_flags = block_flags(cpu); /* the exiting block's state (a block ends where its state changes) */
+        }
+        last_reason = cpu->exit_reason;
+        switch (cpu->exit_reason) {
+        case HV_EXIT_BRANCH:
+        case HV_EXIT_EXCEPTION:
+        case HV_EXIT_SYSREG:
+        case HV_EXIT_FLUSH:
+            break;
+        case HV_EXIT_WFI:
+            if (wait_for_interrupt(cpu) != 0) return HV_EXIT_WFI;
+            break;
+        default:
+            return (int)cpu->exit_reason;
+        }
+        if (one) return HV_EXIT_BRANCH;
+    }
+}
diff --git a/accel/henge/engine/core/dispatch.h b/accel/henge/engine/core/dispatch.h
new file mode 100644
index 0000000000..a21c023247
--- /dev/null
+++ b/accel/henge/engine/core/dispatch.h
@@ -0,0 +1,42 @@
+#ifndef HENGEVM_DISPATCH_H
+#define HENGEVM_DISPATCH_H
+
+#include "cpu.h"
+#include "machine.h"
+
+/* Runs translated code until the CPU halts, the test stop PC is reached, or
+   something the dispatcher cannot handle happens. Returns the HV_EXIT_* reason. */
+int hv_run(HvCpu *cpu);
+/* Runs a single block (after interrupt checks). */
+int hv_run_one(HvCpu *cpu);
+
+/* Drops every translated block (the JIT region is reused from the start). */
+void hv_flush_blocks(HvMachine *m);
+
+void hv_enter(HvCpu *cpu, void *block);
+/* While hv_run runs, the host FPCR/FPSR hold the guest's; these move them in and out. */
+void hv_fp_enter(HvCpu *cpu);
+void hv_fp_leave(HvCpu *cpu);
+
+void hv_debug_el0_in_kernel(HvCpu *cpu, const char *what);
+
+/* ---- interrupt chain trace (HV_IRQTRACE=1) --------------------------------
+   Per-iteration paired record.  Every event carries (seq, cpu, kind, pc, daif,
+   line, aux); seq is global so two CPUs' chains can be merged and ordered.
+   Ring only -- output happens on a storm threshold or hv_irqtrace_dump().
+   Kinds 1..3 cover WFI, 4 the unmask that follows an MSR DAIF, 5 the delivery
+   decision (aux=1 delivered, 0 declined), 6/7 the IAR read, 8 the EOIR write. */
+enum {
+    HV_IT_WFI_HIGH = 1,
+    HV_IT_WFI_SLEEP,
+    HV_IT_WFI_BAIL,
+    HV_IT_UNMASK,
+    HV_IT_DECIDE,
+    HV_IT_IAR,
+    HV_IT_EOIR,
+};
+
+void hv_irqtrace(HvCpu *cpu, int kind, uint64_t pc, uint64_t daif, int line, int aux);
+void hv_irqtrace_dump(int cpu_index);
+
+#endif
diff --git a/accel/henge/engine/core/exception.c b/accel/henge/engine/core/exception.c
new file mode 100644
index 0000000000..407afe55e7
--- /dev/null
+++ b/accel/henge/engine/core/exception.c
@@ -0,0 +1,348 @@
+#include "exception.h"
+
+#include <sched.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "machine.h"
+#include "dispatch.h"
+#include "mmu.h"
+
+/* Only EL0 and EL1 exist for the guest; HengeVM plays EL2 (PSCI over HVC, as
+   QEMU's vmapple machine sets up) and there is no EL3. */
+
+#define PSTATE_EXTRA_MASK ((1ull << 22) | (1ull << 23) | (1ull << 12) | (1ull << 24) | (1ull << 25))
+
+uint64_t hv_pstate_get(HvCpu *cpu) {
+    return (cpu->nzcv & 0xf0000000) | (cpu->daif & HV_PSTATE_DAIF) | (cpu->pstate_extra & PSTATE_EXTRA_MASK) |
+           (uint64_t)cpu->el << 2 | (cpu->el ? cpu->spsel : 0);
+}
+
+static void sp_trace(const char *tag, HvCpu *cpu)
+{
+    static int n;
+    static uint64_t last0[HV_MAX_CPUS];
+    unsigned ci = cpu->index < HV_MAX_CPUS ? cpu->index : 0;
+    int changed = cpu->sp_el0 != last0[ci];
+    last0[ci] = cpu->sp_el0;
+    if (getenv("HENGE_AUTH_TRACE") && changed && n++ < 200)
+        fprintf(stderr, "sp-trace[%s]: el=%u spsel=%u sp=%llx sp0=%llx sp1=%llx\n",
+                tag, cpu->el, cpu->spsel,
+                (unsigned long long)cpu->sp, (unsigned long long)cpu->sp_el0,
+                (unsigned long long)cpu->sp_el1);
+}
+
+void hv_sp_switch(HvCpu *cpu, uint32_t el, uint32_t spsel) {
+    sp_trace("switch-before", cpu);
+    if (cpu->el == 0 || cpu->spsel == 0) cpu->sp_el0 = cpu->sp;
+    else cpu->sp_el1 = cpu->sp;
+    cpu->el = el;
+    cpu->spsel = el ? spsel : 0;
+    cpu->sp = cpu->spsel ? cpu->sp_el1 : cpu->sp_el0;
+    sp_trace("switch-after", cpu);
+}
+
+static void set_extra(HvCpu *cpu, uint64_t extra) {
+    /* PAN selects a different TLB table (hv_tlb_table), so nothing to flush. */
+    cpu->pstate_extra = extra;
+}
+
+void hv_pstate_set(HvCpu *cpu, uint64_t spsr) {
+    uint32_t m = spsr & 0x1f;
+    uint32_t el = (m >> 2) & 3;
+    if ((m & 0x10) || el > 1) el = 1; /* AArch32 and EL2/EL3 do not exist: an illegal return, kept at EL1 */
+    cpu->nzcv = spsr & 0xf0000000;
+    cpu->daif = spsr & HV_PSTATE_DAIF;
+    set_extra(cpu, spsr & PSTATE_EXTRA_MASK);
+    hv_sp_switch(cpu, el, m & 1);
+}
+
+uint64_t hv_irq_taken[8];
+
+void hv_take_exception(HvCpu *cpu, int type, uint32_t esr, uint64_t far, int set_far, uint64_t ret) {
+    if (type == HV_EXC_IRQ && cpu->index < 8) hv_irq_taken[cpu->index]++;
+    /* -kernel 诊断（HV_EXC_TRACE=1）：头 12 次异常把 ESR/EL/FAR/VBAR/入口全打出来，
+       足以为 H1/H2/H3 定性。 */
+    {
+        static int n;
+        if (getenv("HV_EXC_TRACE") && n++ < 12) {
+            fprintf(stderr, "henge-exc: type=%d esr=%08x far=%llx from=%llx el=%u "
+                    "vbar=%llx pc=%llx x0=%llx daif=%llx\n",
+                    type, esr, (unsigned long long)far, (unsigned long long)ret,
+                    cpu->el, (unsigned long long)cpu->vbar_el1,
+                    (unsigned long long)cpu->pc, (unsigned long long)cpu->x[0],
+                    (unsigned long long)cpu->daif);
+        }
+    }
+    if (type == HV_EXC_SYNC) {
+        cpu->m->stats.exceptions++;
+        if (getenv("HENGE_AUTH_TRACE")) {
+            static int n;
+            if (n++ < 30)
+                fprintf(stderr, "sync-exc: pc=%llx far=%llx esr=%08x sp0=%llx sp=%llx spsel=%u el=%u\n",
+                        (unsigned long long)ret, (unsigned long long)far, esr,
+                        (unsigned long long)cpu->sp_el0, (unsigned long long)cpu->sp,
+                        cpu->spsel, cpu->el);
+        }
+    }
+    else cpu->m->stats.interrupts++;
+    uint64_t spsr = hv_pstate_get(cpu);
+    {
+        HvStats *st = &cpu->m->stats;
+        uint32_t k = st->nelchg++ & 15;
+        st->elchg[k].from = ret, st->elchg[k].spsr = spsr, st->elchg[k].kind = (uint32_t)type, st->elchg[k].el = cpu->el;
+        st->elchg[k].to = esr;
+    }
+    if (cpu->m->trace || cpu->m->log >= 2)
+        fprintf(stderr, "exception type %d esr %08x far %llx from pc %llx el%u\n", type, esr, (unsigned long long)far,
+                (unsigned long long)ret, cpu->el);
+    uint64_t offset = cpu->el == 0 ? 0x400 : cpu->spsel ? 0x200 : 0x000;
+    cpu->spsr_el1 = spsr;
+    cpu->elr_el1 = ret;
+    if (type == HV_EXC_SYNC || type == HV_EXC_SERROR) cpu->esr_el1 = esr;
+    if (set_far) cpu->far_el1 = far;
+    hv_sp_switch(cpu, 1, 1);
+    cpu->daif = HV_PSTATE_DAIF;
+    uint64_t extra = cpu->pstate_extra;
+    if (!((cpu->sctlr_el1 >> 23) & 1)) extra |= HV_PSTATE_PAN; /* SCTLR_EL1.SPAN == 0 */
+    extra &= ~(1ull << 12);
+    if ((cpu->sctlr_el1 >> 44) & 1) extra |= 1ull << 12;      /* SSBS from DSSBS */
+    set_extra(cpu, extra);
+    cpu->excl_addr = ~0ull;
+    cpu->pc = (cpu->vbar_el1 & ~0x7ffull) + offset + (uint64_t)type * 0x80;
+    cpu->exit_reason = HV_EXIT_EXCEPTION;
+}
+
+void hv_raise_sync(HvCpu *cpu, uint32_t ec, uint32_t iss, uint64_t far, uint64_t pc) {
+    int set_far = ec == HV_EC_PC_ALIGN || ec == HV_EC_IABT_LOWER || ec == HV_EC_IABT_SAME ||
+                  ec == HV_EC_DABT_LOWER || ec == HV_EC_DABT_SAME;
+    hv_take_exception(cpu, HV_EXC_SYNC, ec << 26 | 1u << 25 | (iss & 0x1ffffff), far, set_far, pc);
+}
+
+void hv_raise_undef(HvCpu *cpu, uint64_t pc) {
+    static int reported;
+    if (cpu->el == 0 && ((pc >> 55) & 1) && reported++ < 3) hv_debug_el0_in_kernel(cpu, "undef");
+    if (cpu->m->log) {
+        uint32_t insn = 0;
+        uint64_t pa;
+        if (!hv_mmu_access(cpu, pc, HV_ACC_EXEC, cpu->el, &pa)) hv_phys_read(cpu->m, pa, &insn, 4);
+        fprintf(stderr, "undefined: pc %llx insn %08x el%u\n", (unsigned long long)pc, insn, cpu->el);
+        if (cpu->el == 1) { /* a kernel assert: its backtrace, from the frame pointers (lr first) */
+            fprintf(stderr, "  backtrace: lr %llx", (unsigned long long)(cpu->x[30] | 0xffffff8000000000ull));
+            uint64_t fp = cpu->x[29];
+            for (int i = 0; i < 24 && fp; i++) {
+                uint64_t fr[2], fpa;
+                if (hv_mmu_access(cpu, fp, HV_ACC_READ, 1, &fpa) || hv_phys_read(cpu->m, fpa, fr, 16)) break;
+                uint64_t ret = fr[1] | 0xffffff8000000000ull; /* strip the PAC bits */
+                fprintf(stderr, " %llx", (unsigned long long)ret);
+                if (fr[0] <= fp) break;
+                fp = fr[0];
+            }
+            fprintf(stderr, "\n  vbar %llx\n", (unsigned long long)cpu->vbar_el1);
+        }
+    }
+    hv_raise_sync(cpu, HV_EC_UNKNOWN, 0, 0, pc);
+}
+
+void hv_raise_abort(HvCpu *cpu, int insn, uint64_t va, uint32_t fsc, int wnr, int s1ptw, uint64_t pc) {
+    uint32_t ec = insn ? (cpu->el ? HV_EC_IABT_SAME : HV_EC_IABT_LOWER)
+                       : (cpu->el ? HV_EC_DABT_SAME : HV_EC_DABT_LOWER);
+    uint32_t iss = fsc | (uint32_t)(wnr && !insn) << 6 | (uint32_t)s1ptw << 7;
+    hv_raise_sync(cpu, ec, iss, va, pc);
+}
+
+void hv_eret(HvCpu *cpu) {
+    if (cpu->m) {
+        HvStats *st = &cpu->m->stats;
+        uint32_t k = st->nelchg++ & 15;
+        st->elchg[k].from = cpu->pc, st->elchg[k].to = cpu->elr_el1, st->elchg[k].spsr = cpu->spsr_el1;
+        st->elchg[k].kind = 9, st->elchg[k].el = cpu->el;
+    }
+    cpu->pc = cpu->elr_el1;
+    hv_pstate_set(cpu, cpu->spsr_el1);
+    cpu->excl_addr = ~0ull;
+}
+
+static HvCpu *cpu_by_mpidr(HvMachine *m, uint64_t mpidr) {
+    for (int i = 0; i < m->ncpus; i++)
+        if (m->cpus[i] && (m->cpus[i]->mpidr & 0xff00ffffffull) == (mpidr & 0xff00ffffffull)) return m->cpus[i];
+    return NULL;
+}
+
+/* PSCI 1.0. */
+static uint64_t psci(HvCpu *cpu, uint64_t fn) {
+    static int log = -1;
+    if (log < 0) log = getenv("HV_PSCI_LOG") != NULL;
+    if (log && ((uint32_t)fn >> 24 == 0x84 || (uint32_t)fn >> 24 == 0xc4))
+        fprintf(stderr, "psci %#llx x1 %#llx x2 %#llx x3 %#llx pc %llx\n", (unsigned long long)fn, (unsigned long long)cpu->x[1],
+                (unsigned long long)cpu->x[2], (unsigned long long)cpu->x[3], (unsigned long long)cpu->pc);
+    switch ((uint32_t)fn) {
+    case 0x84000000: return 0x10000;                         /* PSCI_VERSION: 1.0 */
+    case 0x84000006: return 2;                               /* MIGRATE_INFO_TYPE: no trusted OS */
+    case 0x84000008:                                         /* SYSTEM_OFF */
+    case 0x84000009:                                         /* SYSTEM_RESET */
+        for (int i = 0; i < cpu->m->ncpus; i++) /* the whole machine stops */
+            if (cpu->m->cpus[i]) cpu->m->cpus[i]->halted = (uint32_t)fn == 0x84000008 ? 1 : 2;
+        hv_machine_kick_all(cpu->m);
+        return 0;
+    case 0x8400000a: {                                       /* PSCI_FEATURES */
+        uint32_t q = (uint32_t)cpu->x[1];
+        if (q == 0x84000000 || q == 0x84000002 || q == 0x84000006 || q == 0x84000008 || q == 0x84000009 ||
+            q == 0x8400000a || q == 0xc4000003 || q == 0x84000003 || q == 0xc4000004 || q == 0x84000004)
+            return 0;
+        return (uint64_t)-1;
+    }
+    case 0x84000002:                                         /* CPU_OFF: until another CPU_ON */
+        cpu->off = 1;
+        return 0;
+    case 0x84000003: case 0xc4000003: {                      /* CPU_ON: target, entry point, context id */
+        HvCpu *t = cpu_by_mpidr(cpu->m, cpu->x[1]);
+        if (!t) {
+            if (log) {
+                fprintf(stderr, "psci CPU_ON: no CPU matches mpidr %#llx (ncpus %d):",
+                        (unsigned long long)cpu->x[1], cpu->m->ncpus);
+                for (int i = 0; i < cpu->m->ncpus; i++)
+                    fprintf(stderr, " [%d]=%s mpidr %#llx", i,
+                            cpu->m->cpus[i] ? "cpu" : "null",
+                            cpu->m->cpus[i] ? (unsigned long long)cpu->m->cpus[i]->mpidr : 0ull);
+                fprintf(stderr, "\n");
+            }
+            return (uint64_t)-2;                             /* INVALID_PARAMETERS */
+        }
+        if (!t->off) return (uint64_t)-4;                    /* ALREADY_ON */
+        while (!__atomic_load_n(&t->parked_off, __ATOMIC_SEQ_CST)) sched_yield(); /* still on its way out of CPU_OFF */
+        uint64_t mpidr = t->mpidr, entry = cpu->x[2], context = cpu->x[3];
+        if ((uint32_t)fn == 0x84000003) entry = (uint32_t)entry, context = (uint32_t)context;
+        /* As at reset: EL1h, MMU and caches off, everything masked. Its thread
+           waits on wake_mu, so it cannot see the CPU half reset. */
+        pthread_mutex_lock(&t->pc_state->wake_mu);
+        HvPerCpu *pcs = t->pc_state;
+        hv_cpu_reset_index(t, cpu->m, t->index);
+        t->mpidr = mpidr;
+        t->pc = entry;
+        t->x[0] = context;
+        t->parked_off = 1;
+        __atomic_store_n(&t->off, 0, __ATOMIC_RELEASE);
+        pcs->wake_pending = 1;
+        pthread_cond_signal(&pcs->wake_cv);
+        pthread_mutex_unlock(&pcs->wake_mu);
+        return 0;
+    }
+    case 0x84000004: case 0xc4000004: {                      /* AFFINITY_INFO: 0 on, 1 off */
+        HvCpu *t = cpu_by_mpidr(cpu->m, cpu->x[1]);
+        if (!t) return (uint64_t)-2;
+        return t->off ? 1 : 0;
+    }
+    /* vmapple's paravirtualized PAC (XNU osfmk/arm64/hv_hvc.h): the guest
+       cannot program PAC keys itself, so the hypervisor does. HengeVM never
+       signs pointers, so there is nothing to program; each call only has to
+       succeed (XNU spins on a nonzero x0). */
+    case 0xc1000000: /* VMAPPLE_PAC_SET_INITIAL_STATE */
+    case 0xc1000002: /* VMAPPLE_PAC_SET_A_KEYS */
+    case 0xc1000003: /* VMAPPLE_PAC_SET_B_KEYS */
+    case 0xc1000004: /* VMAPPLE_PAC_SET_EL0_DIVERSIFIER */
+    case 0xc1000005: /* VMAPPLE_PAC_SET_EL0_DIVERSIFIER_AT_EL1 */
+    case 0xc1000006: /* VMAPPLE_PAC_SET_G_KEY */
+    case 0xc10000f0: /* VMAPPLE_PAC_NOP */
+        return 0;
+    case 0xc1000001: /* VMAPPLE_PAC_GET_DEFAULT_KEYS: x2 = default ROP id, x3 = default JOP id */
+        cpu->x[2] = 0x524f50; /* the values only name keys, and no key is ever used */
+        cpu->x[3] = 0x4a4f50;
+        return 0;
+    default:
+        if (cpu->m->log) fprintf(stderr, "hengevm: unknown hypervisor call %#llx (x1 %#llx) at el%u\n",
+                                 (unsigned long long)fn, (unsigned long long)cpu->x[1], cpu->el);
+        return (uint64_t)-1;                                 /* NOT_SUPPORTED */
+    }
+}
+
+/* Bring-up aid: x0-x3, and any string they point to (read with the current EL's mapping). */
+void hv_debug_args(HvCpu *cpu) {
+    for (int i = 0; i < 4; i++) fprintf(stderr, " x%d=%llx", i, (unsigned long long)cpu->x[i]);
+    fprintf(stderr, "\n");
+    for (int i = 0; i < 4; i++) {
+        char str[161];
+        int n = 0;
+        for (; n < 160; n++) {
+            uint64_t pa;
+            if (hv_mmu_access(cpu, cpu->x[i] + n, HV_ACC_READ, cpu->el, &pa) || hv_phys_read(cpu->m, pa, &str[n], 1) ||
+                str[n] < 9 || (unsigned char)str[n] > 126)
+                break;
+        }
+        str[n] = 0;
+        if (n >= 4) fprintf(stderr, "    x%d -> \"%s\"\n", i, str);
+    }
+}
+
+int hv_exception_insn(HvCpu *cpu, uint32_t insn, uint64_t pc) {
+    uint32_t imm16 = (insn >> 5) & 0xffff;
+    uint32_t opc = (insn >> 21) & 7, ll = insn & 3;
+    if (opc == 0 && ll == 1 && cpu->m->log >= 3) {
+        fprintf(stderr, "svc #%x at %llx el%u:", imm16, (unsigned long long)pc, cpu->el);
+        hv_debug_args(cpu);
+    }
+    if (opc == 0 && ll == 1) { /* SVC: ELR is the next instruction */
+        hv_take_exception(cpu, HV_EXC_SYNC, HV_EC_SVC64 << 26 | 1u << 25 | imm16, 0, 0, pc + 4);
+        return 1;
+    }
+    if (opc == 0 && ll == 2 && cpu->el == 1) { /* HVC: the hypervisor's PSCI and vmapple's PAC calls */
+        /*
+         * PSCI is handled here, in the engine, the way KVM handles it at EL2:
+         * the HVC is trapped where the guest executes it, the conduit runs in
+         * the same context, and the block carries on.  There is no host round
+         * trip and no second copy of the vCPU state (HV_EXIT_PSCI_EXT and the
+         * QEMU-side seam are gone; see STATE round 145).
+         */
+        cpu->x[0] = psci(cpu, cpu->x[0]);
+        if (!cpu->halted && !cpu->off) return 0; /* like a call: the block carries on (xnu makes one per context switch) */
+        cpu->pc = pc + 4;
+        cpu->exit_reason = cpu->halted ? HV_EXIT_HALT : HV_EXIT_BRANCH; /* CPU_OFF: the dispatcher parks it */
+        return 1;
+    }
+    if (opc == 1 && ll == 0) { /* BRK */
+        hv_take_exception(cpu, HV_EXC_SYNC, HV_EC_BRK << 26 | 1u << 25 | imm16, 0, 0, pc);
+        return 1;
+    }
+    /* SMC with no EL3, HVC from EL0, HLT without halting debug, DCPS: undefined. */
+    hv_raise_undef(cpu, pc);
+    return 1;
+}
+
+uint64_t hv_irq_injected[8], hv_irq_masked[8];
+
+int hv_check_interrupts(HvCpu *cpu) {
+    HvMachine *m = cpu->m;
+    HvPerCpu *p = cpu->pc_state;
+    (void)m;
+    int l0 = hv_irq_line(cpu, 0), l1 = hv_irq_line(cpu, 1);
+    int line = (l0 ? 1 : 0) | (l1 ? 2 : 0);
+    if (l1 && !(cpu->daif & HV_PSTATE_F)) {
+        hv_irqtrace(cpu, HV_IT_DECIDE, cpu->pc, cpu->daif, line, 1);
+        hv_take_exception(cpu, HV_EXC_FIQ, 0, 0, 0, cpu->pc);
+        return 1;
+    }
+    if (l0 && !(cpu->daif & HV_PSTATE_I)) {
+        hv_irqtrace(cpu, HV_IT_DECIDE, cpu->pc, cpu->daif, line, 1);
+        if (cpu->index < 8) hv_irq_injected[cpu->index]++;
+        hv_take_exception(cpu, HV_EXC_IRQ, 0, 0, 0, cpu->pc);
+        return 1;
+    }
+    hv_irqtrace(cpu, HV_IT_DECIDE, cpu->pc, cpu->daif, line, 0);
+    /* 停顿探针：线在、但引擎没投递时，把引擎自己的 daif/el 打出来
+       （QEMU 的 env->cpsr 只在 seam 同步，不能代表引擎当前掩码）。 */
+    if (line) {
+        if (cpu->index < 8) hv_irq_masked[cpu->index]++;
+        static int on = -1;
+        static uint64_t seen[HV_MAX_CPUS];
+        unsigned ci = cpu->index < HV_MAX_CPUS ? cpu->index : 0;
+        if (on < 0) on = getenv("HENGE_EXIT_DUMP") != NULL;
+        if (on && (seen[ci]++ % 65536) == 0) {
+            fprintf(stderr, "henge-decide: cpu%u pc=%llx daif=%llx l0=%d l1=%d el=%u "
+                    "I=%d F=%d\n", ci, (unsigned long long)cpu->pc,
+                    (unsigned long long)cpu->daif, l0, l1, cpu->el,
+                    !!(cpu->daif & HV_PSTATE_I), !!(cpu->daif & HV_PSTATE_F));
+        }
+    }
+    return 0;
+}
diff --git a/accel/henge/engine/core/exception.h b/accel/henge/engine/core/exception.h
new file mode 100644
index 0000000000..36c9bc0b62
--- /dev/null
+++ b/accel/henge/engine/core/exception.h
@@ -0,0 +1,54 @@
+#ifndef HENGEVM_EXCEPTION_H
+#define HENGEVM_EXCEPTION_H
+
+#include <stdint.h>
+
+#include "cpu.h"
+
+/* Exception classes (ESR_ELx.EC). */
+#define HV_EC_UNKNOWN     0x00
+#define HV_EC_FP_ACCESS   0x07
+#define HV_EC_ILLEGAL     0x0e
+#define HV_EC_SVC64       0x15
+#define HV_EC_HVC64       0x16
+#define HV_EC_SMC64       0x17
+#define HV_EC_SYSREG      0x18
+#define HV_EC_IABT_LOWER  0x20
+#define HV_EC_IABT_SAME   0x21
+#define HV_EC_PC_ALIGN    0x22
+#define HV_EC_DABT_LOWER  0x24
+#define HV_EC_DABT_SAME   0x25
+#define HV_EC_SP_ALIGN    0x26
+#define HV_EC_BRK         0x3c
+
+enum { HV_EXC_SYNC = 0, HV_EXC_IRQ = 1, HV_EXC_FIQ = 2, HV_EXC_SERROR = 3 };
+
+/* PSTATE in SPSR layout, and setting it back (switches EL and SP bank). */
+uint64_t hv_pstate_get(HvCpu *cpu);
+void hv_pstate_set(HvCpu *cpu, uint64_t spsr);
+/* Bank the current SP and select SP_EL0 or SP_ELx for (el, spsel). */
+void hv_sp_switch(HvCpu *cpu, uint32_t el, uint32_t spsel);
+
+/* Takes an exception to EL1. ret is the preferred return address (ELR_EL1). */
+void hv_take_exception(HvCpu *cpu, int type, uint32_t esr, uint64_t far, int set_far, uint64_t ret);
+void hv_raise_sync(HvCpu *cpu, uint32_t ec, uint32_t iss, uint64_t far, uint64_t pc);
+void hv_raise_undef(HvCpu *cpu, uint64_t pc);
+void hv_raise_abort(HvCpu *cpu, int insn, uint64_t va, uint32_t fsc, int wnr, int s1ptw, uint64_t pc);
+void hv_eret(HvCpu *cpu);
+
+/* SVC, HVC (PSCI), SMC, BRK, HLT at pc. Returns 1: the block always leaves. */
+int hv_exception_insn(HvCpu *cpu, uint32_t insn, uint64_t pc);
+
+/* Prints x0-x3 and the strings they point to (bring-up aid). */
+void hv_debug_args(HvCpu *cpu);
+
+/* Called by the dispatcher between blocks. Returns 1 if an interrupt was taken. */
+int hv_check_interrupts(HvCpu *cpu);
+extern uint64_t hv_irq_injected[8], hv_irq_masked[8];
+extern uint64_t hv_irq_taken[8];
+
+/* The interrupt level of `fiq`, asked of whoever owns the GIC rather than read
+ * from this CPU's copy.  Defined in dispatch.c; see irq_line_get in machine.h. */
+int hv_irq_line(HvCpu *cpu, int fiq);
+
+#endif
diff --git a/accel/henge/engine/core/machine.c b/accel/henge/engine/core/machine.c
new file mode 100644
index 0000000000..42199476a7
--- /dev/null
+++ b/accel/henge/engine/core/machine.c
@@ -0,0 +1,584 @@
+#include "machine.h"
+
+#include <mach/mach_time.h>
+#include <sched.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "mmu.h"
+#include "sysreg.h"
+
+extern void hv_exit(void);
+extern void hv_helper_entry(void);
+extern void hv_helper_thunk(void);
+extern void hv_chain_thunk(void);
+extern void hv_ijc_thunk(void);
+extern void hv_xjump_thunk(void);
+
+static int init_rest(HvMachine *m);
+
+int hv_knob[HV_K_COUNT];
+static const char *const hv_knob_names[HV_K_COUNT] = {"HV_NO_RAS", "HV_SUPERBLOCKS", "HV_GROUPS", "HV_WFI_SPIN", "HV_FLUSH", "HV_K1", "HV_K2", "HV_K3", "HV_TLBT", "HV_JIT_CAP", "HV_RECHECK"};
+
+static void knobs_init(void) {
+    for (int i = 0; i < HV_K_COUNT; i++)
+        hv_knob[i] = getenv(hv_knob_names[i]) ? atoi(getenv(hv_knob_names[i])) : 0;
+    if (getenv("HV_NO_RAS") && !*getenv("HV_NO_RAS")) hv_knob[HV_K_NO_RAS] = 1;
+}
+
+int hv_knob_set(HvMachine *m, const char *name, int value) {
+    for (int i = 0; i < HV_K_COUNT; i++)
+        if (!strcmp(name, hv_knob_names[i])) {
+            hv_knob[i] = value;
+            __atomic_store_n(&m->flush_pending, 1, __ATOMIC_SEQ_CST);
+            hv_machine_kick_all(m);
+            return 1;
+        }
+    return 0;
+}
+
+int hv_machine_init(HvMachine *m, size_t jit_bytes) {
+    memset(m, 0, sizeof *m);
+    if (hv_jit_region_open(&m->jit, jit_bytes) != 0) return -1;
+    return init_rest(m);
+}
+
+int hv_machine_init_jit(HvMachine *m, void *rx, void *rw, size_t jit_bytes) {
+    knobs_init();
+    memset(m, 0, sizeof *m);
+    if (hv_jit_region_attach(&m->jit, rx, rw, jit_bytes) != 0) return -1;
+    return init_rest(m);
+}
+
+static int init_rest(HvMachine *m) {
+    /* LSE on by default: the standalone engine implements ARMv8.1 atomics and
+       always has, so its behaviour must not change. A host that owns the ID
+       registers lowers this to whatever it advertises. */
+    m->feat_lse = 1;
+    /* The TLB layout (cpu.h): HV_TLBT from the environment here too, so the Mac tool and the tests can pick it. */
+    hv_knob[HV_K_TLBT] = getenv("HV_TLBT") ? atoi(getenv("HV_TLBT")) : 1; /* table-major unless asked: 9-20% faster in 5 of 6 paired rounds of the mix */
+    hv_tlb_tmajor = hv_knob[HV_K_TLBT] != 0;
+    /* 4 KB pages expose stack accesses in the last 15 bytes of every page (500K+/s on Windows):
+       exact OOL recheck avoids trapping to C on every stack push/pop at page top. */
+    hv_knob[HV_K_RECHECK] = getenv("HV_RECHECK") ? atoi(getenv("HV_RECHECK")) : 1;
+    /* As many blocks as the region holds (a block is at least ~160 bytes of
+       code), so the region filling, not this table, is what flushes; two
+       chainable exits each at most. Untouched entries cost nothing. */
+    size_t bytes = m->jit.capacity * sizeof(uint32_t);
+    m->max_blocks = (uint32_t)(bytes / 160 < 4096 ? 4096 : bytes / 160);
+    m->max_slots = m->max_blocks * 2;
+    m->blocks = calloc(m->max_blocks, sizeof(HvBlock));
+    if (!m->blocks) return -1;
+    m->stop_pc = ~0ull;
+    m->stop_pc2 = ~0ull;
+    m->chain = getenv("HENGE_NO_CHAIN") ? 0 : 1;
+    m->slots = calloc(m->max_slots, sizeof *m->slots);
+    m->slot_site = calloc(m->max_slots, sizeof *m->slot_site);
+    m->slot_stub = calloc(m->max_slots, sizeof *m->slot_stub);
+    m->slot_cond = calloc(m->max_slots, sizeof *m->slot_cond);
+    m->slot_xa = calloc(m->max_slots, sizeof *m->slot_xa);
+    m->slot_xpa = calloc(m->max_slots, sizeof *m->slot_xpa);
+    m->xchained = calloc(m->max_slots, sizeof *m->xchained);
+    if (!m->slots || !m->slot_site || !m->slot_stub || !m->slot_cond || !m->slot_xa || !m->slot_xpa || !m->xchained) return -1;
+    pthread_mutex_init(&m->big_mu, NULL);
+    pthread_cond_init(&m->big_cv, NULL);
+    pthread_mutexattr_t ra;
+    pthread_mutexattr_init(&ra);
+    pthread_mutexattr_settype(&ra, PTHREAD_MUTEX_RECURSIVE);
+    pthread_mutex_init(&m->dev_mu, &ra);
+    pthread_mutex_init(&m->tr_mu, NULL);
+    pthread_mutex_init(&m->stw_mu, NULL);
+    pthread_cond_init(&m->stw_cv, NULL);
+    for (int i = 0; i < HV_MAX_CPUS; i++) { /* untouched pages cost nothing, so every CPU gets its tables now */
+        HvPerCpu *p = &m->percpu[i];
+        p->ijc = calloc(HV_IJC_TABLES * HV_IJC_TABLE_BYTES / 8, 8);
+        p->ucode = calloc(1u << HV_UCODE_BITS, 8);
+        p->cid_chunks = calloc(65536, sizeof *p->cid_chunks);
+        if (!p->ijc || !p->ucode || !p->cid_chunks) return -1;
+        for (int k = 0; k < HV_STASHES; k++) {
+            p->stash[k].slot = calloc(HV_STASH_CAP, sizeof *p->stash[k].slot);
+            p->stash[k].ent = calloc(HV_STASH_CAP, sizeof *p->stash[k].ent);
+            if (!p->stash[k].slot || !p->stash[k].ent) return -1;
+        }
+        pthread_mutex_init(&p->wake_mu, NULL);
+        pthread_cond_init(&p->wake_cv, NULL);
+        pthread_mutex_init(&p->req_mu, NULL);
+    }
+    return 0;
+}
+
+__thread HvCpu *hv_self;
+
+void hv_dev_lock(HvMachine *m) {
+    if (pthread_mutex_trylock(&m->dev_mu) == 0) return;
+    uint64_t t0 = m->stats_interval ? mach_absolute_time() : 0;
+    pthread_mutex_lock(&m->dev_mu);
+    if (m->stats_interval) {
+        m->stats.dev_waits++;
+        m->stats.dev_wait_ticks += mach_absolute_time() - t0;
+    }
+}
+
+void hv_dev_unlock(HvMachine *m) {
+    pthread_mutex_unlock(&m->dev_mu);
+}
+
+static uint64_t post_locked_done(HvCpu *target, HvPerCpu *p) {
+    uint64_t seq = __atomic_add_fetch(&p->req_seq, 1, __ATOMIC_SEQ_CST);
+    pthread_mutex_unlock(&p->req_mu);
+    __atomic_store_n(&target->exit_req, 1, __ATOMIC_SEQ_CST);
+    __asm__ volatile("sev" ::: "memory"); /* a WFE waiting in place (wfe() in dispatch.c) sees it now */
+    if (target->m->stats_interval) target->m->stats.kick_src[0]++;
+    return seq;
+}
+
+uint64_t hv_cpu_post_tlbi(HvCpu *target, uint32_t op1, uint32_t crn, uint32_t crm, uint32_t op2, uint64_t xt) {
+    HvPerCpu *p = target->pc_state;
+    pthread_mutex_lock(&p->req_mu);
+    if (p->nreq < sizeof p->req / sizeof p->req[0]) {
+        p->req[p->nreq].op1 = op1, p->req[p->nreq].crn = crn, p->req[p->nreq].crm = crm, p->req[p->nreq].op2 = op2;
+        p->req[p->nreq].xt = xt;
+        p->nreq++;
+    } else {
+        p->req_flags |= HV_REQ_TLB_ALL; /* too many queued: drop everything instead */
+    }
+    return post_locked_done(target, p);
+}
+
+uint64_t hv_cpu_post(HvCpu *target, uint32_t flags) {
+    HvPerCpu *p = target->pc_state;
+    pthread_mutex_lock(&p->req_mu);
+    p->req_flags |= flags;
+    return post_locked_done(target, p);
+}
+
+void hv_cpu_process_requests(HvCpu *cpu) {
+    HvPerCpu *p = cpu->pc_state;
+    uint64_t seq = __atomic_load_n(&p->req_seq, __ATOMIC_ACQUIRE);
+    if (seq == __atomic_load_n(&p->ack_seq, __ATOMIC_RELAXED)) return;
+    static __thread struct { uint32_t op1, crn, crm, op2; uint64_t xt; } q[64];
+    pthread_mutex_lock(&p->req_mu);
+    seq = p->req_seq;
+    uint32_t flags = p->req_flags, n = p->nreq;
+    memcpy(q, p->req, n * sizeof q[0]);
+    p->req_flags = 0;
+    p->nreq = 0;
+    pthread_mutex_unlock(&p->req_mu);
+    if (flags & HV_REQ_TLB_ALL) {
+        hv_tlb_flush(cpu);
+    } else {
+        for (uint32_t i = 0; i < n; i++) hv_tlbi_apply(cpu, q[i].op1, q[i].crn, q[i].crm, q[i].op2, q[i].xt);
+    }
+    if (flags & HV_REQ_IJC_RESET) {
+        hv_ijc_reset(cpu, 0);
+        hv_ijc_reset(cpu, 1);
+    }
+    __atomic_store_n(&p->ack_seq, seq, __ATOMIC_RELEASE);
+}
+
+void hv_cpu_sync(HvCpu *self, HvCpu *target, uint64_t seq) {
+    HvPerCpu *t = target->pc_state, *s = self ? self->pc_state : NULL;
+    HvMachine *mm = target->m;
+    uint64_t t0 = mm->stats_interval ? mach_absolute_time() : 0;
+    if (s) __atomic_store_n(&s->tlb_live, 0, __ATOMIC_SEQ_CST); /* others need not wait for this one meanwhile */
+    for (uint32_t spins = 0;; spins++) {
+        if (__atomic_load_n(&t->ack_seq, __ATOMIC_ACQUIRE) >= seq) break;
+        if (!__atomic_load_n(&t->tlb_live, __ATOMIC_SEQ_CST)) break; /* parked: it does the work before it runs again */
+        if (self) hv_cpu_process_requests(self);
+        if (spins > 200) sched_yield();
+    }
+    if (s) {
+        __atomic_store_n(&s->tlb_live, 1, __ATOMIC_SEQ_CST);
+        hv_cpu_process_requests(self); /* anything that came in while we were not live */
+    }
+    if (mm->stats_interval) {
+        mm->stats.syncs++;
+        mm->stats.sync_ticks += mach_absolute_time() - t0;
+    }
+}
+
+void hv_big_lock(HvMachine *m) {
+    if (!m->big_lock_on) return;
+    pthread_mutex_lock(&m->big_mu);
+    uint64_t me = m->big_next++;
+    while (m->big_serving != me) pthread_cond_wait(&m->big_cv, &m->big_mu);
+    pthread_mutex_unlock(&m->big_mu);
+}
+
+void hv_big_unlock(HvMachine *m) {
+    if (!m->big_lock_on) return;
+    pthread_mutex_lock(&m->big_mu);
+    m->big_serving++;
+    pthread_cond_broadcast(&m->big_cv);
+    pthread_mutex_unlock(&m->big_mu);
+}
+
+void hv_big_yield(HvMachine *m) {
+    if (!m->big_lock_on) return;
+    pthread_mutex_lock(&m->big_mu);
+    int waiting = m->big_next - m->big_serving > 1;
+    pthread_mutex_unlock(&m->big_mu);
+    if (!waiting) return;
+    hv_big_unlock(m);
+    hv_big_lock(m);
+}
+
+/* Make cpu leave its block at its next checked exit (and end an in-place WFE wait). */
+void hv_cpu_kick(HvCpu *cpu) {
+    __atomic_store_n(&cpu->exit_req, 1, __ATOMIC_SEQ_CST);
+    __asm__ volatile("sev" ::: "memory");
+}
+
+/* Return tables: nothing to return to. A tag is never 0: salts are not, and no VA has their bits. */
+void hv_ret_clear(HvCpu *cpu) {
+    memset(cpu->ret_tab, 0, sizeof cpu->ret_tab);
+    cpu->ret_salt[0] = cpu->ret_salt[1] = 1ull << 48;
+}
+
+void hv_cpu_wake(HvCpu *cpu) {
+    if (cpu->m->wake_hook)
+        cpu->m->wake_hook(cpu->m->wake_hook_opaque, cpu->index);
+    __atomic_store_n(&cpu->exit_req, 1, __ATOMIC_SEQ_CST);
+    __asm__ volatile("sev" ::: "memory");
+    if (cpu->m->stats_interval) cpu->m->stats.kick_src[1]++;
+    HvPerCpu *p = cpu->pc_state;
+    pthread_mutex_lock(&p->wake_mu);
+    p->wake_pending = 1;
+    pthread_cond_signal(&p->wake_cv);
+    pthread_mutex_unlock(&p->wake_mu);
+}
+
+/* Wait on the engine's own wake condvar (the authority-mode output leg):
+   hv_cpu_wake() above sets wake_pending and signals it.  Returns 1 if woken,
+   0 on timeout.  The condvar's context is the engine's, so no BQL is needed. */
+int hv_cpu_wait(HvCpu *cpu, int64_t ns) {
+    HvPerCpu *p = cpu->pc_state;
+    struct timespec ts;
+    clock_gettime(CLOCK_REALTIME, &ts);
+    ts.tv_nsec += ns;
+    if (ts.tv_nsec >= 1000000000) { ts.tv_sec++; ts.tv_nsec -= 1000000000; }
+    pthread_mutex_lock(&p->wake_mu);
+    if (!p->wake_pending)
+        pthread_cond_timedwait(&p->wake_cv, &p->wake_mu, &ts);
+    int got = p->wake_pending;
+    p->wake_pending = 0;
+    pthread_mutex_unlock(&p->wake_mu);
+    return got;
+}
+
+void hv_machine_kick_all(HvMachine *m) {
+    if (m->stats_interval) m->stats.kick_src[2]++;
+    for (int i = 0; i < m->ncpus; i++)
+        if (m->cpus[i]) __atomic_store_n(&m->cpus[i]->exit_req, 1, __ATOMIC_SEQ_CST);
+    __asm__ volatile("sev" ::: "memory");
+}
+
+/* Device work is for CPU 0, which polls the devices. */
+void hv_machine_wake(HvMachine *m) {
+    if (m->stats_interval) m->stats.kick_src[3]++;
+    if (m->cpu) hv_cpu_wake(m->cpu);
+}
+
+void hv_machine_free(HvMachine *m) {
+    hv_jit_region_close(&m->jit);
+    for (int i = 0; i < m->nram; i++) {
+        free(m->ram[i].code_pages);
+        free(m->ram[i].page_gen);
+    }
+    free(m->blocks);
+    for (int i = 0; i < HV_MAX_CPUS; i++) {
+        free(m->percpu[i].ijc);
+        free(m->percpu[i].ucode);
+        free(m->percpu[i].cid_chunks);
+        for (int k = 0; k < HV_STASHES; k++) {
+            free(m->percpu[i].stash[k].slot);
+            free(m->percpu[i].stash[k].ent);
+        }
+    }
+    free(m->slots);
+    free(m->slot_site);
+    free(m->slot_stub);
+    free(m->slot_cond);
+    free(m->slot_xa);
+    free(m->slot_xpa);
+    free(m->xchained);
+}
+
+int hv_machine_add_ram(HvMachine *m, uint64_t pa, uint64_t size, void *host, int readonly) {
+    HvRam *r = NULL;
+    int i;
+
+    /*
+     * Reuse a retired slot before growing the table.
+     *
+     * hv_machine_del_ram() retires an entry in place (host = NULL, size = 0)
+     * rather than compacting, because hv_ram_lookup() hands out HvRam * that
+     * callers hold across later add/remove calls.  Without reuse here every
+     * add/remove cycle burns a permanent slot: HV_MAX_RAM is 8, and pflash
+     * adds and removes the whole variable-store window twice per CFI command
+     * write.  UEFI hit that ceiling and carried on booting with the window
+     * missing from the engine ("failed to mirror virt.flash1" x27), i.e. with
+     * every flash access silently promoted to an MMIO round trip.
+     */
+    for (i = 0; i < m->nram; i++) {
+        if (!m->ram[i].host && !m->ram[i].size) {
+            r = &m->ram[i];
+            m->stats.ram_reuse++;
+            break;
+        }
+    }
+    if (!r) {
+        if (m->nram == HV_MAX_RAM) return -1;
+        r = &m->ram[m->nram++];
+    }
+    r->pa = pa;
+    r->size = size;
+    r->host = host;
+    r->readonly = readonly;
+    /*
+     * Read this before the arrays are replaced, and read it as "which
+     * occupancy of this slot is this".  Every block made from the previous
+     * occupant still points at this same HvRam (slots are reused in place, so
+     * the address is stable) and will stop matching on ram_epoch.  Without
+     * that, page_gen being a fresh zeroed array is enough for the page_gen
+     * test to call a stale block valid again.
+     *
+     * hv_machine_del_ram_flags() bumps it too, for the window in between; see
+     * the note there.  Both bumps are load-bearing and neither is redundant
+     * with the size test: size says "retired", epoch says "different
+     * occupant", and a block must be refused in both cases.
+     */
+    r->epoch++;
+    size_t pages = (size + (1u << HV_TLB_PAGE_BITS) - 1) >> HV_TLB_PAGE_BITS;
+    r->pages_log2 = 0;
+    while ((1ull << r->pages_log2) < pages) r->pages_log2++;
+    /* A power of two, so translated code bounds-checks a page index with one shift (IC IVAU). */
+    r->code_pages = calloc((size_t)1 << r->pages_log2, 1);
+    if (!m->main_ram || size > m->main_ram->size) m->main_ram = r;
+    r->page_gen = calloc(pages, sizeof *r->page_gen);
+    r->whint = calloc(pages * HV_MAX_CPUS, sizeof *r->whint);
+    return r->code_pages && r->page_gen && r->whint ? 0 : -1;
+}
+
+int hv_machine_add_mmio(HvMachine *m, uint64_t pa, uint64_t size, void *opaque,
+                        uint64_t (*read)(void *, uint64_t, unsigned),
+                        void (*write)(void *, uint64_t, uint64_t, unsigned), const char *name) {
+    if (m->nmmio == HV_MAX_MMIO) return -1;
+    m->mmio[m->nmmio++] = (HvMmio){pa, size, opaque, read, write, name, 0};
+    return 0;
+}
+
+HvRam *hv_ram_lookup(HvMachine *m, uint64_t pa) {
+    for (int i = 0; i < m->nram; i++) {
+        HvRam *r = &m->ram[i];
+        if (pa - r->pa < r->size) return r;
+    }
+    return NULL;
+}
+
+uint32_t *hv_smc_counts;
+uint64_t *hv_smc_last;
+uint64_t hv_smc_pages, hv_smc_cpu, hv_smc_dma;
+
+void hv_invalidate_code(HvMachine *m, uint64_t pa) {
+    HvRam *r = hv_ram_lookup(m, pa);
+    if (!r) return;
+    uint64_t pg = (pa - r->pa) >> HV_TLB_PAGE_BITS;
+    if (!r->code_pages[pg]) return;
+    /* Blocks remember the generation they were made under; a stale one is
+       retranslated the next time it is looked up. The block running now may
+       finish with the old code, as it would with a real instruction pipeline. */
+    r->code_pages[pg] = 0;
+    __atomic_add_fetch(&r->page_gen[pg], 1, __ATOMIC_SEQ_CST);
+    m->stats.flush_smc++;
+    if (hv_smc_counts && pg < hv_smc_pages) {
+        hv_smc_counts[pg]++;
+        uint64_t caller = hv_self ? hv_self->pc : 0;
+        hv_smc_last[pg] = caller;
+        if (hv_self) hv_smc_cpu++;
+        else hv_smc_dma++;
+    }
+    /* Exits from other pages chained into the stale blocks go back to their stub
+       (whose next chain finds the new translation). Under the translation lock,
+       as chaining them is: one that saw the old generation is done by now. */
+    pthread_mutex_lock(&m->tr_mu);
+    uint64_t tpa = (r->pa + (pg << HV_TLB_PAGE_BITS)) | 1;
+    for (uint32_t k = 0; k < m->nxchained;) {
+        uint32_t idx = m->xchained[k];
+        if (m->slot_xpa[idx] != tpa) {
+            k++;
+            continue;
+        }
+        m->slot_xpa[idx] = 0;
+        __atomic_store_n(&m->slots[idx], 0, __ATOMIC_RELEASE);
+        uint32_t *site = m->slot_site[idx];
+        if (site) {
+            uint32_t insn = 0x14000000u | (uint32_t)((m->slot_stub[idx] - site) & 0x3ffffff); /* back to its stub */
+            hv_jit_write(&m->jit, site, &insn, 4);
+            hv_jit_finish(&m->jit, site, 1);
+        }
+        m->xchained[k] = m->xchained[--m->nxchained];
+    }
+    pthread_mutex_unlock(&m->tr_mu);
+    /* The indirect-branch cache may lead into the stale blocks: start it over,
+       here at once and on the other CPUs before they next leave a block (their
+       cache lookups and chained exits check exit_req first). */
+    for (int i = 0; i < m->ncpus; i++) {
+        HvCpu *c = m->cpus[i];
+        if (!c) continue;
+        /* Only a CPU may reset its own cache; from any other thread (a device,
+           or no CPU running yet) it is a request, or a running CPU could read a
+           half-written entry and jump into the wrong code. */
+        if (c == hv_self) {
+            hv_ijc_reset(c, 0);
+            hv_ijc_reset(c, 1);
+        } else {
+            hv_cpu_post(c, HV_REQ_IJC_RESET);
+        }
+    }
+    m->stats.reset_why[4]++;
+    /* Make a running chain leave (chains stay patched: see chain() in dispatch.c). */
+    hv_machine_kick_all(m);
+}
+
+void hv_dma_written(HvMachine *m, uint64_t pa, uint64_t len) {
+    HvRam *r = hv_ram_lookup(m, pa);
+    if (!r || !len || pa + len - r->pa > r->size) return;
+    uint64_t first = (pa - r->pa) >> HV_TLB_PAGE_BITS, last = (pa + len - 1 - r->pa) >> HV_TLB_PAGE_BITS;
+    for (uint64_t pg = first; pg <= last; pg++)
+        if (__atomic_load_n(&r->code_pages[pg], __ATOMIC_ACQUIRE)) hv_invalidate_code(m, r->pa + (pg << HV_TLB_PAGE_BITS));
+}
+
+HvMmio *hv_mmio_lookup(HvMachine *m, uint64_t pa) {
+    /* Most specific match wins: the QEMU catch-all (size ~0) must not shadow
+       a device region the engine registers later (e.g. the authority GIC). */
+    HvMmio *best = NULL;
+    for (int i = 0; i < m->nmmio; i++) {
+        HvMmio *d = &m->mmio[i];
+        if (pa - d->pa < d->size) {
+            if (!best || d->size < best->size) best = d;
+        }
+    }
+    return best;
+}
+
+void *hv_phys_ptr(HvMachine *m, uint64_t pa, uint64_t len) {
+    HvRam *r = hv_ram_lookup(m, pa);
+    if (!r || pa + len - r->pa > r->size) return NULL;
+    return r->host + (pa - r->pa);
+}
+
+/* MMIO is accessed in naturally sized pieces of at most 8 bytes. */
+int hv_phys_read(HvMachine *m, uint64_t pa, void *buf, unsigned len) {
+    void *p = hv_phys_ptr(m, pa, len);
+    if (p) {
+        memcpy(buf, p, len);
+        return 0;
+    }
+    HvMmio *d = hv_mmio_lookup(m, pa);
+    if (!d || len > 8) return -1;
+    if (!d->self_locked) hv_dev_lock(m);
+    uint64_t v = d->read ? d->read(d->opaque, pa - d->pa, len) : 0;
+    if (!d->self_locked) hv_dev_unlock(m);
+    memcpy(buf, &v, len);
+    if (m->log >= 3)
+        fprintf(stderr, "mmio read  %s+%llx size %u = %llx pc %llx\n", d->name, (unsigned long long)(pa - d->pa), len,
+                (unsigned long long)v, (unsigned long long)m->access_pc);
+    return 0;
+}
+
+int hv_phys_write(HvMachine *m, uint64_t pa, const void *buf, unsigned len) {
+    HvRam *r = hv_ram_lookup(m, pa);
+    if (r && pa + len - r->pa <= r->size) {
+        /*
+         * A read-only window is one whose reads are direct and whose writes
+         * belong to a device -- QEMU's romd regions (pflash) are exactly that.
+         * Dropping the write and passing it on are both "not storing to RAM";
+         * only the second is correct, because the device's command state
+         * machine is the thing that must see it.  The MMIO catch-all below
+         * covers the whole physical space, so falling through finds it.
+         *
+         * This is still "no store into the RAM window" for the ROM case that
+         * has no device behind it: the lookup misses, the write is ignored, and
+         * that is what a ROM is.
+         */
+        if (!r->readonly) {
+            uint64_t off = pa - r->pa;
+            uint64_t first = off >> HV_TLB_PAGE_BITS, last = (off + len - 1) >> HV_TLB_PAGE_BITS;
+            for (uint64_t pg = first; pg <= last; pg++)
+                if (r->code_pages[pg]) hv_invalidate_code(m, r->pa + (pg << HV_TLB_PAGE_BITS)); /* a write to code */
+            if (m->watch_pa && m->watch_pa - pa < len) {
+                uint64_t v = 0;
+                memcpy(&v, (const uint8_t *)buf + (m->watch_pa - pa), len - (m->watch_pa - pa) < 8 ? len - (m->watch_pa - pa) : 8);
+                fprintf(stderr, "hengevm: watch: write to pa %llx = %llx (%u bytes at pa %llx) by pc %llx\n",
+                        (unsigned long long)m->watch_pa, (unsigned long long)v, len, (unsigned long long)pa,
+                        (unsigned long long)m->access_pc);
+            }
+            memcpy(r->host + off, buf, len);
+            return 0;
+        }
+    }
+    HvMmio *d = hv_mmio_lookup(m, pa);
+    if (!d || len > 8) return -1;
+    uint64_t v = 0;
+    memcpy(&v, buf, len);
+    if (m->log >= 3)
+        fprintf(stderr, "mmio write %s+%llx size %u = %llx pc %llx\n", d->name, (unsigned long long)(pa - d->pa), len,
+                (unsigned long long)v, (unsigned long long)m->access_pc);
+    if (!d->self_locked) hv_dev_lock(m);
+    if (d->write) d->write(d->opaque, pa - d->pa, v, len);
+    if (!d->self_locked) hv_dev_unlock(m);
+    return 0;
+}
+
+void hv_cpu_reset(HvCpu *cpu, HvMachine *m) {
+    hv_cpu_reset_index(cpu, m, 0);
+}
+
+void hv_cpu_reset_index(HvCpu *cpu, HvMachine *m, uint32_t index) {
+    /* Everything but m and pc_state: other CPUs' TLBIs read those of a CPU
+       being started (PSCI CPU_ON) at any time. */
+    _Static_assert(offsetof(HvCpu, m) < offsetof(HvCpu, pc_state), "HvCpu layout");
+    size_t a = offsetof(HvCpu, m), b = offsetof(HvCpu, pc_state);
+    memset(cpu, 0, a);
+    memset((char *)cpu + a + sizeof cpu->m, 0, b - a - sizeof cpu->m);
+    memset((char *)cpu + b + sizeof cpu->pc_state, 0, sizeof *cpu - b - sizeof cpu->pc_state);
+    cpu->m = m;
+    cpu->index = index;
+    cpu->pc_state = &m->percpu[index];
+    m->cpus[index] = cpu;
+    if (m->ncpus <= (int)index) m->ncpus = (int)index + 1;
+    if (index == 0) m->cpu = cpu;
+    HvPerCpu *p = cpu->pc_state;
+    /* Ids start over, so entries tagged with the old ones must go. */
+    for (int t = 0; t < HV_IJC_TABLES; t++)
+        if (p->ijc_tables_used >> t & 1) memset(p->ijc + (size_t)t * (HV_IJC_TABLE_BYTES / 8), 0, HV_IJC_TABLE_BYTES);
+    p->ijc_tables_used = 0;
+    memset(p->ijc_keyed, 0, sizeof p->ijc_keyed);
+    p->ijc_keyed_count = 0;
+    memset(p->ijc_pages, 0, sizeof p->ijc_pages);
+    memset(p->ijc_hint, 0, sizeof p->ijc_hint);
+    memset(p->jc, 0, sizeof p->jc);
+    cpu->ijc = (uint64_t)(uintptr_t)p->ijc;
+    cpu->lines_ptr = (uint64_t)(uintptr_t)&p->irq_line;
+    for (int t = 0; t < HV_IJC_TABLES; t++) cpu->ijc_tab[t] = (uint64_t)(uintptr_t)(p->ijc + (size_t)t * (HV_IJC_TABLE_BYTES / 8));
+    hv_ret_clear(cpu);
+    cpu->next_cid = 1;
+    cpu->kernel_gen = 1;
+    cpu->ijc_salt[1] = 1ull << 48; /* tags of an all-zero table never match */
+    hv_ijc_switch(cpu);
+    cpu->exit_routine = (uint64_t)hv_exit;
+    cpu->helper_routine = (uint64_t)hv_helper_entry;
+    cpu->helper_thunk = (uint64_t)hv_helper_thunk;
+    cpu->chain_thunk = (uint64_t)hv_chain_thunk;
+    cpu->ijc_thunk = (uint64_t)hv_ijc_thunk;
+    cpu->xjump_thunk = (uint64_t)hv_xjump_thunk;
+    cpu->el = 1;
+    cpu->spsel = 1;
+    cpu->daif = HV_PSTATE_DAIF;
+    cpu->excl_addr = ~0ull;
+    /* Architectural reset value has the MMU and caches off; RES1 bits set. */
+    cpu->sctlr_el1 = 0x30d00800;
+    hv_tlb_flush(cpu);
+}
diff --git a/accel/henge/engine/core/machine.h b/accel/henge/engine/core/machine.h
new file mode 100644
index 0000000000..e36f9f96a2
--- /dev/null
+++ b/accel/henge/engine/core/machine.h
@@ -0,0 +1,532 @@
+#ifndef HENGEVM_MACHINE_H
+#define HENGEVM_MACHINE_H
+
+#include <TargetConditionals.h>
+#include <pthread.h>
+#include <stdint.h>
+
+#include "cpu.h"
+#include "jit_region.h"
+
+/* Guest physical memory: RAM regions backed by host memory, and MMIO regions
+   handled by device callbacks. The fast path only ever sees RAM. */
+typedef struct HvRam {
+    uint64_t pa, size;
+    uint8_t *host;
+    int readonly;
+    uint8_t *code_pages; /* one byte per 16 KB page: a translated block came from here (2^pages_log2 of them) */
+    uint32_t pages_log2;
+    uint32_t *page_gen;  /* per page: bumped to invalidate the blocks translated from it */
+    /* Identifies this slot's current occupancy.  Bumped by add_ram() *and* by
+       del_ram(), which is what makes it worth having.
+
+       add_ram() alone would only distinguish two occupants after the fact.  The
+       gap in the middle is the dangerous one: between the del and the next add
+       the slot is retired -- size 0, page_gen NULL -- while pa, flags and
+       epoch all still match whatever was there before, so a block translated
+       from the vanished window passes every other test and then reads
+       page_gen[pg], i.e. NULL[pg].  That is a host SIGSEGV, not a wrong guest
+       read.  Bumping on the way out closes the window instead of documenting
+       it.
+
+       Blocks remember this as ram_epoch; see hv_block_find(). */
+    uint32_t epoch;
+    /* Per page and CPU: up to three TLB entries (slot << 2 | table, plus 1;
+       16 bits each) that mapped the page writable, or HV_WHINT_MANY when there
+       were more. When the page becomes code only those are dropped, not a whole
+       TLB scanned. */
+    uint64_t *whint;
+} HvRam;
+
+typedef struct HvMmio {
+    uint64_t pa, size;
+    void *opaque;
+    uint64_t (*read)(void *opaque, uint64_t off, unsigned size);
+    void (*write)(void *opaque, uint64_t off, uint64_t val, unsigned size);
+    const char *name;
+    int self_locked;     /* the device takes its own lock (the GIC): no device lock around it */
+} HvMmio;
+
+typedef struct HvBlock {
+    uint32_t jit_gen; /* full flushes when it was made */
+    uint64_t va, pa;
+    uint32_t flags;      /* HV_BLOCK_* state the translation depends on */
+    uint32_t ninsns;
+    uint32_t gen;        /* page_gen of its page when translated */
+    uint32_t ram_epoch;  /* ram->epoch when translated: which occupancy of the slot this is */
+    struct HvRam *ram;   /* where its page lives, for a quick staleness check */
+    uint64_t pg;
+    uint32_t *code;
+    struct HvBlock *next;
+    uint32_t maker;      /* the CPU that translated it (index + 1; 0: not a CPU, as in tests) */
+} HvBlock;
+
+#define HV_BLOCK_EL1   1u        /* translated for EL1 (selects tlb[1]) */
+#define HV_BLOCK_FPOFF 2u        /* CPACR_EL1.FPEN traps FP/SIMD at this EL */
+#define HV_BLOCK_SPX   4u        /* EL1 with SPSel = 1 (SP_EL1 in use, SP_EL0 banked) */
+#define HV_BLOCK_PAN   8u        /* EL1 with PSTATE.PAN set (selects TLB table 2) */
+
+#define HV_MAX_RAM 8
+#define HV_MAX_MMIO 48
+#define HV_BLOCK_HASH (1 << 21) /* one bucket per block: chains are walked on every front-cache miss */
+#define HV_JC_BITS 16
+#define HV_MAX_BLOCKS (3 << 20) /* a macOS boot runs well over a million distinct blocks; a full flush retranslates them all */
+#define HV_PROF_RING (1 << 16)
+#define HV_MAX_SLOTS (6 << 20)  /* chainable exits: about two per block */
+
+/* Counters for --stats: where the time goes. */
+#if TARGET_OS_IPHONE
+#define HV_MAX_CPUS 4
+#else
+#define HV_MAX_CPUS 8
+#endif
+
+typedef struct HvStats {
+    uint64_t blocks, translations, block_flushes;
+    uint64_t blocks_n[HV_MAX_CPUS]; /* per-CPU block executions (the 110:1 question) */
+    uint64_t vec_n[HV_MAX_CPUS];    /* per-CPU blocks that start inside the EL1 vector table */
+    uint64_t vec_bucket[16];        /* vector offsets 0x000..0x780, 0x80 apart */
+    /* Slot-identity counters.  Accumulated, not rates: they answer "did this
+     * ever happen", which is the only question that matters for a fault path
+     * that is either impossible or fatal.
+     *
+     *   ram_reuse    add_ram() recycled a retired slot.  Not the same as
+     *                del_ram calls -- a del against a never-mirrored window
+     *                retires nothing, and on a disk boot that is 698 of 704.
+     *                Measured baseline (13.35, disk boot): 5 hits, 704 calls,
+     *                4 reuses, all before the first vCPU.
+     *   retired_hit  a block was looked up while its window was retired
+     *                (size 0, page_gen NULL).  This is the NULL-dereference
+     *                path: it is the only observer the del-epoch bump has,
+     *                since that fix is correct by construction and otherwise
+     *                produces no visible change.
+     *   epoch_stale  a block's occupancy generation no longer matched.
+     *   epoch_high_water  largest generation gap seen.
+     *
+     * del_hit / del_miss: del_ram found a live mirrored window (0) or not
+     * (-1).  Together with ram_reuse these settle "why did 704 dels retire
+     * only 4 slots" without reasoning about the never-mirror list. */
+    uint64_t ram_reuse, epoch_stale, epoch_high_water;
+    uint64_t del_hit, del_miss;
+    uint64_t retired_hit;
+    uint64_t flush_smc, flush_ic, flush_full;  /* why translations were dropped */
+    uint64_t chained, ijc_fills, ijc_resets;
+    uint64_t xchained;
+    uint64_t kick_src[5];     /* exit_req set by: a request (TLBI), hv_cpu_wake, kick_all, hv_machine_wake, the CPU itself */        /* of them, exits to another page (TLB-checked) */
+    uint64_t syncs, sync_ticks;        /* TLBI acks waited for, and host ticks spent waiting */
+    uint64_t dev_waits, dev_wait_ticks; /* device lock taken while another CPU held it */
+    uint64_t tr_waits, tr_wait_ticks;   /* translation lock likewise */
+    uint64_t words_inline, words_ool, words_pool; /* translated code size by part */
+    uint64_t refills;
+    uint64_t ijc_light;       /* branch-cache misses resolved without the dispatcher (hv_ijc_resolve) */         /* TLB misses filled by the light path (hv_tlb_refill) */
+    uint64_t stash_saves, stash_hits, stash_entries; /* user TLB entries kept across process switches */
+    uint64_t code_protects;   /* pages that became code (every CPU's TLB scanned for writable entries) */
+    uint64_t tlb_miss_kind[4]; /* TLB misses: EL0 empty, EL0 other page there, EL1 empty, EL1 other page there */
+    uint64_t slow_why[6];     /* slow accesses by cause: MMIO, code-page write, page end, TLB miss, other, TLB entry there but mismatched */
+    uint64_t slow_kind[12];   /* hv_mem_emulate calls by HV_MEM_* kind */
+    uint64_t light_kind[4];
+    uint64_t light_fail[4];
+    uint64_t light_walks;
+    uint64_t fast_resumes;
+    uint64_t fr_fail[5];    /* SVCs and ERETs that went to their block without the dispatcher */
+    uint64_t protect_kind[3]; /* a page becoming code, per CPU: not mapped writable, one entry, scan */
+    uint64_t light_region[2]; /* user light fills: in the shared region (0x18..0x28 << 28), elsewhere */
+    uint64_t chained_early;   /* exits chained as their block was placed */
+    uint64_t wfe_waits;       /* WFEs that waited on the monitored word in place */
+    uint64_t kind_insns[16], kind_words[16]; /* --stats: inline words by instruction kind (HvInsnKind), as translated */
+    uint64_t posted_kind[4];
+    uint64_t race_kind[3];    /* remote drops that raced: walk under way, cache fill under way, either during the drop */  /* TLBIs other CPUs had to do themselves: a page or small range that raced, a big range, the rest (ASID, all) */
+    uint64_t range_spared;    /* big user-range TLBIs that needed no cached targets dropped */
+    uint64_t kernel_ranges;   /* big kernel-range TLBIs, dropped by range rather than with everything */
+    uint64_t tlb_range_flushes; /* and that dropped only the TLB entries in the range */     /* of hv_ijc_resolve's lookups, ones that walked for the target page */   /* hv_ijc_resolve could not: chaining off/odd target, filters full, no TLB entry, block not made yet */   /* the same for hv_ijc_resolve's fills */
+    uint64_t fill_kind[4];    /* ijc fills into an empty slot, over another live salt, over the same salt, over a dead salt */
+    uint64_t reset_why[8];    /* cache drops: full flush, TLBI by ASID, TLBI user VA, TLBI kernel VA, code change, user VA in every ASID (whole user half), keyed filter full, big user range */
+    uint64_t why[6];          /* dispatcher entries by cause: chain fill, kick, exception/sysreg, interrupt, cached target, cache miss */
+    uint64_t miss_kind[7];    /* cache misses by the branch that missed: RET, BR/BLR, B/BL, conditional, MSR, other, unknown */
+    uint64_t recent[16];      /* debugging: the last blocks the dispatcher entered (pc | el) */
+    struct { uint64_t from, to, spsr; uint32_t kind, el; } elchg[16]; /* debugging: last exception entries (kind = type) and ERETs (kind 9) */
+    uint32_t nelchg;
+    uint64_t nrecent;
+    uint64_t translate_ticks, translated_insns, translated_words; /* time spent translating, guest and host code size */
+    uint64_t retrans_va, retrans_vapa; /* translations of a VA (and VA+PA) translated before: diagnostics */
+    uint64_t helper[12];      /* by HV_OP_* */
+    uint64_t tlb_flushes, fetch_walks, exceptions, interrupts;
+    uint64_t wfi, wfi_ticks;  /* WFI exits, host ticks spent asleep */
+} HvStats;
+
+#define HV_WHINT_MANY (1ull << 63) /* whint: more than three; else up to three TLB codes + 1, 16 bits each */
+
+/* What each CPU has to itself and keeps across hv_cpu_reset (tests copy HvCpu
+   structs around, so it lives here, by CPU index): its indirect-branch cache and
+   the filters for dropping entries from it, the front cache of blocks, its
+   interrupt lines and its wakeup. */
+/* A process's user TLB entries, put aside when it is switched out (TTBR0 now
+   names another address space) and put back when it comes back, as a TLB
+   tagged by ASID keeps them. Any TLBI that could touch the address space
+   (here or from another CPU) bumps gen; a stash whose gen moved is dropped. */
+#define HV_STASHES 8
+#define HV_STASH_CAP 1024
+typedef struct HvTlbStash {
+    uint64_t ttbr0;      /* the address space (0: empty); read by other CPUs */
+    uint32_t gen;        /* bumped by TLBIs (atomic) */
+    uint32_t saved_gen;  /* gen when the entries were saved */
+    uint32_t n;
+    uint64_t used;       /* for replacing the least recently saved */
+    uint16_t *slot;      /* slot << 2 | table, as user_fills */
+    HvTlbEntry *ent;
+} HvTlbStash;
+
+typedef struct HvPerCpu {
+    /* Interrupt lines into this CPU.
+     *
+     * AUTHORITY: whoever owns the GIC owns these.  Standalone (HengeVM and the
+     * AppleVM build) that is this engine, and its GIC writes them.  Under the
+     * QEMU accelerator they are DERIVED and diagnostic only -- see
+     * irq_line_get below, which is what the dispatcher actually consults.
+     *
+     * They stay adjacent and 8-byte aligned because translated code can read
+     * both with one load through HvCpu.lines_ptr; after the read-through
+     * change that load exists only for hv_engine_get_irq/monitor display. */
+    int irq_line, fiq_line;
+    uint64_t unmask_n;       /* inline MSR DAIFClr executions (diagnostic; JIT-incremented) */
+    uint64_t daif_cont;      /* of those, how many carried on (copy was empty) */
+    uint64_t *ijc;           /* indirect-branch cache tables (cpu->ijc points here) */
+    uint64_t ijc_pages[2][1024]; /* hashed bitmap of the user pages any process cached targets in (for all-ASID TLBIs) */
+    /* Hashed bitmap of (page, salt) pairs with cached targets: a TLBI for one
+       address space drops its entries only if that address space cached
+       something in the page. A new salt makes old bits meaningless, so this is
+       only cleared (with the whole cache) when it gets an eighth full. */
+    uint64_t ijc_keyed[1 << 14];
+    uint32_t ijc_keyed_count;
+    uint32_t ijc_tables_used; /* bit per flags value whose table was ever filled */
+    /* Exactly which (user id, user page) pairs have cached targets: a hash set,
+       so unmapping a big range of one address space drops only its code pages'
+       entries instead of the whole address space's. Emptied with the user half. */
+    uint64_t *ucode;
+    uint32_t ucode_count;
+    /* Per user id: which 32 MB chunks of its VA (hashed into 256) have cached
+       targets, so a TLBI for a big range elsewhere (data, nearly always) drops nothing. */
+    uint64_t (*cid_chunks)[4];
+    uint64_t last_fill[2];
+    /* Per half, hashed by (page ^ salt): which 256-byte pieces of the page have
+       cached targets, so dropping a page clears 64 entries per piece instead of
+       all 4096. A slot two keys wanted is spoiled (key ~0: scan it all); only
+       this CPU empties one again, after clearing its page. */
+    struct { uint64_t key, bits; } ijc_hint[2][4096];   /* page ^ salt of the last fill in each half: its filter bits are set already */
+    /* Direct-mapped cache in front of the hash, with the VA beside the block so
+       a slot holding another block is passed over without reading it. */
+    struct { uint64_t va; struct HvBlock *b; } jc[1 << HV_JC_BITS];
+    /* WFI sleeps on this; device threads, the GIC and other CPUs signal it. */
+    pthread_mutex_t wake_mu;
+    pthread_cond_t wake_cv;
+    int wake_pending;
+    /* Work other CPUs ask of this one (only the owner may touch its TLB and
+       branch cache while it runs). Posting bumps req_seq; the owner does the
+       work at its next dispatcher entry and publishes ack_seq. */
+    pthread_mutex_t req_mu;
+    uint32_t req_flags;          /* HV_REQ_* */
+    uint32_t nreq;
+    struct { uint32_t op1, crn, crm, op2; uint64_t xt; } req[64]; /* TLBIs to apply */
+    uint64_t req_seq, ack_seq;
+    /* active: inside the dispatcher loop (0 while parked: WFI, powered off, at a
+       flush barrier). tlb_live: active and not itself waiting for acks, i.e. it
+       may be using TLB entries right now. */
+    int active, tlb_live;
+    uint32_t walk_seq;           /* odd while it walks page tables and fills its TLB (see hv_tlbi_drop_remote_va) */
+    uint32_t ijc_seq;            /* odd while it checks a block's mapping in its TLB and caches it (hv_ijc_fill_checked) */
+    HvTlbStash stash[HV_STASHES];
+    uint64_t stash_clock;
+    /* Bloom filters for >4 KB block/large-page descriptors expanded into 4 KB TLB entries,
+       so a single by-VA TLBI on a 2 MB / 1 GB / 16 KB / 64 KB mapping drops all sub-pages. */
+    uint64_t large_2m_bloom[64];
+    uint64_t large_big_bloom[8];
+    uint64_t last_refill_key;
+} HvPerCpu;
+
+#define HV_REQ_TLB_ALL 1u   /* drop the whole TLB and branch cache */
+#define HV_REQ_IJC_RESET 2u /* drop the branch cache (code changed) */
+
+typedef struct HvMachine {
+    HvRam ram[HV_MAX_RAM];
+    int nram;
+    HvRam *main_ram;     /* the largest region: guest RAM */
+    HvMmio mmio[HV_MAX_MMIO];
+    int nmmio;
+
+    HvJitRegion jit;
+    HvBlock *hash[HV_BLOCK_HASH];
+    HvBlock *blocks;
+    int nblocks;
+    uint32_t max_blocks, max_slots; /* sized from the JIT region (machine.c) */
+    int flush_pending;   /* set by helpers; the dispatcher flushes once the block has left */
+    /* Set by a host that changes the RAM map (a QEMU MemoryListener, after a
+       region was removed or its read-back mode changed).  hv_flush_blocks()
+       normally only empties the software TLB when the *layout* changes; for a
+       RAM change it must empty every entry on every CPU, because the entries
+       point at host memory the guest may no longer read directly.  Cleared by
+       hv_flush_blocks() once it has done so.  Set together with
+       flush_pending, and always from a thread that will not touch any TLB
+       itself: the flush happens later, on a vCPU, with everybody parked --
+       the only moment the layout may change (see hv_flush_blocks). */
+    int need_tlb_flush;
+    /* Phase 1 acceptance instrumentation (HV_DBG_FLUSH): how long a deferred
+       invalidation took to actually run.  The window is real and this is its
+       measurement, so "0 violations" is never read as "0 window". */
+    int dbg_flush;
+    uint64_t flush_req_ns;
+    uint64_t flush_reqs;
+    uint64_t flush_max_ns;
+    uint64_t flush_sum_ns;
+
+    void *gic;
+    /* Devices: called between blocks every so often and while the CPU waits.
+       Returns the host time (mach_absolute_time units) of the next timer event, or 0. */
+    uint64_t (*tick)(struct HvMachine *m, HvCpu *cpu);
+    void *tick_opaque;
+    /* GIC CPU interface system registers (ICC_*_EL1), reg = op0:op1:CRn:CRm:op2. */
+    uint64_t (*icc_read)(struct HvMachine *m, HvCpu *cpu, uint32_t reg);
+    void (*icc_write)(struct HvMachine *m, HvCpu *cpu, uint32_t reg, uint64_t v);
+
+    uint64_t stop_pc;    /* tests: leave the dispatcher when pc reaches this */
+    void (*stop_hook)(HvCpu *cpu); /* debugging: call this there instead of leaving */
+    uint64_t stop_pc2;   /* debugging: a second such place */
+    uint32_t jit_gen;    /* full flushes so far, as blocks see them (HV_JIT_POISON checks) */
+    int gen_checks;
+    int trace;           /* print every block entered */
+    int log;             /* 1: unknown sysregs, undefined instructions, unmapped accesses; 2: also every exception */
+    int slow_mem;        /* tests: send every load and store through hv_mem_emulate */
+
+    /* ---- seams: what a host with its own device models takes over ----
+       All three default to 0, which is exactly the standalone behaviour. A
+       host that owns the devices (QEMU) sets them, and the engine stops
+       pretending to be the machine it cannot see. Being flags rather than
+       #ifdefs is deliberate: the standalone build and the hosted build then
+       run the same code paths, so a change that breaks one is caught by the
+       other's tests. */
+    /* An MRS/MSR the engine does not model: leave the block with
+       HV_EXIT_SYSREG_EXT instead of injecting UNDEF, so the host can answer it
+       from its own register table (QEMU's cpu->cp_regs) and hand back the
+       value. Without this the engine's idea of "unimplemented" decides what
+       the guest sees, which is wrong the moment the host has registers the
+       engine never will (ICC_*, CNTV_CVAL, ...). */
+    /* ---- the time base ----
+       The engine counts in its own domain (counter(), 24 MHz on this port) and
+       compiles nothing into the guest that depends on it being guest time --
+       on Linux counter reads go through the MRS helper, not inline code, so
+       converting here costs a multiply and nothing else.
+
+       timer_freq is the guest's CNTFRQ and comes from the host's timer model,
+       not from a #define.  scale converts counter() ticks to timer_freq ticks.
+       epoch is the difference between the two clocks at the last calibration:
+       guest ticks = scaled(counter()) - epoch.  A virtual clock that freezes
+       while the VM is stopped (QEMU's) makes host and guest diverge whenever
+       the guest is paused, so epoch is re-taken on every resume.
+
+       Defaults (freq 24000000, scale 1/1, epoch 0) are exactly the standalone
+       behaviour. */
+    uint64_t timer_freq;
+    uint64_t timer_scale_num, timer_scale_den;
+    uint64_t timer_epoch;
+    int sysreg_external;
+    /* ICC_* 单独一位：翻权威期 ICC 回引擎、ID/PSCI 仍走 QEMU。 */
+    int icc_external;
+    /* SMC/HVC: leave the block instead of running the built-in PSCI, so the
+       host's PSCI conduit owns CPU_ON/CPU_OFF. The in-engine version resets
+       the target CPU itself, which a host that owns CPU objects (QEMU and its
+       vCPU threads) must not have happen behind its back. */
+    /* LSE (ARMv8.1 atomics: LDADD/LDCLR/CAS/SWP and friends) is implemented by
+       the translator, so it executes whatever the guest's ID register claims.
+       INITIALISED TO 1 BY hv_machine_init() -- that is the standalone behaviour
+       and it must not change -- and a host that owns the ID registers sets it
+       from what it actually advertises. Under QEMU that matters: -cpu
+       cortex-a57 advertises ATOMIC=0, so a guest probing for LSE is told "no",
+       yet the engine would still execute it. TCG traps instead. */
+    int feat_lse;
+
+    /*
+     * Interrupt level, read through -- the single-owner rule.
+     *
+     * HvPerCpu.irq_line/fiq_line are a *copy*.  Whoever writes them and
+     * whoever delivers interrupts must be the same party, or the copy goes
+     * stale between a device lowering the line and the dispatcher looking.
+     * ARM makes this load-bearing: CPU_INTERRUPT_HARD is cleared ONLY by the
+     * GIC dropping the line (target/arm/cpu.c arm_cpu_set_irq), never by the
+     * delivery path, so a stale-high level is indistinguishable from a real
+     * pending interrupt and the guest livelocks in cpu_do_idle().
+     *
+     * So the owner installs this hook and the engine asks it at every block
+     * boundary instead of trusting its own copy:
+     *
+     *   - QEMU accelerator: reads cs->interrupt_request atomically.  That is
+     *     exactly MTTCG's own model -- the vCPU thread reads the flag at every
+     *     TB boundary while an iothread may be setting it with qatomic_or, and
+     *     nobody claims the reader has a private copy.
+     *   - Standalone (AppleVM): reads its own GIC, i.e. the same bytes as
+     *     pc_state, so it is a no-op indirection there and both builds stay
+     *     structurally identical.
+     *
+     * NULL means "no hook": the engine then falls back to pc_state, which is
+     * the pre-read-through behaviour.  Kept so this file still builds and runs
+     * standalone without a host shim.
+     *
+     * Memory order: the writer publishes with a release store and the reader
+     * uses an acquire load, so a line raised before a kick is visible to the
+     * block the kick causes.  Return 1 for asserted, 0 for not.
+     */
+    int (*irq_line_get)(void *ctx, unsigned cpu_index, int fiq);
+    /* Opaque to the engine: the host's way back from cpu_index to its own CPU
+     * object.  Passed straight through to irq_line_get. */
+    void *irq_line_ctx;
+
+    uint64_t stat_slow_mem; /* hv_mem_emulate calls */
+    uint64_t access_pc;  /* guest PC of the load/store being emulated, for logs */
+    uint64_t watch_va;   /* debugging: log every write that touches this guest VA (0: off) */
+    uint64_t watch_pa;   /* debugging: the same by physical address */
+    HvStats stats;
+    int chain;               /* block chaining and the indirect-branch cache are enabled */
+    uint64_t *slots;         /* chainable exits' targets (0: not chained) */
+    uint32_t **slot_site;    /* the B in each exit's stub that chaining rewrites to jump to the target */
+    uint32_t **slot_stub;    /* what that B goes to while it isn't chained */
+    uint32_t **slot_cond;    /* a conditional branch in a block's hot part that chaining may send straight to the target too */
+    /* Exits to another page (see put_branch_exit): the host addend the target
+       page's TLB entry must hold for the exit to go straight to the chained
+       block (0: a same-page exit), and once chained, the target's physical page
+       (| 1) so that invalidating its code can unchain it. xchained lists them. */
+    uint64_t *slot_xa, *slot_xpa;
+    uint32_t *xchained, nxchained;
+    uint32_t nslots;
+    HvCpu *cpu;              /* CPU 0: the one that polls devices */
+    HvCpu *cpus[HV_MAX_CPUS]; /* every CPU, so device and invalidation code can ask them to leave */
+    int ncpus;
+    HvPerCpu percpu[HV_MAX_CPUS];
+    /* With more than one CPU, only the holder of this runs guest code (a fair
+       ticket lock, handed over at every kick and while a CPU sleeps). */
+    int big_lock_on;
+    /* 翻权威期：引擎 GIC 置线后桥接到宿主 vCPU 唤醒（影子期不用）。 */
+    void (*wake_hook)(void *opaque, int cpu_index);
+    void *wake_hook_opaque;
+    /* 影子 machine：GIC 只读计算，不叫醒任何 CPU */
+    int shadow;
+    /* Devices, the GIC and the ICC registers: one CPU at a time (recursive). */
+    pthread_mutex_t dev_mu;
+    /* Translating and inserting blocks, the JIT region and the slots. */
+    pthread_mutex_t tr_mu;
+    /* Stopping every CPU to flush all translations. */
+    pthread_mutex_t stw_mu;
+    pthread_cond_t stw_cv;
+    int stw_active;
+    pthread_mutex_t big_mu;
+    pthread_cond_t big_cv;
+    uint64_t big_next, big_serving;
+    int stats_interval;  /* seconds between --stats lines, 0 = off */
+    /* --profile: host PCs of the CPU thread sampled every millisecond, drained by the stats line. */
+    uint64_t *prof;
+    uint32_t prof_head, prof_tail;
+} HvMachine;
+
+static inline uint32_t hv_block_hash(uint64_t va, uint64_t pa, uint32_t flags) {
+    uint64_t h = (va >> 2) ^ (pa >> 2) * 0x9e3779b97f4a7c15ull ^ flags;
+    return (uint32_t)(h ^ (h >> 29)) & (HV_BLOCK_HASH - 1);
+}
+
+/* Lock-free: blocks are only added (release store) until a flush, which stops every CPU. */
+static inline HvBlock *hv_block_find(HvMachine *m, uint32_t h, uint64_t va, uint64_t pa, uint32_t flags, uint32_t gen) {
+    for (HvBlock *b = __atomic_load_n(&m->hash[h], __ATOMIC_ACQUIRE); b; b = __atomic_load_n(&b->next, __ATOMIC_ACQUIRE)) {
+        if (b->va == va && b->pa == pa && b->flags == flags && b->gen == gen) {
+            /*
+             * The generation test above is per page and cannot tell one
+             * occupancy of a RAM slot from the next: page_gen is freed and
+             * reallocated by add_ram() and starts at zero again, so a block
+             * made from the previous occupant matches whenever its own gen was
+             * 0.  b->ram points at the same HvRam either way, because slots are
+             * reused in place, so nothing else in this comparison notices.
+             *
+             * ram_epoch does, and it is the last check available here -- any
+             * block that gets past it is returned to the dispatcher, which
+             * jumps straight into code translated against memory the guest may
+             * no longer own.
+             *
+             * (Scope, so nobody re-derives the wrong lesson: 13.35 measured
+             * 4 reuses per disk boot with zero live blocks on the slot each
+             * time, so this particular aliasing has never been observed.  The
+             * retired-window case is the one with a real NULL in it, and it is
+             * covered by the same counter plus the size test in lookup().)
+             */
+            if (b->ram_epoch != b->ram->epoch) {
+                m->stats.epoch_stale++;
+                {
+                    uint32_t d = b->ram->epoch - b->ram_epoch;
+                    if (d > m->stats.epoch_high_water) m->stats.epoch_high_water = d;
+                }
+                /* Counted only; this header has no stdio. */
+                return NULL;
+            }
+            return b;
+        }
+    }
+    return NULL;
+}
+
+int hv_machine_init(HvMachine *m, size_t jit_bytes);
