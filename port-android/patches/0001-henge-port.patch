+#!/bin/sh
+# Refresh the vendored engine copy from the reference tree.
+#
+#   ./sync-from-upstream.sh            copy upstream, re-apply local-edits.patch
+#   ./sync-from-upstream.sh --check    verify only, exit 1 on any drift
+#
+# The reference tree is read-only by policy (see VENDORED-FROM): nine rounds of
+# measurements were taken against it, so it is the ground truth, not a working
+# copy.  Everything QEMU-specific lives outside engine/, in ../.
+#
+# Why the patch is applied here rather than left to the reader: the copy is not
+# upstream, it is upstream plus local-edits.patch.  A refresh that silently
+# dropped the local edits would compile (the seams default to off) and then
+# behave as a plain host-less engine -- no ID registers, no PSCI, no clock
+# alignment -- which is a working binary with three quarter of the port missing.
+# So a refresh without a cleanly-applying patch is a hard failure.
+set -e
+
+HERE=$(cd "$(dirname "$0")" && pwd)
+UP=${HENGE_UPSTREAM:-/data/用户/项目/qemu-acce/src/WindowsiOS}
+PORT=${HENGE_PORT:-/data/用户/项目/qemu-acce/port-android}
+PATCH=local-edits.patch
+
+[ -d "$UP/core" ] || { echo "sync: no engine at $UP (set HENGE_UPSTREAM)" >&2; exit 1; }
+[ -f "$HERE/$PATCH" ] || { echo "sync: missing $PATCH" >&2; exit 1; }
+
+check=0
+[ "$1" = "--check" ] && check=1
+
+stage=$(mktemp -d)
+trap 'rm -rf "$stage"' EXIT
+
+mkdir -p "$stage/core" "$stage/compat/mach" "$stage/compat/libkern" "$stage/host"
+cp "$UP"/core/*.c "$UP"/core/*.h            "$stage/core/"
+cp "$PORT"/compat/TargetConditionals.h \
+   "$PORT"/compat/hv_posix_compat.h \
+   "$PORT"/compat/plat_linux.c               "$stage/compat/"
+cp "$PORT"/compat/mach/*.h                   "$stage/compat/mach/"
+cp "$PORT"/compat/libkern/*.h                "$stage/compat/libkern/"
+cp "$UP"/host/jit_region.h                   "$stage/host/"
+cp "$PORT"/jit_region_linux.c                "$stage/host/"
+# enter.S carries Mach-O underscore prefixes (_hv_enter); ELF wants none.  The
+# upstream file is never edited -- the stripped copy is generated here.
+sed -e 's/\b_hv_/hv_/g' "$UP"/host/enter.S > "$stage/host/enter_elf.S"
+
+# Apply the local edits to the staged copy: that is the target state.
+( cd "$stage" && patch -p1 --forward --silent < "$HERE/$PATCH" ) || {
+    echo "sync: $PATCH does not apply to upstream $(git -C "$UP" rev-parse --short HEAD 2>/dev/null) --" >&2
+    echo "sync: upstream changed under it.  Rebase the patch, do not drop it." >&2
+    exit 1
+}
+
+if [ $check -eq 1 ]; then
+    if diff -r -q "$stage" "$HERE" \
+        --exclude=VENDORED-FROM --exclude=sync-from-upstream.sh --exclude="$PATCH"; then
+        echo "sync: clean"
+        exit 0
+    fi
+    echo "sync: drift, run without --check to copy" >&2
+    exit 1
+fi
+
+for d in core compat host; do
+    if ! diff -r -q "$stage/$d" "$HERE/$d" >/dev/null 2>&1; then
+        echo "sync: updating $d/"
+        cp -a "$stage/$d/." "$HERE/$d/"
+    fi
+done
+echo "sync: done (upstream $(git -C "$UP" rev-parse --short HEAD 2>/dev/null || echo '?'), $PATCH applied)"
diff --git a/accel/henge/henge-accel-ops.c b/accel/henge/henge-accel-ops.c
new file mode 100644
index 0000000000..57ce4c2f12
--- /dev/null
+++ b/accel/henge/henge-accel-ops.c
@@ -0,0 +1,550 @@
+/*
+ * Henge accelerator: AccelOpsClass side (the vCPU thread)
+ *
+ * The lock order is copied from accel/tcg/tcg-accel-ops-mttcg.c, and that is
+ * the whole point: QEMU's BQL is a global lock, but MTTCG deliberately drops
+ * it around execution:
+ *
+ *     bql_unlock();
+ *     r = tcg_cpu_exec(cpu);
+ *     bql_lock();
+ *
+ * Our engine is itself multi-threaded (one thread per vCPU, each with its own
+ * TLB), so holding the BQL while running would serialize SMP down to one core.
+ * Dropping it is safe for the same reason it is safe for MTTCG: everything the
+ * engine touches during execution is either guest RAM (whose host pointer we
+ * mirrored) or its own state, and every QEMU-side change of memory layout takes
+ * the BQL and notifies our MemoryListener, which flushes the engine's TLB.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "qemu/main-loop.h"
+#include "qemu/guest-random.h"
+#include "qemu/timer.h"
+#include "qemu/thread.h"
+#include "accel/accel-cpu-ops.h"
+#include "system/cpus.h"
+#include "system/runstate.h"
+#include "system/memory.h"
+#include "system/address-spaces.h"
+#include "hw/core/cpu.h"
+#include "target/arm/cpu.h"
+#include "target/arm/cpu-features.h"
+#include "system/henge-accel.h"
+#include "system/henge-engine.h"
+#include "exec/cpu-interrupt.h"
+
+/* The engine's per-CPU array is HV_MAX_CPUS entries; mirror that bound here
+ * rather than including the engine's cpu.h into a QEMU translation unit. */
+#define HV_MAX_CPUS_SHIM 8
+
+static HvCpu *henge_cpu_of(CPUState *cs)
+{
+    return (HvCpu *)cs->opaque;
+}
+
+/* henge-cpu.c: answer an exit that is really "QEMU owns this register/call".
+ * Returns true if it was serviced and the engine should simply be re-entered. */
+bool henge_service_external_exit(CPUState *cs, HvCpu *cpu, int r);
+
+/* henge-accel.c: the engine's clock, and its two interrupt input lines. */
+void henge_timer_setup(HvMachine *m, uint64_t freq);
+void henge_timer_calibrate(HvMachine *m);
+
+/*
+ * Copy QEMU's interrupt-request bits onto the engine's two level lines.
+ *
+ * CPU_INTERRUPT_HARD is what the GIC's IRQ output sets through
+ * arm_cpu_set_irq(); CPU_INTERRUPT_FIQ is CPU_INTERRUPT_TGT_EXT_1.  Nothing
+ * here looks at PSTATE: the engine applies DAIF itself in
+ * hv_check_interrupts(), against the live PSTATE rather than QEMU's env, which
+ * mid-run is whatever it was at the last synchronisation.
+ *
+ * CPU_INTERRUPT_EXITTB is deliberately ignored.  QEMU uses it to make a
+ * translated block end after a memory-map change; the engine needs no such
+ * kick because every block checks its page's generation when it is entered, so
+ * an invalidated translation is discovered at the next fetch rather than by a
+ * signal.  Treating it as HARD would deliver a phantom interrupt.
+ */
+static void henge_sync_irq(CPUState *cs, HvCpu *cpu)
+{
+    uint32_t req = cs->interrupt_request;
+    int hard = !!(req & CPU_INTERRUPT_HARD);
+
+    hv_engine_set_irq(cpu, hard, !!(req & CPU_INTERRUPT_FIQ));
+    if (henge_tracing(HENGE_TRACE_IRQ)) {
+        /*
+         * Previous level per CPU, not a file-static: with -smp > 1 every vCPU
+         * thread runs this, and one shared "last" would report a change every
+         * time a different CPU got here (and race besides).
+         */
+        static int last[HV_MAX_CPUS_SHIM];
+        unsigned i = cs->cpu_index < HV_MAX_CPUS_SHIM ? cs->cpu_index : 0;
+
+        if (hard != last[i]) {
+            fprintf(stderr, "henge: cpu%u irq line -> %d "
+                    "(interrupt_request=0x%x)\n", cs->cpu_index, hard, req);
+            last[i] = hard;
+        }
+    }
+}
+
+/*
+ * Turn an engine exit into whatever QEMU expects the vCPU thread to do next.
+ *
+ * Read this together with the exit enum: the engine only comes back out of
+ * hv_run() for things it cannot handle itself, because branches, exceptions,
+ * system registers and self-modifying code are all dealt with inside the run
+ * loop.  That is why there is no HV_EXIT_MMIO here -- device accesses are
+ * serviced inline through henge_mmio_forward() and never unwind the loop.
+ */
+static void henge_dispatch_exit(CPUState *cs, int r)
+{
+    switch (r) {
+    case HENGE_EXIT_HALT:
+        /* PSCI CPU_OFF, or the guest asked to stop: idle until something
+         * wakes us (an interrupt, or the monitor). */
+        cs->halted = 1;
+        break;
+
+    case HENGE_EXIT_WFI:
+        /*
+         * The guest executed WFI/WFE.  With no timer wired yet this is
+         * indistinguishable from halted; the difference only matters once the
+         * generic timer can wake us (see the TODO in henge-cpu.c).
+         */
+        cs->halted = 1;
+        break;
+
+    case HENGE_EXIT_NONE:
+    case HENGE_EXIT_BRANCH:
+    case HENGE_EXIT_SYSREG:
+    case HENGE_EXIT_EXCEPTION:
+    case HENGE_EXIT_FLUSH:
+        /* Internal states that should have been consumed by the dispatcher
+         * before returning.  Looping again is the safe response. */
+        break;
+
+    case HENGE_EXIT_UNDEF:
+    case HENGE_EXIT_UNSUPPORTED:
+    case HENGE_EXIT_FAULT_LOOP:
+    default:
+        /*
+         * Not recoverable by going around again: the translator cannot encode
+         * this instruction (or the guest is dead).  Spinning here would turn a
+         * clear failure into a hang, which is the one outcome that costs a day
+         * to diagnose.  Stop the whole VM and say where.
+         */
+        error_report("henge: vCPU %d stopped at pc=0x%016" PRIx64
+                     ", exit reason %d (%s)", cs->cpu_index,
+                     (uint64_t)ARM_CPU(cs)->env.pc, r,
+                     r == HENGE_EXIT_UNDEF ? "undefined instruction" :
+                     r == HENGE_EXIT_UNSUPPORTED ? "untranslatable instruction" :
+                     r == HENGE_EXIT_FAULT_LOOP ? "exception vector faulted" :
+                     "unknown");
+        vm_stop(RUN_STATE_INTERNAL_ERROR);
+        cs->halted = 1;
+        break;
+    }
+}
+
+static void *henge_cpu_thread_fn(void *arg)
+{
+    CPUState *cs = arg;
+    HvCpu *cpu;
+    /*
+     * Per-vCPU exit tally, for one question only: is this vCPU looping
+     * without making progress?
+     *
+     * The shape of the nohz failure -- an *idle* CPU taking more interrupts
+     * than the busy one, then an RCU stall 30 s later -- has two candidate
+     * mechanisms that look identical from the guest side, and the difference
+     * decides where the fix goes:
+     *
+     *   a) the guest really is idle and the tick is still firing at HZ (the
+     *      engine hands back a phantom level because a level copied at three
+     *      sync points cannot track QEMU's edge-latched CPU_INTERRUPT_HARD);
+     *   b) the vCPU never parks at all.  qemu_process_cpu_events() blocks on
+     *      cpu_thread_is_idle(), which returns false while
+     *      arm_cpu_has_work(cs) is true -- and that is true exactly while
+     *      CPU_INTERRUPT_HARD is set.  henge never calls cpu_reset_interrupt(),
+     *      so if the flag ever outlives the interrupt inside the engine, this
+     *      thread spins: hv_run -> WFI -> halted=1 -> not idle -> hv_run...
+     *
+     * In (a) hv_run returns HENGE_EXIT_WFI a few hundred times a second.  In
+     * (b) it returns thousands to millions of times a second, in an unbroken
+     * streak, because nothing between the returns ever blocks.  So the
+     * discriminator is the longest unbroken WFI streak, not the rate.
+     *
+     * Kept as `static` per-CPU counters rather than a struct member: HvCpu is
+     * private to the engine and this TU may not see it.
+     */
+    static struct {
+        uint64_t runs, wfi, halt, other;
+        uint64_t streak, max_streak;
+        int64_t  last_wfi_ns;
+    } ex[HV_MAX_CPUS_SHIM];
+    unsigned cix = cs->cpu_index < HV_MAX_CPUS_SHIM ? cs->cpu_index : 0;
+
+    rcu_register_thread();
+
+    bql_lock();
+    qemu_thread_get_self(cs->thread);
+    cs->thread_id = qemu_get_thread_id();
+    current_cpu = cs;
+
+    /*
+     * Bridge, step 1 of 2: QEMU has already built the CPUARMState (arm_load_kernel
+     * ran cpu_set_pc() on it after arm_cpu_reset_hold() zeroed env->pc), so the
+     * entry point lives in ARM_CPU(cs)->env, NOT in anything the engine knows.
+     * Read it here, on the vCPU thread, before the first hv_run().
+     */
+    cpu = henge_cpu_of(cs);
+    if (hv_engine_load_state(cpu, &ARM_CPU(cs)->env) != 0) {
+        /* The message is already printed; there is no sane way to run the
+         * guest with the wrong privilege level. */
+        cpu_thread_signal_created(cs);
+        cpu_thread_signal_destroyed(cs);
+        bql_unlock();
+        rcu_unregister_thread();
+        return NULL;
+    }
+
+    /*
+     * CNTFRQ comes from the CPU object QEMU built, not from any constant in
+     * this accelerator: it is the frequency the host's gtimer divides its
+     * virtual clock by, so it is also the frequency the guest's deadlines are
+     * expressed in.  Read it once, after the CPU is realized.
+     */
+    henge_timer_setup(henge_accel_machine(), ARM_CPU(cs)->gt_cntfrq_hz);
+
+    cpu_thread_signal_created(cs);
+    qemu_guest_random_seed_thread_part2(cs->random_seed);
+
+    /*
+     * The parking of a halted vCPU happens in qemu_process_cpu_events(), not
+     * here, and that is worth stating because it is not obvious from reading
+     * this loop: cpu_can_run() only looks at ->stop and ->stopped, never at
+     * ->halted.  What keeps a -smp 4 guest's three idle secondaries out of
+     * hv_run() is cpu_thread_is_idle() (system/cpus.c), which returns false
+     * when ->halted is clear and otherwise calls our
+     * henge_vcpu_thread_is_idle(); the thread then blocks on cpu->halt_cond
+     * with the BQL released.  It is woken by kick_vcpu_thread -> hv_cpu_wake.
+     * If henge_vcpu_thread_is_idle() ever reported "not idle" for a halted
+     * CPU, four threads would enter the engine with a stale PC.
+     */
+    do {
+        /*
+         * No env re-sync here, deliberately.  There is no hook that fires after
+         * QEMU rewrites a parked vCPU's env: cpu_synchronize_post_reset() is
+         * called explicitly and only by s390x, so ARM's reset path never
+         * reaches an accelerator through it (checked: the only callers are
+         * target/s390x/sigp.c and the nvmm ops table).  The one place that does
+         * rewrite env for a parked CPU -- PSCI CPU_ON -- is handled where it
+         * happens instead; see henge_service_psci().
+         */
+        qemu_process_cpu_events(cs);
+
+        if (cpu_can_run(cs)) {
+            int r;
+
+            cs->halted = 0;
+            /*
+             * The counterpart to henge_kick_vcpu_thread()'s request_stop():
+             * a stop the host pulled left the engine's halted set, and
+             * run_loop() returns HV_EXIT_HALT immediately while it is.  Clearing
+             * it here -- only on the path that has already decided this vCPU may
+             * run -- keeps a resumed vCPU from spinning on HALT without ever
+             * executing an instruction.
+             */
+            hv_engine_cpu_clear_stop(cpu);
+
+            /*
+             * The GIC raises its line from another thread and kicks us; the
+             * kick only sets exit_req, so the line itself has to be copied
+             * across before re-entering the engine -- otherwise the engine
+             * goes back to sleep waiting for an interrupt that has already
+             * arrived.
+             */
+            henge_sync_irq(cs, cpu);
+
+            /* ---- the MTTCG lock order ---- */
+            bql_unlock();
+            /*
+             * Seam exits (an unmodelled system register, later PSCI) are not
+             * reasons to leave the vCPU thread: they are one instruction
+             * handed to QEMU.  Service each with the BQL held -- a cpreg's
+             * read/writefn can touch device state -- and go straight back into
+             * the engine.  The BQL is dropped again for each re-entry so the
+             * guest keeps running without it.
+             */
+            for (;;) {
+                r = hv_run(cpu);
+                ex[cix].runs++;
+                if (r == HENGE_EXIT_WFI) {
+                    int64_t now_ns = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+                    int64_t gap = now_ns - ex[cix].last_wfi_ns;
+
+                    ex[cix].wfi++;
+                    ex[cix].last_wfi_ns = now_ns;
+                    /*
+                     * Count the streak only while the returns are *tight*.
+                     * A correctly parked idle vCPU also returns WFI ~250 times
+                     * a second, but each return is separated by the time it
+                     * actually spent blocked on halt_cond, so the gap is
+                     * milliseconds.  A vCPU that never parks returns WFI back
+                     * to back and the gap collapses to microseconds.  50 us is
+                     * two orders of magnitude away from both.
+                     */
+                    ex[cix].streak = (gap >= 0 && gap < 50000)
+                                     ? ex[cix].streak + 1 : 1;
+                    if (ex[cix].streak > ex[cix].max_streak) {
+                        ex[cix].max_streak = ex[cix].streak;
+                        if (henge_tracing(HENGE_TRACE_IRQ) &&
+                            ex[cix].max_streak >= 1000) {
+                            fprintf(stderr, "henge: cpu%u tight WFI streak = "
+                                    "%" PRIu64 " (gap=%" PRId64 "us, runs=%"
+                                    PRIu64 ", hard=%d, halted=%d, req=0x%x)\n",
+                                    cix, ex[cix].max_streak, gap / 1000,
+                                    ex[cix].runs,
+                                    !!(cs->interrupt_request
+                                       & CPU_INTERRUPT_HARD),
+                                    cs->halted, cs->interrupt_request);
+                        }
+                    }
+                } else {
+                    ex[cix].streak = 0;
+                    ex[cix].last_wfi_ns = 0;
+                    if (r == HENGE_EXIT_HALT) {
+                        ex[cix].halt++;
+                    } else {
+                        ex[cix].other++;
+                    }
+                }
+                if (henge_tracing(HENGE_TRACE_IRQ)) {
+                    fprintf(stderr, "henge: hv_run returned %d\n", r);
+                }
+                if (r != HENGE_EXIT_SYSREG_EXT && r != HENGE_EXIT_PSCI_EXT) {
+                    break;
+                }
+                bql_lock();
+                henge_service_external_exit(cs, cpu, r);
+                /* A cpreg write can program a timer that fires immediately. */
+                henge_sync_irq(cs, cpu);
+                bql_unlock();
+            }
+            bql_lock();
+            /* ------------------------------ */
+
+            henge_sync_irq(cs, cpu);
+            henge_dispatch_exit(cs, r);
+        }
+    } while (!cs->unplug || cpu_can_run(cs));
+
+    /*
+     * Bridge, step 2 of 2: publish registers back so the monitor, gdbstub and
+     * "info registers" see what the guest actually did.
+     */
+    hv_engine_save_state(&ARM_CPU(cs)->env, cpu);
+
+    cpu_thread_signal_destroyed(cs);
+    bql_unlock();
+    rcu_unregister_thread();
+    return NULL;
+}
+
+static void henge_start_vcpu_thread(CPUState *cs)
+{
+    char thread_name[VCPU_THREAD_NAME_SIZE];
+    HvCpu *cpu;
+
+    /*
+     * Per-vCPU engine state.  Must use the _index variant: hv_cpu_reset()
+     * hardcodes index 0 and would make every vCPU alias m->cpus[0].
+     *
+     * Done here rather than in the thread function because
+     * henge_kick_vcpu_thread() may run before the thread does, and it needs
+     * cs->opaque to be valid.
+     */
+    cpu = hv_engine_cpu_new(henge_accel_machine(), cs->cpu_index);
+    if (!cpu) {
+        error_report("henge: cannot allocate engine state for cpu %d",
+                     cs->cpu_index);
+        exit(1);
+    }
+    hv_engine_cpu_set_mpidr(cpu, ARM_CPU(cs)->mp_affinity);
+
+    /*
+     * Tell the translator what this CPU model actually advertises.
+     *
+     * The engine's translator implements ARMv8.1 atomics unconditionally, so
+     * without this a guest running on a model whose ID_AA64ISAR0.ATOMIC reads
+     * zero gets LSE executed instead of UNDEF -- wider than the architecture,
+     * and a divergence from TCG that `work/probe/lse.S` measures directly.
+     *
+     * Read from QEMU's ID registers rather than from the engine's constants:
+     * sysreg_external forwards the ID group, so QEMU's value is what the guest
+     * sees and therefore the only correct input.
+     *
+     * Idempotent across CPUs: every CPU of a machine carries the same model, and
+     * setting it per vCPU keeps it right even if that ever stops being true.
+     */
+    /*
+     * LSE gate: ATTEMPTED AND REVERTED.
+     *
+     * The translator implements ARMv8.1 atomics unconditionally, and QEMU's
+     * ID_AA64ISAR0.ATOMIC for this tree's -cpu max is 0, so the guest is told
+     * "no LSE" while the engine would still execute it -- measured with
+     * work/probe/lse.S (LSE-OK on henge, UNDEF on TCG).  Calling
+     * hv_engine_set_lse(m, cpu_isar_feature(aa64_lse, ...)) closed that gap and
+     * made the probe match TCG, but it also stopped the Linux baseline booting
+     * at all (no serial output, killed at timeout), and the boot returns as
+     * soon as the gate is forced back on:
+     *
+     *     hv_engine_set_lse(m, 0) -> no output, dead
+     *     hv_engine_set_lse(m, 1) -> userspace alive, END=18.76
+     *
+     * So the guest really does execute something the gate classifies as
+     * LSE-class on a CPU model that claims no LSE, or the two ID views disagree
+     * (cpu_isar_feature vs. what the seam forwards).  Both are worth chasing,
+     * neither is settled, and a working baseline is worth more than a
+     * fidelity fix that bricks it.  Left off, and recorded rather than hidden.
+     */
+    /*
+     * HV_NO_LSE: drive the gate from the CPU model instead of forcing it on.
+     * Same getenv-in-the-accelerator style as the engine's own debug knobs, and
+     * here for the same reason: the alternative is a rebuild per bisect step,
+     * and this needs to be bisected on the phone.
+     */
+    hv_engine_set_lse(henge_accel_machine(),
+                      getenv("HV_NO_LSE")
+                          ? cpu_isar_feature(aa64_lse, ARM_CPU(cs)) != 0
+                          : 1);
+
+    cs->opaque = cpu;
+
+    snprintf(thread_name, VCPU_THREAD_NAME_SIZE, "CPU %d/Henge", cs->cpu_index);
+    qemu_thread_create(cs->thread, thread_name, henge_cpu_thread_fn, cs,
+                       QEMU_THREAD_JOINABLE);
+}
+
+static void henge_kick_vcpu_thread(CPUState *cs)
+{
+    if (!qemu_cpu_is_self(cs)) {
+        HvCpu *cpu = henge_cpu_of(cs);
+        if (cpu) {
+            /* Set the line before waking it: the engine re-checks the lines
+               the moment it leaves WFI, so a wake with a stale line just puts
+               it straight back to sleep. */
+            henge_sync_irq(cs, cpu);
+            hv_cpu_wake(cpu);
+            /*
+             * A kick alone does not bring the engine back: hv_cpu_wake() sets
+             * the engine's exit_req, which run_loop() consumes as "let another
+             * CPU have a turn" and then carries on executing.  So a vCPU with
+             * no reason of its own to leave ignores every host request --
+             * pause, shutdown, SIGTERM -- and the host waits for it forever.
+             * That is exactly what "reboot: Power down" followed by a QEMU that
+             * outlives twenty minutes of SIGTERM looked like.
+             *
+             * cs->stop is QEMU saying "stop executing now" (pause_all_vcpus,
+             * vm_stop).  Translate it into the engine's one interruptible
+             * exit, which it tests at the top of every loop iteration.
+             */
+            if (cs->stop) {
+                hv_engine_cpu_request_stop(cpu);
+            }
+        }
+    }
+}
+
+static bool henge_vcpu_thread_is_idle(CPUState *cs)
+{
+    return cs->halted;
+}
+
+/* Registers: QEMU is the reference on reset/init, the engine is afterwards. */
+static void henge_cpu_synchronize_state(CPUState *cs)
+{
+    HvCpu *cpu = henge_cpu_of(cs);
+    if (cpu) {
+        hv_engine_save_state(&ARM_CPU(cs)->env, cpu);
+    }
+}
+
+static void henge_cpu_synchronize_post_init(CPUState *cs)
+{
+    HvCpu *cpu = henge_cpu_of(cs);
+    if (cpu) {
+        hv_engine_load_state(cpu, &ARM_CPU(cs)->env);
+    }
+}
+
+static bool henge_cpu_ops_target_realize(CPUState *cs, Error **errp)
+{
+    if (object_dynamic_cast(OBJECT(cs), TYPE_ARM_CPU) == NULL) {
+        error_setg(errp, "henge accelerator supports aarch64 CPUs only");
+        return false;
+    }
+    return true;
+}
+
+/*
+ * Copy the calling thread's vCPU interrupt line into the engine.
+ *
+ * Lives here rather than in henge-accel.c because it needs CPU_INTERRUPT_HARD
+ * *and* CPU_INTERRUPT_FIQ, and FIQ is defined in target/arm/cpu.h -- the
+ * accelerator's common code may not include a per-target header.  This TU
+ * already does, for arm_handle_psci_call().
+ *
+ * Called from henge_mmio_forward() right after a device access returns.  A
+ * GICv2 SGI is an MMIO write, and a CPU that IPIs itself never gets a kick
+ * (generic_handle_interrupt() skips qemu_cpu_kick() when is_self, and our kick
+ * is the only other place that copies the line), so without this the guest
+ * keeps running with a stale line past the point where it should have taken
+ * the interrupt.  Measured as a 26 s / 89 s RCU stall under GICv2 + nohz that
+ * TCG does not have.
+ */
+void henge_sync_irq_current(void)
+{
+    CPUState *cs = current_cpu;
+
+    if (cs && cs->opaque) {
+        henge_sync_irq(cs, (HvCpu *)cs->opaque);
+    }
+}
+
+static void henge_accel_ops_class_init(ObjectClass *oc, const void *data)
+{
+    AccelOpsClass *ops = ACCEL_OPS_CLASS(oc);
+
+    ops->create_vcpu_thread = henge_start_vcpu_thread;
+    ops->kick_vcpu_thread = henge_kick_vcpu_thread;
+    ops->cpu_thread_is_idle = henge_vcpu_thread_is_idle;
+    ops->handle_interrupt = generic_handle_interrupt;
+
+    ops->synchronize_state = henge_cpu_synchronize_state;
+    ops->synchronize_post_init = henge_cpu_synchronize_post_init;
+    ops->synchronize_post_reset = henge_cpu_synchronize_post_init;
+
+    ops->cpu_target_realize = henge_cpu_ops_target_realize;
+}
+
+static const TypeInfo henge_accel_ops_type = {
+    .name = ACCEL_OPS_NAME("henge"),
+    .parent = TYPE_ACCEL_OPS,
+    .class_init = henge_accel_ops_class_init,
+    .abstract = true,
+};
+module_obj(ACCEL_OPS_NAME("henge"));
+
+static void henge_accel_ops_register_types(void)
+{
+    type_register_static(&henge_accel_ops_type);
+}
+
+type_init(henge_accel_ops_register_types);
diff --git a/accel/henge/henge-accel.c b/accel/henge/henge-accel.c
new file mode 100644
index 0000000000..bc81c7bcb3
--- /dev/null
+++ b/accel/henge/henge-accel.c
@@ -0,0 +1,959 @@
+/*
+ * Henge accelerator: AccelClass side
+ *
+ * An ARM64->ARM64 dynamic binary translator running entirely in user space.
+ * QEMU keeps ownership of RAM and devices; this accelerator owns only
+ * "how a vCPU runs" (see henge-accel-ops.c).
+ *
+ * Division of labour, and why the software MMU survives:
+ *
+ *   guest VA -> guest PA   engine's hv_mmu_walk, reading the *guest's* page
+ *                          tables out of guest RAM.  Unchanged under QEMU.
+ *   guest PA -> host ptr   provided here, from QEMU's MemoryRegion host
+ *                          pointers, via a MemoryListener.
+ *
+ * So the JIT, block cache, TLB, bank and the EL-based probe split are all
+ * untouched: they only care what host pointer a PA maps to, not who owns it.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "qapi/error.h"
+#include "qemu/module.h"
+#include "qemu/accel.h"
+#include "qemu/main-loop.h"
+#include "accel/accel-ops.h"
+#include "accel/accel-cpu-ops.h"
+#include "system/cpus.h"
+/* henge-accel-ops.c: copy this thread's vCPU line into the engine. */
+void henge_sync_irq_current(void);
+#include "system/memory.h"
+#include "system/address-spaces.h"
+#include "hw/core/cpu.h"
+#include "hw/core/boards.h"
+#include "qemu/timer.h"
+#include "qemu/host-utils.h"
+#include "system/runstate.h"
+#include "system/reset.h"
+#include "system/henge-accel.h"
+#include "system/ramblock.h"
+/* Migration is not gated by CONFIG_MIGRATION in this tree: the `migrate` QMP
+ * command exists and runs even with --without-default-features (verified: it
+ * started and emitted STOP before this notifier existed).  So the guard that
+ * looked prudent was in fact the reason migration was not being refused. */
+#include "migration/misc.h"
+#include "system/henge-engine.h"
+/* 注意：这里**不** include "trace.h"。这个配置（--without-default-features）下
+   build/trace.h 不会生成，只有 build/trace/trace-root.h。accel/henge/trace-events
+   仍然保留（trace/meson.build 要求它存在），等真的要用时再按 QEMU 的方式接。 */
+
+bool henge_allowed;
+
+/* See include/system/henge-accel.h.  Zero unless -accel henge,trace=... */
+unsigned henge_trace;
+
+static void henge_trace_parse(const char *spec)
+{
+    char *copy, *tok, *save = NULL;
+
+    if (!spec) {
+        return;
+    }
+    copy = g_strdup(spec);
+    for (tok = strtok_r(copy, ",", &save); tok; tok = strtok_r(NULL, ",", &save)) {
+        if (!strcmp(tok, "all"))                        henge_trace = ~0u;
+        else if (!strcmp(tok, "ram"))                   henge_trace |= HENGE_TRACE_RAM;
+        else if (!strcmp(tok, "sysreg"))                henge_trace |= HENGE_TRACE_SYSREG;
+        else if (!strcmp(tok, "irq"))                   henge_trace |= HENGE_TRACE_IRQ;
+        else if (!strcmp(tok, "psci"))                  henge_trace |= HENGE_TRACE_PSCI;
+        else if (!strcmp(tok, "timer"))                 henge_trace |= HENGE_TRACE_TIMER;
+        else if (!strcmp(tok, "env"))                   henge_trace |= HENGE_TRACE_ENV;
+        else if (!strcmp(tok, "dma"))                   henge_trace |= HENGE_TRACE_DMA;
+        else if (!strcmp(tok, "mmio"))                  henge_trace |= HENGE_TRACE_MMIO;
+        else warn_report("henge: unknown trace channel '%s'", tok);
+    }
+    g_free(copy);
+}
+
+struct HengeAccelState {
+    AccelState parent_obj;
+
+    HvMachine *m;   /* owned by the engine's allocator, opaque here */
+    MemoryListener listener;
+
+    /* Config knobs (QOM properties on the -accel object). */
+    uint64_t jit_mb;
+    bool     stats;
+    char     *trace;     /* -accel henge,trace=ram,sysreg,... */
+    int      nregions;   /* mirror count, for HENGE_DEBUG_RAM */
+
+    /*
+     * MemoryRegion -> GPA base, recorded at mirror time.
+     *
+     * Needed because a host pointer cannot be turned into a GPA from the
+     * RAMBlock alone.  Measured with the memfd backend (-machine
+     * memory-backend=mem):
+     *
+     *     DMAhost mr=mem addr1=0x7efcd298 rb->offset=0x0 rb_off=0x7efcd298
+     *
+     * while the region's actual GPA is 0x40000000.  The memory backend creates
+     * its own RAMBlock at offset 0 and the machine RAM then aliases it into the
+     * address space, so neither rb->offset nor rb->offset+rb_off is the GPA.
+     *
+     * What IS exact is the pair QEMU hands to address_space_unmap(): the
+     * MemoryRegion the pointer belongs to, and the offset inside it.  The GPA
+     * base of that same MemoryRegion is what the MemoryListener reported when
+     * the region was mirrored, so record it there and look it up by identity.
+     */
+    struct {
+        MemoryRegion *mr;
+        uint64_t gpa;
+        uint64_t size;
+    } ram_map[16];
+    int nram_map;
+    bool     started;    /* setup_post has run: the RAM table is the authority now */
+
+    /*
+     * romd windows that have entered their device's command mode at least once,
+     * and are therefore never mirrored again.
+     *
+     * Why this is the right discriminator, and why nothing else is available:
+     *
+     * A QEMU pflash bank is a rom_device whose reads may be direct (romd) or
+     * routed to the model.  Which of the two is in force is decided per access
+     * by romd_mode, and pflash_write() clears it on the first write of every
+     * command sequence.  WindowsiOS and WindowsPixel do not have this problem
+     * because they create the device themselves and pass `readonly` explicitly
+     * (devices/pflash.c: readonly -> hv_machine_add_ram, else
+     * hv_machine_add_mmio).  Here both banks report is_rom=0/is_romd=1 and
+     * -drive readonly=on only touches the block layer, so no static test in
+     * common code can tell the code bank from the variable store.
+     *
+     * What separates them is behaviour, and it is visible: the code bank never
+     * enters command mode, so its romd_mode never changes, so the flatview
+     * never changes, so region_del never fires for it.  The variable store
+     * fires twice per CFI command write.  A romd region that reaches
+     * region_del is a region the guest reads as a device, and mirroring it is
+     * exactly what produced 0xFFFFFFFF where a status register belonged.
+     */
+    struct { hwaddr pa; uint64_t size; } nomirror[8];
+    int      nnomirror;
+};
+
+static HengeAccelState *henge_state;
+
+static uint64_t henge_sync_irq_calls;
+static bool henge_sync_irq_count_enabled;
+
+HvMachine *henge_accel_machine(void)
+{
+    return henge_state ? henge_state->m : NULL;
+}
+
+/*
+ * Tell the engine that a device wrote guest RAM through a host pointer.
+ *
+ * The caller has already resolved the pointer with qemu_ram_block_from_host(),
+ * QEMU's authoritative reverse map (the same call virtio-balloon and
+ * virtio-gpu us).  That is what makes this correct for anonymous RAM,
+ * memfd/file-backed RAM and aliased regions alike.
+ *
+ * The previous implementation scanned the engine's own GPA->host table by
+ * address range.  That only ever worked by luck on anonymous RAM: a
+ * memfd-backed block is mapped at a host address outside the window recorded at
+ * mirror time, so the scan missed silently, the engine kept a stale
+ * translation, and UEFI read a stale FAT directory -- which surfaced as
+ * "Image type X64 can't be loaded on AARCH64 UEFI system".
+ *
+ * RAMBlock->offset is the block's base in the RAM address space, which for
+ * system memory is the guest physical address, so the GPA is the sum.
+ */
+uint64_t hv_engine_dma_written_mr(MemoryRegion *mr, uint64_t off, uint64_t len)
+{
+    HengeAccelState *h = henge_state;
+    uint64_t pa, n;
+    int i;
+
+    if (!h || !h->m || !mr || !len) {
+        return 0;
+    }
+    for (i = 0; i < h->nram_map; i++) {
+        if (h->ram_map[i].mr != mr) {
+            continue;
+        }
+        if (off >= h->ram_map[i].size) {
+            return 0;
+        }
+        pa = h->ram_map[i].gpa + off;
+        n = h->ram_map[i].size - off;
+        if (n > len) {
+            n = len;
+        }
+        hv_engine_dma_written(h->m, pa, n);
+        if (getenv("HV_DMA_DEBUG")) {
+            fprintf(stderr, "DMAhit mr=%s off=0x%" PRIx64 " -> gpa=0x%" PRIx64
+                    " n=0x%" PRIx64 " (base=0x%" PRIx64 ")\n",
+                    mr->name, off, pa, n, h->ram_map[i].gpa);
+        }
+        return n;
+    }
+    if (getenv("HV_DMA_DEBUG")) {
+        fprintf(stderr, "DMAmiss mr=%s off=0x%" PRIx64 " (nram_map=%d)\n",
+                mr->name, off, h->nram_map);
+    }
+    return 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* MMIO: hand everything the engine cannot resolve to QEMU            */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Called from a vCPU thread with the BQL *dropped* -- the engine services
+ * device accesses inline, inside hv_run(), and hv_run is called after
+ * bql_unlock() (MTTCG's lock order, see henge-accel-ops.c).  So this takes the
+ * BQL itself rather than assuming it.
+ *
+ * This is the KVM arrangement: guest execution without the BQL, device
+ * emulation with it.  It is safe for the same reason: everything the engine
+ * touches while executing is either guest RAM (whose host pointer we mirrored)
+ * or its own state, and every QEMU-side change of the memory layout takes the
+ * BQL first and notifies our MemoryListener, which drops the affected
+ * translations.
+ */
+/*
+ * Which MMIO window the trace covers.
+ *
+ * Unfiltered, the serial console fills the budget before the guest reaches
+ * anything interesting: edk2 emits a byte at a time, so a few hundred lines are
+ * one banner.  HV_MMIO_PA/HV_MMIO_LEN narrow it to one device, and the function
+ * becomes a scalpel instead of a firehose.  Parsed once; the trace path is
+ * cold by definition.
+ */
+static bool henge_mmio_traced(uint64_t pa, uint32_t len)
+{
+    static uint64_t base, end;
+    static bool init;
+
+    if (!init) {
+        const char *s = getenv("HV_MMIO_PA");
+        init = true;
+        if (s) {
+            base = g_ascii_strtoull(s, NULL, 0);
+            s = getenv("HV_MMIO_LEN");
+            end = base + (s ? g_ascii_strtoull(s, NULL, 0) : 0x10000000ull);
+        }
+    }
+    if (!base) {
+        return true;
+    }
+    return pa < end && pa + len > base;
+}
+
+static int henge_mmio_forward(void *opaque, uint64_t pa, void *buf,
+                              uint32_t len, int is_write)
+{
+    MemTxResult r;
+    bool trace;
+    uint64_t tpc;
+
+    /*
+     * Enforced, not just documented.  This runs on a vCPU thread inside
+     * hv_run(), which the MTTCG lock order calls with the BQL released.  If it
+     * were ever called with the BQL held, bql_lock() would deadlock the whole
+     * VM -- and it would do so only under load, which is the failure mode that
+     * costs days.  bql_locked() is per-thread, so this asks the right question.
+     */
+    assert(!bql_locked());
+
+    /*
+     * The access as the engine saw it, with the value read back for reads.
+     *
+     * Two things make this line load-bearing rather than decoration:
+     *
+     *  - the guest PC.  QEMU's own device traces show only the value handed to
+     *    the device, so a repeated access looks identical whether the guest is
+     *    retrying one instruction or the engine is replaying a stale access.
+     *    The PC separates those two, and they need opposite fixes.
+     *  - the value, printed *after* the access.  For a read that is the only
+     *    place it exists: QEMU's pflash trace shows what was written, never
+     *    what the guest got back, which is exactly the half that was wrong
+     *    when the UEFI variable store read 0xFFFFFFFF (erased flash content)
+     *    where it expected a CFI status register.
+     *
+     * Scoped by HV_MMIO_PA / HV_MMIO_LEN so a window can be isolated without
+     * the serial console spending the whole budget first.
+     */
+    trace = henge_tracing(HENGE_TRACE_MMIO) && henge_mmio_traced(pa, len);
+    tpc = hv_engine_access_pc(henge_accel_machine());
+
+    bql_lock();
+    r = address_space_rw(&address_space_memory, pa, MEMTXATTRS_UNSPECIFIED,
+                         buf, len, is_write);
+    bql_unlock();
+
+    if (trace) {
+        uint64_t v = 0;
+
+        if (len <= sizeof v) {
+            memcpy(&v, buf, len);
+        }
+        fprintf(stderr,
+                "henge-mmio %c pa=0x%" HWADDR_PRIx " len=%u val=0x%" PRIx64
+                " pc=0x%" PRIx64 "\n",
+                is_write ? 'W' : 'R', pa, len, v, tpc);
+    }
+
+    /*
+     * A device write that raises an interrupt for the CPU that issued it is
+     * invisible to the engine unless somebody copies the line across, and on
+     * this path nobody does:
+     *
+     *   guest MMIO store -> here -> address_space_rw -> the GIC
+     *     -> arm_cpu_set_irq(cs) -> cpu_interrupt(cs)
+     *     -> generic_handle_interrupt(): cpu_set_interrupt(mask), then
+     *        `if (!qemu_cpu_is_self(cpu)) qemu_cpu_kick(cpu);`
+     *
+     * qemu_cpu_kick() is the only thing that reaches henge_kick_vcpu_thread(),
+     * which is the only place that copies cs->interrupt_request into the
+     * engine's line.  For a self-targeted interrupt it is skipped by design --
+     * TCG has no need for it, because cpu_exec() re-reads interrupt_request at
+     * every translation block.
+     *
+     * The concrete case is a GICv2 SGI, which the guest sends by writing
+     * GICD_SGIR: a CPU that IPIs itself (reschedule, call-function) gets
+     * CPU_INTERRUPT_HARD set in QEMU and nothing at all in the engine, so it
+     * keeps executing straight past the point where it should have taken the
+     * interrupt.  Measured: `-M virt` (GICv2) + `-smp 2` + default nohz stalls
+     * in _nohz_idle_balance at 26 s and 89 s, while the same command under TCG
+     * boots clean in 77 s -- so it is this accelerator, not the GICv2 model.
+     *
+     * GICv3 has no such hole: ICC_SGI1R_EL1 is a system register, and the seam
+     * path re-syncs after servicing one.  That is why switching to
+     * gic-version=3 made the stall disappear without anyone fixing anything.
+     *
+     * current_cpu is this thread's vCPU (QEMU keeps it in TLS), which is
+     * exactly the CPU whose line went stale.
+     */
+    /*
+     * 统计口径：virtio-net 的 doorbell 写、ISR 读都是 MMIO，每一次都会走到
+     * 这里。HV_SYNC_IRQ_COUNT=1 时按 10 万次一档打到 stderr，用来判断
+     * "每次 MMIO 都同步 IRQ" 到底是几千次还是几十万次——这个数量级决定
+     * 该优化 sync_irq 还是去看网络栈。
+     */
+    if (henge_sync_irq_count_enabled) {
+        if ((++henge_sync_irq_calls % 100000) == 0) {
+            fprintf(stderr, "henge: sync_irq calls=%" PRIu64 "\n",
+                    henge_sync_irq_calls);
+        }
+    }
+    if (henge_enabled() && current_cpu && current_cpu->opaque) {
+        /*
+         * Implemented in henge-accel-ops.c: this file is common code and
+         * CPU_INTERRUPT_FIQ lives in target/arm/cpu.h, which it may not
+         * include.  See that function for why the sync is needed here at all.
+         */
+        henge_sync_irq_current();
+    }
+    return r == MEMTX_OK ? 0 : -1;
+}
+
+/* ------------------------------------------------------------------ */
+/* Memory: let QEMU own RAM, mirror PA->host into the engine           */
+/* ------------------------------------------------------------------ */
+
+static void henge_mirror(HengeAccelState *h, MemoryRegion *mr, hwaddr pa,
+                         uint64_t size, hwaddr offset_in_region)
+{
+    void *host;
+    bool is_ram = memory_region_is_ram(mr);
+    bool is_rom = memory_region_is_rom(mr);
+    /*
+     * romd ("ROM device, direct reads") is the third kind and the one that
+     * gates UEFI.
+     *
+     * is_ram() is false for it and is_rom() is `mr->ram && mr->readonly`, which
+     * is also false because romd mode clears ->readonly.  So the old
+     * `is_ram || is_rom` test skipped virt.flash0 entirely -- the region edk2
+     * resets into.  Measured with trace=ram:
+     *
+     *     henge: region virt.flash0  pa=0x0  size=0x4000000  ram=0 rom=0 romd=1
+     *
+     * and the guest then died at pc=0 with HV_EXIT_FAULT_LOOP on the first
+     * fetch, while TCG printed the edk2 banner and reached BDS.
+     *
+     * romd semantics are "reads are direct, writes go to the device": that is
+     * precisely why it is mirrored read-only here, with hv_phys_write() passing
+     * writes through to the MMIO catch-all instead of dropping them (see the
+     * matching change in the engine's machine.c).  Mapping it read-write would
+     * let the guest scribble straight into the backing file and bypass the CFI
+     * command state machine.
+     */
+    bool is_romd = memory_region_is_romd(mr);
+
+    if (henge_tracing(HENGE_TRACE_RAM)) {
+        fprintf(stderr, "henge: region %-24s pa=0x%" HWADDR_PRIx
+                " size=0x%" PRIx64 " ram=%d rom=%d romd=%d\n",
+                memory_region_name(mr), pa, size, is_ram, is_rom, is_romd);
+    }
+
+    /*
+     * RAM *and* ROM, and romd.
+     *
+     * MMIO must NOT be registered as engine RAM: the engine has to trap those
+     * addresses so it can forward them to QEMU (address_space_rw), which is what
+     * keeps QEMU's device models authoritative.
+     *
+     * ROM is not an afterthought.  -kernel loads the guest image with
+     * rom_add_blob(), which installs a ROM MemoryRegion *over* the RAM block;
+     * memory_region_is_ram() is false for it.  With a RAM-only filter the
+     * engine never learned about 0x40080000, the first guest fetch went
+     * nowhere, and the run died as "exception vector faulted" at the entry PC.
+     * pflash (UEFI) repeats exactly that failure through the romd door.
+     */
+    if (!size || (!is_ram && !is_rom && !is_romd)) {
+        return;
+    }
+
+    /*
+     * A romd window that has been seen in command mode is a device the guest
+     * reads through the CFI state machine, not memory.  Leave it to the MMIO
+     * catch-all so QEMU's romd_mode decides what a read returns -- the same
+     * path TCG takes, and the one that makes the status register readable.
+     * See the comment on nomirror[] for why "has it been del'd" is the test.
+     */
+    if (is_romd) {
+        for (int i = 0; i < h->nnomirror; i++) {
+            if (h->nomirror[i].pa == pa) {
+                hv_machine_del_ram(h->m, pa, size);   /* in case an earlier add landed */
+                if (henge_tracing(HENGE_TRACE_RAM)) {
+                    fprintf(stderr, "henge: skip   %-20s pa=0x%" HWADDR_PRIx
+                            " size=0x%" PRIx64 " (romd in command mode)\n",
+                            memory_region_name(mr), pa, size);
+                }
+                return;
+            }
+        }
+    }
+
+    /*
+     * A region can be re-added after a remove (memory hotplug, or a board that
+     * rebuilds its memory tree); drop the stale entry first so the engine does
+     * not end up with two windows over the same guest PA.
+     */
+    hv_machine_del_ram(h->m, pa, size);
+
+    host = memory_region_get_ram_ptr(mr) + offset_in_region;
+
+    /*
+     * readonly = 0 for RAM and the kernel ROM: the region a kernel is loaded
+     * into has to be writable (Linux relocates and patches itself in place),
+     * and QEMU's ROM write protection is a device-model behaviour this
+     * accelerator cannot honour without trapping every store to it.
+     *
+     * The romd case (virt.flash0/1 under -drive if=pflash) is NOT handled here
+     * yet: mapping it, in either write mode, breaks the -kernel baseline
+     * (measured: mirrored 1 region -> boots; 3 regions -> no output at all,
+     * because the two 64 MB windows land below the RAM base).  UEFI therefore
+     * remains unported; see the note in VENDORED-FROM.
+     */
+    if (hv_machine_add_ram(h->m, pa, size, host, is_romd ? 1 : 0) != 0) {
+        error_report("henge: failed to mirror %s at 0x%" HWADDR_PRIx
+                     " (%" PRIu64 " bytes)", memory_region_name(mr), pa, size);
+        return;
+    }
+
+    /* Remember where this MemoryRegion lives, for the DMA host->GPA lookup. */
+    {
+        int i;
+
+        for (i = 0; i < h->nram_map; i++) {
+            if (h->ram_map[i].mr == mr) {
+                break;
+            }
+        }
+        if (i == h->nram_map && h->nram_map < (int)ARRAY_SIZE(h->ram_map)) {
+            h->nram_map++;
+        }
+        if (i < (int)ARRAY_SIZE(h->ram_map)) {
+            h->ram_map[i].mr   = mr;
+            h->ram_map[i].gpa  = pa;
+            h->ram_map[i].size = size;
+        }
+    }
+    h->nregions++;
+}
+
+static void henge_region_add(MemoryListener *listener, MemoryRegionSection *s)
+{
+    henge_mirror(container_of(listener, HengeAccelState, listener), s->mr,
+                 s->offset_within_address_space, int128_get64(s->size),
+                 s->offset_within_region);
+}
+
+static void henge_region_del(MemoryListener *listener, MemoryRegionSection *s)
+{
+    HengeAccelState *h = container_of(listener, HengeAccelState, listener);
+    int rc;
+
+    if (henge_tracing(HENGE_TRACE_RAM)) {
+        fprintf(stderr, "henge: del    %-20s pa=0x%" HWADDR_PRIx " size=0x%" PRIx64
+                " romd=%d\n", memory_region_name(s->mr),
+                s->offset_within_address_space, int128_get64(s->size),
+                memory_region_is_romd(s->mr));
+    }
+
+    /*
+     * Evidence, gathered on the way out: this romd window just proved it enters
+     * its device's command mode, because that is the only thing that changes
+     * romd_mode and therefore the only thing that makes the flatview change.
+     * Once is enough -- pflash calls set_romd() twice per command sequence
+     * forever after -- so it goes on the never-mirror list and every later
+     * add of it is refused.  The code bank never arrives here at all, which is
+     * what keeps it mirrored and its fetch path at native speed.
+     */
+    if (h->started && memory_region_is_romd(s->mr) && h->nnomirror < 8) {
+        hwaddr npa = s->offset_within_address_space;
+        int known = 0;
+
+        for (int i = 0; i < h->nnomirror; i++) {
+            if (h->nomirror[i].pa == npa) {
+                known = 1;
+                break;
+            }
+        }
+        if (!known) {
+            h->nomirror[h->nnomirror].pa = npa;
+            h->nomirror[h->nnomirror].size = int128_get64(s->size);
+            h->nnomirror++;
+            if (henge_tracing(HENGE_TRACE_RAM)) {
+                fprintf(stderr, "henge: romd   %-20s pa=0x%" HWADDR_PRIx
+                        " entered command mode: stop mirroring it\n",
+                        memory_region_name(s->mr), npa);
+            }
+        }
+    }
+
+    /*
+     * Retire the window, then ask for the invalidation -- do not perform it.
+     *
+     * This runs on QEMU's main thread with the BQL held, while vCPUs are
+     * executing.  Invalidating from here means hv_invalidate_code() walking the
+     * chained-exit list and hv_tlb_flush() memsetting a TLB that a vCPU is
+     * reading at that instant.  Measured on the engine's exact entry layout:
+     * a reader that saw a valid tag and then loaded the addend across a
+     * concurrent flush got 0x8080808080808080 as an addend 619,156 times in
+     * five seconds -- every one of those is a wild host address.  Counted in
+     * the field on edk2 -smp 2: 168 of 341 del_ram calls landed on a CPU whose
+     * `active` was set, i.e. mid-dispatcher.
+     *
+     * hv_engine_request_flush() sets flush_pending, which every vCPU checks at
+     * the top of its dispatcher loop; the first one to see it runs
+     * stop_the_world() and flushes with everybody parked -- the engine's own
+     * documented invariant ("the one moment the TLB layout can change").  It
+     * cannot wait for that here: a vCPU inside henge_mmio_forward() is blocked
+     * on the BQL this thread holds.
+     */
+    rc = hv_machine_del_ram_flags(h->m, s->offset_within_address_space,
+                                  int128_get64(s->size), 1);
+    /*
+     * Flush only if the engine actually held this window.
+     *
+     * This is what makes the never-mirror list pay off.  A romd window that is
+     * no longer mirrored produces region_del on every CFI command write all
+     * the same -- the flatview still changes -- but there is nothing in the
+     * engine to invalidate, because its reads and writes already go to the
+     * device through the MMIO catch-all.  Requesting a flush for it cost a
+     * stop-the-world per sequence: measured 379 requests / 240 flushes at
+     * 735-847 us each, all of it for a window the engine had stopped caching.
+     *
+     * rc == -1 means "no window with this base PA", which is both the case for
+     * a never-mirrored region and the case worth reporting (see below).
+     */
+    if (rc == 0) {
+        hv_engine_request_flush(h->m);
+    }
+    /*
+     * A -1 here is worth seeing.  hv_machine_del_ram() matches on the base PA,
+     * so a section that is reported with a different base than the one that was
+     * added silently survives -- and a romd window that survives a romd-off
+     * transition is a window that answers reads from stale storage.  That is
+     * the exact shape of the UEFI variable-store failure, so it must not be
+     * swallowed again.
+     */
+    if (henge_tracing(HENGE_TRACE_RAM) && rc != 0) {
+        fprintf(stderr, "henge: del    %-20s pa=0x%" HWADDR_PRIx
+                " NOT MIRRORED\n", memory_region_name(s->mr),
+                s->offset_within_address_space);
+    }
+}
+
+static const MemoryListener henge_memory_listener = {
+    .name = "henge",
+    .region_add = henge_region_add,
+    .region_del = henge_region_del,
+};
+
+/* flatview_for_each_range() walks the *finished* address space, which is the
+ * only place the whole RAM map can be read in one go. */
+static bool henge_flatview_cb(Int128 start, Int128 size,
+                              const MemoryRegion *mr,
+                              hwaddr offset_in_region, void *opaque)
+{
+    henge_mirror(opaque, (MemoryRegion *)mr, int128_get64(start),
+                 int128_get64(size), offset_in_region);
+    return false;   /* never stop early */
+}
+
+/* ------------------------------------------------------------------ */
+/* The time base                                                       */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Calibrate the engine's counter against QEMU's virtual clock.
+ *
+ * QEMU's virtual clock is the authority for the guest's CNTPCT: it is what the
+ * gtimer compares CVAL against when it decides to raise an interrupt.  The
+ * engine has its own counter, so the two agree only if we say when they
+ * started: epoch = engine ticks - host ticks.  After that every guest counter
+ * read is one subtraction.
+ *
+ * Why this has to run again on every resume: QEMU_CLOCK_VIRTUAL stops while
+ * the VM is stopped, and the host's counter does not.  A VM paused for ten
+ * seconds comes back with engine time ten seconds ahead, and the guest sees
+ * ten seconds vanish into a timer that should still have been pending.  That
+ * is a clock jump, not a slow clock -- the kind of thing that shows up as a
+ * mysterious timeout rather than as a wrong number.
+ */
+void henge_timer_calibrate(HvMachine *m)
+{
+    uint64_t freq, engine_ticks, host_ticks;
+
+    if (!m) {
+        return;
+    }
+    freq = hv_engine_timer_freq(m);
+    if (!freq) {
+        return;
+    }
+    engine_ticks = hv_engine_timer_ticks(m);
+    host_ticks = muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), freq,
+                          NANOSECONDS_PER_SECOND);
+    hv_engine_set_timer_epoch(m, engine_ticks - host_ticks);
+}
+
+void henge_timer_setup(HvMachine *m, uint64_t freq)
+{
+    if (!m || !freq) {
+        return;
+    }
+    hv_engine_set_timer_freq(m, freq);
+    henge_timer_calibrate(m);
+    if (henge_tracing(HENGE_TRACE_TIMER)) {
+        fprintf(stderr, "henge: timer CNTFRQ=%" PRIu64 " Hz (host clock), "
+                "epoch=%" PRId64 "\n", freq,
+                (int64_t)(hv_engine_timer_ticks(m) -
+                          muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), freq,
+                                   NANOSECONDS_PER_SECOND)));
+    }
+}
+
+/*
+ * Resume (and reset) re-calibrate.  running == 1 is the transition that
+ * matters: the virtual clock has been frozen for however long the VM was
+ * stopped, and the host counter has not.
+ */
+static void henge_vm_state(void *opaque, bool running, RunState state)
+{
+    if (running) {
+        henge_timer_calibrate(opaque);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Machine lifecycle: reset, and what must be refused                  */
+/* ------------------------------------------------------------------ */
+
+/*
+ * system_reset, and why setup_post's one-shot mirror is not enough.
+ *
+ * On a reset QEMU tears the ROM contents down and reloads them, builds a new
+ * flatview (possibly with different regions) and resets every CPU.  The engine
+ * holds four things that a reboot invalidates and that nothing else drops:
+ * translated blocks, the per-CPU software TLB, the per-page code/whint/gen
+ * bookkeeping, and the indirect-branch caches.  A block is keyed by
+ * {va, pa, flags, gen} -- a reboot changes none of those and changes every byte
+ * behind them, so the second boot would run the *first* image's translations.
+ *
+ * A vCPU-level reset cannot cover this (it knows one CPU) and code
+ * invalidation cannot either (it knows one page).  This callback is the only
+ * place with the whole picture, and it runs after QEMU has reset the device
+ * tree, so the flatview walk sees the new memory map.
+ *
+ * Called with the BQL held and every vCPU stopped (qemu_devices_reset runs
+ * after vm_stop), which is what makes wiping shared engine state safe.
+ */
+static void henge_reset(void *opaque)
+{
+    HengeAccelState *h = opaque;
+
+    if (!h || !h->m) {
+        return;
+    }
+    /*
+     * QEMU runs its reset handlers once during startup too, before the machine
+     * has finished building.  Acting then would mirror a half-built flatview
+     * and then mirror it again in setup_post, leaving a dead (size 0) entry
+     * behind for every region -- harmless to lookups, but it made the mirror
+     * count read 2 for 1 region, which is exactly the kind of thing that makes
+     * a later memory bug take a day.  Before setup_post there is nothing to
+     * invalidate anyway.
+     */
+    if (!h->started) {
+        return;
+    }
+
+    /*
+     * Only machine-wide state here.  The per-vCPU half of a reset is not this
+     * callback's business and cannot be: re-syncing a vCPU means reading
+     * CPUARMState, which lives in target/arm/cpu.h, and this file is common
+     * code -- it may not include a per-target header.  That half already has a
+     * home: henge_cpu_synchronize_post_reset() in henge-accel-ops.c, which QEMU
+     * calls on every CPU around the same reset.  The two do not race: this one
+     * touches blocks, TLB and the RAM table, that one touches registers, and
+     * neither reads what the other writes.
+     */
+    hv_engine_machine_reset(h->m);
+
+    /*
+     * Re-mirror from scratch: a reset can add, remove or move regions, and the
+     * engine's table holds host pointers into MemoryRegions that may have been
+     * recreated.  Clearing and walking again is cheaper to reason about than
+     * diffing a table against a flatview.
+     */
+    hv_engine_ram_clear(h->m);
+    /* The rebooted guest starts its counters where QEMU's clock is now. */
+    henge_timer_calibrate(h->m);
+    h->nregions = 0;
+    flatview_for_each_range(address_space_to_flatview(&address_space_memory),
+                            henge_flatview_cb, h);
+
+    if (henge_tracing(HENGE_TRACE_RAM)) {
+        fprintf(stderr, "henge: reset, re-mirrored %d regions\n", h->nregions);
+    }
+}
+
+/*
+ * Migration and snapshots: refuse, loudly, at setup time.
+ *
+ * Every piece of engine state that makes the guest fast -- the JIT region and
+ * its blocks, the four software TLB tables with their host addends, whint, the
+ * indirect-branch caches, the whole HvCpu -- is a host pointer graph.  None of
+ * it is serialisable, and none of it is in QEMU's migration stream.  QEMU has no
+ * way to know that: hv_engine_save_state() puts the architectural registers in
+ * env, which is what the stream carries, so a migrate would succeed and produce
+ * a destination that starts executing with an empty JIT over a guest that was
+ * mid-syscall.  The failure mode is a corrupt snapshot that looks fine.
+ *
+ * MIG_EVENT_SETUP is the one hook that can still say no (its handler may return
+ * an error; the others may not), and saying no there is better than a doc note.
+ */
+static int henge_migration_notify(NotifierWithReturn *n, MigrationEvent *e,
+                                  Error **errp)
+{
+    if (e->type == MIG_EVENT_SETUP) {
+        error_setg(errp, "henge: migration is not supported (the JIT cache, "
+                   "software TLB and per-CPU state are host pointers and are "
+                   "not in the migration stream)");
+        return -1;
+    }
+    return 0;
+}
+
+static NotifierWithReturn henge_migration_notifier;
+
+/* henge-cpu.c: the engine's tick source, in 24 MHz host ticks, or 0. */
+uint64_t henge_tick_delta24(void *opaque, uint32_t index);
+
+/* ------------------------------------------------------------------ */
+/* AccelClass                                                          */
+/* ------------------------------------------------------------------ */
+
+static int henge_init_machine(AccelState *as, MachineState *ms)
+{
+    HengeAccelState *h = HENGE_ACCEL(as);
+
+    henge_state = h;
+    henge_trace_parse(h->trace);
+    henge_sync_irq_count_enabled = getenv("HV_SYNC_IRQ_COUNT") != NULL;
+
+
+    /*
+     * Create the engine but do NOT create RAM: QEMU owns it and will tell us
+     * about it through the listener below.  JIT memory is ours.
+     *
+     * The engine owns HvMachine (its sizeof is private to the engine), so it
+     * allocates and returns the pointer.
+     */
+    h->m = hv_engine_machine_new(h->jit_mb << 20);
+    if (!h->m) {
+        error_report("henge: engine machine allocation failed (jit-mb=%" PRIu64 ")",
+                     h->jit_mb);
+        return -ENOMEM;
+    }
+
+    /* The catch-all device window.  Installed before any vCPU exists and
+     * before devices are realized, so it is in place for the first access. */
+    hv_engine_set_mmio_forward(h->m, henge_mmio_forward, h);
+
+    /*
+     * The tick source.  Without it m->tick stays NULL and wait_for_interrupt()
+     * can only give up and unwind the run -- measured at 512 B-path returns per
+     * vCPU on a two-vCPU boot -- so the engine can never sleep to a deadline and
+     * has to be kicked once per timer event.
+     *
+     * Registered here rather than at first vCPU start because the engine reads
+     * m->tick from the WFI path of any CPU, and a half-started machine must not
+     * see one installed for some CPUs and not others.  The callback resolves the
+     * vCPU by index through qemu_get_cpu(), so it is valid as soon as the
+     * CPUStates exist, which is before this point.
+     */
+    hv_engine_set_tick(h->m, henge_tick_delta24, h);
+
+    /*
+     * The copy is the fix, not boilerplate.
+     *
+     * MemoryListener callbacks are dispatched with `if (_listener->_callback)`,
+     * so a listener whose hooks were never installed is skipped in silence:
+     * register() succeeds, the struct sits in the address space's queue, and
+     * nothing is ever called.  That is what this did for its whole life --
+     * henge_memory_listener was defined and never assigned, so region_add and
+     * region_del were both NULL.
+     *
+     * It stayed invisible because setup_post walks the finished flatview
+     * directly, which covers the initial map completely.  The gap only opens
+     * later: pflash calls memory_region_rom_device_set_romd() on every
+     * command-sequence write, and a flatview rebuild is the *only* signal that
+     * the window must change.  With no callback the mirror survived the
+     * romd-off transition, so the guest kept reading the variable store out of
+     * RAM instead of the CFI state machine, read 0xFFFFFFFF (erased flash) as
+     * the status register, and looped forever unlocking a block it could never
+     * unlock.  UEFI then had no Variable Arch Protocol to install and DxeCore
+     * asserted.
+     */
+    h->listener = henge_memory_listener;
+    memory_listener_register(&h->listener, &address_space_memory);
+
+    /*
+     * Both seam flags on: QEMU owns the system registers the engine does not
+     * model, and it owns PSCI too.
+     *
+     * PSCI must be QEMU's once -smp > 1: the engine's own conduit resets the
+     * target HvCpu directly, behind the back of the CPUState and the parked
+     * vCPU thread that QEMU owns, and it matches CPUs by its own MPIDR layout
+     * rather than the one the device tree describes.  With both fixed (MPIDR
+     * now forwarded, PSCI now dispatched into psci.c) a secondary can actually
+     * be brought up.  See henge_service_psci().
+     */
+    hv_engine_set_external(h->m, 1, 1);
+
+    qemu_register_reset(henge_reset, h);
+    qemu_add_vm_change_state_handler(henge_vm_state, h->m);
+
+    migration_add_notifier(&henge_migration_notifier, henge_migration_notify);
+
+    return 0;
+}
+
+static void henge_setup_post(AccelState *as)
+{
+    HengeAccelState *h = HENGE_ACCEL(as);
+    FlatView *fv;
+
+    /*
+     * Walk the finished flatview once, whatever the listener did.
+     *
+     * The listener's region_add is the normal path, but it is not a substitute
+     * for this: init_machine runs before the board has created its regions, so
+     * at registration time there is almost nothing to add, and a listener that
+     * is registered on an AddressSpace that has not been initialised yet can
+     * lose its queue entry.  Walking here means the initial map is correct
+     * regardless of either.
+     *
+     * It is idempotent: henge_mirror() drops any window already covering the
+     * same base before adding, so the overlap between the two paths costs one
+     * add/del pair per region and nothing else.
+     *
+     * The listener is still what handles everything *after* this point --
+     * hotplug, memory-tree rebuilds, and the romd toggles that pflash drives.
+     */
+    fv = address_space_to_flatview(&address_space_memory);
+    flatview_for_each_range(fv, henge_flatview_cb, h);
+    h->started = true;
+    if (henge_tracing(HENGE_TRACE_RAM)) {
+        fprintf(stderr, "henge: setup_post mirrored %d regions\n", h->nregions);
+    }
+    /*
+     * RAM is mirrored and devices are realized by now, so the engine's RAM
+     * table is complete -- which is what it needs before the first
+     * translation.  Nothing to publish here: the MMIO forwarder was installed
+     * in init_machine.
+     */
+}
+
+/* QOM: -accel henge,jit-mb=512 */
+static void henge_accel_instance_init(Object *obj)
+{
+    HengeAccelState *h = HENGE_ACCEL(obj);
+
+    h->jit_mb = 256;
+    h->stats = false;
+    h->trace = NULL;
+}
+
+static char *henge_get_trace(Object *obj, Error **errp)
+{
+    HengeAccelState *h = HENGE_ACCEL(obj);
+
+    return g_strdup(h->trace ? h->trace : "");
+}
+
+static void henge_set_trace(Object *obj, const char *value, Error **errp)
+{
+    HengeAccelState *h = HENGE_ACCEL(obj);
+
+    g_free(h->trace);
+    h->trace = (value && *value) ? g_strdup(value) : NULL;
+}
+
+static void henge_accel_class_init(ObjectClass *oc, const void *data)
+{
+    AccelClass *ac = ACCEL_CLASS(oc);
+
+    object_class_property_add_str(oc, "trace", henge_get_trace, henge_set_trace);
+    object_class_property_set_description(oc, "trace",
+        "Diagnostic channels: ram,sysreg,irq,psci,timer,env,dma,all");
+
+    ac->name = "Henge";
+    ac->init_machine = henge_init_machine;
+    ac->setup_post = henge_setup_post;
+    ac->allowed = &henge_allowed;
+}
+
+static const TypeInfo henge_accel_type = {
+    .name = TYPE_HENGE_ACCEL,
+    .parent = TYPE_ACCEL,
+    .instance_size = sizeof(HengeAccelState),
+    .instance_init = henge_accel_instance_init,
+    .class_init = henge_accel_class_init,
+};
+module_obj(TYPE_HENGE_ACCEL);
+
+static void henge_type_init(void)
+{
+    type_register_static(&henge_accel_type);
+}
+
+type_init(henge_type_init);
diff --git a/accel/henge/henge-cpu.c b/accel/henge/henge-cpu.c
new file mode 100644
index 0000000000..c7a5257088
--- /dev/null
+++ b/accel/henge/henge-cpu.c
@@ -0,0 +1,701 @@
+/*
+ * Henge accelerator: the QEMU-side half of the bridge (registers)
+ *
+ * QEMU's CPUARMState and the engine's HvCpu are two representations of the
+ * same architectural state.  This file moves one into the other.  Direction
+ * matters and is not symmetric:
+ *
+ *   reset  ->  QEMU is authoritative.  arm_load_kernel() wrote the entry point
+ *              into env->pc AFTER arm_cpu_reset_hold(), so the only place the
+ *              entry point exists is QEMU's env.  load_state() reads it.
+ *   run    ->  the engine is authoritative.  save_state() publishes back so
+ *              the monitor, the gdbstub and "info registers" see reality.
+ *
+ * Why this file is separate from henge-engine.c: only this one may include
+ * both worlds' headers, and it needs the HvCpu *layout* (2.2 MB of inline TLB
+ * tables) while the machine side needs engine/core/machine.h, which drags in
+ * the engine's jit_region.h.  Keeping them apart means QEMU's build never has
+ * engine/core on its include path.
+ *
+ * What is deliberately NOT carried yet (see the TODO at the bottom):
+ * EL2/EL3 state, the generic timer's CNTV* registers, GIC system registers.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/error-report.h"
+#include "system/henge-engine.h"
+#include "system/henge-accel.h"
+#include "target/arm/cpu.h"
+#include "target/arm/cpregs.h"
+#include "target/arm/internals.h"   /* arm_handle_psci_call */
+#include "target/arm/arm-powerctl.h"  /* arm_get_cpu_by_id */
+#include "qemu/timer.h"
+#include "qemu/host-utils.h"   /* cp_regs, ENCODE_AA64_CP_REG, read_raw_cp_reg */
+
+#include "engine/core/cpu.h"     /* HvCpu layout; self-contained, includes nothing local */
+
+/* Engine internal, declared here rather than including core/mmu.h (which pulls
+ * in core/machine.h and with it core/jit_region.h). */
+void hv_tlb_flush(HvCpu *cpu);
+
+/*
+ * ABI guard.  include/system/henge-engine.h restates the engine's prototypes
+ * for QEMU's benefit; if the engine ever changes one, the assignment below is
+ * an incompatible-pointer-types error instead of a silent stack/data
+ * corruption three thousand guest instructions later.  This is not paranoia:
+ * the first draft of that header had HV_EXIT_HALT = 3, which in core/cpu.h is
+ * HV_EXIT_EXCEPTION.
+ */
+static void henge_abi_check(void)
+{
+    int (*add_ram)(HvMachine *, uint64_t, uint64_t, void *, int)
+        = hv_machine_add_ram;
+    int (*run)(HvCpu *) = hv_run;
+    void (*wake)(HvCpu *) = hv_cpu_wake;
+
+    (void)add_ram;
+    (void)run;
+    (void)wake;
+
+    /*
+     * One per exit reason.  This is the check that the first draft needed: it
+     * declared HV_EXIT_HALT = 3, and 3 in the engine's enum is
+     * HV_EXIT_EXCEPTION, so every guest exception would have been reported to
+     * QEMU as "the CPU halted".
+     */
+    _Static_assert(HENGE_EXIT_NONE        == HV_EXIT_NONE,        "exit code drift");
+    _Static_assert(HENGE_EXIT_BRANCH      == HV_EXIT_BRANCH,      "exit code drift");
+    _Static_assert(HENGE_EXIT_SYSREG      == HV_EXIT_SYSREG,      "exit code drift");
+    _Static_assert(HENGE_EXIT_EXCEPTION   == HV_EXIT_EXCEPTION,   "exit code drift");
+    _Static_assert(HENGE_EXIT_WFI         == HV_EXIT_WFI,         "exit code drift");
+    _Static_assert(HENGE_EXIT_UNDEF       == HV_EXIT_UNDEF,       "exit code drift");
+    _Static_assert(HENGE_EXIT_UNSUPPORTED == HV_EXIT_UNSUPPORTED, "exit code drift");
+    _Static_assert(HENGE_EXIT_HALT        == HV_EXIT_HALT,        "exit code drift");
+    _Static_assert(HENGE_EXIT_FLUSH       == HV_EXIT_FLUSH,       "exit code drift");
+    _Static_assert(HENGE_EXIT_FAULT_LOOP  == HV_EXIT_FAULT_LOOP,  "exit code drift");
+}
+
+/* PSTATE bits the engine carries in HvCpu.pstate_extra.  These are copied
+ * straight across because the engine stores them where SPSR stores them --
+ * that is what makes MSR/MRS to DAIF/PAN cheap in translated code. */
+#define HENGE_PSTATE_EXTRA \
+    (PSTATE_PAN | PSTATE_UAO | PSTATE_SSBS | PSTATE_DIT | PSTATE_TCO)
+
+static CPUARMState *arm_env(const void *p)
+{
+    return (CPUARMState *)p;
+}
+
+int hv_engine_load_state(HvCpu *cpu, const void *arm_env_p)
+{
+    CPUARMState *env = arm_env(arm_env_p);
+    uint64_t ps = pstate_read(env);
+    unsigned mode = ps & 0xf;
+    unsigned el = (mode >> 2) & 3;
+    unsigned spsel = mode & 1;
+    int i;
+
+    henge_abi_check();
+
+    /*
+     * The engine models EL0 and EL1 only -- there is no EL2/EL3 in its
+     * exception model, its TLB tables or its translator.  A guest that starts
+     * higher would run with the wrong privilege and fault on the first system
+     * register access, so refuse instead of pretending.
+     *
+     * -M virt already defaults to virtualization=off (vms->virt = false in
+     * virt_instance_init), so the ordinary command line never reaches this.
+     * It fires for -M virt,virtualization=on, for a CPU model that keeps EL2
+     * (has_el2=on), or for a machine that boots at EL3.
+     */
+    if (el > 1) {
+        error_report("henge: guest starts at EL%u; this engine implements "
+                     "EL0/EL1 only.", el);
+        error_report("henge: drop virtualization=on (or has_el2=on) for this "
+                     "machine — the engine has no EL2.");
+        return -1;
+    }
+
+    /*
+     * xregs, not regs.  They are separate arrays in CPUARMState: regs[16] is
+     * the AArch32 view (r0-r15, 32-bit) and xregs[32] is the AArch64 one.  The
+     * engine translates AArch64 only, so xregs is the whole truth here.
+     *
+     * Getting this wrong is silent and expensive: everything that reads
+     * CPUARMState rather than an HvCpu sees zeroes.  It cost exactly one
+     * debugging round -- PSCI's CPU_ON arrived with fn = 0 and came back
+     * NOT_SUPPORTED, because arm_handle_psci_call() reads env->xregs[0].
+     */
+    for (i = 0; i < 31; i++) {
+        cpu->x[i] = env->xregs[i];
+    }
+    cpu->pc = env->pc;
+
+    cpu->el = el;
+    cpu->spsel = spsel;
+    if (spsel) {
+        cpu->sp = env->sp_el[1];
+        cpu->sp_el0 = env->sp_el[0];
+    } else {
+        cpu->sp = env->sp_el[0];
+        cpu->sp_el1 = env->sp_el[1];
+    }
+
+    cpu->nzcv = ps & 0xf0000000u;
+    cpu->daif = ps & PSTATE_DAIF;
+    cpu->pstate_extra = ps & HENGE_PSTATE_EXTRA;
+
+    /* Translation inputs.  If these differ from what the current TLB entries
+     * were filled under, sctlr_seen = 0 forces every entry to be revalidated
+     * instead of trusted.  Cheaper and safer than flushing: load_state runs on
+     * reset, where there is nothing worth keeping anyway. */
+    cpu->sctlr_el1 = env->cp15.sctlr_el[1];
+    cpu->sctlr_seen = 0;
+    cpu->tcr_el1 = env->cp15.tcr_el[1];
+    cpu->ttbr0_el1 = env->cp15.ttbr0_el[1];
+    cpu->ttbr1_el1 = env->cp15.ttbr1_el[1];
+    cpu->mair_el1 = env->cp15.mair_el[1];
+
+    /* Everything the guest can read back. */
+    cpu->vbar_el1 = env->cp15.vbar_el[1];
+    cpu->contextidr_el1 = env->cp15.contextidr_el[1];
+    cpu->mdscr_el1 = env->cp15.mdscr_el1;
+    cpu->cpacr_el1 = env->cp15.cpacr_el1;
+    cpu->tpidr_el1 = env->cp15.tpidr_el[1];
+    cpu->tpidr_el0 = env->cp15.tpidr_el[0];
+    cpu->tpidrro_el0 = env->cp15.tpidrro_el[0];
+    cpu->cntkctl_el1 = env->cp15.c14_cntkctl;
+    cpu->el0_cnt = env->cp15.c14_cntkctl & 3;
+
+    /*
+     * CNTVOFF_EL2.  Zero on a bare -M virt guest at EL1, which is why it went
+     * unnoticed: the engine read its own field, that field was zero, and the
+     * virtual counter matched the physical one, as it should when there is no
+     * hypervisor.  It stops being zero the moment anything sets it, and then
+     * CNTVCT would be wrong by a constant that nothing else in the system
+     * knows about -- a silently skewed clock, not a crash.
+     *
+     * The engine's own CNTVCT path never applied this value before either, so
+     * this is the first time the two agree.  Copied from env, where QEMU keeps
+     * it, rather than forwarded: it is per-CPU state the engine already has a
+     * field for and uses inline.
+     */
+    cpu->cntvoff = env->cp15.cntvoff_el2;
+    cpu->esr_el1 = env->cp15.esr_el[1];
+    cpu->far_el1 = env->cp15.far_el[1];
+    cpu->elr_el1 = env->elr_el[1];
+
+    for (i = 0; i < 32; i++) {
+        cpu->v[i] = ((__uint128_t)env->vfp.zregs[i].d[1] << 64) |
+                    env->vfp.zregs[i].d[0];
+    }
+    cpu->fpcr = env->vfp.fpcr;
+    cpu->fpsr = env->vfp.fpsr;
+
+    /* Reset the exclusive monitor and drop translations: after a load_state
+     * nothing about the previous epoch is trustworthy. */
+    cpu->excl_addr = ~0ull;
+    hv_tlb_flush(cpu);
+
+    if (henge_tracing(HENGE_TRACE_ENV)) {
+        fprintf(stderr, "henge: load_state pc=0x%016" PRIx64 " x0=0x%016" PRIx64
+                " el=%u\n", cpu->pc, cpu->x[0], cpu->el);
+    }
+
+    return 0;
+}
+
+void hv_engine_save_state(const void *arm_env_p, HvCpu *cpu)
+{
+    CPUARMState *env = arm_env(arm_env_p);
+    uint64_t ps;
+    int i;
+
+    for (i = 0; i < 31; i++) {
+        env->xregs[i] = cpu->x[i];
+    }
+    /* The engine keeps the live SP in cpu->sp and the banked one alongside.
+     * QEMU keeps both sp_el[0] and sp_el[1] and picks by PSTATE.SP, so rebuild
+     * both slots from wherever the engine left them. */
+    if (cpu->spsel) {
+        env->sp_el[1] = cpu->sp;
+        env->sp_el[0] = cpu->sp_el0;
+    } else {
+        env->sp_el[0] = cpu->sp;
+        env->sp_el[1] = cpu->sp_el1;
+    }
+    env->pc = cpu->pc;
+
+    ps = cpu->nzcv | cpu->daif | (cpu->pstate_extra & HENGE_PSTATE_EXTRA) |
+         (cpu->el << 2) | (cpu->spsel ? 1 : 0);
+    pstate_write(env, ps);
+
+    env->cp15.sctlr_el[1] = cpu->sctlr_el1;
+    env->cp15.tcr_el[1] = cpu->tcr_el1;
+    env->cp15.ttbr0_el[1] = cpu->ttbr0_el1;
+    env->cp15.ttbr1_el[1] = cpu->ttbr1_el1;
+    env->cp15.mair_el[1] = cpu->mair_el1;
+    env->cp15.vbar_el[1] = cpu->vbar_el1;
+    env->cp15.contextidr_el[1] = cpu->contextidr_el1;
+    env->cp15.mdscr_el1 = cpu->mdscr_el1;
+    env->cp15.cpacr_el1 = cpu->cpacr_el1;
+    env->cp15.tpidr_el[1] = cpu->tpidr_el1;
+    env->cp15.tpidr_el[0] = cpu->tpidr_el0;
+    env->cp15.tpidrro_el[0] = cpu->tpidrro_el0;
+    env->cp15.c14_cntkctl = cpu->cntkctl_el1;
+    env->cp15.cntvoff_el2 = cpu->cntvoff;
+    env->cp15.esr_el[1] = cpu->esr_el1;
+    env->cp15.far_el[1] = cpu->far_el1;
+    env->elr_el[1] = cpu->elr_el1;
+
+    for (i = 0; i < 32; i++) {
+        env->vfp.zregs[i].d[0] = (uint64_t)cpu->v[i];
+        env->vfp.zregs[i].d[1] = (uint64_t)(cpu->v[i] >> 64);
+    }
+    env->vfp.fpcr = cpu->fpcr;
+    env->vfp.fpsr = cpu->fpsr;
+}
+
+/*
+ * TODO before this can be called a port rather than a demo:
+ *   - EL2/EL3 state (only reachable once the engine models them at all)
+ *   - CNTV_CTL/CNTV_CVAL/CNTV_TVAL and CNTPCT, once QEMU owns the timer:
+ *     the engine's time base is the host's CNTVCT scaled to 24 MHz
+ *     (engine/compat/plat_linux.c), while QEMU's -M virt advertises a 62.5 MHz
+ *     CNTFRQ, so today the two clocks disagree and any guest that calibrates
+ *     its delay loop against CNTFRQ will drift.
+ *   - GICv3 system registers (ICC_*), which currently reach nothing.
+ */
+
+/* ------------------------------------------------------------------ */
+/* The system-register forwarder                                       */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Why this exists, in one sentence: the engine models the ARMv8 system
+ * registers a hypervisor needs, and QEMU models the rest -- GICv3's CPU
+ * interface (ICC_*), the generic timer's compare registers (CNTV_CVAL and
+ * friends), and whatever a device adds later.  Neither list is a subset of the
+ * other, and guessing which one owns a register by its encoding is exactly the
+ * kind of table that rots.
+ *
+ * The engine therefore gives up on the registers it does not know: instead of
+ * injecting UNDEF it leaves the block with HENGE_EXIT_SYSREG_EXT, and this file
+ * answers from QEMU's own table.  That table is cpu->cp_regs, populated by the
+ * GIC and the timer core at realize time with the same readfn/writefn the TCG
+ * path would call -- so GIC semantics (priority, group, PMR comparison, the
+ * active-priority stack) never get reimplemented here.  This is the whole
+ * reason the GIC stops being a two-week job: the control plane was already
+ * working through the MMIO catch-all, and the CPU interface turns out to be a
+ * register-table lookup, not a device model.
+ */
+
+/*
+ * GUEST semantics, not raw semantics -- and the difference is not cosmetic.
+ *
+ * QEMU exports read_raw_cp_reg() (and keeps write_raw_cp_reg() static), but
+ * both are the *migration* path: raw means "move the storage, do not run the
+ * side effects".  A guest access must do the opposite.  CNTV_CVAL_EL0 is the
+ * clean example, and it is the one that made this a bug:
+ *
+ *     .writefn = gt_virt_cval_write, .raw_writefn = raw_write
+ *
+ * Writing the CVAL through raw_writefn stores the number and never calls
+ * gt_recalc_timer(), so the host's timer is never armed and the interrupt the
+ * guest asked for never arrives -- with every register readback looking
+ * perfectly correct.  This was found only by a closed-loop probe (program a
+ * deadline, wait for the IRQ); no amount of comparing register values would
+ * have shown it.
+ *
+ * So: writefn first, raw_writefn only as a fallback for registers that have no
+ * guest-side write.  Same reason on the read side: readfn can compute ISTATUS
+ * or claim an interrupt.
+ */
+static uint64_t henge_cpreg_read(CPUARMState *env, const ARMCPRegInfo *ri)
+{
+    if (ri->type & ARM_CP_CONST) {
+        return ri->resetvalue;
+    }
+    if (ri->readfn) {
+        return ri->readfn(env, ri);
+    }
+    if (ri->raw_readfn) {
+        return ri->raw_readfn(env, ri);
+    }
+    return raw_read(env, ri);
+}
+
+static void henge_cpreg_write(CPUARMState *env, const ARMCPRegInfo *ri,
+                              uint64_t value)
+{
+    if (ri->type & ARM_CP_CONST) {
+        return;                       /* writes to a constant are ignored */
+    }
+    if (ri->writefn) {
+        ri->writefn(env, ri, value);
+    } else if (ri->raw_writefn) {
+        ri->raw_writefn(env, ri, value);
+    } else {
+        raw_write(env, ri, value);
+    }
+}
+
+/*
+ * Answer one pending MRS/MSR.  Called with the BQL held, because a cpreg's
+ * accessfn and its read/writefn are allowed to touch device state (the GIC's
+ * are: ICC_IAR1_EL1 claims an interrupt and moves the active-priority stack).
+ */
+static void henge_service_sysreg(CPUState *cs, HvCpu *cpu)
+{
+    ARMCPU *acpu = ARM_CPU(cs);
+    CPUARMState *env = &acpu->env;
+    const ARMCPRegInfo *ri;
+    uint32_t reg = 0, key;
+    int rt = 0, is_write = 0, el = 1;
+    uint64_t pc = 0, value = 0;
+    CPAccessResult ar;
+
+    if (!hv_engine_sysreg_pending(cpu, &reg, &rt, &is_write, &pc, &value, &el)) {
+        return;
+    }
+
+    /* The engine packs op0:op1:crn:crm:op2 into 16 bits (see its R() macro).
+       QEMU's key is the same five fields in its own arrangement. */
+    key = ENCODE_AA64_CP_REG(reg >> 14, (reg >> 11) & 7, (reg >> 7) & 15,
+                             (reg >> 3) & 15, reg & 7);
+    ri = get_arm_cp_reginfo(acpu->cp_regs, key);
+    if (!ri) {
+        /*
+         * Not in QEMU's table either.  Two different architectural answers,
+         * and using the wrong one is a guest-visible bug in both directions:
+         *
+         *   ID space (op0=3, CRn=0): an unimplemented ID register READS AS
+         *   ZERO.  It must not UNDEF -- a guest probing "do I have FEAT_X?"
+         *   would take an exception instead of getting "no".  This is also
+         *   what the engine answered before the seam existed, so nothing
+         *   regresses for the registers QEMU simply does not register.
+         *
+         *   Everything else: UNDEF, which is what the engine would have done
+         *   on its own.  A guest must not be told an unimplemented register
+         *   exists.
+         */
+        if (!is_write && ((reg >> 14) == 3 && ((reg >> 7) & 15) == 0)) {
+            hv_engine_sysreg_resume(cpu, 0, 1);
+            return;
+        }
+        hv_engine_sysreg_resume(cpu, 0, 0);
+        if (henge_tracing(HENGE_TRACE_SYSREG)) {
+            fprintf(stderr, "henge: unhandled %s S%u_%u_C%u_C%u_%u at 0x%"
+                    PRIx64 " (not in cp_regs)\n",
+                    is_write ? "MSR" : "MRS", reg >> 14, (reg >> 11) & 7,
+                    (reg >> 7) & 15, (reg >> 3) & 15, reg & 7, pc);
+        }
+        return;
+    }
+
+    /*
+     * Name resolution is done; now the same three checks QEMU's own access
+     * path makes, in the same order, because skipping them is invisible in a
+     * smoke test and wrong in a guest:
+     *
+     *   1. PL.  ri->access has one bit per (EL, direction).  Without this an
+     *      EL0 read of a PL1 register (MPIDR, CNTFRQ, ID_AA64*) would return
+     *      the value instead of UNDEF -- a privilege check that silently
+     *      passes.  The EL comes from the engine, not from env.
+     *   2. accessfn.  This is where a register refuses on its own terms --
+     *      ICC_* with ICC_SRE_EL1 disabled, for instance, must UNDEF here or
+     *      the guest is told a sysreg interface exists when it is not enabled.
+     *   3. read/writefn.  read_raw_cp_reg covers all three storage shapes:
+     *      ARM_CP_CONST -> resetvalue, raw_readfn, readfn, then raw_read
+     *      through fieldoffset.  That is why the ID registers (CONST) and
+     *      CNTFRQ (a field in env.cp15) both work through this one call.
+     */
+    if (!cp_access_ok(el, ri, !is_write)) {
+        if (henge_tracing(HENGE_TRACE_SYSREG)) {
+            fprintf(stderr, "henge: %s S%u_%u_C%u_C%u_%u at 0x%" PRIx64
+                    " denied at EL%d (access=0x%x)\n",
+                    is_write ? "MSR" : "MRS", reg >> 14, (reg >> 11) & 7,
+                    (reg >> 7) & 15, (reg >> 3) & 15, reg & 7, pc, el,
+                    ri->access);
+        }
+        hv_engine_sysreg_resume(cpu, 0, 0);   /* UNDEF, as the architecture says */
+        return;
+    }
+
+    ar = CP_ACCESS_OK;
+    if (ri->accessfn) {
+        ar = ri->accessfn(env, ri, !is_write);
+    }
+    if (ar != CP_ACCESS_OK) {
+        /*
+         * A refusal here ought to be a trap to a higher EL carrying a
+         * syndrome, not a UNDEF.  For the registers this seam currently
+         * carries (ICC_*, ID group, the timer compares) a trap and a UNDEF
+         * are the same thing to a guest with no EL2, and trapping properly
+         * needs the engine's exception machinery rather than a return code.
+         * Recorded as a known gap, not papered over: HENGE_DEBUG_SYSREG says
+         * which register it was.
+         */
+        if (henge_tracing(HENGE_TRACE_SYSREG)) {
+            fprintf(stderr, "henge: %s %s at 0x%" PRIx64
+                    " refused by accessfn (%d) at EL%d\n",
+                    is_write ? "MSR" : "MRS", ri->name, pc, (int)ar, el);
+        }
+        hv_engine_sysreg_resume(cpu, 0, 0);
+        return;
+    }
+
+    if (is_write) {
+        henge_cpreg_write(env, ri, value);
+        hv_engine_sysreg_resume(cpu, 0, 1);
+    } else {
+        hv_engine_sysreg_resume(cpu, henge_cpreg_read(env, ri), 1);
+    }
+
+    if (henge_tracing(HENGE_TRACE_SYSREG)) {
+        unsigned r_crn = (reg >> 7) & 15, r_crm = (reg >> 3) & 15;
+        unsigned r_op2 = reg & 7;
+
+        fprintf(stderr, "henge: cpu%d %s S%u_%u_C%u_C%u_%u at 0x%" PRIx64
+                " -> %s", cs->cpu_index, is_write ? "MSR" : "MRS",
+                reg >> 14, (reg >> 11) & 7, r_crn, r_crm, r_op2, pc,
+                ri->name);
+        /*
+         * ICC_* needs three extra numbers, and they are not decoration.
+         *
+         * The GICv3 CPU interface is banked by security state, and the bank a
+         * write lands in is decided from CPUARMState: gicv3_use_ns_bank()
+         * reads arm_is_secure_below_el3(), icc_bpr_write() looks at
+         * arm_current_el().  Under this accelerator CPUARMState is only
+         * refreshed at synchronisation points, so "which bank did that write
+         * actually reach" cannot be assumed from the guest's EL -- it has to be
+         * printed and read.  That is what caught the bpr==0 assert.
+         */
+        if (r_crn == 12 || (r_crn == 4 && r_crm == 6)) {
+            fprintf(stderr, " [el=%d env_el=%d ns_bank=%d cpsr=0x%x%s]",
+                    el, arm_current_el(env),
+                    !arm_is_secure_below_el3(env),
+                    env->uncached_cpsr,
+                    is_write ? "" : "");
+            if (is_write) {
+                fprintf(stderr, " [value=0x%" PRIx64 "]", value);
+            }
+        }
+        /*
+         * Compare the deadline against QEMU's clock -- but ONLY on a CVAL
+         * write, where `value` really is an absolute deadline in the guest's
+         * counter domain.
+         *
+         * This block used to fire for every CRn 14 access, which produced two
+         * lines that read like evidence and were not:
+         *
+         *   - on a CTL write, `value` is the control word (1/5/7), so any
+         *     positive clock printed "DEADLINE ALREADY PASSED";
+         *   - on a read, hv_engine_sysreg_pending() leaves `value` at 0, so it
+         *     printed the same thing regardless of what the guest got.
+         *
+         * Both were misinterpreted once during SMP bring-up.  A trace line has
+         * to mean exactly one thing or it is worse than no line at all.
+         */
+        if (is_write && r_crn == 14 && (r_crm == 2 || r_crm == 3) &&
+            r_op2 == 2) {
+            uint64_t f = hv_engine_timer_freq(henge_accel_machine());
+            uint64_t now = f ? muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL),
+                                        f, NANOSECONDS_PER_SECOND) : 0;
+            fprintf(stderr, "  [deadline=%" PRIu64 ", qemu_virt_ticks=%" PRIu64
+                    ", delta=%" PRId64 " ticks, %s]",
+                    value, now, (int64_t)(value - now),
+                    now < value ? "future" : "ALREADY PASSED");
+        }
+        fprintf(stderr, "\n");
+    }
+}
+
+/* Runs on the target vCPU thread, after QEMU's own CPU_ON work item. */
+static void henge_resync_target(CPUState *cs, run_on_cpu_data data)
+{
+    if (cs->opaque) {
+        hv_engine_load_state(cs->opaque, &ARM_CPU(cs)->env);
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* The tick source                                                     */
+/* ------------------------------------------------------------------ */
+
+/*
+ * How long until this vCPU's next generic-timer expiry, in 24 MHz host ticks.
+ *
+ * The engine asked for none of this before: m->tick was NULL, so every WFI
+ * unwound the run and the vCPU was parked until QEMU kicked it.  The engine now
+ * gets a deadline it can sleep to.
+ *
+ * Read from QEMU's own timer state, not the engine's.  That is not a
+ * preference: sysreg_external routes CNTV_CVAL/CTL to the cpreg table, so the
+ * engine's cntv_cval/cntv_ctl are written once at reset and never again.  The
+ * authority is env->cp15.c14_timer[GTIMER_VIRT], which gt_cval_write() fills and
+ * gt_recalc_timer() arms.
+ *
+ * The two timers are merged the way the standalone board merges them (take the
+ * earlier of the two), and only enabled-and-not-masked timers count -- bit 0 of
+ * CTL is ENABLE, bit 1 is IMASK, and IMASK means the output is suppressed but
+ * the compare still happens.
+ *
+ * Units, and why it is a delta: the guest counts at CNTFRQ (62.5 MHz on -M virt)
+ * while the engine sleeps in its own 24 MHz domain.  A difference between two
+ * guest-domain values cancels the epoch that QEMU recalibrates on every
+ * stop/cont; converting an absolute value would have to reconstruct it.
+ */
+uint64_t henge_tick_delta24(void *opaque, uint32_t index)
+{
+    CPUState *cs = qemu_get_cpu(index);
+    CPUARMState *env;
+    uint64_t freq, now_ns, now_guest, best = 0;
+    int t;
+
+    if (!cs) {
+        return 0;
+    }
+    env = &ARM_CPU(cs)->env;
+    freq = ARM_CPU(cs)->gt_cntfrq_hz;
+    if (!freq) {
+        return 0;
+    }
+
+    now_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    now_guest = muldiv64(now_ns, freq, NANOSECONDS_PER_SECOND);
+
+    for (t = 0; t < 2; t++) {
+        int idx = t == 0 ? GTIMER_VIRT : GTIMER_PHYS;
+        uint64_t ctl = env->cp15.c14_timer[idx].ctl;
+        uint64_t cval = env->cp15.c14_timer[idx].cval;
+        uint64_t delta;
+
+        if (!(ctl & 1) || (ctl & 2)) {
+            continue;                       /* not enabled, or masked */
+        }
+        delta = cval - now_guest;           /* unsigned: wraps "already past" */
+        if ((int64_t)delta <= 0) {
+            return 0;                       /* expired: fire, do not sleep */
+        }
+        if (!best || delta < best) {
+            best = delta;
+        }
+    }
+    if (!best) {
+        return 0;
+    }
+    /* Guest ticks -> 24 MHz host ticks.  Round up: sleeping one tick short of
+     * the deadline means waking for nothing, which is the thing this exists to
+     * avoid. */
+    best = muldiv64(best, 24000000ull, freq);
+    return best ? best : 1;
+}
+
+/*
+ * PSCI, dispatched straight into QEMU's conduit.
+ *
+ * The tempting route was to widen `if (tcg_enabled() && arm_is_psci_call(...))`
+ * in arm_cpu_do_interrupt() and let QEMU's exception machinery deliver the
+ * call.  That route drags in the whole TCG exception path -- vector selection,
+ * PSTATE updates, syndrome construction -- and then requires translating its
+ * result back into the engine's state.  Calling arm_handle_psci_call() directly
+ * is both smaller and more honest about what is happening: PSCI is not an
+ * exception here, it is a hypercall QEMU has promised to answer.
+ *
+ * psci.c has no TCG dependency at all (two functions, CPUState and env only),
+ * so this is safe in a non-TCG accelerator -- but arm_is_psci_call() *is*
+ * compiled out to `return false` when CONFIG_TCG is off, which would turn every
+ * HVC into "not PSCI" and then into an UNDEF.  That is a build-time fact, so it
+ * is a build-time error rather than a runtime surprise.
+ *
+ * Register contract: a full sync in, a full sync out.  arm_handle_psci_call()
+ * reads env->xregs[0..3] and writes env->xregs[0], and CPU_ON calls
+ * arm_set_cpu_on() which resets the *target* CPU through QEMU's own path (which
+ * in turn calls our synchronize_post_reset).  PSCI runs a few dozen times during
+ * boot, so paying a full TLB flush per call to keep the contract simple is the
+ * right trade.
+ */
+static void henge_service_psci(CPUState *cs, HvCpu *cpu)
+{
+    ARMCPU *acpu = ARM_CPU(cs);
+    CPUARMState *env = &acpu->env;
+    uint64_t pc = 0, args[4] = {0};
+    int is_smc = 0, excp;
+
+    if (!hv_engine_psci_pending(cpu, &pc, args, &is_smc)) {
+        return;
+    }
+
+#if defined(CONFIG_TCG)
+    hv_engine_save_state(env, cpu);
+
+    excp = is_smc ? EXCP_SMC : EXCP_HVC;
+    if (arm_is_psci_call(acpu, excp)) {
+        arm_handle_psci_call(acpu);
+
+        /*
+         * The caller's own state comes back through load_state, which is safe
+         * here: save_state above just published the engine's truth, so nothing
+         * of the caller's is lost.
+         *
+         * CPU_ON needs one more step.  arm_handle_psci_call() ends in
+         * arm_set_cpu_on(), which only *queues* arm_set_cpu_on_async_work() on
+         * the target; that work is what does cpu_reset(), writes
+         * env.xregs[0] = context_id and cpu_set_pc(entry).  The target is
+         * parked in its own thread, so unless we hand it a follow-up item that
+         * runs *after* the queued work, the engine enters the secondary with
+         * whatever env held before -- measured as x0 = 0 and pc = 0 while the
+         * guest expected context_id and the entry point.
+         *
+         * run_on_cpu() appends to the same per-CPU queue, so ordering is
+         * guaranteed: reset-and-set-env first, our re-sync second.
+         */
+        if (((uint32_t)args[0] == 0xc4000003u || (uint32_t)args[0] == 0x84000003u)
+            && (uint32_t)env->xregs[0] == 0) {
+            CPUState *target = arm_get_cpu_by_id(args[1]);
+            if (target && target->opaque) {
+                run_on_cpu(target, henge_resync_target, RUN_ON_CPU_NULL);
+            }
+        }
+
+        hv_engine_load_state(cpu, env);
+        hv_engine_psci_resume(cpu, env->xregs[0], 1);
+        if (henge_tracing(HENGE_TRACE_PSCI)) {
+            fprintf(stderr, "henge: PSCI %s fn=0x%" PRIx64
+                    " -> 0x%" PRIx64 "\n", is_smc ? "SMC" : "HVC",
+                    args[0], (uint64_t)env->xregs[0]);
+        }
+        return;
+    }
+    /* Not a PSCI function number: put the guest's own semantics back.  With no
+       EL3 an SMC is undefined; an HVC nobody claimed likewise. */
+    hv_engine_psci_resume(cpu, 0, 0);
+#else
+    (void)excp;
+    error_report("henge: PSCI forwarding needs CONFIG_TCG (arm_is_psci_call "
+                 "is compiled out without it)");
+    hv_engine_psci_resume(cpu, (uint64_t)-1, 1);
+#endif
+}
+
+/*
+ * Returns true if the exit was one of the seams and has been serviced, in which
+ * case the caller should call hv_run() again instead of treating it as a reason
+ * to leave the vCPU thread.
+ */
+bool henge_service_external_exit(CPUState *cs, HvCpu *cpu, int r)
+{
+    switch (r) {
+    case HENGE_EXIT_SYSREG_EXT:
+        henge_service_sysreg(cs, cpu);
+        return true;
+    case HENGE_EXIT_PSCI_EXT:
+        henge_service_psci(cs, cpu);
+        return true;
+    default:
+        return false;
+    }
+}
diff --git a/accel/henge/henge-engine.c b/accel/henge/henge-engine.c
new file mode 100644
index 0000000000..624593d268
--- /dev/null
+++ b/accel/henge/henge-engine.c
@@ -0,0 +1,818 @@
+/*
+ * Henge accelerator: the engine-side half of the bridge
+ *
+ * Everything QEMU calls that has to know the engine's private layouts lives
+ * here.  This file is compiled as part of the engine static library, so it
+ * sees engine/core/*.h and NOT QEMU's headers: the two worlds share a
+ * vocabulary (HvMachine, HvCpu) but their headers must never be included in
+ * the same translation unit, because the engine defines its own cpu.h /
+ * machine.h with names QEMU also uses.
+ *
+ * The QEMU-side half is henge-cpu.c (registers) plus henge-accel*.c.
+ *
+ * Three obligations of the engine that are easy to miss, and that this file
+ * exists to honour:
+ *
+ *   1. HvCpu needs 128-byte alignment.  It has `aligned(128)` members (the
+ *      TLB tables and ret_salt), so plain malloc - 8 or 16 bytes on glibc -
+ *      is not enough.  main_android.c got away with a static array, where the
+ *      compiler does it for you.
+ *   2. The storage must be ZERO before hv_cpu_reset_index().  That function
+ *      reads p->ijc_tables_used and p->ijc_tables_used is part of HvPerCpu,
+ *      which lives in the machine, not in the CPU -- but it also memsets the
+ *      CPU in three ranges that deliberately skip m and pc_state.  Passing
+ *      uninitialised heap would make it walk garbage table pointers.
+ *   3. hv_machine_init() does NOT read the HV_* environment knobs (only
+ *      hv_machine_init_jit() calls knobs_init()).  That is not a bug to fix
+ *      here: every measurement this project has - 74.0 ns at 512 MB, the
+ *      +8.0% boot cost of the EL split - was taken with the knobs at zero.
+ *      "Fixing" it would silently move the baseline.
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* mach_absolute_time() is the engine's portable name for "host counter, 24 MHz"
+ * (compat/mach/mach_time.h defines it as hv_host_ticks_24mhz()).  The WFI path
+ * in dispatch.c compares tick()'s return value against it, so the tick stub
+ * below has to be in the same domain. */
+#include <mach/mach_time.h>
+
+#include "engine/core/cpu.h"
+#include "engine/core/machine.h"
+#include "engine/core/mmu.h"
+#include "engine/core/exception.h"
+#include "engine/core/sysreg.h"   /* hv_guest_ticks */
+#include "engine/core/dispatch.h"
+
+/* The contract header is written for QEMU TUs (it pulls in qemu/osdep.h), so
+ * it cannot be included here.  What this file needs from it are the two
+ * prototypes QEMU expects, declared identically; henge-cpu.c asserts they
+ * still match.  Keep these in sync with include/system/henge-engine.h. */
+typedef int (*HvMmioForward)(void *opaque, uint64_t pa, void *buf,
+                             uint32_t len, int is_write);
+
+/* ------------------------------------------------------------------ */
+/* Machine                                                             */
+/* ------------------------------------------------------------------ */
+
+HvMachine *hv_engine_machine_new(size_t jit_bytes)
+{
+    HvMachine *m;
+
+    if (jit_bytes < (1u << 20)) {
+        jit_bytes = 1u << 20;
+    }
+    m = calloc(1, sizeof *m);
+    if (!m) {
+        return NULL;
+    }
+    /* Allocates the JIT region and every per-machine table.  No RAM: under
+     * QEMU the memory belongs to a MemoryRegion and arrives later through
+     * hv_machine_add_ram(). */
+    if (hv_machine_init(m, jit_bytes) != 0) {
+        free(m);
+        return NULL;
+    }
+    /* Read once: the deferred-flush instrumentation is off unless asked for. */
+    m->dbg_flush = getenv("HV_DBG_FLUSH") != NULL;
+    return m;
+}
+
+/*
+ * @defer_flush: caller is a host thread that must not touch any vCPU's TLB
+ * (QEMU's MemoryListener, which runs on the main thread holding the BQL while
+ * vCPUs are live).  It retires the window here and expects a following
+ * hv_engine_request_flush() to do the invalidation at a point where every vCPU
+ * is parked.  Without it, hv_tlb_flush() would memset a TLB that a running
+ * vCPU is reading: measured at 619,156 torn reads in five seconds on a single
+ * entry, each one an addend of 0x8080808080808080 added to a guest address.
+ */
+int hv_machine_del_ram_flags(HvMachine *m, uint64_t pa, uint64_t size,
+                             int defer_flush)
+{
+    HvRam *r = NULL;
+    int i;
+
+    for (i = 0; i < m->nram; i++) {
+        if (m->ram[i].host && m->ram[i].pa == pa) {
+            r = &m->ram[i];
+            break;
+        }
+    }
+    if (!r) {
+        return -1;
+    }
+
+    /*
+     * Both of these reach into state another vCPU may be using right now --
+     * hv_invalidate_code() walks the chained-exit list and the IJC, and
+     * hv_tlb_flush() memsets the TLB -- so a deferred caller skips them and
+     * leaves the whole job to the flush it requests.  That flush empties the
+     * blocks, the JIT, every IJC, the return tables and (via need_tlb_flush)
+     * every TLB entry, which is a superset of what these two do.
+     */
+    if (!defer_flush) {
+        /* 1. Kill every translation that came from these pages.  hv_invalidate_code
+         *    bumps page_gen so the next lookup retranslates, and reaches into the
+         *    chained exits and the indirect-branch caches of other CPUs.  Doing
+         *    this before dropping the arrays is deliberate: it needs
+         *    code_pages/page_gen to still be there. */
+        {
+            uint64_t pages = (r->size + (1u << HV_TLB_PAGE_BITS) - 1) >> HV_TLB_PAGE_BITS;
+            uint64_t pg;
+
+            for (pg = 0; pg < pages; pg++) {
+                if (r->code_pages[pg]) {
+                    hv_invalidate_code(m, r->pa + (pg << HV_TLB_PAGE_BITS));
+                }
+            }
+        }
+
+        /* 2. Drop every CPU's TLB: entries hold host addresses into memory that
+         *    QEMU is about to hand to somebody else.  Legitimate here only
+         *    because a non-deferring caller is the owner (reset, boot) or has
+         *    already parked everybody. */
+        for (i = 0; i < HV_MAX_CPUS; i++) {
+            if (m->cpus[i]) {
+                hv_tlb_flush(m->cpus[i]);
+            }
+        }
+    }
+
+    /* 3. Release the bookkeeping, then *retire the slot*.  size = 0 alone made
+     *    hv_ram_lookup() (pa - r->pa < r->size) miss it, which covers
+     *    hv_phys_ptr and the DMA path -- but it left m->nram untouched, and
+     *    add_ram() consumes a slot every call.  HV_MAX_RAM is 8, so eight
+     *    add/remove cycles exhausted the table and every later add failed
+     *    with "failed to mirror".
+     *
+     *    That was not theoretical: pflash calls
+     *    memory_region_rom_device_set_romd() on every CFI command write, and
+     *    with the listener finally wired each toggle is a del + add of the
+     *    whole 64 MB variable-store window.  UEFI reached the shell with
+     *    twenty-seven "failed to mirror virt.flash1" lines behind it, i.e. it
+     *    had been running with the window absent from the engine.
+     *
+     *    Compaction is what makes the slot reusable.  The last entry moves
+     *    into the hole, so main_ram (a pointer into the array) needs the same
+     *    move applied -- otherwise it dangles into the vacated tail. */
+    free(r->code_pages);
+    free(r->page_gen);
+    free(r->whint);
+    r->code_pages = NULL;
+    r->page_gen = NULL;
+    r->whint = NULL;
+    r->host = NULL;
+    r->size = 0;
+    r->pa = 0;
+    r->readonly = 0;
+    if (m->main_ram == r) {
+        /* Leave no dangling main_ram.  Do NOT compact the array to do this:
+         * hv_ram_lookup() hands out HvRam * that callers hold across further
+         * add/remove calls, so moving entries turns those into use-after-move.
+         * Measured as an immediate SIGSEGV at the first romd toggle.  add_ram()
+         * reuses a retired slot instead, which keeps every pointer stable. */
+        m->main_ram = NULL;
+        for (i = 0; i < m->nram; i++) {
+            if (m->ram[i].size &&
+                (!m->main_ram || m->ram[i].size > m->main_ram->size)) {
+                m->main_ram = &m->ram[i];
+            }
+        }
+    }
+    return 0;
+}
+
+int hv_machine_del_ram(HvMachine *m, uint64_t pa, uint64_t size)
+{
+    return hv_machine_del_ram_flags(m, pa, size, 0);
+}
+
+/*
+ * Ask for a full invalidation at the next safe point, from a thread that must
+ * not touch a vCPU itself.
+ *
+ * This is the engine's own mechanism, not a new one: flush_pending is what
+ * helpers use, and dispatch.c's loop already heads every iteration with
+ *
+ *     if (flush_pending || stw_active) { stop_the_world(cpu); continue; }
+ *
+ * stop_the_world parks everybody (active == 0, the two-phase handshake in
+ * park/unpark is what closes the entry race), then calls hv_flush_blocks under
+ * tr_mu.  need_tlb_flush makes that flush empty the entries as well, which is
+ * what a removed or demoted RAM window requires.
+ *
+ * Deliberately does not wait: the caller holds the BQL, and a vCPU that is
+ * inside henge_mmio_forward() is waiting for that same BQL.  Blocking here
+ * would deadlock the VM.  The window between this call and the flush is real
+ * and bounded by one block's execution plus the stop-the-world handshake; the
+ * guest still reads the old mapping through its TLB for that long, which is
+ * what the caller's own "retire the window first" step is for.
+ */
+void hv_engine_request_flush(HvMachine *m)
+{
+    int i;
+
+    if (!m) {
+        return;
+    }
+    /*
+     * HV_DBG_FLUSH doubles as the Phase 1 acceptance gate: it stamps the
+     * request and reports the delay when the flush actually happens, so the
+     * semantic window is a number instead of a hope.  Off by default.
+     */
+    if (m->dbg_flush) {
+        m->flush_req_ns = mach_absolute_time();
+        m->flush_reqs++;
+    }
+    __atomic_store_n(&m->need_tlb_flush, 1, __ATOMIC_SEQ_CST);
+    __atomic_store_n(&m->flush_pending, 1, __ATOMIC_SEQ_CST);
+    for (i = 0; i < m->ncpus; i++) {
+        if (m->cpus[i]) {
+            /* Wake, not just kick: a vCPU sleeping in WFI inside
+             * wait_for_interrupt() is parked and has to come back to a
+             * dispatcher iteration to see flush_pending at all. */
+            hv_cpu_wake(m->cpus[i]);
+        }
+    }
+}
+
+
+HvCpu *hv_engine_cpu_new(HvMachine *m, uint32_t index)
+{
+    HvCpu *cpu = NULL;
+    void *p = NULL;
+
+    if (!m || index >= (uint32_t)HV_MAX_CPUS) {
+        return NULL;
+    }
+    if (posix_memalign(&p, 128, sizeof *cpu) != 0) {
+        return NULL;
+    }
+    cpu = p;
+    memset(cpu, 0, sizeof *cpu);   /* see obligation (2) above */
+    /* The _index form: hv_cpu_reset() would hardcode 0 and alias every vCPU
+     * onto m->cpus[0]. */
+    hv_cpu_reset_index(cpu, m, index);
+    return cpu;
+}
+
+void hv_engine_cpu_set_mpidr(HvCpu *cpu, uint64_t mpidr)
+{
+    cpu->mpidr = mpidr;
+}
+
+/* ------------------------------------------------------------------ */
+/* MMIO: one catch-all region that forwards everything to QEMU          */
+/* ------------------------------------------------------------------ */
+
+static HvMmioForward mmio_forward;
+static void *mmio_opaque;
+
+/*
+ * The engine resolves a physical access in two steps: hv_ram_lookup() for RAM,
+ * then hv_mmio_lookup() over a small table of registered windows.  Under QEMU
+ * the set of device windows is large, dynamic and owned by the other side, so
+ * instead of mirroring it we register ONE window covering the whole physical
+ * address space.  RAM wins the race because hv_phys_read/hv_phys_write check
+ * RAM first, so this only ever sees what RAM did not claim.
+ *
+ * The engine passes the offset within the window, not the address; with a base
+ * of 0 they are the same number.  That is why the base is 0 and not the
+ * beginning of the device range.
+ */
+static uint64_t mmio_fwd_read(void *opaque, uint64_t off, unsigned size)
+{
+    uint64_t v = 0;
+
+    if (!mmio_forward || size > 8) {
+        return 0;
+    }
+    if (mmio_forward(mmio_opaque, off, &v, size, 0) != 0) {
+        /* Nothing to raise from here: the engine's callback API has no error
+         * return, so a failed device read becomes zeroes.  QEMU's own
+         * unassigned-memory path logs the access, which is where to look. */
+        return 0;
+    }
+    return v;
+}
+
+static void mmio_fwd_write(void *opaque, uint64_t off, uint64_t val,
+                           unsigned size)
+{
+    if (!mmio_forward || size > 8) {
+        return;
+    }
+    mmio_forward(mmio_opaque, off, &val, size, 1);
+}
+
+void hv_engine_set_mmio_forward(HvMachine *m, HvMmioForward fn, void *opaque)
+{
+    mmio_forward = fn;
+    mmio_opaque = opaque;
+    if (!m || !fn || m->nmmio) {
+        return;
+    }
+    if (hv_machine_add_mmio(m, 0, ~0ull, NULL,
+                            mmio_fwd_read, mmio_fwd_write, "qemu") != 0) {
+        fprintf(stderr, "henge: cannot register the MMIO catch-all; "
+                        "device accesses will fault the guest\n");
+        return;
+    }
+    /* self_locked: the forwarder serialises itself (it takes QEMU's BQL), so
+     * the engine must not also take its own device lock around it -- that
+     * would invert the QEMU-side lock order on the next MemoryListener
+     * callback. */
+    m->mmio[m->nmmio - 1].self_locked = 1;
+}
+
+/* ------------------------------------------------------------------ */
+/* Seams: what the host owns instead of the engine                     */
+/* ------------------------------------------------------------------ */
+
+void hv_engine_set_external(HvMachine *m, int sysreg, int psci)
+{
+    if (!m) {
+        return;
+    }
+    m->sysreg_external = sysreg ? 1 : 0;
+    m->psci_external = psci ? 1 : 0;
+}
+
+int hv_engine_sysreg_pending(const HvCpu *cpu, uint32_t *reg, int *rt,
+                             int *is_write, uint64_t *pc, uint64_t *value,
+                             int *el)
+{
+    uint32_t insn;
+
+    if (cpu->exit_reason != HV_EXIT_SYSREG_EXT) {
+        return 0;
+    }
+    insn = cpu->exit_insn;
+    /* The engine's own packing (see R() in core/sysreg.c): op0:op1:crn:crm:op2
+       in 16 bits.  Handing this over rather than the raw instruction keeps the
+       decoding in one place -- the engine already got it right, including the
+       deprecation aliases. */
+    if (reg) {
+        *reg = (insn >> 5) & 0xffff;
+    }
+    if (rt) {
+        *rt = insn & 0x1f;
+    }
+    if (is_write) {
+        /* AArch64: bit 21 is L -- 1 for MRS (read), 0 for MSR (write). */
+        *is_write = ((insn >> 21) & 1) ? 0 : 1;
+    }
+    if (pc) {
+        *pc = cpu->pc;
+    }
+    if (value) {
+        /*
+         * For an MSR, the value the guest wrote, out of Rt.  Passing it here
+         * rather than exposing HvCpu.x[] keeps the register file's layout in
+         * one place -- the same reason HvCpu is opaque to QEMU.
+         *
+         * Rt == 31 is XZR for a write, and must contribute 0 -- not x[31].
+         * HvCpu.x is `uint64_t x[31]` (indices 0..30, XZR is not stored,
+         * because it is not a register), so x[31] reads whatever field the
+         * compiler put next, which here is a host pointer.  Getting this wrong
+         * is not a rounding error: `MSR ICC_BPR1_EL1, xzr` -- which is how
+         * Linux zeroes the binary point register -- carried
+         * 0xffff800082ae3af0 into icc_bpr_write(), `value & 7` became 0, and
+         * QEMU's GICv3 asserted on `bpr > 0` a few instructions later.  The
+         * engine's own path (core/sysreg.c, hv_sysreg_msr) has always done
+         * `rt == 31 ? 0 : cpu->x[rt]`; this bridge is the copy that forgot.
+         */
+        unsigned rt = insn & 0x1f;
+
+        *value = ((insn >> 21) & 1) ? 0 : (rt == 31 ? 0 : cpu->x[rt]);
+    }
+    if (el) {
+        /* The engine's PSTATE is the authority, not QEMU's env: env is only
+           written when the two are synchronised, and this exit happens in the
+           middle of a run.  A permission check against a stale EL would let an
+           EL0 access to a PL1 register through. */
+        *el = (int)cpu->el;
+    }
+    return 1;
+}
+
+void hv_engine_sysreg_resume(HvCpu *cpu, uint64_t value, int handled)
+{
+    int is_write = ((cpu->exit_insn >> 21) & 1) ? 0 : 1;
+    int rt = cpu->exit_insn & 0x1f;
+
+    if (!handled) {
+        /* The host does not know it either: put back the semantics the engine
+           would have applied on its own, which is UNDEF.  hv_raise_undef moves
+           pc to the vector and sets HV_EXIT_EXCEPTION, so the caller's next
+           hv_run() carries on inside the guest's handler. */
+        hv_raise_undef(cpu, cpu->pc);
+        return;
+    }
+
+    if (!is_write && rt != 31) {
+        cpu->x[rt] = value;
+    }
+    cpu->pc += 4;
+    cpu->exit_reason = HV_EXIT_BRANCH;
+    /* An MSR can unmask interrupts or program a timer that fires at once; the
+       engine's own path rechecks for that here, and a forwarded write must not
+       be the one case where it is skipped. */
+    if (is_write) {
+        hv_check_interrupts(cpu);
+    }
+}
+
+int hv_engine_psci_pending(const HvCpu *cpu, uint64_t *pc, uint64_t args[4],
+                           int *is_smc)
+{
+    if (cpu->exit_reason != HV_EXIT_PSCI_EXT) {
+        return 0;
+    }
+    if (is_smc) {
+        /* SMC is ll == 3, HVC is ll == 2 (instruction bits 1:0).  The host
+           needs it because its conduit decides by exception type. */
+        *is_smc = (cpu->exit_insn & 3) == 3;
+    }
+    if (pc) {
+        *pc = cpu->pc;
+    }
+    if (args) {
+        int i;
+        for (i = 0; i < 4; i++) {
+            args[i] = cpu->x[i];
+        }
+    }
+    return 1;
+}
+
+void hv_engine_psci_resume(HvCpu *cpu, uint64_t ret, int handled)
+{
+    if (!handled) {
+        /* No conduit answered: the call is undefined, as SMC is without EL3. */
+        hv_raise_undef(cpu, cpu->pc);
+        return;
+    }
+    cpu->x[0] = ret;
+    cpu->pc += 4;
+    cpu->exit_reason = HV_EXIT_BRANCH;
+}
+
+/* ------------------------------------------------------------------ */
+/* Machine reset: what a system_reset has to throw away                */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The engine keeps four kinds of derived state that outlive a reboot if nobody
+ * drops them, and every one of them is silently wrong afterwards:
+ *
+ *   translated blocks   the new image is at the same addresses with different
+ *                       bytes; a block key is {va, pa, flags, gen}, and none of
+ *                       those four changed, so the old translation is a match
+ *   software TLB        entries hold host addends for the previous page tables
+ *   whint / code_pages  which pages held code, and which TLB entries mapped
+ *                       them writable
+ *   indirect-branch     targets into blocks that no longer exist
+ *   caches, ret_tab
+ *
+ * hv_flush_blocks() drops blocks and every reference to them; hv_tlb_flush()
+ * empties a CPU's tables.  Doing both for every CPU here is the only place
+ * that can: a vCPU-level reset knows about one CPU, and code invalidation
+ * knows about one page.
+ */
+void hv_engine_machine_reset(HvMachine *m)
+{
+    int i;
+
+    if (!m) {
+        return;
+    }
+    hv_flush_blocks(m);
+    for (i = 0; i < HV_MAX_CPUS; i++) {
+        if (m->cpus[i]) {
+            hv_tlb_flush(m->cpus[i]);
+        }
+    }
+    /* Whint (which entries mapped a now-code page writable) and the per-page
+       generation counters describe the previous address space.  Zeroing the
+       generations is enough: a block remembers the generation it was made
+       under, and nothing is left to compare against. */
+    for (i = 0; i < m->nram; i++) {
+        HvRam *r = &m->ram[i];
+        uint64_t pages = (r->size + (1u << HV_TLB_PAGE_BITS) - 1) >> HV_TLB_PAGE_BITS;
+
+        if (r->code_pages) {
+            memset(r->code_pages, 0, (size_t)1 << r->pages_log2);
+        }
+        if (r->page_gen) {
+            memset(r->page_gen, 0, pages * sizeof *r->page_gen);
+        }
+        if (r->whint) {
+            memset(r->whint, 0, pages * HV_MAX_CPUS * sizeof *r->whint);
+        }
+    }
+}
+
+/* Drop every RAM window.  A system_reset re-mirrors from the new flatview, and
+   a region that disappeared would otherwise stay in the table pointing at
+   memory QEMU has released. */
+void hv_engine_ram_clear(HvMachine *m)
+{
+    int i;
+
+    if (!m) {
+        return;
+    }
+    for (i = 0; i < m->nram; i++) {
+        HvRam *r = &m->ram[i];
+
+        free(r->code_pages);
+        free(r->page_gen);
+        free(r->whint);
+        r->code_pages = NULL;
+        r->page_gen = NULL;
+        r->whint = NULL;
+        r->host = NULL;
+        r->size = 0;
+        r->pa = 0;
+        r->readonly = 0;
+    }
+    m->nram = 0;
+    m->main_ram = NULL;
+}
+
+uint64_t hv_engine_access_pc(const HvMachine *m)
+{
+    return m ? m->access_pc : 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* The time base                                                       */
+/* ------------------------------------------------------------------ */
+
+/*
+ * K, not a callout.  The guest's CNTFRQ comes from the host's timer model and
+ * on this machine is 62.5 MHz, while the engine counts at 24 MHz; the two
+ * clocks run at the same *rate* only after scaling, and differ by a constant.
+ * So: scale once (a multiply by a fixed ratio), then subtract an epoch.  Guest
+ * counter reads stay pure arithmetic -- no host call, no lock, no clock read
+ * beyond the one already needed.
+ *
+ * timer_freq is not a #define any more.  Hardcoding 24 MHz is how the guest
+ * ends up calibrating its delay loop against a frequency the deadlines are not
+ * measured in.
+ */
+void hv_engine_set_timer_freq(HvMachine *m, uint64_t freq)
+{
+    if (!m || !freq) {
+        return;
+    }
+    m->timer_freq = freq;
+    /* counter() domain -> guest domain, as an exact rational: the port's
+       counter is 24 MHz (compat/mach/mach_time.h scales the host's CNTVCT
+       there), so num/den is freq/24000000.  Kept unreduced on purpose: den > 1
+       is what tells the read path whether it needs the multiply at all. */
+    m->timer_scale_num = freq;
+    m->timer_scale_den = 24000000ull;
+}
+
+uint64_t hv_engine_timer_freq(const HvMachine *m)
+{
+    return m ? m->timer_freq : 0;
+}
+
+uint64_t hv_engine_timer_ticks(HvMachine *m)
+{
+    return m ? hv_guest_ticks(m) : 0;
+}
+
+void hv_engine_set_timer_epoch(HvMachine *m, uint64_t epoch)
+{
+    if (!m) {
+        return;
+    }
+    /* Read on every counter access from other threads, so publish it as one
+       64-bit store rather than a plain assignment the compiler may tear. */
+    __atomic_store_n(&m->timer_epoch, epoch, __ATOMIC_RELEASE);
+}
+
+
+
+/* ------------------------------------------------------------------ */
+/* Interrupt lines                                                     */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The host's GIC drives its own qemu_irq into the CPU, which lands in
+ * CPUState.interrupt_request; the engine only ever looks at HvPerCpu's two
+ * line bytes.  This is the join between them, and it is deliberately a plain
+ * level copy with no edge logic: the engine's own hv_check_interrupts() decides
+ * whether the current PSTATE lets the interrupt in, exactly as it does for its
+ * own standalone GIC.  Duplicating that decision here (against QEMU's env,
+ * which is stale mid-run) is how you get an interrupt delivered at EL0 that
+ * should have waited for EL1.
+ */
+void hv_engine_set_irq(HvCpu *cpu, int irq, int fiq)
+{
+    HvPerCpu *p;
+
+    if (!cpu || !(p = cpu->pc_state)) {
+        return;
+    }
+    __atomic_store_n(&p->irq_line, irq ? 1 : 0, __ATOMIC_RELEASE);
+    __atomic_store_n(&p->fiq_line, fiq ? 1 : 0, __ATOMIC_RELEASE);
+}
+
+/* ------------------------------------------------------------------ */
+/* DMA: a write that did not come from the CPU                          */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The engine's own stores invalidate code inline (hv_phys_write checks
+ * code_pages).  A device writing guest RAM never goes through that path: it
+ * enters QEMU, and without this the engine would keep executing the old
+ * translation of a page that has just been overwritten -- the classic
+ * DMA->self-modifying-code hole, and the one thing that makes "load a kernel
+ * module and run it" fail in a way that looks like memory corruption.
+ *
+ * hv_dma_written() is the engine's existing primitive for this (the standalone
+ * build needs it too, for its inlined NVMe), and it is already cheap in the
+ * right way: it looks the page up and only does work for pages that are
+ * actually marked as code.  The caller guards on RAM-ness, so an MMIO write
+ * never reaches even that.
+ */
+void hv_engine_dma_written(HvMachine *m, uint64_t pa, uint64_t len)
+{
+    /* The engine's own store path does this inline (hv_phys_write checks
+     * code_pages); a write from outside -- a device DMA, the monitor -- does
+     * not, and would otherwise leave a stale translation of bytes that just
+     * changed.  hv_dma_written is the same primitive either way. */
+    if (!m || !len) {
+        return;
+    }
+    hv_dma_written(m, pa, len);
+}
+
+/*
+ * The mapped-DMA form used to live here as a hand-rolled reverse scan over the
+ * engine's own GPA->host table.  It was removed: it only worked for anonymous
+ * RAM, and silently missed for memfd/file-backed RAM (the host pointer QEMU
+ * hands out is not inside the recorded window), leaving stale translations
+ * behind.  The reverse lookup now uses qemu_ram_block_from_host() on the QEMU
+ * side, in accel/henge/henge-accel.c:hv_engine_dma_written_ram().
+ */
+
+/* ------------------------------------------------------------------ */
+/* The tick that never was                                             */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Until this existed, m->tick was NULL under henge, and that has a
+ * consequence much sharper than "WFI costs one host round trip":
+ *
+ *     wait_for_interrupt():
+ *         uint64_t deadline = m->tick ? m->tick(m, cpu) : 0;
+ *         ...
+ *         if (!m->tick) return -1;     // "nothing could ever wake us"
+ *
+ * So every WFI unwound the whole engine and handed the vCPU back to QEMU,
+ * which parked it on halt_cond until something else kicked it.  Measured on a
+ * two-vCPU boot: 512 B-path returns per CPU, and 4 / 2 A-path returns.  The
+ * parking itself is correct -- that is not the bug.  The bug is that the engine
+ * had no idea when the guest next needed to run, so it could only ever be
+ * woken from outside, one host round trip per event.
+ *
+ * Semantics are copied from the standalone board (port-android/linuxvirt.c),
+ * because two hosts must not disagree about what tick() means:
+ *
+ *     returns  "the counter value of the next expiry, or 0"
+ *
+ * The standalone returns it in the engine's own 24 MHz counter domain, because
+ * there it is the engine that owns the GIC and compares against counter().
+ * Here the timer belongs to QEMU -- sysreg_external routes CNTV_* to the
+ * cpreg table, so the engine's own cntv_cval/cntv_ctl are stale forever -- so
+ * the value cannot come from the engine at all.  A QEMU-side callback computes
+ * "how far in the future is this vCPU's next expiry, in 24 MHz ticks" and this
+ * stub turns that into the absolute host-counter value the WFI path expects.
+ *
+ * Why a relative delta rather than an absolute conversion: the guest deadline
+ * lives in the guest's CNTFRQ domain and the engine sleeps in the 24 MHz host
+ * domain, and the two are only related through timer_epoch (which QEMU
+ * recalibrates on every stop/cont).  Converting the difference is epoch-free;
+ * converting the absolute deadline would have to reconstruct the epoch a second
+ * time and would silently disagree with the calibration after a pause.
+ */
+static uint64_t (*tick_delta24)(void *opaque, uint32_t index);
+static void *tick_opaque;
+
+static uint64_t engine_tick(HvMachine *m, HvCpu *cpu)
+{
+    uint64_t delta;
+
+    if (!tick_delta24) {
+        return 0;
+    }
+    delta = tick_delta24(tick_opaque, cpu->index);
+    if (!delta) {
+        return 0;                  /* nothing armed: park, do not time out */
+    }
+    /* The WFI path compares this against mach_absolute_time(). */
+    return mach_absolute_time() + delta;
+}
+
+void hv_engine_set_tick(HvMachine *m, uint64_t (*fn)(void *, uint32_t),
+                        void *opaque)
+{
+    if (!m) {
+        return;
+    }
+    tick_delta24 = fn;
+    tick_opaque = opaque;
+    /* Both or neither: a tick with no source would make wait_for_interrupt()
+     * take the "sleep" branch and block until the 10 ms cap, every time. */
+    m->tick = fn ? engine_tick : NULL;
+    m->tick_opaque = opaque;
+}
+
+/* ------------------------------------------------------------------ */
+/* Host lifecycle: making hv_run() come back                           */
+/* ------------------------------------------------------------------ */
+
+/*
+ * The engine decides when to return.  That is fine for the engine's own
+ * reasons (WFI, an unmodelled sysreg, an unencodable instruction) and fatal for
+ * the host's, and the failure is not subtle once you see it:
+ *
+ *     guest: reboot: Power down
+ *     qemu:  (still alive 20 minutes later, and ignores SIGTERM)
+ *
+ * QEMU asks a vCPU to leave with qemu_cpu_kick(), which sets cs->exit_request
+ * and calls the accelerator's kick.  Ours called hv_cpu_wake(), which sets the
+ * engine's own exit_req -- but exit_req is *not* a "return to the host" flag.
+ * run_loop() consumes it as "let another CPU have a turn", services devices and
+ * carries straight on.  So a vCPU with no reason of its own to leave never
+ * leaves, pause_all_vcpus() waits for it forever, and the process cannot shut
+ * down.  Under TCG this cannot happen because cpu_exec() tests exit_request at
+ * every translation block and returns EXCP_INTERRUPT.
+ *
+ * halted is the engine's one exit that the host can pull.  run_loop() tests it
+ * at the top of every iteration:
+ *
+ *     hv_cpu_process_requests(cpu);
+ *     if (cpu->halted) return HV_EXIT_HALT;
+ *
+ * so setting it makes the next block boundary an exit, which is the same
+ * latency class as TCG's per-block test.  It is also the flag PSCI CPU_OFF
+ * already uses, so the host-requested stop and the guest-requested one converge
+ * on the exit that henge_dispatch_exit() already knows how to report.
+ *
+ * Clearing it is the counterpart and must not be forgotten: a vCPU resumed
+ * after a stop would otherwise return HV_EXIT_HALT forever without executing
+ * anything.
+ */
+void hv_engine_cpu_request_stop(HvCpu *cpu)
+{
+    if (!cpu) {
+        return;
+    }
+    cpu->halted = 1;
+    hv_cpu_wake(cpu);      /* end a WFI too, not just a running block */
+}
+
+void hv_engine_cpu_clear_stop(HvCpu *cpu)
+{
+    if (!cpu) {
+        return;
+    }
+    cpu->halted = 0;
+}
+
+/* ------------------------------------------------------------------ */
+/* Advertised features                                                 */
+/* ------------------------------------------------------------------ */
+
+/*
+ * Tell the translator which extension bits the guest is actually being told it
+ * has.
+ *
+ * Only LSE matters today, and only in one direction: the translator implements
+ * ARMv8.1 atomics unconditionally, so on a CPU whose ID_AA64ISAR0.ATOMIC reads
+ * zero the guest should get UNDEF but gets execution instead -- wider than the
+ * architecture.  TCG traps; henge did not.
+ *
+ * The engine cannot work this out itself: under a host that owns the system
+ * registers, the ID group is forwarded, so the engine's built-in constants are
+ * not what the guest sees.  Hence a setter rather than a lookup.
+ */
+void hv_engine_set_lse(HvMachine *m, int on)
+{
+    if (m) {
+        m->feat_lse = on ? 1 : 0;
+    }
+}
diff --git a/accel/henge/meson.build b/accel/henge/meson.build
new file mode 100644
index 0000000000..43e12f388a
--- /dev/null
+++ b/accel/henge/meson.build
@@ -0,0 +1,94 @@
+#
+# Henge accelerator: an ARM64->ARM64 dynamic binary translator in user space.
+#
+# Three targets, and the split is not cosmetic:
+#
+#   henge-engine  the vendored engine (engine/), compiled with its own c_args and
+#                 include paths so that none of its Darwin shims or its own
+#                 cpu.h/machine.h leak into QEMU's compile units.
+#   henge-mmu     engine/core/mmu.c alone, because it must be built with
+#                 -mgeneral-regs-only: hv_tlb_refill runs while the guest's
+#                 SIMD registers are live, so the compiler must not touch them.
+#   henge_ss      the QEMU-side files, compiled as part of the target.
+#
+# The two static libraries only exist when this host can actually run the
+# accelerator (host_arch == aarch64, which is also what gates CONFIG_HENGE).
+# Declaring them unconditionally would try to assemble enter_elf.S on x86_64
+# builds, where nothing would ever link against it.
+#
+
+henge_ss = ss.source_set()
+
+if 'CONFIG_HENGE' in accelerators
+  henge_engine_dir = meson.current_source_dir() / 'engine'
+
+  # The engine was written against Darwin and is ported with shim headers
+  # (engine/compat).  -include forces the POSIX shim in front of every file that
+  # needs it; engine/compat is also on the include path because machine.h spells
+  # <TargetConditionals.h> with angle brackets.
+  henge_engine_args = [
+    '-include', henge_engine_dir / 'compat' / 'hv_posix_compat.h',
+    '-D_GNU_SOURCE',
+  ]
+
+  henge_engine_inc = include_directories(
+    'engine/core',
+    'engine/host',
+    'engine/compat',
+  )
+
+  # mmu.c is deliberately not in this list; it gets its own library below.
+  henge_engine_lib = static_library('henge-engine',
+    files(
+      'engine/core/classify.c',
+      'engine/core/dispatch.c',
+      'engine/core/exception.c',
+      'engine/core/machine.c',
+      'engine/core/memop.c',
+      'engine/core/operands.c',
+      'engine/core/sysreg.c',
+      'engine/core/translate.c',
+      'engine/host/jit_region_linux.c',
+      'engine/compat/plat_linux.c',
+      'henge-engine.c',
+    ),
+    include_directories: henge_engine_inc,
+    c_args: henge_engine_args,
+  )
+
+  henge_mmu_lib = static_library('henge-mmu',
+    files('engine/core/mmu.c'),
+    include_directories: henge_engine_inc,
+    c_args: henge_engine_args + ['-mgeneral-regs-only'],
+  )
+
+  # sourceset.add() takes files, generated files and Dependency objects, not
+  # build targets, so the two libraries are wrapped.  (Same reason
+  # hw/meson.build adds libslirp as a declare_dependency.)
+  # enter_elf.S gets its own library because it must NOT be given
+  # henge_engine_args: -include hv_posix_compat.h drags <fcntl.h> and friends
+  # into a .S file, and the assembler reads them as mnemonics ("unknown
+  # mnemonic `typedef'").  Anything added to that library's c_args will hit the
+  # assembler, so keep it empty.
+  henge_asm_lib = static_library('henge-asm',
+    files('engine/host/enter_elf.S'),
+  )
+
+  henge_ss.add(declare_dependency(
+    link_with: [henge_engine_lib, henge_mmu_lib, henge_asm_lib],
+    # engine/core/memop.c does 16-byte compare-and-swap (the exclusive monitor's
+    # STXP/CASP path works on register pairs), which is __atomic_*_16 --
+    # a libatomic call on aarch64, not an inline ldxp/stxp sequence, because
+    # 16-byte atomics are not lock-free at every -march.  QEMU itself never
+    # needs libatomic, so nothing else in the tree pulls it in.
+    dependencies: cc.find_library('atomic'),
+  ))
+endif
+
+henge_ss.add(files(
+  'henge-accel.c',
+  'henge-accel-ops.c',
+  'henge-cpu.c',
+))
+
+system_ss.add_all(when: 'CONFIG_HENGE', if_true: henge_ss)
diff --git a/accel/henge/trace-events b/accel/henge/trace-events
new file mode 100644
index 0000000000..1505a9f723
--- /dev/null
+++ b/accel/henge/trace-events
@@ -0,0 +1,16 @@
+# Henge/Hv accelerator trace events
+#
+# Keep this small: tracing must never be on the hot path of a DBT that is
+# trying to be faster than TCG.  Only lifecycle and exits.
+#
+# NOTE: tracetool only accepts standard C / fixed-size integer types.  Using
+# `hwaddr` here fails at build time with
+#   "Argument type 'hwaddr' is not allowed"
+# so all addresses are declared as uint64_t and cast at the call site.
+
+hv_accel_init(uint64_t jit_bytes, uint32_t ncpus) "jit_bytes=%" PRIu64 " ncpus=%u"
+hv_vcpu_thread_start(uint32_t cpu_index, uint64_t pc) "cpu=%u pc=0x%" PRIx64
+hv_vcpu_exit(uint32_t cpu_index, int code, uint64_t pc) "cpu=%u code=%d pc=0x%" PRIx64
+hv_mem_add(uint64_t pa, uint64_t size, void *host, int readonly) "pa=0x%" PRIx64 " size=%" PRIu64 " host=%p ro=%d"
+hv_mem_del(uint64_t pa, uint64_t size) "pa=0x%" PRIx64 " size=%" PRIu64
+hv_mmio_forward(uint64_t pa, uint32_t len, int is_write) "pa=0x%" PRIx64 " len=%u write=%d"
