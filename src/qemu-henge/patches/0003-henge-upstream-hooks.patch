+static void henge_sgi_alarm_arm(GICv3CPUState *ocs, uint32_t irq)
+{
+    unsigned ci = ocs->cpu ? ocs->cpu->cpu_index : 0;
+    if (ci < 8) {
+        henge_sgi_arm[ci].enter_us = g_get_monotonic_time();
+        henge_sgi_arm[ci].deadline_us = henge_sgi_arm[ci].enter_us + 5000;
+        henge_sgi_arm[ci].irq = irq;
+        henge_sgi_arm[ci].armed = 1;
+        henge_sgi_arm[ci].dumped = 0;
+    }
+}
+
+static void henge_sgi_alarm_consume(GICv3CPUState *ocs, uint32_t intid)
+{
+    unsigned ci = ocs->cpu ? ocs->cpu->cpu_index : 0;
+    if (ci < 8 && henge_sgi_arm[ci].armed) {
+        uint64_t d = (uint64_t)(g_get_monotonic_time() - henge_sgi_arm[ci].enter_us);
+        henge_sgi_arm[ci].armed = 0;
+        henge_sgi_census[ci].n++;
+        henge_sgi_census[ci].sum_us += d;
+        if (d > henge_sgi_census[ci].max_us) henge_sgi_census[ci].max_us = d;
+        henge_sgi_census[ci].hist[d < 100 ? 0 : d < 1000 ? 1 : d < 5000 ? 2 : 3]++;
+        if (getenv("HENGE_SGI_ALARM") && (henge_sgi_census[ci].n % 64) == 0) {
+            fprintf(stderr, "henge-sgicensus: cpu%u n=%llu sum=%llums max=%lluus "
+                    "hist<0.1/1/5/>5ms=%llu/%llu/%llu/%llu\n", ci,
+                    (unsigned long long)henge_sgi_census[ci].n,
+                    (unsigned long long)(henge_sgi_census[ci].sum_us / 1000),
+                    (unsigned long long)henge_sgi_census[ci].max_us,
+                    (unsigned long long)henge_sgi_census[ci].hist[0],
+                    (unsigned long long)henge_sgi_census[ci].hist[1],
+                    (unsigned long long)henge_sgi_census[ci].hist[2],
+                    (unsigned long long)henge_sgi_census[ci].hist[3]);
+        }
+    }
+}
+
+static void henge_sgi_alarm_check(GICv3CPUState *ocs)
+{
+    unsigned ci = ocs->cpu ? ocs->cpu->cpu_index : 0;
+    if (ci >= 8 || !henge_sgi_arm[ci].armed || henge_sgi_arm[ci].dumped) return;
+    if (!getenv("HENGE_SGI_ALARM")) return;
+    int64_t now = g_get_monotonic_time();
+    if (now < henge_sgi_arm[ci].deadline_us) return;
+    henge_sgi_arm[ci].dumped = 1;
+    fprintf(stderr, "henge-sgialarm: t=%lldus cpu%u irq=%u hppi=%u prio=%u can_preempt=%d "
+            "hard=%d halted=%d kicked=%d runprio=%u pmr=%u igrpen_ns=%d ctlr=%x\n",
+            (long long)now, ci, henge_sgi_arm[ci].irq,
+            ocs->hppi.irq, ocs->hppi.prio,
+            (int)icc_hppi_can_preempt(ocs),
+            ocs->cpu ? !!(ocs->cpu->interrupt_request & CPU_INTERRUPT_HARD) : -1,
+            ocs->cpu ? ocs->cpu->halted : -1,
+            ocs->cpu ? qatomic_read(&ocs->cpu->thread_kicked) : -1,
+            (unsigned)icc_highest_active_prio(ocs),
+            (unsigned)ocs->icc_pmr_el1,
+            (int)(ocs->icc_igrpen[GICV3_G1NS] & 1), ocs->gic->gicd_ctlr);
+    {
+        extern uint64_t henge_engine_pc[8];
+        extern uint64_t henge_engine_daif[8];
+        { extern void henge_debug_dump_code(int); henge_debug_dump_code((int)ci); }
+        if (ci < 8)
+            fprintf(stderr, "  sgialarm-detail: cpu%u engine_pc=%llx daif=%llx "
+                    "kernel=%d\n", ci,
+                    (unsigned long long)henge_engine_pc[ci],
+                    (unsigned long long)henge_engine_daif[ci],
+                    !!(henge_engine_pc[ci] >> 63));
+    }
+}
