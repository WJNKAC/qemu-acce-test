+/* Decoding follows the "Loads and Stores" encoding index of the Arm ARM. */
+
+static inline int64_t sext(uint64_t v, int bits) {
+    return (int64_t)(v << (64 - bits)) >> (64 - bits);
+}
+
+static int decode_vector(uint32_t insn, HvMemOp *op) {
+    uint32_t q = (insn >> 30) & 1, l = (insn >> 22) & 1, size = (insn >> 10) & 3;
+    int single = (insn >> 24) & 1, post = (insn >> 23) & 1;
+    op->kind = single ? HV_MEM_VEC_SINGLE : HV_MEM_VEC_MULTI;
+    op->vec = 1;
+    op->vq = q;
+    op->load = l;
+    op->store = !l;
+    if (!post && op->rm != 0) return -1;
+    if (single) {
+        uint32_t opcode = (insn >> 13) & 7, s = (insn >> 12) & 1, r = (insn >> 21) & 1;
+        uint32_t scale = opcode >> 1;
+        op->selem = (((opcode & 1) << 1) | r) + 1;
+        switch (scale) {
+        case 3:
+            if (!l || s) return -1;
+            op->index = 0xff;
+            op->size = size;
+            break;
+        case 0:
+            op->index = q << 3 | s << 2 | size;
+            op->size = 0;
+            break;
+        case 1:
+            if (size & 1) return -1;
+            op->index = q << 2 | s << 1 | size >> 1;
+            op->size = 1;
+            break;
+        default:
+            if (size & 2) return -1;
+            if (!(size & 1)) {
+                op->index = q << 1 | s;
+                op->size = 2;
+            } else {
+                if (s) return -1;
+                op->index = q;
+                op->size = 3;
+            }
+            break;
+        }
+        op->bytes = op->selem << op->size;
+    } else {
+        if ((insn >> 21) & 1) return -1;
+        static const uint8_t rpt[16] = {1, 0, 4, 0, 1, 0, 3, 1, 1, 0, 2, 0, 0, 0, 0, 0};
+        static const uint8_t selem[16] = {4, 0, 1, 0, 3, 0, 1, 1, 2, 0, 1, 0, 0, 0, 0, 0};
+        uint32_t opcode = (insn >> 12) & 0xf;
+        if (!rpt[opcode]) return -1;
+        if (size == 3 && !q && selem[opcode] > 1) return -1;
+        op->rpt = rpt[opcode];
+        op->selem = selem[opcode];
+        op->size = size;
+        op->bytes = (uint32_t)op->rpt * op->selem * (q ? 16 : 8);
+    }
+    if (post) {
+        op->mode = HV_ADDR_POST;
+        op->imm = op->bytes; /* used when Rm is 31; otherwise Xm is the amount */
+    } else {
+        op->mode = HV_ADDR_BASE;
+        op->rm = 31;
+    }
+    return 0;
+}
+
+static int decode_exclusive(uint32_t insn, HvMemOp *op) {
+    uint32_t size = insn >> 30, o2 = (insn >> 23) & 1, l = (insn >> 22) & 1, o1 = (insn >> 21) & 1;
+    op->mode = HV_ADDR_BASE;
+    op->align = 1;
+    op->size = size;
+    op->rm = 31;
+    if (!o2 && !o1) {
+        op->kind = HV_MEM_EXCL;
+        op->load = l;
+        op->store = !l;
+        op->bytes = 1u << size;
+        return 0;
+    }
+    if (!o2 && o1) {
+        op->size = 2 + (size & 1);
+        op->bytes = 2u << op->size;
+        if (size >> 1) {
+            op->kind = HV_MEM_EXCL;
+            op->load = l;
+            op->store = !l;
+            op->rt2 = (insn >> 10) & 0x1f;
+            return 0;
+        }
+        if ((op->rs & 1) || (op->rt & 1)) return -1;
+        op->kind = HV_MEM_CASP;
+        op->load = op->store = 1;
+        return 0;
+    }
+    if (o2 && !o1) {
+        op->kind = HV_MEM_ORDERED;
+        op->load = l;
+        op->store = !l;
+        op->bytes = 1u << size;
+        return 0;
+    }
+    op->kind = HV_MEM_CAS;
+    op->load = op->store = 1;
+    op->bytes = 1u << size;
+    return 0;
+}
+
+int hv_mem_decode(uint32_t insn, HvMemOp *op) {
+    memset(op, 0, sizeof *op);
+    op->rt = insn & 0x1f;
+    op->rn = (insn >> 5) & 0x1f;
+    op->rt2 = (insn >> 10) & 0x1f;
+    op->rm = op->rs = (insn >> 16) & 0x1f;
+    uint32_t size = insn >> 30, v = (insn >> 26) & 1;
+
+    if ((insn & 0x3b000000) == 0x18000000) { /* load register (literal) */
+        op->kind = HV_MEM_LITERAL;
+        op->mode = HV_ADDR_LITERAL;
+        op->load = 1;
+        op->vec = v;
+        op->rm = 31;
+        op->imm = sext((insn >> 5) & 0x7ffff, 19) * 4;
+        if (v) {
+            if (size == 3) return -1;
+            op->size = 2 + size;
+        } else {
+            if (size == 3) return -1; /* PRFM is dropped before here */
+            op->size = size == 1 ? 3 : 2;
+            if (size == 2) op->sign = 64;
+        }
+        op->bytes = 1u << op->size;
+        return 0;
+    }
+    if ((insn & 0xbe000000) == 0x0c000000) { /* SIMD structures */
+        if (!v) return -1;
+        return decode_vector(insn, op);
+    }
+    if ((insn & 0x3f000000) == 0x08000000) { /* exclusive, ordered, compare and swap */
+        if (v) return -1;
+        return decode_exclusive(insn, op);
+    }
+    if ((insn & 0x3f200c00) == 0x19000000) { /* LDAPUR/STLUR (RCpc, unscaled) */
+        uint32_t opc = (insn >> 22) & 3;
+        op->kind = HV_MEM_ORDERED;
+        op->mode = HV_ADDR_OFFSET;
+        op->imm = sext((insn >> 12) & 0x1ff, 9);
+        op->size = size;
+        op->rm = 31;
+        op->bytes = 1u << size;
+        op->store = opc == 0;
+        op->load = opc != 0;
+        if (opc == 2) {
+            if (size == 3) return -1;
+            op->sign = 64;
+        } else if (opc == 3) {
+            if (size >= 2) return -1;
+            op->sign = 32;
+        }
+        return 0;
+    }
+    if ((insn & 0x38000000) == 0x28000000) { /* register pairs */
+        uint32_t opc = insn >> 30, l = (insn >> 22) & 1, mode = (insn >> 23) & 3;
+        op->kind = HV_MEM_PAIR;
+        op->vec = v;
+        op->load = l;
+        op->store = !l;
+        op->rm = 31;
+        if (opc == 3) return -1;
+        if (v) {
+            op->size = 2 + opc;
+        } else if (opc == 1) {
+            if (!l || mode == 0) return -1; /* STGP (MTE) is not exposed */
+            op->size = 2;
+            op->sign = 64;
+        } else {
+            op->size = opc ? 3 : 2;
+        }
+        op->imm = sext((insn >> 15) & 0x7f, 7) << op->size;
+        op->mode = mode == 1 ? HV_ADDR_POST : mode == 3 ? HV_ADDR_PRE : HV_ADDR_OFFSET;
+        op->bytes = 2u << op->size;
+        return 0;
+    }
+    if ((insn & 0x38000000) != 0x38000000) return -1;
+
+    /* Single register: unsigned offset, imm9 forms, register offset, atomics, LDRA*. */
+    uint32_t opc = (insn >> 22) & 3;
+    op->kind = HV_MEM_SINGLE;
+    op->vec = v;
+    op->rm = 31;
+    int atomic = !((insn >> 24) & 1) && ((insn >> 21) & 1) && ((insn >> 10) & 3) == 0;
+    int ldra = !((insn >> 24) & 1) && ((insn >> 21) & 1) && ((insn >> 10) & 1);
+    if (atomic) {
+        if (v) return -1;
+        uint32_t o3 = (insn >> 15) & 1, aop = (insn >> 12) & 7, a = (insn >> 23) & 1, r = (insn >> 22) & 1;
+        op->mode = HV_ADDR_BASE;
+        op->size = size;
+        op->bytes = 1u << size;
+        op->align = 1;
+        if (o3 && aop == 4 && a && !r && op->rs == 31) { /* LDAPR (RCpc, AccType_LIMITEDORDERED) */
+            op->kind = HV_MEM_ORDERED;
+            op->align = 0;
+            op->load = 1;
+            return 0;
+        }
+        if (o3 && aop != 0) return -1; /* LD64B and friends */
+        op->kind = HV_MEM_ATOMIC;
+        op->atomic_op = o3 << 3 | aop;
+        op->load = op->store = 1;
+        return 0;
+    }
+    if (ldra) {
+        if (v || size != 3) return -1;
+        op->kind = HV_MEM_LDRA;
+        op->load = 1;
+        op->size = 3;
+        op->bytes = 8;
+        op->imm = sext(((insn >> 22) & 1) << 9 | ((insn >> 12) & 0x1ff), 10) * 8;
+        op->mode = (insn >> 11) & 1 ? HV_ADDR_PRE : HV_ADDR_OFFSET;
+        return 0;
+    }
+    if (v) {
+        if (opc & 2) {
+            if (size != 0) return -1;
+            op->size = 4;
+        } else {
+            op->size = size;
+        }
+        op->load = opc & 1;
+        op->store = !(opc & 1);
+    } else {
+        op->size = size;
+        if (opc == 0) {
+            op->store = 1;
+        } else if (opc == 1) {
+            op->load = 1;
+        } else if (opc == 2) {
+            if (size == 3) return -1; /* PRFM forms are dropped before here */
+            op->load = 1;
+            op->sign = 64;
+        } else {
+            if (size >= 2) return -1;
+            op->load = 1;
+            op->sign = 32;
+        }
+    }
+    op->bytes = 1u << op->size;
+    if ((insn >> 24) & 1) {
+        op->mode = HV_ADDR_OFFSET;
+        op->imm = (int64_t)((insn >> 10) & 0xfff) << op->size;
+        return 0;
+    }
+    if ((insn >> 21) & 1) { /* register offset */
+        uint32_t option = (insn >> 13) & 7;
+        if (((insn >> 10) & 3) != 2 || !(option & 2)) return -1;
+        op->mode = HV_ADDR_REG;
+        op->rm = (insn >> 16) & 0x1f;
+        op->ext = option;
+        op->shift = (insn >> 12) & 1 ? op->size : 0;
+        return 0;
+    }
+    op->imm = sext((insn >> 12) & 0x1ff, 9);
+    switch ((insn >> 10) & 3) {
+    case 0: op->mode = HV_ADDR_OFFSET; break;
+    case 1: op->mode = HV_ADDR_POST; break;
+    case 2:
+        if (v) return -1;
+        op->mode = HV_ADDR_OFFSET;
+        op->unpriv = 1;
+        break;
+    default: op->mode = HV_ADDR_PRE; break;
+    }
+    return 0;
+}
+
+/* ---- C-side access ---- */
+
+
+int hv_vmem_xfer(HvCpu *cpu, uint64_t va, void *buf, uint32_t len, int write, int el, uint64_t pc) {
+    uint8_t *b = buf;
+    uint64_t w = cpu->m->watch_va;
+    if (write && w && w - va < len) {
+        uint64_t v = 0;
+        memcpy(&v, b + (w - va), len - (w - va) < 8 ? len - (w - va) : 8);
+        fprintf(stderr, "hengevm: watch[seq=%llu]: write to %llx = %llx (%u-byte store at %llx) by pc %llx x30 %llx\n",
+                (unsigned long long)0, (unsigned long long)w, (unsigned long long)v, len,
+                (unsigned long long)va, (unsigned long long)pc, (unsigned long long)cpu->x[30]);
+    }
+    while (len) {
+        uint32_t chunk = 4096 - (uint32_t)(va & 4095);
+        if (chunk > len) chunk = len;
+        if (!w && !cpu->m->watch_pa) {
+            HvTlbEntry *t = hv_tlb_ent(cpu, (va >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1), hv_tlb_table(cpu, el));
+            uint64_t tag = write ? __atomic_load_n(&t->write_tag, __ATOMIC_RELAXED)
+                                 : __atomic_load_n(&t->read_tag, __ATOMIC_RELAXED);
+            if (tag != HV_TLB_INVALID && tag + HV_TLB_ADJ == (va & ~((1ull << HV_TLB_PAGE_BITS) - 1))) {
+                uint8_t *hp = (uint8_t *)(uintptr_t)(va + (uint64_t)t->addend);
+                if (cpu->m->stats_interval) {
+                    uint64_t inpage = va & ((1ull << HV_TLB_PAGE_BITS) - 1);
+                    cpu->m->stats.slow_why[inpage + len > (1ull << HV_TLB_PAGE_BITS) - HV_TLB_ADJ ? 2 : 4]++;
+                }
+                if (write) memcpy(hp, b, chunk);
+                else memcpy(b, hp, chunk);
+                va += chunk;
+                b += chunk;
+                len -= chunk;
+                continue;
+            }
+        }
+        uint64_t pa;
+        int had_entry = 0;
+        if (cpu->m->stats_interval) { /* --stats: was the TLB entry there before this access? */
+            HvTlbEntry *t = hv_tlb_ent(cpu, (va >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1), hv_tlb_table(cpu, el));
+            uint64_t tag = write ? t->write_tag : t->read_tag;
+            had_entry = tag != HV_TLB_INVALID && ((va - tag) >> HV_TLB_PAGE_BITS) == 0 ? 1 :
+                        tag != HV_TLB_INVALID && ((va - tag - HV_TLB_ADJ) >> HV_TLB_PAGE_BITS) == 0 ? 2 : 0;
+            if (!had_entry) {
+                int other = t->read_tag != HV_TLB_INVALID || t->write_tag != HV_TLB_INVALID || t->exec_tag != HV_TLB_INVALID;
+                cpu->m->stats.tlb_miss_kind[(el ? 2 : 0) + other]++;
+            }
+        }
+        uint32_t fsc = hv_mmu_access(cpu, va, write ? HV_ACC_WRITE : HV_ACC_READ, el, &pa);
+        if (fsc) {
+            hv_raise_abort(cpu, 0, va, fsc, write, fsc >= 0x14 && fsc <= 0x17, pc);
+            return 1;
+        }
+        int rc = 0;
+        if (cpu->m->stats_interval) {
+            HvRam *ram = hv_ram_lookup(cpu->m, pa);
+            uint64_t inpage = va & ((1ull << HV_TLB_PAGE_BITS) - 1);
+            int why = !ram ? 0 : write && ram->code_pages[(pa - ram->pa) >> HV_TLB_PAGE_BITS] ? 1
+                    : inpage + len > (1ull << HV_TLB_PAGE_BITS) - HV_TLB_ADJ ? 2 : had_entry == 0 ? 3 : had_entry == 2 ? 5 : 4;
+            cpu->m->stats.slow_why[why]++;
+        }
+        if (hv_phys_ptr(cpu->m, pa, chunk)) {
+            rc = write ? hv_phys_write(cpu->m, pa, b, chunk) : hv_phys_read(cpu->m, pa, b, chunk);
+        } else {
+            for (uint32_t off = 0; off < chunk && !rc; off += 8) { /* MMIO: at most 8 bytes at a time */
+                uint32_t piece = chunk - off < 8 ? chunk - off : 8;
+                rc = write ? hv_phys_write(cpu->m, pa + off, b + off, piece) : hv_phys_read(cpu->m, pa + off, b + off, piece);
+            }
+        }
+        if (rc) {
+            if (cpu->m->log)
+                fprintf(stderr, "unmapped %s: pa %llx (va %llx) size %u pc %llx\n", write ? "write" : "read",
+                        (unsigned long long)pa, (unsigned long long)va, chunk, (unsigned long long)pc);
+            hv_raise_abort(cpu, 0, va, HV_FSC_EXTERNAL, write, 0, pc);
+            return 1;
+        }
+        va += chunk;
+        b += chunk;
+        len -= chunk;
+    }
+    return 0;
+}
+
+static uint64_t gpr(HvCpu *cpu, int r) {
+    return r == 31 ? 0 : cpu->x[r];
+}
+
+static void set_gpr(HvCpu *cpu, int r, uint64_t v) {
+    if (r != 31) cpu->x[r] = v;
+}
+
+static uint64_t base_reg(HvCpu *cpu, int r) {
+    return r == 31 ? cpu->sp : cpu->x[r];
+}
+
+static void set_base(HvCpu *cpu, int r, uint64_t v) {
+    if (r == 31) cpu->sp = v;
+    else cpu->x[r] = v;
+}
+
+static uint8_t *vreg(HvCpu *cpu, int r) {
+    return (uint8_t *)&cpu->v[r & 31];
+}
+
+static uint64_t extend(uint64_t v, const HvMemOp *op) {
+    int bits = 8 << op->size;
+    if (op->sign == 64) return (uint64_t)sext(v, bits);
+    if (op->sign == 32) return (uint32_t)sext(v, bits);
+    return bits == 64 ? v : v & ((1ull << bits) - 1);
+}
+
+static uint64_t le(const uint8_t *p, int bytes) {
+    uint64_t v = 0;
+    memcpy(&v, p, bytes);
+    return v;
+}
+
+static int alignment_fault(HvCpu *cpu, uint64_t va, int write, uint64_t pc) {
+    hv_raise_abort(cpu, 0, va, HV_FSC_ALIGNMENT, write, 0, pc);
+    return 1;
+}
+
+/* For atomics: a host pointer when va is RAM the guest may write, else NULL with
+   *mmio_pa set. Returns -1 after an abort. */
+static int rmw_target(HvCpu *cpu, uint64_t va, uint32_t bytes, int el, uint64_t pc, void **host, uint64_t *mmio_pa) {
+    if (!cpu->m->watch_va && !cpu->m->watch_pa && ((va & ((1u << HV_TLB_PAGE_BITS) - 1)) + bytes <= (1u << HV_TLB_PAGE_BITS))) {
+        HvTlbEntry *t = hv_tlb_ent(cpu, (va >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1), hv_tlb_table(cpu, el));
+        uint64_t tag = __atomic_load_n(&t->write_tag, __ATOMIC_RELAXED);
+        if (tag != HV_TLB_INVALID && tag + HV_TLB_ADJ == (va & ~((1ull << HV_TLB_PAGE_BITS) - 1))) {
+            *host = (void *)(uintptr_t)(va + (uint64_t)t->addend);
+            *mmio_pa = 0;
+            return 0;
+        }
+    }
+    uint64_t pa;
+    uint32_t fsc = hv_mmu_access(cpu, va, HV_ACC_WRITE, el, &pa);
+    if (fsc) {
+        hv_raise_abort(cpu, 0, va, fsc, 1, fsc >= 0x14 && fsc <= 0x17, pc);
+        return -1;
+    }
+    HvRam *ram = hv_ram_lookup(cpu->m, pa);
+    if (ram && ram->readonly) { /* ROM: nothing to write; treat like a device */
+        *host = NULL;
+        *mmio_pa = pa;
+        return 0;
+    }
+    *host = hv_phys_ptr(cpu->m, pa, bytes);
+    if (*host) {
+        /* Same rule as other writes: drop translations made from this page. */
+        uint64_t pg = (pa - ram->pa) >> HV_TLB_PAGE_BITS;
+        if (ram->code_pages[pg]) hv_invalidate_code(cpu->m, pa);
+    }
+    *mmio_pa = pa;
+    return 0;
+}
+
+static int cas_host(void *p, int size, uint64_t *expected, uint64_t desired) {
+    switch (size) {
+    case 0: { uint8_t e = (uint8_t)*expected; int ok = __atomic_compare_exchange_n((uint8_t *)p, &e, (uint8_t)desired, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); *expected = e; return ok; }
+    case 1: { uint16_t e = (uint16_t)*expected; int ok = __atomic_compare_exchange_n((uint16_t *)p, &e, (uint16_t)desired, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); *expected = e; return ok; }
+    case 2: { uint32_t e = (uint32_t)*expected; int ok = __atomic_compare_exchange_n((uint32_t *)p, &e, (uint32_t)desired, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); *expected = e; return ok; }
+    default: return __atomic_compare_exchange_n((uint64_t *)p, expected, desired, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+    }
+}
+
+static uint64_t load_host(void *p, int size) {
+    switch (size) {
+    case 0: return __atomic_load_n((uint8_t *)p, __ATOMIC_SEQ_CST);
+    case 1: return __atomic_load_n((uint16_t *)p, __ATOMIC_SEQ_CST);
+    case 2: return __atomic_load_n((uint32_t *)p, __ATOMIC_SEQ_CST);
+    default: return __atomic_load_n((uint64_t *)p, __ATOMIC_SEQ_CST);
+    }
+}
+
+static uint64_t atomic_result(int aop, int size, uint64_t old, uint64_t s) {
+    int bits = 8 << size;
+    int64_t so = sext(old, bits), ss = sext(s, bits);
+    uint64_t mask = bits == 64 ? ~0ull : (1ull << bits) - 1;
+    old &= mask;
+    s &= mask;
+    switch (aop) {
+    case 0: return (old + s) & mask;             /* LDADD */
+    case 1: return old & ~s;                     /* LDCLR */
+    case 2: return old ^ s;                      /* LDEOR */
+    case 3: return old | s;                      /* LDSET */
+    case 4: return (so > ss ? old : s);          /* LDSMAX */
+    case 5: return (so < ss ? old : s);          /* LDSMIN */
+    case 6: return old > s ? old : s;            /* LDUMAX */
+    case 7: return old < s ? old : s;            /* LDUMIN */
+    default: return s;                           /* SWP */
+    }
+}
+
+static int do_atomic(HvCpu *cpu, const HvMemOp *op, uint64_t va, int el, uint64_t pc) {
+    int size = op->size;
+    uint32_t bytes = 1u << size;
+    if (va & (bytes - 1)) return alignment_fault(cpu, va, 1, pc);
+    void *host;
+    uint64_t pa;
+    if (rmw_target(cpu, va, bytes, el, pc, &host, &pa)) return 1;
+    uint64_t mask = size == 3 ? ~0ull : (1ull << (8 << size)) - 1;
+    uint64_t old, s = gpr(cpu, op->rs);
+    if (op->kind == HV_MEM_CAS) {
+        uint64_t desired = gpr(cpu, op->rt) & mask;
+        if (host) {
+            old = s & mask;
+            cas_host(host, size, &old, desired);
+        } else {
+            old = 0;
+            if (hv_phys_read(cpu->m, pa, &old, bytes)) goto external;
+            if (old == (s & mask) && hv_phys_write(cpu->m, pa, &desired, bytes)) goto external;
+        }
+        set_gpr(cpu, op->rs, old);
+        return 0;
+    }
+    if (host) {
+        old = load_host(host, size);
+        while (!cas_host(host, size, &old, atomic_result(op->atomic_op, size, old, s))) {
+        }
+    } else {
+        old = 0;
+        if (hv_phys_read(cpu->m, pa, &old, bytes)) goto external;
+        uint64_t n = atomic_result(op->atomic_op, size, old, s);
+        if (hv_phys_write(cpu->m, pa, &n, bytes)) goto external;
+    }
+    set_gpr(cpu, op->rt, old & mask);
+    return 0;
+external:
+    hv_raise_abort(cpu, 0, va, HV_FSC_EXTERNAL, 1, 0, pc);
+    return 1;
+}
+
+static int do_casp(HvCpu *cpu, const HvMemOp *op, uint64_t va, int el, uint64_t pc) {
+    uint32_t esize = 1u << op->size, bytes = esize * 2;
+    if (va & (bytes - 1)) return alignment_fault(cpu, va, 1, pc);
+    void *host;
+    uint64_t pa;
+    if (rmw_target(cpu, va, bytes, el, pc, &host, &pa)) return 1;
+    uint64_t mask = esize == 8 ? ~0ull : 0xffffffffull;
+    uint64_t c0 = gpr(cpu, op->rs) & mask, c1 = gpr(cpu, op->rs + 1) & mask;
+    uint64_t n0 = gpr(cpu, op->rt) & mask, n1 = gpr(cpu, op->rt + 1) & mask;
+    uint64_t o0, o1;
+    if (host && esize == 4) {
+        uint64_t old = c0 | c1 << 32;
+        cas_host(host, 3, &old, n0 | n1 << 32);
+        o0 = old & mask;
+        o1 = old >> 32;
+    } else if (host) {
+        __uint128_t old = (__uint128_t)c1 << 64 | c0;
+        __atomic_compare_exchange_n((__uint128_t *)host, &old, (__uint128_t)n1 << 64 | n0, 0, __ATOMIC_SEQ_CST,
+                                    __ATOMIC_SEQ_CST);
+        o0 = (uint64_t)old;
+        o1 = (uint64_t)(old >> 64);
+    } else {
+        uint8_t buf[16] = {0};
+        if (hv_phys_read(cpu->m, pa, buf, esize) || hv_phys_read(cpu->m, pa + esize, buf + esize, esize)) goto external;
+        o0 = le(buf, esize);
+        o1 = le(buf + esize, esize);
+        if (o0 == c0 && o1 == c1) {
+            if (hv_phys_write(cpu->m, pa, &n0, esize) || hv_phys_write(cpu->m, pa + esize, &n1, esize)) goto external;
+        }
+    }
+    set_gpr(cpu, op->rs, o0);
+    set_gpr(cpu, op->rs + 1, o1);
+    return 0;
+external:
+    hv_raise_abort(cpu, 0, va, HV_FSC_EXTERNAL, 1, 0, pc);
+    return 1;
+}
+
+static int do_exclusive(HvCpu *cpu, const HvMemOp *op, uint64_t va, int el, uint64_t pc) {
+    uint32_t bytes = op->bytes;
+    int pair = bytes == (2u << op->size); /* LDXP/STXP: decode sets bytes to two registers' worth */
+    if (va & (bytes - 1)) return alignment_fault(cpu, va, op->store, pc);
+    uint32_t esize = pair ? 1u << op->size : bytes;
+    if (op->load) {
+        uint8_t buf[16];
+        if (hv_vmem_xfer(cpu, va, buf, bytes, 0, el, pc)) return 1;
+        cpu->excl_addr = va;
+        cpu->excl_size = bytes;
+        cpu->excl_val[0] = le(buf, esize);
+        cpu->excl_val[1] = pair ? le(buf + esize, esize) : 0;
+        set_gpr(cpu, op->rt, cpu->excl_val[0]);
+        if (pair) set_gpr(cpu, op->rt2, cpu->excl_val[1]);
+        return 0;
+    }
+    void *host;
+    uint64_t pa;
+    if (rmw_target(cpu, va, bytes, el, pc, &host, &pa)) return 1;
+    uint64_t mask = esize == 8 ? ~0ull : (1ull << (esize * 8)) - 1;
+    uint64_t n0 = gpr(cpu, op->rt) & mask, n1 = pair ? gpr(cpu, op->rt2) & mask : 0;
+    int ok = 0;
+    if (cpu->excl_addr == va && cpu->excl_size == bytes) {
+        if (!host) {
+            ok = !hv_phys_write(cpu->m, pa, &n0, esize) && (!pair || !hv_phys_write(cpu->m, pa + esize, &n1, esize));
+        } else if (!pair) {
+            uint64_t expect = cpu->excl_val[0];
+            ok = cas_host(host, op->size, &expect, n0);
+        } else if (esize == 4) {
+            uint64_t expect = cpu->excl_val[0] | cpu->excl_val[1] << 32;
+            ok = cas_host(host, 3, &expect, n0 | n1 << 32);
+        } else {
+            __uint128_t expect = (__uint128_t)cpu->excl_val[1] << 64 | cpu->excl_val[0];
+            ok = __atomic_compare_exchange_n((__uint128_t *)host, &expect, (__uint128_t)n1 << 64 | n0, 0,
+                                             __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+        }
+    }
+    cpu->excl_addr = ~0ull;
+    set_gpr(cpu, op->rs, ok ? 0 : 1);
+    return 0;
+}
+
+static int do_vector(HvCpu *cpu, const HvMemOp *op, uint64_t va, int el, uint64_t pc) {
+    uint8_t buf[64];
+    uint32_t ebytes = 1u << op->size;
+    if (op->store) {
+        uint32_t off = 0;
+        if (op->kind == HV_MEM_VEC_MULTI) {
+            uint32_t elements = (op->vq ? 16 : 8) / ebytes;
+            for (int r = 0; r < op->rpt; r++)
+                for (uint32_t e = 0; e < elements; e++)
+                    for (int s = 0; s < op->selem; s++, off += ebytes)
+                        memcpy(buf + off, vreg(cpu, op->rt + r + s) + e * ebytes, ebytes);
+        } else {
+            for (int s = 0; s < op->selem; s++, off += ebytes)
+                memcpy(buf + off, vreg(cpu, op->rt + s) + op->index * ebytes, ebytes);
+        }
+        return hv_vmem_xfer(cpu, va, buf, op->bytes, 1, el, pc);
+    }
+    if (hv_vmem_xfer(cpu, va, buf, op->bytes, 0, el, pc)) return 1;
+    uint32_t off = 0;
+    if (op->kind == HV_MEM_VEC_MULTI) {
+        uint32_t elements = (op->vq ? 16 : 8) / ebytes;
+        for (int r = 0; r < op->rpt; r++)
+            for (uint32_t e = 0; e < elements; e++)
+                for (int s = 0; s < op->selem; s++, off += ebytes)
+                    memcpy(vreg(cpu, op->rt + r + s) + e * ebytes, buf + off, ebytes);
+        if (!op->vq) /* 64-bit destinations clear the top half */
+            for (int r = 0; r < op->rpt; r++)
+                for (int s = 0; s < op->selem; s++) memset(vreg(cpu, op->rt + r + s) + 8, 0, 8);
+    } else if (op->index == 0xff) {
+        for (int s = 0; s < op->selem; s++, off += ebytes) {
+            uint8_t *d = vreg(cpu, op->rt + s);
+            memset(d, 0, 16);
+            for (uint32_t i = 0; i < (op->vq ? 16u : 8u); i += ebytes) memcpy(d + i, buf + off, ebytes);
+        }
+    } else {
+        for (int s = 0; s < op->selem; s++, off += ebytes)
+            memcpy(vreg(cpu, op->rt + s) + op->index * ebytes, buf + off, ebytes);
+    }
+    return 0;
+}
+
+int hv_mem_emulate(HvCpu *cpu, uint32_t insn, uint64_t pc) {
+    cpu->m->access_pc = pc;
+    HvMemOp op;
+    if (hv_mem_decode(insn, &op) != 0) {
+        hv_raise_undef(cpu, pc);
+        return 1;
+    }
+    int el = op.unpriv ? 0 : (int)cpu->el;
+    uint64_t base = op.mode == HV_ADDR_LITERAL ? pc : base_reg(cpu, op.rn);
+    uint64_t va = base;
+    switch (op.mode) {
+    case HV_ADDR_OFFSET:
+    case HV_ADDR_PRE:
+    case HV_ADDR_LITERAL:
+        va = base + op.imm;
+        break;
+    case HV_ADDR_REG: {
+        uint64_t m = gpr(cpu, op.rm);
+        switch (op.ext) {
+        case 2: m = (uint32_t)m; break;
+        case 6: m = (uint64_t)(int64_t)(int32_t)m; break;
+        default: break;
+        }
+        va = base + (m << op.shift);
+        break;
+    }
+    default:
+        break;
+    }
+
+    int rc = 0;
+    switch (op.kind) {
+    case HV_MEM_EXCL:
+        rc = do_exclusive(cpu, &op, va, el, pc);
+        break;
+    case HV_MEM_CAS:
+    case HV_MEM_ATOMIC:
+        rc = do_atomic(cpu, &op, va, el, pc);
+        break;
+    case HV_MEM_CASP:
+        rc = do_casp(cpu, &op, va, el, pc);
+        break;
+    case HV_MEM_VEC_MULTI:
+    case HV_MEM_VEC_SINGLE:
+        rc = do_vector(cpu, &op, va, el, pc);
+        break;
+    default: {
+        if (op.align && !(op.kind == HV_MEM_ORDERED && (cpu->sctlr_el1 & (1u << 6))) && (va & (op.bytes - 1)))
+            return alignment_fault(cpu, va, op.store, pc);
+        int pair = op.kind == HV_MEM_PAIR;
+        uint32_t esize = 1u << op.size;
+        uint8_t buf[32] = {0};
+        if (op.store) {
+            if (op.vec) {
+                memcpy(buf, vreg(cpu, op.rt), esize);
+                if (pair) memcpy(buf + esize, vreg(cpu, op.rt2), esize);
+            } else {
+                uint64_t a = gpr(cpu, op.rt), b = pair ? gpr(cpu, op.rt2) : 0;
+                memcpy(buf, &a, esize);
+                if (pair) memcpy(buf + esize, &b, esize);
+            }
+            if (op.kind == HV_MEM_ORDERED) __atomic_thread_fence(__ATOMIC_RELEASE);
+            rc = hv_vmem_xfer(cpu, va, buf, op.bytes, 1, el, pc);
+            break;
+        }
+        rc = hv_vmem_xfer(cpu, va, buf, op.bytes, 0, el, pc);
+        if (rc) break;
+        if (op.kind == HV_MEM_ORDERED) __atomic_thread_fence(__ATOMIC_ACQUIRE);
+        if (op.vec) {
+            memset(vreg(cpu, op.rt), 0, 16);
+            memcpy(vreg(cpu, op.rt), buf, esize);
+            if (pair) {
+                memset(vreg(cpu, op.rt2), 0, 16);
+                memcpy(vreg(cpu, op.rt2), buf + esize, esize);
+            }
+        } else {
+            uint64_t a = extend(le(buf, esize > 8 ? 8 : esize), &op);
+            uint64_t b = pair ? extend(le(buf + esize, esize), &op) : 0;
+            /* Writeback first, so a loaded base register keeps the loaded value. */
+            if (op.mode == HV_ADDR_PRE) set_base(cpu, op.rn, va);
+            else if (op.mode == HV_ADDR_POST) set_base(cpu, op.rn, base + op.imm);
+            set_gpr(cpu, op.rt, a);
+            if (pair) set_gpr(cpu, op.rt2, b);
+            return 0;
+        }
+        break;
+    }
+    }
+    if (rc) return 1;
+    if (op.mode == HV_ADDR_PRE) {
+        set_base(cpu, op.rn, va);
+    } else if (op.mode == HV_ADDR_POST) {
+        int vec_reg = (op.kind == HV_MEM_VEC_MULTI || op.kind == HV_MEM_VEC_SINGLE) && op.rm != 31;
+        set_base(cpu, op.rn, base + (vec_reg ? gpr(cpu, op.rm) : (uint64_t)op.imm));
+    }
+    return 0;
+}
diff --git a/accel/henge/engine/core/memop.h b/accel/henge/engine/core/memop.h
new file mode 100644
index 0000000000..47264a7b4f
--- /dev/null
+++ b/accel/henge/engine/core/memop.h
@@ -0,0 +1,57 @@
+#ifndef HENGEVM_MEMOP_H
+#define HENGEVM_MEMOP_H
+
+#include <stdint.h>
+
+#include "cpu.h"
+
+/* A decoded load/store, shared by the translator's fast path and the C slow path. */
+typedef enum {
+    HV_MEM_SINGLE,     /* LDR/STR and sign-extending loads, all addressing modes, GPR or SIMD&FP */
+    HV_MEM_PAIR,       /* LDP/STP/LDNP/STNP/LDPSW */
+    HV_MEM_LITERAL,    /* LDR (literal), LDRSW (literal) */
+    HV_MEM_LDRA,       /* LDRAA/LDRAB: base + scaled imm10, optional pre-index writeback */
+    HV_MEM_ORDERED,    /* LDAR/STLR/LDLAR/STLLR, and LDAPUR/STLUR (imm9) */
+    HV_MEM_EXCL,       /* LDXR/STXR/LDAXR/STLXR and the pair forms */
+    HV_MEM_CAS,        /* CAS, CASA, CASL, CASAL (all sizes) */
+    HV_MEM_CASP,       /* CASP and its ordered forms */
+    HV_MEM_ATOMIC,     /* LDADD..LDUMIN, SWP, LDAPR */
+    HV_MEM_VEC_MULTI,  /* LD1-LD4 / ST1-ST4 (multiple structures) */
+    HV_MEM_VEC_SINGLE, /* LD1-LD4 / ST1-ST4 (single structure) and LD1R-LD4R */
+} HvMemKind;
+
+typedef enum { HV_ADDR_BASE, HV_ADDR_OFFSET, HV_ADDR_PRE, HV_ADDR_POST, HV_ADDR_REG, HV_ADDR_LITERAL } HvAddrMode;
+
+typedef struct HvMemOp {
+    HvMemKind kind;
+    HvAddrMode mode;
+    uint8_t load, store;   /* both for atomics, CAS and SWP */
+    uint8_t vec;           /* Rt (and Rt2) are SIMD&FP registers */
+    uint8_t size;          /* log2 bytes of one register's access (0..4) */
+    uint8_t sign;          /* 0: zero-extend, 32 or 64: sign-extend to that width */
+    uint8_t unpriv;        /* LDTR/STTR: EL0 permissions */
+    uint8_t align;         /* must be naturally aligned (atomics, exclusives, LDAR/STLR) */
+    uint8_t rt, rt2, rn, rm, rs;
+    uint8_t ext, shift;    /* register offset: option (UXTW 2, LSL 3, SXTW 6, SXTX 7) and shift */
+    uint8_t atomic_op;     /* o3:opc for HV_MEM_ATOMIC */
+    uint8_t rpt, selem;    /* vector structures */
+    uint8_t vq;            /* vector: Q bit */
+    uint8_t index;         /* single structure: element index; replicate if 0xff */
+    int64_t imm;           /* byte offset, or post-index amount */
+    uint32_t bytes;        /* total bytes touched */
+} HvMemOp;
+
+/* Returns 0, or -1 if the encoding is unallocated or a feature we do not expose. */
+int hv_mem_decode(uint32_t insn, HvMemOp *op);
+
+/* Emulates one load/store instruction completely in C: address, translation,
+   the access (RAM or MMIO), and base writeback. This is the slow path for TLB
+   misses and device accesses, and the only path for exclusives.
+   Returns 1 if the block must leave (an abort was taken). */
+int hv_mem_emulate(HvCpu *cpu, uint32_t insn, uint64_t pc);
+
+/* Virtual-memory access from C (used by DC ZVA and tests). el selects the
+   permissions. Returns 0, or 1 after taking a data abort. */
+int hv_vmem_xfer(HvCpu *cpu, uint64_t va, void *buf, uint32_t len, int write, int el, uint64_t pc);
+
+#endif
diff --git a/accel/henge/engine/core/mmu.c b/accel/henge/engine/core/mmu.c
new file mode 100644
index 0000000000..5b405e9e97
--- /dev/null
+++ b/accel/henge/engine/core/mmu.c
@@ -0,0 +1,1170 @@
+#include "mmu.h"
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "exception.h"
+#include "machine.h"
+
+/* VMSAv8-64 stage 1 translation for the EL1&0 regime, 4 KB, 16 KB and 64 KB
+   granules, 48-bit VA and PA. There is no stage 2: HengeVM is the hypervisor. */
+
+#define PAGE_MASK ((1ull << HV_TLB_PAGE_BITS) - 1)
+#define OA_MASK 0x0000ffffffffffffull
+
+static int granule_bits(uint32_t tg, int ttbr1) {
+    if (ttbr1) return tg == 1 ? 14 : tg == 3 ? 16 : 12; /* TG1: 01 16K, 10 4K, 11 64K */
+    return tg == 2 ? 14 : tg == 1 ? 16 : 12;            /* TG0: 00 4K, 01 64K, 10 16K */
+}
+
+/* This file is built with -mgeneral-regs-only, and the walk and the TLB fill
+   call nothing in libc: hv_tlb_refill runs them from translated code without
+   saving the guest's SIMD registers, which libc's memory routines would use. */
+static HvRam *ram_of(HvMachine *m, uint64_t pa) {
+    for (int i = 0; i < m->nram; i++)
+        if (pa - m->ram[i].pa < m->ram[i].size) return &m->ram[i];
+    return NULL;
+}
+
+/* A descriptor: RAM, 8 bytes, aligned. Device memory as a page table is not supported. */
+static int read_desc(HvMachine *m, uint64_t pa, uint64_t *out) {
+    HvRam *r = ram_of(m, pa);
+    if (!r || pa + 8 - r->pa > r->size) return -1;
+    *out = __atomic_load_n((const uint64_t *)(const void *)(r->host + (pa - r->pa)), __ATOMIC_RELAXED);
+    return 0;
+}
+
+void hv_mmu_walk(HvCpu *cpu, uint64_t va, HvAccess acc, int el, HvWalk *out) {
+    *out = (HvWalk){0};
+    uint64_t sctlr = cpu->sctlr_el1;
+    if (!(sctlr & 1)) {
+        /* MMU off: flat, everything allowed. Data is Device-nGnRnE, fetches Normal. */
+        out->pa = va;
+        out->r = out->w = out->x = 1;
+        out->block_size = 1ull << 30;
+        out->attr = acc == HV_ACC_EXEC ? 0xff : 0x00;
+        return;
+    }
+
+    uint64_t tcr = cpu->tcr_el1;
+    int hi = (va >> 55) & 1;
+    int tbi = hi ? (tcr >> 38) & 1 : (tcr >> 37) & 1;
+    int tbid = hi ? (tcr >> 52) & 1 : (tcr >> 51) & 1;
+    if (acc == HV_ACC_EXEC && tbid) tbi = 0;
+    uint32_t tsz = hi ? (tcr >> 16) & 63 : tcr & 63;
+    int epd = hi ? (tcr >> 23) & 1 : (tcr >> 7) & 1;
+    int hpd = hi ? (tcr >> 42) & 1 : (tcr >> 41) & 1;
+    int g = granule_bits(hi ? (tcr >> 30) & 3 : (tcr >> 14) & 3, hi);
+    if (tsz < 16) tsz = 16;
+    if (tsz > 39) tsz = 39;
+    int inputsize = 64 - (int)tsz;
+
+    /* Bits above the input size must all match bit 55 (or bit 63 without TBI). */
+    int top = tbi ? 55 : 63;
+    uint64_t mask = (top - inputsize + 1 >= 64 ? ~0ull : ((1ull << (top - inputsize + 1)) - 1)) << inputsize;
+    if ((va & mask) != (hi ? mask : 0) || epd) {
+        out->fsc = HV_FSC_TRANSLATION(0);
+        return;
+    }
+
+    int stride = g - 3;
+    int levels = (inputsize - g + stride - 1) / stride;
+    int level = 4 - levels;
+    uint64_t base = (hi ? cpu->ttbr1_el1 : cpu->ttbr0_el1) & OA_MASK & ~1ull;
+    int ap_table = 0, pxn_table = 0, uxn_table = 0;
+
+    for (;; level++) {
+        int shift = g + stride * (3 - level);
+        int idx_bits = level == 4 - levels ? inputsize - shift : stride;
+        uint64_t idx = (va >> shift) & ((1ull << idx_bits) - 1);
+        uint64_t desc;
+        if (read_desc(cpu->m, base + idx * 8, &desc) != 0) {
+            out->fsc = 0x14 + level; /* synchronous external abort on a table walk */
+            out->s1ptw = 1;
+            return;
+        }
+        if (!(desc & 1)) {
+            out->fsc = HV_FSC_TRANSLATION(level);
+            return;
+        }
+        if (level < 3 && (desc & 2)) { /* table */
+            base = desc & OA_MASK & ~((1ull << g) - 1);
+            if (!hpd) {
+                pxn_table |= (desc >> 59) & 1;
+                uxn_table |= (desc >> 60) & 1;
+                ap_table |= (desc >> 61) & 3;
+            }
+            continue;
+        }
+        if (level == 3 && !(desc & 2)) {
+            out->fsc = HV_FSC_TRANSLATION(level);
+            return;
+        }
+        if (level < 3) { /* block: 4K at levels 1-2, 16K and 64K at level 2 */
+            if (level == 0 || (g != 12 && level == 1)) {
+                out->fsc = HV_FSC_TRANSLATION(level);
+                return;
+            }
+        }
+        uint64_t size = 1ull << shift;
+        out->block_size = size;
+        out->pa = (desc & OA_MASK & ~(size - 1)) | (va & (size - 1));
+        out->attr = (cpu->mair_el1 >> (((desc >> 2) & 7) * 8)) & 0xff;
+        if (!(desc & (1u << 10))) {
+            out->fsc = HV_FSC_ACCESS(level);
+            return;
+        }
+        int ap = (desc >> 6) & 3;
+        int uxn = ((desc >> 54) & 1) | uxn_table;
+        int pxn = ((desc >> 53) & 1) | pxn_table;
+        int el0_access = (ap & 1) && !(ap_table & 1);
+        int read_only = (ap & 2) || (ap_table & 2);
+        if (el == 0) {
+            out->r = el0_access;
+            out->w = el0_access && !read_only;
+            out->x = !uxn;
+        } else {
+            int pan = (cpu->pstate_extra & HV_PSTATE_PAN) && el0_access;
+            out->r = !pan;
+            out->w = !pan && !read_only;
+            /* EL1 never executes what EL0 can write. */
+            out->x = !pxn && !(el0_access && !read_only);
+        }
+        if ((sctlr >> 19) & 1 && !read_only && (el == 0 ? el0_access : 1)) out->x = 0; /* WXN */
+        int ok = acc == HV_ACC_READ ? out->r : acc == HV_ACC_WRITE ? out->w : out->x;
+        if (!ok) out->fsc = HV_FSC_PERMISSION(level);
+        return;
+    }
+}
+
+int hv_tlb_tmajor;
+
+void hv_tlb_flush(HvCpu *cpu) {
+    if (cpu->m) cpu->m->stats.tlb_flushes++;
+    if (cpu->m) cpu->m->stats.reset_why[0]++;
+    hv_ijc_reset(cpu, 0); /* mappings changed: branch targets cached by VA are no longer trusted */
+    hv_ijc_reset(cpu, 1);
+    memset(cpu->tlb, 0x80, sizeof cpu->tlb);
+    cpu->nuser_fills = 0;
+    cpu->nkernel_fills = 0;
+    hv_tlb_stash_drop(cpu, -1);
+    if (cpu->pc_state) {
+        memset(cpu->pc_state->large_2m_bloom, 0, sizeof cpu->pc_state->large_2m_bloom);
+        memset(cpu->pc_state->large_big_bloom, 0, sizeof cpu->pc_state->large_big_bloom);
+    }
+}
+
+/* Clear the tables of one half (user tables are the even flags values, kernel ones odd). */
+static uint32_t hint_slot(uint64_t key) {
+    return (uint32_t)((key * 0x9e3779b97f4a7c15ull) >> 52);
+}
+
+static void ijc_clear(HvCpu *cpu, int kernel) {
+    if (!cpu->pc_state) return;
+    memset(cpu->pc_state->ijc_hint[kernel], 0, sizeof cpu->pc_state->ijc_hint[kernel]);
+    for (int t = kernel; t < HV_IJC_TABLES; t += 2)
+        memset(cpu->pc_state->ijc + (size_t)t * (HV_IJC_TABLE_BYTES / 8), 0, HV_IJC_TABLE_BYTES);
+}
+
+/* ASIDs live in TTBR0 unless TCR.A1 (bit 22) puts them in TTBR1 (as Windows 11 ARM64 does);
+   TCR.AS (bit 36) selects 16-bit vs 8-bit ASIDs. */
+static int current_asid(HvCpu *cpu) {
+    uint64_t tcr = cpu->tcr_el1;
+    uint64_t src = ((tcr >> 22) & 1) ? cpu->ttbr1_el1 : cpu->ttbr0_el1;
+    uint32_t mask = ((tcr >> 36) & 1) ? 0xffffu : 0xffu;
+    return (int)((src >> 48) & mask);
+}
+
+/* Active user address space key: (ASID << 48) | (TTBR0 & OA_MASK), regardless of
+   whether TCR.A1 places the ASID in TTBR0 or TTBR1. ASID 0 (including Windows 11's
+   intermediate KiSwapProcess transition) returns 0 so transient tables never stash
+   or restore entries across dead processes reusing a freed DirectoryTableBase PA. */
+uint64_t hv_mmu_ukey(const HvCpu *cpu) {
+    int asid = current_asid((HvCpu *)cpu);
+    uint64_t pa = cpu->ttbr0_el1 & OA_MASK;
+    if (asid <= 0 || !pa) return 0;
+    return ((uint64_t)(uint16_t)asid << 48) | pa;
+}
+
+/* ---- the (user id, page) set ---- */
+
+static uint64_t ucode_key(uint32_t cid, uint64_t va) {
+    return ((uint64_t)cid << 40 | ((va >> HV_TLB_PAGE_BITS) & 0xffffffffffull)) + 1; /* never 0, the empty slot */
+}
+
+static uint32_t ucode_slot(uint64_t key) {
+    return (uint32_t)((key * 0x9e3779b97f4a7c15ull) >> (64 - HV_UCODE_BITS));
+}
+
+static void ucode_clear(HvPerCpu *m) {
+    if (m) m->last_fill[0] = 0;
+    if (m && m->ucode) memset(m->ucode, 0, (sizeof *m->ucode) << HV_UCODE_BITS);
+    if (m) m->ucode_count = 0;
+}
+
+static int ucode_has(HvPerCpu *m, uint32_t cid, uint64_t va) {
+    uint64_t key = ucode_key(cid, va);
+    for (uint32_t i = ucode_slot(key);; i = (i + 1) & ((1u << HV_UCODE_BITS) - 1)) {
+        if (m->ucode[i] == key) return 1;
+        if (!m->ucode[i]) return 0;
+    }
+}
+
+void hv_ucode_add(HvCpu *cpu, uint64_t va) {
+    HvPerCpu *m = cpu->pc_state;
+    uint32_t cid = (uint32_t)(cpu->ijc_salt[0] >> 48);
+    if (!m || !cid) return;
+    uint64_t key = ucode_key(cid, va);
+    uint32_t i = ucode_slot(key);
+    for (; m->ucode[i]; i = (i + 1) & ((1u << HV_UCODE_BITS) - 1))
+        if (m->ucode[i] == key) return;
+    if (m->ucode_count >= (1u << HV_UCODE_BITS) / 2) { /* half full: start the user half over */
+        hv_ijc_reset(cpu, 0);
+        hv_ijc_switch(cpu);
+        cid = (uint32_t)(cpu->ijc_salt[0] >> 48);
+        key = ucode_key(cid, va);
+        i = ucode_slot(key);
+    }
+    m->ucode[i] = key;
+    m->ucode_count++;
+}
+
+/* A user id no tag in the tables uses yet; when they run out, empty the user tables and start over. */
+static uint16_t fresh_cid(HvCpu *cpu) {
+    if (cpu->next_cid == 0 || cpu->next_cid > 0xffff) {
+        if (cpu->pc_state && cpu->pc_state->cid_chunks) memset(cpu->pc_state->cid_chunks, 0, 65536 * sizeof *cpu->pc_state->cid_chunks);
+        if (cpu->pc_state) cpu->pc_state->last_fill[0] = cpu->pc_state->last_fill[1] = 0;
+        ijc_clear(cpu, 0);
+        ucode_clear(cpu->pc_state);
+        memset(cpu->asid_cid, 0, sizeof cpu->asid_cid);
+        cpu->asid0_used = 0;
+        cpu->next_cid = 1;
+    }
+    if (cpu->pc_state && cpu->pc_state->cid_chunks) memset(cpu->pc_state->cid_chunks[cpu->next_cid], 0, sizeof cpu->pc_state->cid_chunks[0]);
+    return (uint16_t)cpu->next_cid++;
+}
+
+/* Empty a half of the return tables by giving it a new salt. From the CPU's own thread;
+   the salts run out here, and it is the only one that may clear the tables. */
+static void ret_new(HvCpu *cpu, int kernel) {
+    if (cpu->ret_salt[kernel] >> 48 >= 0xf000) {
+        hv_ret_clear(cpu); /* both halves: nothing is left under any salt */
+        return;
+    }
+    __atomic_add_fetch(&cpu->ret_salt[kernel], 1ull << 48, __ATOMIC_RELAXED);
+}
+
+/* The same from another CPU's thread. 0 if it is too near running out to do it here. */
+static int ret_new_remote(HvCpu *cpu, int kernel) {
+    if (__atomic_load_n(&cpu->ret_salt[kernel], __ATOMIC_RELAXED) >> 48 >= 0xff00) return 0;
+    __atomic_add_fetch(&cpu->ret_salt[kernel], 1ull << 48, __ATOMIC_RELAXED);
+    return 1;
+}
+
+void hv_ijc_switch(HvCpu *cpu) {
+    int asid = current_asid(cpu);
+    ret_new(cpu, 0); /* a switch forgets the old process's returns: its frames miss once at worst */
+    if (asid < 0) { /* no ASIDs to tell processes apart: a switch forgets the old one */
+        cpu->ijc_salt[0] = (uint64_t)fresh_cid(cpu) << 48;
+        return;
+    }
+    if (asid == 0) {
+        uint64_t b0 = cpu->ttbr0_el1 & OA_MASK;
+        if (cpu->asid0_ttbr0 != b0) {
+            cpu->asid0_ttbr0 = b0;
+            if (cpu->asid_cid[0] && cpu->asid0_used) cpu->asid_cid[0] = 0;
+            cpu->asid0_used = 0;
+        }
+    }
+    if (!cpu->asid_cid[asid]) {
+        cpu->asid_cid[asid] = fresh_cid(cpu);
+        cpu->cid_asid[cpu->asid_cid[asid]] = (uint16_t)asid;
+    }
+    cpu->ijc_salt[0] = (uint64_t)cpu->asid_cid[asid] << 48;
+}
+
+void hv_ijc_drop_asid(HvCpu *cpu, uint16_t asid) {
+    if (cpu->m) cpu->m->stats.ijc_resets++;
+    cpu->asid_cid[asid] = 0;
+    int cur = current_asid(cpu);
+    if (cur == asid || cur < 0) hv_ijc_switch(cpu); /* without ASIDs, any drop may be about the current process */
+}
+
+void hv_ijc_reset(HvCpu *cpu, int kernel) {
+    ret_new(cpu, kernel);
+    if (cpu->pc_state) cpu->pc_state->last_fill[0] = cpu->pc_state->last_fill[1] = 0;
+    /* Every entry of the half is dead now (new ids or kernel generation): so are their hints. */
+    if (cpu->pc_state) memset(cpu->pc_state->ijc_hint[kernel], 0, sizeof cpu->pc_state->ijc_hint[kernel]);
+    if (cpu->m) {
+        cpu->m->stats.ijc_resets++;
+        memset(cpu->pc_state->ijc_pages[kernel], 0, sizeof cpu->pc_state->ijc_pages[kernel]);
+    }
+    if (kernel) {
+        /* Kernel VAs have 0xffff in bits 63..48, so the salt must not make that 0 (the empty tag). */
+        if (++cpu->kernel_gen >= 0xffff) {
+            ijc_clear(cpu, 1);
+            cpu->kernel_gen = 1;
+        }
+        cpu->ijc_salt[1] = (uint64_t)cpu->kernel_gen << 48;
+        memset(cpu->kttbr_map, 0, sizeof cpu->kttbr_map);
+        cpu->kttbr_next = 0;
+        uint64_t kt = (cpu->ttbr1_el1 & OA_MASK) ? cpu->ttbr1_el1 : 0;
+        if (kt) {
+            cpu->kttbr_map[0].ttbr1 = kt;
+            cpu->kttbr_map[0].kgen = (uint16_t)cpu->kernel_gen;
+            cpu->kttbr_next = 1;
+            __atomic_store_n(&cpu->kttbr_count, 1, __ATOMIC_RELAXED);
+        } else {
+            __atomic_store_n(&cpu->kttbr_count, 0, __ATOMIC_RELAXED);
+        }
+        return;
+    }
+    memset(cpu->asid_cid, 0, sizeof cpu->asid_cid);
+    cpu->asid0_used = 0;
+    ucode_clear(cpu->pc_state); /* every user id is new now */
+    hv_ijc_switch(cpu);
+}
+
+void hv_ijc_switch_kernel(HvCpu *cpu, uint64_t new_ttbr1) {
+    uint64_t kt = (new_ttbr1 & OA_MASK) ? new_ttbr1 : 0;
+    ret_new(cpu, 1);
+    if (!kt) {
+        hv_ijc_reset(cpu, 1);
+        return;
+    }
+    for (uint32_t i = 0; i < HV_KTTBR_SLOTS; i++) {
+        if (cpu->kttbr_map[i].ttbr1 == kt && cpu->kttbr_map[i].kgen) {
+            cpu->ijc_salt[1] = (uint64_t)cpu->kttbr_map[i].kgen << 48;
+            return;
+        }
+    }
+    if (++cpu->kernel_gen >= 0xffff) {
+        if (cpu->pc_state) cpu->pc_state->last_fill[1] = 0;
+        ijc_clear(cpu, 1);
+        memset(cpu->kttbr_map, 0, sizeof cpu->kttbr_map);
+        cpu->kttbr_next = 0;
+        __atomic_store_n(&cpu->kttbr_count, 0, __ATOMIC_RELAXED);
+        cpu->kernel_gen = 1;
+    }
+    uint32_t sl = cpu->kttbr_next & (HV_KTTBR_SLOTS - 1);
+    int was_empty = cpu->kttbr_map[sl].ttbr1 == 0;
+    cpu->kttbr_map[sl].ttbr1 = kt;
+    cpu->kttbr_map[sl].kgen = (uint16_t)cpu->kernel_gen;
+    cpu->kttbr_next = (sl + 1) & (HV_KTTBR_SLOTS - 1);
+    if (was_empty) __atomic_add_fetch(&cpu->kttbr_count, 1, __ATOMIC_RELAXED);
+    cpu->ijc_salt[1] = (uint64_t)cpu->kernel_gen << 48;
+}
+
+/* TTBR0 changed or an ASID was dropped: only user-half (TTBR0) translations go;
+   the kernel's TTBR1 entries stay. */
+void hv_tlb_flush_user(HvCpu *cpu) {
+    if (cpu->m) cpu->m->stats.tlb_flushes++;
+    uint32_t n = cpu->nuser_fills;
+    cpu->nuser_fills = 0;
+    if (n <= HV_USER_FILLS) {
+        for (uint32_t k = 0; k < n; k++) {
+            HvTlbEntry *e = &cpu->tlb[0] + cpu->user_fills[k];
+            uint64_t tag = e->read_tag != HV_TLB_INVALID ? e->read_tag + HV_TLB_ADJ : e->exec_tag != HV_TLB_INVALID ? hv_exec_key(e->exec_tag, e->addend) : e->write_tag + HV_TLB_ADJ;
+            if (e->read_tag != HV_TLB_INVALID || e->exec_tag != HV_TLB_INVALID || e->write_tag != HV_TLB_INVALID) if (!((tag >> 55) & 1)) memset(e, 0x80, sizeof *e); /* the slot may hold a kernel page by now */
+        }
+        return;
+    }
+    for (int t = 0; t < 3; t++)
+        for (uint32_t i = 0; i < HV_TLB_SIZE; i++) {
+            HvTlbEntry *e = hv_tlb_ent(cpu, i, t);
+            uint64_t tag = e->read_tag != HV_TLB_INVALID ? e->read_tag + HV_TLB_ADJ : e->exec_tag != HV_TLB_INVALID ? hv_exec_key(e->exec_tag, e->addend) : e->write_tag + HV_TLB_ADJ;
+            if (e->read_tag != HV_TLB_INVALID || e->exec_tag != HV_TLB_INVALID || e->write_tag != HV_TLB_INVALID) if (!((tag >> 55) & 1)) memset(e, 0x80, sizeof *e);
+        }
+}
+
+/* A TLBI for a big user range: only the user entries filled since the last
+   flush that fall in it (all of them if there were too many to list). */
+void hv_tlb_flush_user_range(HvCpu *cpu, uint64_t va, uint64_t len) {
+    uint32_t n = cpu->nuser_fills;
+    if (n > HV_USER_FILLS) {
+        hv_tlb_flush_user(cpu);
+        return;
+    }
+    if (cpu->m) if (cpu->m->stats_interval) cpu->m->stats.tlb_range_flushes++;
+    uint64_t lo = va & 0x00ffffffffffffffull;
+    for (uint32_t k = 0; k < n; k++) {
+        HvTlbEntry *e = &cpu->tlb[0] + cpu->user_fills[k];
+        if (e->read_tag == HV_TLB_INVALID && e->exec_tag == HV_TLB_INVALID && e->write_tag == HV_TLB_INVALID) continue;
+        uint64_t tag = e->read_tag != HV_TLB_INVALID ? e->read_tag + HV_TLB_ADJ : e->exec_tag != HV_TLB_INVALID ? hv_exec_key(e->exec_tag, e->addend) : e->write_tag + HV_TLB_ADJ;
+        if ((tag >> 55) & 1) continue; /* the slot holds a kernel page by now */
+        /* Any overlap (a 4 KB-granule range may start inside the page); tagged addresses: by the low 56 bits. */
+        uint64_t pg = tag & 0x00ffffffffffffffull;
+        if (pg < lo + len && pg + PAGE_MASK + 1 > lo) memset(e, 0x80, sizeof *e);
+    }
+}
+
+/* A big range of kernel VAs. A full flush here also dropped every process's entries and both halves of the branch
+   caches, and macOS 27 sends ranges like this hundreds of times a second (a phone running it did 120-260 full flushes a
+   second, Sequoia none). Up to 64 MB page by page, as small ranges are; past that, a scan for kernel entries in the range
+   and the kernel half of the branch caches. */
+void hv_tlb_flush_kernel_range(HvCpu *cpu, uint64_t va, uint64_t len) {
+    if (cpu->m && cpu->m->stats_interval) cpu->m->stats.kernel_ranges++;
+    uint64_t first = va & ~(uint64_t)PAGE_MASK;
+    if (len <= (4096ull << HV_TLB_PAGE_BITS)) {
+        for (uint64_t p = first; p < va + len; p += 1ull << HV_TLB_PAGE_BITS) hv_tlb_flush_va_asid(cpu, p, -1);
+        return;
+    }
+    uint64_t lo = first & 0x00ffffffffffffffull, hi = (va + len) & 0x00ffffffffffffffull; /* tagged addresses: by the low 56 bits */
+    for (int t = 0; t < 3; t++)
+        for (uint32_t i = 0; i < HV_TLB_SIZE; i++) {
+            HvTlbEntry *e = hv_tlb_ent(cpu, i, t);
+            if (e->read_tag == HV_TLB_INVALID && e->exec_tag == HV_TLB_INVALID && e->write_tag == HV_TLB_INVALID) continue;
+            uint64_t tag = e->read_tag != HV_TLB_INVALID ? e->read_tag + HV_TLB_ADJ : e->exec_tag != HV_TLB_INVALID ? hv_exec_key(e->exec_tag, e->addend) : e->write_tag + HV_TLB_ADJ;
+            if (!((tag >> 55) & 1)) continue; /* a process's page */
+            uint64_t pg = tag & 0x00ffffffffffffffull;
+            if (pg < hi && pg + PAGE_MASK + 1 > lo) memset(e, 0x80, sizeof *e);
+        }
+    hv_ijc_reset(cpu, 1);
+}
+
+/* A page just got translated code: writes to it must take the slow path from now
+   on, so drop just the write permission of the entries that map it. */
+static int maps_writable(const HvTlbEntry *e, const uint8_t *host_page) {
+    return e->write_tag != HV_TLB_INVALID && (const uint8_t *)(uintptr_t)(e->write_tag + HV_TLB_ADJ + e->addend) == host_page;
+}
+
+/* RAM page pg just became code: drop write permission from cpu's entries for it. */
+void hv_tlb_protect_code_page(HvCpu *cpu, HvRam *ram, uint64_t pg) {
+    uint64_t *hint = &ram->whint[pg * HV_MAX_CPUS + cpu->index];
+    uint64_t h = __atomic_exchange_n(hint, 0, __ATOMIC_SEQ_CST);
+    const uint8_t *host_page = ram->host + (pg << HV_TLB_PAGE_BITS);
+    if (cpu->m) if (cpu->m->stats_interval) cpu->m->stats.protect_kind[h & HV_WHINT_MANY ? 2 : h ? 1 : 0]++;
+    if (h & HV_WHINT_MANY) {
+        hv_tlb_protect_code(cpu, host_page);
+        return;
+    }
+    for (int k = 0; k < 3; k++) {
+        uint64_t c = h >> (16 * k) & 0xffff;
+        if (!c) continue;
+        HvTlbEntry *e = &cpu->tlb[0] + (c - 1);
+        if (maps_writable(e, host_page)) e->write_tag = HV_TLB_INVALID;
+    }
+}
+
+void hv_tlb_protect_code(HvCpu *cpu, const uint8_t *host_page) {
+    for (int t = 0; t < 3; t++)
+        for (uint32_t i = 0; i < HV_TLB_SIZE; i++) {
+            HvTlbEntry *e = hv_tlb_ent(cpu, i, t);
+            if (e->write_tag != HV_TLB_INVALID && (const uint8_t *)(uintptr_t)(e->write_tag + HV_TLB_ADJ + e->addend) == host_page)
+                e->write_tag = HV_TLB_INVALID;
+        }
+}
+
+/* Forget one salt's cached targets in one 16 KB page. A page's 4096 possible
+   targets have 4096 known slots in each table, so only those are looked at. */
+/* local: cpu itself (it may empty the page's hint slot afterwards). */
+static void ijc_clear_page(HvCpu *cpu, uint64_t page, int kernel, uint64_t salt, int local) {
+    HvPerCpu *m = cpu->pc_state;
+    uint64_t key = (page ^ salt) | 1;
+    __typeof__(m->ijc_hint[0][0]) *h = &m->ijc_hint[kernel][hint_slot(key)];
+    uint64_t hk = __atomic_load_n(&h->key, __ATOMIC_RELAXED);
+    /* Another key's slot means this one has filled nothing since its own drop or the last reset. */
+    uint64_t bits = hk == key ? __atomic_load_n(&h->bits, __ATOMIC_RELAXED) : hk == ~0ull ? ~0ull : 0;
+    if (!bits) return;
+    for (int t = kernel; t < HV_IJC_TABLES; t += 2) {
+        if (!(m->ijc_tables_used >> t & 1)) continue;
+        uint64_t *tab = m->ijc + (size_t)t * (HV_IJC_TABLE_BYTES / 8);
+        const uint32_t insns_per_piece = 1u << (HV_TLB_PAGE_BITS - 8);
+        for (uint32_t piece = 0; piece < 64; piece++) {
+            if (!(bits >> piece & 1)) continue;
+            for (uint32_t o = piece * insns_per_piece; o < (piece + 1) * insns_per_piece; o++) {
+                uint64_t tag = (page | (uint64_t)o << 2) ^ salt;
+                uint64_t *ent = tab + (size_t)hv_ijc_index(tag) * 2;
+                if (ent[0] == tag) ent[0] = 0;
+                if (ent[2] == tag) ent[2] = 0;
+            }
+        }
+    }
+    if (local && hk == key) h->key = 0, h->bits = 0;
+}
+
+/* The page may hold cached branch targets even if its TLB entry is gone: forget
+   them, if the filters say it has any. */
+/* remote: another CPU doing it (hv_tlbi_drop_remote_va): returns 0 instead of
+   starting the user half over, which only cpu itself may do. */
+static int ijc_drop_va(HvCpu *cpu, uint64_t va, int asid, int remote) {
+    int kernel = (va >> 55) & 1;
+    HvMachine *m = cpu->m;
+    HvPerCpu *p = cpu->pc_state;
+    {   /* A return may lead into the page. For the kernel only if it is code the CPU has run;
+           xnu remaps data all the time and its code hardly ever. For a process only if it is the
+           one running: a switch forgets the returns of the others anyway. */
+        uint64_t page = va & ~((1ull << HV_TLB_PAGE_BITS) - 1);
+        uint32_t sl = (uint32_t)(va >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1);
+        const HvTlbEntry *t1 = hv_tlb_ent(cpu, sl, 1), *t2 = hv_tlb_ent(cpu, sl, 2);
+        int some = kernel ? t1->exec_tag == hv_exec_key(page, t1->addend) || t2->exec_tag == hv_exec_key(page, t2->addend) : asid < 0 || asid == current_asid(cpu) || current_asid(cpu) < 0;
+        if (some) {
+            if (!remote) ret_new(cpu, kernel);
+            else if (!ret_new_remote(cpu, kernel)) return 0;
+        }
+    }
+    if (m && p) {
+        int drop = 0;
+        if (kernel) {
+            uint32_t k = hv_ijc_key(va, cpu->ijc_salt[1]);
+            drop = p->ijc_keyed[k >> 6] >> (k & 63) & 1;
+        } else if (asid < 0) { /* every address space: any process's targets in the page count */
+            uint32_t h = (uint32_t)(va >> HV_TLB_PAGE_BITS) & 0xffff;
+            drop = p->ijc_pages[0][h >> 6] >> (h & 63) & 1;
+        } else {
+            uint64_t salt = current_asid(cpu) < 0 ? cpu->ijc_salt[0] : (uint64_t)cpu->asid_cid[asid] << 48;
+            drop = (salt >> 48) && ucode_has(p, (uint32_t)(salt >> 48), va);
+        }
+        if (drop) {
+            if (remote && !kernel && asid < 0) return 0;
+            if (remote && kernel && __atomic_load_n(&cpu->kttbr_count, __ATOMIC_RELAXED) > 1) return 0;
+            m->stats.reset_why[kernel ? 3 : 2]++;
+            uint64_t page = va & ~((1ull << HV_TLB_PAGE_BITS) - 1);
+            if (kernel) {
+                ijc_clear_page(cpu, page, 1, cpu->ijc_salt[1], !remote);
+                if (!remote && __atomic_load_n(&cpu->kttbr_count, __ATOMIC_RELAXED) > 1) {
+                    /* Other processes' TTBR1 salts may have cached targets in this kernel code page:
+                       keep only the current TTBR1 whose page we just cleared. */
+                    uint64_t cur_kt = (cpu->ttbr1_el1 & OA_MASK) ? cpu->ttbr1_el1 : 0;
+                    uint16_t cur_kg = (uint16_t)(cpu->ijc_salt[1] >> 48);
+                    memset(cpu->kttbr_map, 0, sizeof cpu->kttbr_map);
+                    cpu->kttbr_next = 0;
+                    if (cur_kt && cur_kg) {
+                        cpu->kttbr_map[0].ttbr1 = cur_kt;
+                        cpu->kttbr_map[0].kgen = cur_kg;
+                        cpu->kttbr_next = 1;
+                        __atomic_store_n(&cpu->kttbr_count, 1, __ATOMIC_RELAXED);
+                    } else {
+                        __atomic_store_n(&cpu->kttbr_count, 0, __ATOMIC_RELAXED);
+                    }
+                }
+            }
+            else if (asid < 0) m->stats.reset_why[5]++, hv_ijc_reset(cpu, 0); /* every address space: their slots differ, so start the user half over */
+            else ijc_clear_page(cpu, page, 0, current_asid(cpu) < 0 ? cpu->ijc_salt[0] : (uint64_t)cpu->asid_cid[asid] << 48, !remote);
+        }
+    }
+    return 1;
+}
+
+void hv_ijc_drop_va(HvCpu *cpu, uint64_t va, int asid) {
+    ijc_drop_va(cpu, va, asid, 0);
+}
+
+void hv_tlb_flush_va_asid(HvCpu *cpu, uint64_t va, int asid) {
+    /* Tagged addresses may sit in any slot's tag byte, so check by the low 56 bits. */
+    uint32_t idx = (va >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1);
+    hv_ijc_drop_va(cpu, va, asid);
+    if (!((va >> 55) & 1)) hv_tlb_stash_drop(cpu, asid);
+    for (int el = 0; el < 3; el++) {
+        HvTlbEntry *e = hv_tlb_ent(cpu, idx, el);
+        memset(e, 0x80, sizeof *e);
+    }
+    HvPerCpu *p = cpu->pc_state;
+    if (p) {
+        uint32_t h2 = hv_large_2m_bit(va);
+        if (p->large_2m_bloom[h2 >> 6] >> (h2 & 63) & 1) {
+            uint64_t base = va & ~((1ull << 21) - 1);
+            uint64_t lo = base & 0x00ffffffffffffffull, hi = lo + (1ull << 21);
+            int had_exec = 0;
+            for (uint32_t s = 0; s < (1u << (21 - HV_TLB_PAGE_BITS)); s++) {
+                uint32_t sl = ((uint32_t)(base >> HV_TLB_PAGE_BITS) + s) & (HV_TLB_SIZE - 1);
+                for (int el = 0; el < 3; el++) {
+                    HvTlbEntry *e = hv_tlb_ent(cpu, sl, el);
+                    if (e->read_tag == HV_TLB_INVALID && e->exec_tag == HV_TLB_INVALID && e->write_tag == HV_TLB_INVALID) continue;
+                    uint64_t tag = e->read_tag != HV_TLB_INVALID ? e->read_tag + HV_TLB_ADJ :
+                                   e->exec_tag != HV_TLB_INVALID ? hv_exec_key(e->exec_tag, e->addend) : e->write_tag + HV_TLB_ADJ;
+                    uint64_t pg = tag & 0x00ffffffffffffffull;
+                    if (pg >= lo && pg < hi) {
+                        if (e->exec_tag != HV_TLB_INVALID) had_exec = 1;
+                        memset(e, 0x80, sizeof *e);
+                    }
+                }
+            }
+            if (had_exec) {
+                if ((va >> 55) & 1) hv_ijc_reset(cpu, 1);
+                else hv_ijc_drop_range(cpu, base, 1ull << 21, asid);
+            }
+        }
+        uint32_t hb = hv_large_big_bit(va);
+        if (p->large_big_bloom[hb >> 6] >> (hb & 63) & 1) {
+            uint64_t base = va & ~((1ull << 30) - 1);
+            if ((va >> 55) & 1) hv_tlb_flush_kernel_range(cpu, base, 1ull << 30);
+            else {
+                hv_tlb_flush_user_range(cpu, base, 1ull << 30);
+                hv_ijc_drop_range(cpu, base, 1ull << 30, asid);
+            }
+        }
+    }
+}
+
+/* A TLBI by range too big to do page by page in the TLB (which then drops its
+   user half): forget cached branch targets only in the range's code pages. */
+void hv_ijc_drop_range(HvCpu *cpu, uint64_t va, uint64_t len, int asid) {
+    HvMachine *m = cpu->m;
+    if (!m) return;
+    if (asid < 0) { /* every address space */
+        m->stats.reset_why[5]++;
+        hv_ijc_reset(cpu, 0);
+        return;
+    }
+    if (asid == current_asid(cpu) || current_asid(cpu) < 0) ret_new(cpu, 0);
+    uint64_t salt = current_asid(cpu) < 0 ? cpu->ijc_salt[0] : (uint64_t)cpu->asid_cid[asid] << 48;
+    uint32_t cid = (uint32_t)(salt >> 48);
+    if (!cid) return; /* nothing cached for it */
+    uint64_t first = va >> HV_TLB_PAGE_BITS, last = (va + len - 1) >> HV_TLB_PAGE_BITS;
+    {   /* nothing cached in the chunks the range covers: nothing to drop */
+        uint64_t c0 = va >> 25, c1 = (va + len - 1) >> 25;
+        int any = c1 - c0 >= 255;
+        for (uint64_t c = c0; !any && c <= c1; c++)
+            any = cpu->pc_state->cid_chunks[cid][(c & 255) >> 6] >> (c & 63) & 1;
+        if (!any) {
+            if (m->stats_interval) m->stats.range_spared++;
+            return;
+        }
+    }
+    if (last - first >= 4096) { /* scanning the whole set costs more than the cold start: drop the address space */
+        hv_ijc_drop_asid(cpu, (uint16_t)asid);
+        return;
+    }
+    {
+        for (uint64_t p = first; p <= last; p++)
+            if (ucode_has(cpu->pc_state, cid, p << HV_TLB_PAGE_BITS)) {
+                m->stats.reset_why[2]++;
+                ijc_clear_page(cpu, p << HV_TLB_PAGE_BITS, 0, salt, 1);
+            }
+        return;
+    }
+    for (uint32_t i = 0; i < 1u << HV_UCODE_BITS; i++) {
+        uint64_t k = cpu->pc_state->ucode[i];
+        if (!k || (k - 1) >> 40 != cid) continue;
+        uint64_t p = (k - 1) & 0xffffffffffull;
+        if (p >= (first & 0xffffffffffull) && p <= (last & 0xffffffffffull)) {
+            m->stats.reset_why[2]++;
+            ijc_clear_page(cpu, p << HV_TLB_PAGE_BITS, 0, salt, 1);
+        }
+    }
+}
+
+void hv_tlb_flush_va(HvCpu *cpu, uint64_t va) {
+    hv_tlb_flush_va_asid(cpu, va, -1);
+}
+
+/* A writable entry just went into the TLB at code (slot << 2 | table) for RAM
+   page pg. Another CPU may have just translated code from the page, setting
+   code_pages and then dropping write tags in every TLB: if that came before
+   this entry was there, it must not stay writable. */
+static void stash_drop(HvPerCpu *p, int asid);
+
+static void write_guard(HvCpu *cpu, HvRam *ram, uint64_t pg, uint32_t code, HvTlbEntry *e) {
+    /* Say where, so that the page becoming code drops just this entry (or, if
+       this CPU now maps it writable twice, makes the protector scan). */
+    uint64_t *hint = &ram->whint[pg * HV_MAX_CPUS + cpu->index];
+    uint64_t mine = code + 1, old = __atomic_load_n(hint, __ATOMIC_RELAXED), now = old;
+    const uint8_t *host_page = ram->host + (pg << HV_TLB_PAGE_BITS);
+    if (!(old & HV_WHINT_MANY)) {
+        /* Up to three entries: this one, in a free place or one whose entry maps
+           something else by now; beyond that the protector scans. */
+        int have = 0, place = -1;
+        for (int k = 0; k < 3; k++) {
+            uint64_t c = old >> (16 * k) & 0xffff;
+            if (c == mine) have = 1;
+            else if (place < 0 && (!c || !maps_writable(&cpu->tlb[0] + (c - 1), host_page))) place = k;
+        }
+        if (!have) now = place >= 0 ? (old & ~(0xffffull << (16 * place))) | mine << (16 * place) : HV_WHINT_MANY;
+        if (now != old) __atomic_store_n(hint, now, __ATOMIC_RELAXED);
+    }
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    if (__atomic_load_n(&ram->code_pages[pg], __ATOMIC_RELAXED)) e->write_tag = HV_TLB_INVALID;
+}
+
+/* HV_KVA_HIST (measuring, for a kernel fastmem window): which kernel VAs get TLB fills, per GB from the bottom of xnu's
+   kernel VA space, and how many distinct 16 KB pages. hv_kva_hist_dump writes it out. */
+#define KVA_GBS 2048 /* buckets: 2048 of 1 GB from 0xfffffe0000000000 by default; HV_KVA_BASE (hex) and HV_KVA_SHIFT move and widen them */
+static uint64_t KVA_BASE = 0xfffffe0000000000ull;
+static int kva_shift = 30;
+static uint64_t kva_fills[KVA_GBS], kva_pages_n[KVA_GBS], kva_below, kva_above;
+static uint8_t *kva_seen; /* one bit per page */
+static int kva_on = -1;
+static void kva_note(uint64_t va) {
+    if (kva_on < 0) {
+        kva_on = getenv("HV_KVA_HIST") != NULL;
+        if (getenv("HV_KVA_BASE")) KVA_BASE = strtoull(getenv("HV_KVA_BASE"), NULL, 16);
+        if (getenv("HV_KVA_SHIFT")) kva_shift = atoi(getenv("HV_KVA_SHIFT"));
+    }
+    if (!kva_on) return;
+    if (!kva_seen) kva_seen = calloc((size_t)KVA_GBS << (kva_shift - HV_TLB_PAGE_BITS - 3), 1);
+    if (va < KVA_BASE) { __atomic_add_fetch(&kva_below, 1, __ATOMIC_RELAXED); return; }
+    uint64_t off = va - KVA_BASE, gb = off >> kva_shift;
+    if (gb >= KVA_GBS) { __atomic_add_fetch(&kva_above, 1, __ATOMIC_RELAXED); return; }
+    __atomic_add_fetch(&kva_fills[gb], 1, __ATOMIC_RELAXED);
+    uint64_t pg = off >> HV_TLB_PAGE_BITS;
+    uint8_t bit = (uint8_t)(1u << (pg & 7));
+    if (!(__atomic_fetch_or(&kva_seen[pg >> 3], bit, __ATOMIC_RELAXED) & bit)) __atomic_add_fetch(&kva_pages_n[gb], 1, __ATOMIC_RELAXED);
+}
+
+void hv_kva_hist_dump(FILE *f) {
+    if (kva_on <= 0) return;
+    fprintf(f, "kva below %llu above %llu (outside %d buckets of 2^%d bytes from %llx)\n", (unsigned long long)kva_below, (unsigned long long)kva_above, KVA_GBS, kva_shift, (unsigned long long)KVA_BASE);
+    for (int g = 0; g < KVA_GBS; g++)
+        if (kva_fills[g]) fprintf(f, "kva gb %d fills %llu pages %llu\n", g, (unsigned long long)kva_fills[g], (unsigned long long)kva_pages_n[g]);
+}
+
+static void tlb_fill(HvCpu *cpu, uint64_t va, int el, const HvWalk *w) {
+    if ((va >> 55) & 1) kva_note(va & ~(uint64_t)PAGE_MASK);
+    if (w->block_size < (1ull << HV_TLB_PAGE_BITS)) return; /* smaller guest pages: slow path only */
+    HvRam *ram = ram_of(cpu->m, w->pa);
+    if (!ram) return;
+    uint64_t page_pa = w->pa & ~PAGE_MASK;
+    if (page_pa < ram->pa || page_pa + PAGE_MASK + 1 - ram->pa > ram->size) return;
+    uint64_t pg = (page_pa - ram->pa) >> HV_TLB_PAGE_BITS;
+    uint64_t page_va = va & ~PAGE_MASK;
+    int table = hv_tlb_table(cpu, el);
+    uint32_t slot = (uint32_t)(va >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1);
+    HvTlbEntry *e = hv_tlb_ent(cpu, slot, table);
+    if (!((page_va >> 55) & 1)) {
+        if (cpu->nuser_fills < HV_USER_FILLS) cpu->user_fills[cpu->nuser_fills] = (uint16_t)hv_tlb_code(slot, table);
+        if (cpu->nuser_fills <= HV_USER_FILLS) cpu->nuser_fills++;
+    } else {
+        if (cpu->nkernel_fills < HV_KERNEL_FILLS) cpu->kernel_fills[cpu->nkernel_fills] = (uint16_t)hv_tlb_code(slot, table);
+        if (cpu->nkernel_fills <= HV_KERNEL_FILLS) cpu->nkernel_fills++;
+    }
+    e->addend = (int64_t)((uint64_t)(uintptr_t)(ram->host + (page_pa - ram->pa)) - page_va);
+    e->read_tag = w->r ? page_va - HV_TLB_ADJ : HV_TLB_INVALID;
+    /* Writes to ROM or to pages we translated from take the slow path. */
+    e->write_tag = w->w && !ram->readonly && !ram->code_pages[pg] ? page_va - HV_TLB_ADJ : HV_TLB_INVALID;
+    /* A watched page takes the slow path for every write. */
+    if (cpu->m->watch_va && (cpu->m->watch_va & ~PAGE_MASK & 0x00ffffffffffffffull) == (page_va & 0x00ffffffffffffffull))
+        e->write_tag = HV_TLB_INVALID;
+    if (cpu->m->watch_pa && (cpu->m->watch_pa & ~PAGE_MASK) == page_pa) e->write_tag = HV_TLB_INVALID;
+    e->exec_tag = w->x ? hv_exec_key(page_va, e->addend) : HV_TLB_INVALID;
+    if (e->write_tag != HV_TLB_INVALID) write_guard(cpu, ram, pg, hv_tlb_code(slot, table), e);
+    if ((cpu->sctlr_el1 & 1) && w->block_size > (1ull << HV_TLB_PAGE_BITS) && cpu->pc_state) {
+        if (w->block_size <= (1ull << 21)) {
+            uint32_t h = hv_large_2m_bit(page_va);
+            __atomic_or_fetch(&cpu->pc_state->large_2m_bloom[h >> 6], 1ull << (h & 63), __ATOMIC_RELAXED);
+        } else {
+            uint32_t h = hv_large_big_bit(page_va);
+            __atomic_or_fetch(&cpu->pc_state->large_big_bloom[h >> 6], 1ull << (h & 63), __ATOMIC_RELAXED);
+        }
+    }
+}
+
+/* Walks that may fill the TLB are bracketed by the CPU's walk_seq (odd while
+   one runs), so another CPU's TLBI can drop entries here itself and know no
+   fill from an old page table raced it (hv_tlbi_drop_remote_va). */
+static void walk_begin(HvCpu *cpu) {
+    if (cpu->pc_state) __atomic_add_fetch(&cpu->pc_state->walk_seq, 1, __ATOMIC_SEQ_CST);
+}
+
+static void walk_end(HvCpu *cpu) {
+    if (cpu->pc_state) __atomic_add_fetch(&cpu->pc_state->walk_seq, 1, __ATOMIC_RELEASE);
+}
+
+uint32_t hv_mmu_access(HvCpu *cpu, uint64_t va, HvAccess acc, int el, uint64_t *pa) {
+    HvWalk w;
+    walk_begin(cpu);
+    hv_mmu_walk(cpu, va, acc, el, &w);
+    if (!w.fsc) tlb_fill(cpu, va, el, &w);
+    walk_end(cpu);
+    if (w.fsc) return w.fsc;
+    *pa = w.pa;
+    return 0;
+}
+
+int hv_tlbi_drop_remote_va(HvCpu *target, uint64_t va, int asid) {
+    HvPerCpu *p = target->pc_state;
+    uint32_t h2 = hv_large_2m_bit(va), hb = hv_large_big_bit(va);
+    if ((p->large_2m_bloom[h2 >> 6] >> (h2 & 63) & 1) || (p->large_big_bloom[hb >> 6] >> (hb & 63) & 1))
+        return -1; /* large-block sub-pages may exist on target: let target flush them */
+    uint32_t s1 = __atomic_load_n(&p->walk_seq, __ATOMIC_SEQ_CST);
+    if (s1 & 1) { if (target->m->stats_interval) target->m->stats.race_kind[0]++; return 0; } /* mid-walk: it may be about to fill from the old table */
+    uint32_t c1 = __atomic_load_n(&p->ijc_seq, __ATOMIC_SEQ_CST);
+    if (c1 & 1) { if (target->m->stats_interval) target->m->stats.race_kind[1]++; return 0; } /* caching a block it may have looked up through the old mapping */
+    if (!((va >> 55) & 1)) stash_drop(p, asid);
+    uint32_t idx = (va >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1);
+    int fetched = 0; /* the target may be running code from the page: it must leave and look again */
+    for (int t = 0; t < 3; t++) { /* the slot whatever its tag byte, as hv_tlb_flush_va_asid does */
+        HvTlbEntry *e = hv_tlb_ent(target, idx, t);
+        uint64_t x = __atomic_load_n(&e->exec_tag, __ATOMIC_RELAXED);
+        if (x != HV_TLB_INVALID && ((hv_exec_key(x, e->addend) ^ va) & (0x00ffffffffffffffull & ~PAGE_MASK)) == 0) fetched = 1;
+        __atomic_store_n(&e->read_tag, HV_TLB_INVALID, __ATOMIC_RELAXED);
+        __atomic_store_n(&e->write_tag, HV_TLB_INVALID, __ATOMIC_RELAXED);
+        __atomic_store_n(&e->exec_tag, HV_TLB_INVALID, __ATOMIC_RELAXED);
+    }
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    /* Its cached branch targets in the page too: a cache fill checks the TLB
+       entry first (hv_ijc_fill_checked), so one after this sees it gone, and one
+       during it changed ijc_seq. */
+    if (!ijc_drop_va(target, va, asid, 1)) return -1; /* only target can do it: no use trying again */
+    __atomic_thread_fence(__ATOMIC_SEQ_CST);
+    int ok = __atomic_load_n(&p->walk_seq, __ATOMIC_SEQ_CST) == s1 && /* no fill in between */
+             __atomic_load_n(&p->ijc_seq, __ATOMIC_SEQ_CST) == c1;
+    if (!ok) {
+        if (target->m->stats_interval) target->m->stats.race_kind[2]++;
+    } else if (fetched) {
+        hv_cpu_kick(target);
+    }
+    return ok;
+}
+
+const uint32_t *hv_mmu_fetch(HvCpu *cpu, uint64_t va, uint64_t *pa, uint32_t *avail) {
+    if (va & 3) {
+        hv_raise_sync(cpu, HV_EC_PC_ALIGN, 0, va, va);
+        return NULL;
+    }
+    HvTlbEntry *t = hv_tlb_ent(cpu, (va >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1), hv_tlb_table(cpu, cpu->el));
+    if (t->exec_tag == hv_exec_key(va & ~PAGE_MASK, t->addend)) {
+        uint8_t *host = (uint8_t *)(uintptr_t)(va + t->addend);
+        for (int i = 0; i < cpu->m->nram; i++) {
+            HvRam *r = &cpu->m->ram[i];
+            if ((uint64_t)(host - r->host) < r->size) {
+                *pa = r->pa + (uint64_t)(host - r->host);
+                *avail = (uint32_t)(((1ull << HV_TLB_PAGE_BITS) - (va & PAGE_MASK)) / 4);
+                return (const uint32_t *)host;
+            }
+        }
+    }
+    HvWalk w;
+    cpu->m->stats.fetch_walks++;
+    walk_begin(cpu);
+    hv_mmu_walk(cpu, va, HV_ACC_EXEC, cpu->el, &w);
+    if (!w.fsc) tlb_fill(cpu, va, cpu->el, &w);
+    walk_end(cpu);
+    if (w.fsc) {
+        hv_raise_abort(cpu, 1, va, w.fsc, 0, w.s1ptw, va);
+        return NULL;
+    }
+    uint64_t chunk = w.block_size < (1ull << HV_TLB_PAGE_BITS) ? w.block_size : 1ull << HV_TLB_PAGE_BITS;
+    uint64_t left = chunk - (va & (chunk - 1));
+    const uint32_t *p = hv_phys_ptr(cpu->m, w.pa, 4);
+    if (!p) {
+        hv_raise_abort(cpu, 1, va, HV_FSC_EXTERNAL, 0, 0, va);
+        return NULL;
+    }
+    HvRam *ram = hv_ram_lookup(cpu->m, w.pa);
+    uint64_t ram_left = ram->size - (w.pa - ram->pa);
+    if (left > ram_left) left = ram_left;
+    *pa = w.pa;
+    *avail = (uint32_t)(left / 4);
+    return p;
+}
+
+/* A TLB miss in translated code, before the full helper: walk and fill, and
+   say whether the fast path will now succeed (0) or the helper must do the
+   access (a fault, device memory, a write to a code page, an unusual spot in
+   the page). Called by hv_helper_thunk with the guest's SIMD registers live,
+   so nothing here may use them (see read_desc). flags: bit 0 write, bits 2..1
+   the TLB table (0 EL0 or unprivileged, 1 EL1, 2 EL1 with PAN), bits 8..3 bytes - 1. */
+int hv_tlb_refill(HvCpu *cpu, uint64_t va, uint32_t flags) {
+    int write = flags & 1, table = (flags >> 1) & 3;
+    uint32_t bytes = ((flags >> 3) & 63) + 1;
+    int el = table ? 1 : 0;
+    uint64_t off = va & PAGE_MASK;
+    if (off + bytes > PAGE_MASK + 1) return 1; /* crosses into the next page: the helper */
+    if ((flags & (1u << 10)) && (va & (bytes - 1))) return 1; /* unaligned ordered access: fault in helper */
+    /* In the page, but where the fast check cannot pass (it allows HV_TLB_ADJ bytes of every access, so a small one in a
+       page's last HV_TLB_ADJ bytes misses): a refill would come straight back here. */
+    if (bytes <= HV_TLB_ADJ + 1 && off + HV_TLB_ADJ > PAGE_MASK) return 1;
+    uint64_t rkey = (va ^ ((uint64_t)flags << 49)) | 1ull;
+    if (cpu->pc_state) {
+        if (cpu->pc_state->last_refill_key == rkey) {
+            cpu->pc_state->last_refill_key = 0;
+            if (cpu->m->stats_interval) cpu->m->stats.slow_why[5]++;
+            return 1;
+        }
+        cpu->pc_state->last_refill_key = rkey;
+    }
+    HvWalk w;
+    walk_begin(cpu);
+    hv_mmu_walk(cpu, va, write ? HV_ACC_WRITE : HV_ACC_READ, el, &w);
+    if (!w.fsc) tlb_fill(cpu, va, el, &w);
+    walk_end(cpu);
+    if (w.fsc) return 1;
+    HvTlbEntry *e = hv_tlb_ent(cpu, (va >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1), table);
+    uint64_t tag = write ? e->write_tag : e->read_tag;
+    if (cpu->m->stats_interval) cpu->m->stats.refills++;
+    return tag != HV_TLB_INVALID && tag + HV_TLB_ADJ == (va & ~(uint64_t)PAGE_MASK) ? 0 : 1;
+}
+
+/* Put block b in this CPU's indirect-branch cache under its VA (b->va must be in
+   the half its flags say: kernel blocks, kernel VAs). */
+void hv_ijc_fill(HvCpu *cpu, HvBlock *b) {
+    HvMachine *m = cpu->m;
+    HvPerCpu *pcs = cpu->pc_state;
+    int kernel = b->flags & HV_BLOCK_EL1;
+    uint64_t *t = pcs->ijc + (size_t)(b->flags & (HV_IJC_TABLES - 1)) * (HV_IJC_TABLE_BYTES / 8);
+    uint64_t tag = b->va ^ cpu->ijc_salt[kernel];
+    uint64_t *ent = t + (size_t)hv_ijc_index(tag) * 2;
+    if (ent[0] != tag && ent[0]) ent[2] = ent[0], ent[3] = ent[1]; /* way 0's goes to way 1 (over this one's, if there) */
+    ent[0] = tag;
+    ent[1] = (uint64_t)(uintptr_t)b->code;
+    pcs->ijc_tables_used |= 1u << (b->flags & (HV_IJC_TABLES - 1));
+    {   /* the page's hint: which piece has a target now */
+        uint64_t key = ((b->va & ~(uint64_t)PAGE_MASK) ^ cpu->ijc_salt[kernel]) | 1;
+        uint64_t bit = 1ull << ((b->va >> (HV_TLB_PAGE_BITS - 6)) & 63);
+        __typeof__(pcs->ijc_hint[0][0]) *h = &pcs->ijc_hint[kernel][hint_slot(key)];
+        if (h->key == key) h->bits |= bit;
+        else if (!h->key) h->bits = bit, __atomic_store_n(&h->key, key, __ATOMIC_RELEASE);
+        else if (h->key != ~0ull) h->bits = ~0ull, __atomic_store_n(&h->key, ~0ull, __ATOMIC_RELEASE);
+    }
+    /* The filters below are per page: the next fill is mostly in the same one. */
+    uint64_t pkey = (b->va & ~(uint64_t)PAGE_MASK) ^ cpu->ijc_salt[kernel] ^ 1;
+    if (pcs->last_fill[kernel] == pkey) return;
+    if (!kernel) {
+        if (cpu->asid_cid[0] && (cpu->ijc_salt[0] >> 48) == cpu->asid_cid[0]) cpu->asid0_used = 1;
+        hv_ucode_add(cpu, b->va);
+        uint32_t h = (uint32_t)(b->va >> HV_TLB_PAGE_BITS) & 0xffff;
+        pcs->ijc_pages[0][h >> 6] |= 1ull << (h & 63);
+        uint32_t ch = (uint32_t)(b->va >> 25) & 255, cid = (uint32_t)(cpu->ijc_salt[0] >> 48); /* the id after any reset in ucode_add */
+        pcs->cid_chunks[cid][ch >> 6] |= 1ull << (ch & 63);
+    }
+    uint32_t k = hv_ijc_key(b->va, cpu->ijc_salt[kernel]);
+    if (!(pcs->ijc_keyed[k >> 6] >> (k & 63) & 1)) {
+        pcs->ijc_keyed[k >> 6] |= 1ull << (k & 63);
+        if (++pcs->ijc_keyed_count > (1u << 17)) { /* an eighth full: start the cache and the filter over */
+            m->stats.reset_why[6]++;
+            hv_ijc_reset(cpu, 0);
+            hv_ijc_reset(cpu, 1);
+            memset(pcs->ijc_keyed, 0, sizeof pcs->ijc_keyed);
+            pcs->ijc_keyed_count = 0;
+        }
+    }
+    pcs->last_fill[kernel] = (b->va & ~(uint64_t)PAGE_MASK) ^ cpu->ijc_salt[kernel] ^ 1; /* the salt after any reset above */
+}
+
+/* An indirect-branch cache miss in translated code, before the dispatcher: if
+   the target's block already exists (found through this CPU's TLB and the
+   block hash), cache it and return its code for the thunk to jump to; else 0
+   and the dispatcher does it. Called by hv_ijc_thunk with the guest's SIMD
+   registers live (see read_desc), so nothing that could reach libc runs: a
+   fill that would reset the cache's filters goes to the dispatcher instead.
+   flags: the block flags the branch was translated under (the target's too). */
+/* Does this CPU's TLB (the table for flags) map b's page where b came from? */
+static int tlb_maps_block(HvCpu *cpu, const HvBlock *b) {
+    int table = !(b->flags & HV_BLOCK_EL1) ? 0 : (b->flags & HV_BLOCK_PAN) ? 2 : 1;
+    const HvTlbEntry *e = hv_tlb_ent(cpu, (b->va >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1), table);
+    uint64_t page_va = b->va & ~(uint64_t)PAGE_MASK, page_pa = b->pa & ~(uint64_t)PAGE_MASK;
+    return __atomic_load_n(&e->exec_tag, __ATOMIC_RELAXED) == hv_exec_key(page_va, e->addend) &&
+           (uint64_t)e->addend == (uint64_t)(uintptr_t)(b->ram->host + (page_pa - b->ram->pa)) - page_va;
+}
+
+/* The dispatcher caching a block it found for va: only while the TLB still
+   says va is there, inside ijc_seq, so another CPU's TLBI can drop this CPU's
+   cached targets itself (hv_tlbi_drop_remote_va). */
+int hv_ijc_fill_checked(HvCpu *cpu, HvBlock *b) {
+    HvPerCpu *p = cpu->pc_state;
+    if (!p) {
+        hv_ijc_fill(cpu, b);
+        return 1;
+    }
+    __atomic_add_fetch(&p->ijc_seq, 1, __ATOMIC_SEQ_CST);
+    int ok = tlb_maps_block(cpu, b);
+    if (ok) hv_ijc_fill(cpu, b);
+    __atomic_add_fetch(&p->ijc_seq, 1, __ATOMIC_RELEASE);
+    return ok;
+}
+
+static void *ijc_resolve(HvCpu *cpu, uint64_t va, uint32_t flags);
+
+void *hv_ijc_resolve(HvCpu *cpu, uint64_t va, uint32_t flags) {
+    return ijc_resolve(cpu, va, flags);
+}
+
+static void *ijc_resolve(HvCpu *cpu, uint64_t va, uint32_t flags) {
+    HvMachine *m = cpu->m;
+    HvPerCpu *pcs = cpu->pc_state;
+    int kernel = flags & HV_BLOCK_EL1;
+#define FAIL(k) do { if (m->stats_interval) m->stats.light_fail[k]++; return 0; } while (0)
+    if (!m->chain || va == m->stop_pc || va == m->stop_pc2 || (int)((va >> 55) & 1) != kernel || (va & 3)) FAIL(0);
+    if (pcs->ijc_keyed_count >= (1u << 17) || pcs->ucode_count + 1 >= (1u << HV_UCODE_BITS) / 2) FAIL(1);
+    int table = !kernel ? 0 : (flags & HV_BLOCK_PAN) ? 2 : 1;
+    HvTlbEntry *e = hv_tlb_ent(cpu, (va >> HV_TLB_PAGE_BITS) & (HV_TLB_SIZE - 1), table);
+    if (e->exec_tag != hv_exec_key(va & ~(uint64_t)PAGE_MASK, e->addend)) {
+        /* Not in the TLB (a process switch, or another page took the slot):
+           walk for it here, as hv_tlb_refill does for data. A fault is for the
+           dispatcher to take. */
+        HvWalk w;
+        walk_begin(cpu);
+        hv_mmu_walk(cpu, va, HV_ACC_EXEC, kernel ? 1 : 0, &w);
+        if (!w.fsc) tlb_fill(cpu, va, kernel ? 1 : 0, &w);
+        walk_end(cpu);
+        if (w.fsc || e->exec_tag != hv_exec_key(va & ~(uint64_t)PAGE_MASK, e->addend)) FAIL(2);
+        if (m->stats_interval) m->stats.light_walks++;
+    }
+    const uint8_t *host = (const uint8_t *)(uintptr_t)(va + (uint64_t)e->addend);
+    HvRam *ram = NULL;
+    for (int i = 0; i < m->nram; i++)
+        if ((uint64_t)(host - m->ram[i].host) < m->ram[i].size) ram = &m->ram[i];
+    if (!ram) return 0;
+    uint64_t pa = ram->pa + (uint64_t)(host - ram->host);
+    uint32_t gen = __atomic_load_n(&ram->page_gen[(pa - ram->pa) >> HV_TLB_PAGE_BITS], __ATOMIC_ACQUIRE);
+    /* This CPU's small cache in front of the block hash first (as the dispatcher's lookup). */
+    uint32_t j = (uint32_t)((va >> 2) ^ (va >> 18) ^ ((uint64_t)flags << 13)) & ((1u << HV_JC_BITS) - 1);
+    HvBlock *b = pcs->jc[j].va == va ? pcs->jc[j].b : NULL;
+    if (!(b && b->pa == pa && b->flags == flags && b->gen == gen)) {
+        b = hv_block_find(m, hv_block_hash(va, pa, flags), va, pa, flags, gen);
+        if (!b) FAIL(3);
+#undef FAIL
+        pcs->jc[j].va = va, pcs->jc[j].b = b;
+    }
+    if (m->stats_interval) { /* what the fill replaces, as the dispatcher counts it */
+        uint64_t *t = pcs->ijc + (size_t)(b->flags & (HV_IJC_TABLES - 1)) * (HV_IJC_TABLE_BYTES / 8);
+        uint64_t tag = b->va ^ cpu->ijc_salt[kernel];
+        uint64_t old = t[(size_t)hv_ijc_index(tag) * 2];
+        int k = !old ? 0 : (old >> 48) != (tag >> 48) ? 1 : 2;
+        if (k == 1) {
+            uint32_t c = (uint32_t)(old >> 48);
+            int live = 0;
+            if (kernel) {
+                uint16_t kg = (uint16_t)(c ^ 0xffff);
+                if (kg == cpu->kernel_gen) live = 1;
+                for (uint32_t si = 0; !live && si < HV_KTTBR_SLOTS; si++)
+                    if (cpu->kttbr_map[si].ttbr1 && cpu->kttbr_map[si].kgen == kg) live = 1;
+            } else {
+                live = cpu->asid_cid[cpu->cid_asid[c]] == c;
+            }
+            if (!live) k = 3;
+        }
+        m->stats.light_kind[k]++;
+        m->stats.ijc_light++;
+        if (!kernel) m->stats.light_region[(va - 0x180000000ull) < 0x100000000ull ? 0 : 1]++;
+    }
+    /* Cached only while the TLB still maps it, inside ijc_seq (see hv_ijc_fill_checked). */
+    if (!hv_ijc_fill_checked(cpu, b)) return 0;
+    return b->code;
+}
+
+/* ---- user TLB entries kept across process switches (HvTlbStash) ---- */
+
+/* Forget the stashed entries of address space asid (-1: all). Other CPUs call
+   this on the target's stashes too, between reading and rechecking its
+   walk_seq: saves and restores run inside walk_begin/walk_end, so a TLBI that
+   races one of them falls back to waiting for the target. */
+static void stash_drop(HvPerCpu *p, int asid) {
+    for (int i = 0; i < HV_STASHES; i++) {
+        uint64_t t = __atomic_load_n(&p->stash[i].ttbr0, __ATOMIC_SEQ_CST);
+        if (t && (asid < 0 || !(t >> 48) || (int)(t >> 48) == asid))
+            __atomic_add_fetch(&p->stash[i].gen, 1, __ATOMIC_SEQ_CST);
+    }
+}
+
+void hv_tlb_stash_drop(HvCpu *cpu, int asid) {
+    if (cpu->pc_state) stash_drop(cpu->pc_state, asid);
+}
+
+static int kernel_entry(const HvTlbEntry *e) {
+    if (e->read_tag == HV_TLB_INVALID && e->exec_tag == HV_TLB_INVALID && e->write_tag == HV_TLB_INVALID) return 0;
+    uint64_t tag = e->read_tag != HV_TLB_INVALID ? e->read_tag + HV_TLB_ADJ : e->exec_tag != HV_TLB_INVALID ? hv_exec_key(e->exec_tag, e->addend) : e->write_tag + HV_TLB_ADJ;
+    return (int)((tag >> 55) & 1);
+}
+
+void hv_tlb_flush_kernel(HvCpu *cpu) {
+    if (cpu->m) cpu->m->stats.tlb_flushes++;
+    uint32_t n = cpu->nkernel_fills;
+    cpu->nkernel_fills = 0;
+    if (n <= HV_KERNEL_FILLS) {
+        for (uint32_t k = 0; k < n; k++) {
+            HvTlbEntry *e = &cpu->tlb[0] + cpu->kernel_fills[k];
+            if (kernel_entry(e)) memset(e, 0x80, sizeof *e);
+        }
+        return;
+    }
+    for (int t = 0; t < 3; t++)
+        for (uint32_t i = 0; i < HV_TLB_SIZE; i++) {
+            HvTlbEntry *e = hv_tlb_ent(cpu, i, t);
+            if (kernel_entry(e)) memset(e, 0x80, sizeof *e);
+        }
+}
+
+static int user_entry(const HvTlbEntry *e) {
+    if (e->read_tag == HV_TLB_INVALID && e->exec_tag == HV_TLB_INVALID && e->write_tag == HV_TLB_INVALID) return 0;
+    uint64_t tag = e->read_tag != HV_TLB_INVALID ? e->read_tag + HV_TLB_ADJ : e->exec_tag != HV_TLB_INVALID ? hv_exec_key(e->exec_tag, e->addend) : e->write_tag + HV_TLB_ADJ;
+    return !((tag >> 55) & 1);
+}
+
+static HvRam *ram_of_host(HvMachine *m, const uint8_t *host) {
+    for (int i = 0; i < m->nram; i++)
+        if ((uint64_t)(host - m->ram[i].host) < m->ram[i].size) return &m->ram[i];
+    return NULL;
+}
+
+/* Active user key (hv_mmu_ukey) went from old to now: keep old's user entries
+   aside, drop them from the TLB, and bring back now's if they were kept and no
+   TLBI touched them since. */
+void hv_tlb_switch_user(HvCpu *cpu, uint64_t old, uint64_t now) {
+    HvPerCpu *p = cpu->pc_state;
+    HvMachine *m = cpu->m;
+    if (old == now) return;
+    static int no_stash = -1; /* HV_NO_STASH: a switch just drops the user entries */
+    if (no_stash < 0) no_stash = getenv("HV_NO_STASH") != NULL;
+    if (!p || !m || m->watch_va || m->watch_pa || no_stash) {
+        hv_tlb_flush_user(cpu);
+        return;
+    }
+    walk_begin(cpu);
+    m->stats.tlb_flushes++;
+    uint32_t n = cpu->nuser_fills;
+    cpu->nuser_fills = 0;
+    HvTlbStash *s = NULL;
+    if (old && n > 0 && n <= HV_STASH_CAP) {
+        for (int i = 0; i < HV_STASHES && !s; i++)
+            if (p->stash[i].ttbr0 == old) s = &p->stash[i];
+        for (int i = 0; i < HV_STASHES && !s; i++)
+            if (!p->stash[i].ttbr0) s = &p->stash[i];
+        if (!s) {
+            s = &p->stash[0];
+            for (int i = 1; i < HV_STASHES; i++)
+                if (p->stash[i].used < s->used) s = &p->stash[i];
+        }
+        __atomic_store_n(&s->ttbr0, old, __ATOMIC_SEQ_CST);
+        s->saved_gen = __atomic_load_n(&s->gen, __ATOMIC_SEQ_CST);
+        s->used = ++p->stash_clock;
+        if (m->stats_interval) m->stats.stash_saves++;
+    }
+    uint32_t k = 0;
+    if (n <= HV_USER_FILLS) {
+        for (uint32_t i = 0; i < n; i++) {
+            uint16_t code = cpu->user_fills[i];
+            HvTlbEntry *e = &cpu->tlb[0] + code;
+            if (!user_entry(e)) continue; /* the slot may hold a kernel page by now */
+            if (s) {
+                s->slot[k] = code;
+                s->ent[k++] = *e;
+            }
+            memset(e, 0x80, sizeof *e);
+        }
+    } else {
+        for (uint32_t i = 0; i < HV_TLB_SIZE; i++)
+            for (int t = 0; t < 3; t++)
+                if (user_entry(hv_tlb_ent(cpu, i, t))) memset(hv_tlb_ent(cpu, i, t), 0x80, sizeof(HvTlbEntry));
+    }
+    if (s) {
+        if (k) s->n = k;
+        else __atomic_store_n(&s->ttbr0, 0, __ATOMIC_SEQ_CST);
+    }
+
+    if (now) {
+        for (int i = 0; i < HV_STASHES; i++) {
+            HvTlbStash *r = &p->stash[i];
+            if (r->ttbr0 != now) continue;
+            int fresh = __atomic_load_n(&r->gen, __ATOMIC_SEQ_CST) == r->saved_gen;
+            __atomic_store_n(&r->ttbr0, 0, __ATOMIC_SEQ_CST); /* used up either way: the live TLB has them now */
+            if (!fresh) break;
+            for (uint32_t j = 0; j < r->n; j++) {
+                HvTlbEntry *e = &cpu->tlb[0] + r->slot[j];
+                *e = r->ent[j];
+                cpu->user_fills[cpu->nuser_fills++] = r->slot[j];
+                if (e->write_tag != HV_TLB_INVALID) {
+                    const uint8_t *host = (const uint8_t *)(uintptr_t)(e->write_tag + HV_TLB_ADJ + e->addend);
+                    HvRam *ram = ram_of_host(m, host);
+                    if (!ram) e->write_tag = HV_TLB_INVALID;
+                    else write_guard(cpu, ram, (uint64_t)(host - ram->host) >> HV_TLB_PAGE_BITS, r->slot[j], e);
+                }
+            }
+            if (m->stats_interval) m->stats.stash_hits++;
+            if (m->stats_interval) m->stats.stash_entries += r->n;
+            break;
+        }
+    }
+    walk_end(cpu);
+}
diff --git a/accel/henge/engine/core/mmu.h b/accel/henge/engine/core/mmu.h
new file mode 100644
index 0000000000..dbc2118b8c
--- /dev/null
+++ b/accel/henge/engine/core/mmu.h
@@ -0,0 +1,96 @@
+#ifndef HENGEVM_MMU_H
+#define HENGEVM_MMU_H
+
+#include <stdint.h>
+#include <stdio.h>
+
+#include "cpu.h"
+
+struct HvRam;
+
+typedef enum { HV_ACC_READ = 0, HV_ACC_WRITE = 1, HV_ACC_EXEC = 2 } HvAccess;
+
+/* Result of a stage 1 translation for the EL1&0 regime. */
+typedef struct HvWalk {
+    uint64_t pa;
+    uint32_t fsc;        /* 0 on success, otherwise the abort's fault status code */
+    int s1ptw;           /* the fault happened reading a table */
+    uint64_t block_size; /* size of the mapping that was found */
+    uint8_t r, w, x;     /* permissions at the EL that was asked about */
+    uint8_t attr;        /* MAIR attribute byte */
+} HvWalk;
+
+/* Fault status codes (ESR ISS DFSC/IFSC). */
+#define HV_FSC_ADDR_SIZE(l)   (0x00 + (l))
+#define HV_FSC_TRANSLATION(l) (0x04 + (l))
+#define HV_FSC_ACCESS(l)      (0x08 + (l))
+#define HV_FSC_PERMISSION(l)  (0x0c + (l))
+#define HV_FSC_EXTERNAL       0x10
+#define HV_FSC_ALIGNMENT      0x21
+
+/* el is the EL whose permissions apply (0 for LDTR/STTR at EL1). */
+void hv_mmu_walk(HvCpu *cpu, uint64_t va, HvAccess acc, int el, HvWalk *out);
+
+void hv_tlb_flush(HvCpu *cpu);
+void hv_tlb_flush_va(HvCpu *cpu, uint64_t va);
+void hv_tlb_flush_user(HvCpu *cpu);
+void hv_kva_hist_dump(FILE *f); /* HV_KVA_HIST, see mmu.c */
+/* A big range of kernel VAs: its kernel entries and cached branch targets, not every process's entries. */
+void hv_tlb_flush_kernel_range(HvCpu *cpu, uint64_t va, uint64_t len);
+void hv_tlb_flush_user_range(HvCpu *cpu, uint64_t va, uint64_t len);
+uint64_t hv_mmu_ukey(const HvCpu *cpu);
+void hv_tlb_switch_user(HvCpu *cpu, uint64_t old_ukey, uint64_t new_ukey); /* a process switch */
+void hv_tlb_flush_kernel(HvCpu *cpu);
+void hv_tlb_stash_drop(HvCpu *cpu, int asid); /* asid -1: all */
+/* Empty the indirect-branch cache for all user (0) or for kernel (1) VAs. */
+void hv_ijc_reset(HvCpu *cpu, int kernel);
+void hv_ijc_switch_kernel(HvCpu *cpu, uint64_t new_ttbr1);
+/* The indirect-branch cache slot of a tag (VA ^ salt); translated code computes the same. */
+/* The cache is two-way: a tag's set is two entries, this one (way 0, the one
+   filled last) and the next. */
+static inline uint32_t hv_ijc_index(uint64_t tag) {
+    return (uint32_t)(((tag ^ tag >> 16 ^ tag >> 46) >> 2) & ((1u << (HV_IJC_BITS - 1)) - 1)) << 1;
+}
+static inline uint32_t hv_ijc_key(uint64_t va, uint64_t salt) {
+    return (uint32_t)(((va >> HV_TLB_PAGE_BITS) * 0x9e3779b97f4a7c15ull ^ (salt >> 48) * 0xc2b2ae3d27d4eb4full) >> 44);
+}
+static inline uint32_t hv_large_2m_bit(uint64_t va) {
+    return (uint32_t)(((va >> 21) * 0x9e3779b97f4a7c15ull) >> 52); /* 0..4095 */
+}
+static inline uint32_t hv_large_big_bit(uint64_t va) {
+    return (uint32_t)(((va >> 30) * 0x9e3779b97f4a7c15ull) >> 55); /* 0..511 */
+}
+/* Forget one address space's cached user targets. */
+void hv_ijc_drop_asid(HvCpu *cpu, uint16_t asid);
+/* TTBR0 changed: use the new address space's user entries. */
+void hv_ijc_switch(HvCpu *cpu);
+void hv_tlb_flush_va_asid(HvCpu *cpu, uint64_t va, int asid); /* asid -1: every address space */
+void hv_ijc_drop_va(HvCpu *cpu, uint64_t va, int asid);
+/* Translated code's TLB miss: walk and fill without the full helper (see mmu.c). */
+int hv_tlb_refill(HvCpu *cpu, uint64_t va, uint32_t flags);
+struct HvBlock;
+void hv_ijc_fill(HvCpu *cpu, struct HvBlock *b);
+int hv_ijc_fill_checked(HvCpu *cpu, struct HvBlock *b); /* only if the TLB still maps it (0: not cached) */
+void *hv_ijc_resolve(HvCpu *cpu, uint64_t va, uint32_t flags);
+/* Another CPU's TLBI of one page: drop target's entries for it from here. 1 if
+   that is enough (no page walk of target's raced it), 0 if target must do it
+   itself and be waited for. Its branch cache is still target's own business. */
+/* asid -1: all. 1: done; 0: raced the target's own page walk or cache fill
+   (try again); -1: the target has to do it itself. */
+int hv_tlbi_drop_remote_va(HvCpu *target, uint64_t va, int asid);       /* just the cached branch targets in the page */
+void hv_ijc_drop_range(HvCpu *cpu, uint64_t va, uint64_t len, int asid);
+void hv_ucode_add(HvCpu *cpu, uint64_t va); /* a user target was cached in this page (current address space) */
+void hv_tlb_protect_code(HvCpu *cpu, const uint8_t *host_page);
+void hv_tlb_protect_code_page(HvCpu *cpu, struct HvRam *ram, uint64_t pg); /* the same, through the page's write hints */
+
+/* Translates for a C access of `len` bytes that stays inside one 16 KB page,
+   filling the TLB when the page is ordinary RAM. Returns 0 and sets *pa, or the
+   fault status code. */
+uint32_t hv_mmu_access(HvCpu *cpu, uint64_t va, HvAccess acc, int el, uint64_t *pa);
+
+/* For the dispatcher: host pointer to the guest instructions at va and how many
+   can be read before the page ends. On a fault, the instruction abort is taken
+   and NULL is returned. */
+const uint32_t *hv_mmu_fetch(HvCpu *cpu, uint64_t va, uint64_t *pa, uint32_t *avail);
+
+#endif
diff --git a/accel/henge/engine/core/operands.c b/accel/henge/engine/core/operands.c
new file mode 100644
index 0000000000..e899def595
--- /dev/null
+++ b/accel/henge/engine/core/operands.c
@@ -0,0 +1,87 @@
+#include "operands.h"
+
+/* Follows the A64 encoding index. Only the copied groups are decoded here:
+   data processing (immediate), data processing (register), and SIMD/FP. */
+
+static uint32_t dp_immediate(uint32_t insn) {
+    uint32_t op = (insn >> 23) & 7;
+    switch (op) {
+    case 2: { /* add/sub (immediate): Rd is SP unless flags are set; Rn is SP */
+        uint32_t s = (insn >> 29) & 1;
+        return HV_FIELD_RD | HV_FIELD_RN | HV_FIELD_RN_SP | (s ? 0 : HV_FIELD_RD_SP);
+    }
+    case 4: { /* logical (immediate): Rd is SP unless ANDS */
+        uint32_t opc = (insn >> 29) & 3;
+        return HV_FIELD_RD | HV_FIELD_RN | (opc == 3 ? 0 : HV_FIELD_RD_SP);
+    }
+    case 5: /* move wide */
+        return HV_FIELD_RD;
+    case 6: /* bitfield */
+        return HV_FIELD_RD | HV_FIELD_RN;
+    case 7: /* extract */
+        return HV_FIELD_RD | HV_FIELD_RN | HV_FIELD_RM;
+    default:
+        return 0;
+    }
+}
+
+static uint32_t dp_register(uint32_t insn) {
+    uint32_t op1 = (insn >> 28) & 1;
+    uint32_t op2 = (insn >> 21) & 0xf;
+    if (op1 == 0) {
+        if ((op2 & 0x9) == 0x9) { /* add/sub (extended register) */
+            uint32_t s = (insn >> 29) & 1;
+            return HV_FIELD_RD | HV_FIELD_RN | HV_FIELD_RM | HV_FIELD_RN_SP | (s ? 0 : HV_FIELD_RD_SP);
+        }
+        /* logical (shifted register), add/sub (shifted register) */
+        return HV_FIELD_RD | HV_FIELD_RN | HV_FIELD_RM;
+    }
+    if (op2 == 0x2) { /* conditional compare: Rm is an immediate when bit 11 is set */
+        return HV_FIELD_RN | (((insn >> 11) & 1) ? 0 : HV_FIELD_RM);
+    }
+    if (op2 == 0x6 && ((insn >> 30) & 1)) { /* data processing (1 source): Rm holds opcode2 */
+        return HV_FIELD_RD | HV_FIELD_RN;
+    }
+    if (op2 & 0x8) { /* data processing (3 source) */
+        return HV_FIELD_RD | HV_FIELD_RN | HV_FIELD_RM | HV_FIELD_RA;
+    }
+    if (op2 == 0x0 && ((insn >> 10) & 0x3f) != 0) {
+        /* RMIF, SETF8, SETF16: only Rn is a register. RMIF keeps an immediate in the
+           Rm bits and a flag mask in the Rd bits. */
+        return HV_FIELD_RN;
+    }
+    /* add/sub with carry, flag manipulation, conditional select, 2 source */
+    return HV_FIELD_RD | HV_FIELD_RN | HV_FIELD_RM;
+}
+
+static uint32_t simd_fp(uint32_t insn) {
+    /* Conversion between floating-point and integer. */
+    if ((insn & 0x5f20fc00) == 0x1e200000) {
+        uint32_t opcode = (insn >> 16) & 7;
+        if (opcode == 2 || opcode == 3 || opcode == 7) return HV_FIELD_RN; /* SCVTF, UCVTF, FMOV to FP */
+        return HV_FIELD_RD;
+    }
+    /* Conversion between floating-point and fixed-point. */
+    if ((insn & 0x5f200000) == 0x1e000000) {
+        uint32_t opcode = (insn >> 16) & 7;
+        if (opcode == 2 || opcode == 3) return HV_FIELD_RN;
+        return HV_FIELD_RD;
+    }
+    /* Advanced SIMD copy: DUP (general), INS (general), SMOV, UMOV. */
+    if ((insn & 0x9fe08400) == 0x0e000400) {
+        uint32_t imm4 = (insn >> 11) & 0xf;
+        uint32_t op = (insn >> 29) & 1;
+        if (op == 0 && (imm4 == 1 || imm4 == 3)) return HV_FIELD_RN;
+        if (op == 0 && (imm4 == 5 || imm4 == 7)) return HV_FIELD_RD;
+        return 0;
+    }
+    return 0;
+}
+
+uint32_t hv_gpr_fields(uint32_t insn) {
+    uint32_t op0 = (insn >> 25) & 0xf;
+    if ((op0 & 0xe) == 0x8) return dp_immediate(insn);
+    if ((op0 & 0x7) == 0x5) return dp_register(insn);
+    if ((op0 & 0x7) == 0x7) return simd_fp(insn);
+    return 0; /* hints: no registers */
+}
diff --git a/accel/henge/engine/core/operands.h b/accel/henge/engine/core/operands.h
new file mode 100644
index 0000000000..84b3640409
--- /dev/null
+++ b/accel/henge/engine/core/operands.h
@@ -0,0 +1,35 @@
+#ifndef HENGEVM_OPERANDS_H
+#define HENGEVM_OPERANDS_H
+
+#include <stdint.h>
+
+/* Which register fields of a copied instruction name general-purpose registers.
+   Rd is bits 4..0, Rn 9..5, Rm 20..16, Ra 14..10. */
+enum {
+    HV_FIELD_RD = 1u << 0,
+    HV_FIELD_RN = 1u << 1,
+    HV_FIELD_RM = 1u << 2,
+    HV_FIELD_RA = 1u << 3,
+    /* Register 31 in this field is SP rather than the zero register. */
+    HV_FIELD_RD_SP = 1u << 4,
+    HV_FIELD_RN_SP = 1u << 5,
+};
+
+/* For instructions hv_classify calls HV_INSN_COPY. */
+uint32_t hv_gpr_fields(uint32_t insn);
+
+static inline uint32_t hv_field_reg(uint32_t insn, int field) {
+    switch (field) {
+    case 0: return insn & 0x1f;
+    case 1: return (insn >> 5) & 0x1f;
+    case 2: return (insn >> 16) & 0x1f;
+    default: return (insn >> 10) & 0x1f;
+    }
+}
+
+static inline uint32_t hv_field_set(uint32_t insn, int field, uint32_t reg) {
+    static const int shift[4] = {0, 5, 16, 10};
+    return (insn & ~(0x1fu << shift[field])) | ((reg & 0x1f) << shift[field]);
+}
+
+#endif
diff --git a/accel/henge/engine/core/sysreg.c b/accel/henge/engine/core/sysreg.c
new file mode 100644
index 0000000000..17955fb74b
--- /dev/null
+++ b/accel/henge/engine/core/sysreg.c
@@ -0,0 +1,642 @@
+#include "sysreg.h"
+
+#include <mach/mach_time.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "exception.h"
+#include "dispatch.h"
+#include "machine.h"
+#include "memop.h"
+#include "mmu.h"
+#include <stdlib.h>
+
+/* System registers are named by op0:op1:CRn:CRm:op2, which is bits 20..5 of MRS/MSR. */
+#define R(op0, op1, crn, crm, op2) ((op0) << 14 | (op1) << 11 | (crn) << 7 | (crm) << 3 | (op2))
+
+/* ID registers: only features the translator handles. Host features are a
+   superset (Apple M1 and later), so copied instructions always exist. */
+#define ID_AA64PFR0  0x1100000001110011ull /* EL0/EL1 AArch64, FP+AdvSIMD with FP16, GICv3 sysregs, CSV2, CSV3 */
+#define ID_AA64ISAR0 0x0011100110212120ull /* AES+PMULL, SHA1, SHA2/512, CRC32, LSE, RDM, SHA3, DotProd, FHM, FlagM */
+#define ID_AA64ISAR1 0x0000001100211001ull /* DPB, JSCVT, FCMA, LRCPC2, FRINTTS, SB (no PAuth: Cortex-A76 + no-op PAC) */
+#define ID_AA64MMFR0 0x0000000000100025ull /* 48-bit PA, 16-bit ASID, 4K/16K/64K granules */
+#define ID_AA64MMFR1 0x0000000000111000ull /* HPDS, LOR, PAN */
+#define ID_AA64DFR0  0x0000000000000006ull /* Armv8 debug, no PMU */
+#define MIDR         0x414fd0b1ull         /* ARM Cortex-A76 r4p1: recognized by Windows 11 ARM64 ntoskrnl */
+#define CTR_EL0      0x9444c004ull         /* 64-byte lines, PIPT I-cache, IDC */
+#define CLIDR        0x0a200023ull         /* L1 split, L2 unified */
+#define CNTFRQ       24000000ull
+
+static uint64_t counter(void) {
+    return mach_absolute_time(); /* 24 MHz on Apple silicon */
+}
+
+/* counter() in the guest's CNTFRQ domain, minus the epoch.  One 128-bit
+   multiply when the two domains differ, nothing when they do not. */
+static uint64_t guest_ticks(HvCpu *cpu) {
+    return hv_guest_ticks(cpu->m) - cpu->m->timer_epoch;
+}
+
+uint64_t hv_guest_ticks(struct HvMachine *m) {
+    uint64_t c = counter();
+    if (m->timer_scale_den > 1)
+        c = (uint64_t)(((__uint128_t)c * m->timer_scale_num) / m->timer_scale_den);
+    return c;
+}
+
+uint64_t hv_counter(void) {
+    return counter();
+}
+
+/* read_reg/write_reg 的第三个返回值：这个寄存器该由宿主回答。它们拿不到
+   insn/pc，所以把"交给宿主"这件事讲给外层，由外层组装退出。 */
+#define HV_SYSREG_EXTERNAL (-2)
+
+/* The ID / cache-description group: op0=3, CRn=0, no matter the op1/crm/op2.
+   Everything a CPU model declares *about itself* lives there -- MIDR, MPIDR,
+   REVIDR, the whole ID_AA64* set, CTR_EL0, DCZID, CLIDR, AIDR, CCSIDR and the
+   CSSELR that selects which CCSIDR is being asked about.
+
+   Under a host that owns the CPU model these are the host's to answer.  Three
+   separate problems turn out to be the same problem, which is why this is one
+   predicate and not three special cases:
+     - PSCI CPU_ON: QEMU's device tree and the GIC's affinity routing describe
+       MPIDR the way QEMU laid it out; the engine's own layout makes Linux's
+       cpu_logical_map disagree with the secondary entry points.
+     - -cpu max: the engine advertises a fixed Cortex-A76 feature set, so the
+       guest sees a CPU that is not the one QEMU is modelling.
+     - any feature probe: a guest that reads ID_AA64* and gets the engine's
+       answer will refuse to use hardware QEMU would have provided. */
+static int is_id_group(uint32_t reg) {
+    return (reg >> 14) == 3 && ((reg >> 7) & 15) == 0;
+}
+
+/* The generic timer's control surface, as opposed to its counters.  Counters
+   (CNTPCT/CNTVCT) stay with the engine -- they are the hot path and pure
+   arithmetic after the epoch.  CTL/CVAL/TVAL are deadlines, and a deadline
+   only means something to whoever owns the clock that will expire it: under a
+   host that runs its own gtimer, that is the host.  Forwarding them also keeps
+   CVAL and CNTVCT in one tick domain, which is the whole point of #2. */
+static int is_timer_ctl(uint32_t reg) {
+    if ((reg >> 14) != 3 || ((reg >> 11) & 7) != 3 || ((reg >> 7) & 15) != 14)
+        return 0;
+    unsigned crm = (reg >> 3) & 15;
+    return crm == 2 || crm == 3;          /* CNTP_* and CNTV_* */
+}
+
+static int undefined(HvCpu *cpu, uint64_t pc) {
+    hv_raise_undef(cpu, pc);
+    return 1;
+}
+
+/* Timer control: ISTATUS (bit 2) reflects the compare right now. */
+static uint64_t timer_ctl(uint64_t ctl, uint64_t cval, uint64_t now) {
+    ctl &= 3;
+    if ((ctl & 1) && now >= cval) ctl |= 4;
+    return ctl;
+}
+
+/* EL0 is allowed only a few registers, some gated by SCTLR_EL1 / CNTKCTL_EL1. */
+static int el0_allowed(HvCpu *cpu, uint32_t reg, int write) {
+    uint64_t k = cpu->cntkctl_el1;
+    switch (reg) {
+    case R(3, 3, 4, 2, 0): case R(3, 3, 4, 4, 0): case R(3, 3, 4, 4, 1): /* NZCV, FPCR, FPSR */
+    case R(3, 3, 13, 0, 2):                                               /* TPIDR_EL0 */
+    case R(3, 3, 4, 2, 5): case R(3, 3, 4, 2, 6):                         /* DIT, SSBS */
+        return 1;
+    case R(3, 3, 4, 2, 1): return (cpu->sctlr_el1 >> 9) & 1;            /* DAIF: UMA */
+    case R(3, 3, 13, 0, 3): return !write;                               /* TPIDRRO_EL0 */
+    case R(3, 3, 0, 0, 1): return !write && ((cpu->sctlr_el1 >> 15) & 1); /* CTR_EL0: UCT */
+    case R(3, 3, 0, 0, 7): return !write;                                /* DCZID_EL0 */
+    case R(3, 3, 14, 0, 0): return !write && (k & 3);                    /* CNTFRQ */
+    case R(3, 3, 14, 0, 1): case R(3, 3, 14, 0, 5): return !write && (k & 1);       /* CNTPCT */
+    case R(3, 3, 14, 0, 2): case R(3, 3, 14, 0, 6): return !write && ((k >> 1) & 1); /* CNTVCT */
+    case R(3, 3, 14, 3, 0): case R(3, 3, 14, 3, 1): case R(3, 3, 14, 3, 2): return (k >> 8) & 1; /* CNTV_* */
+    case R(3, 3, 14, 2, 0): case R(3, 3, 14, 2, 1): case R(3, 3, 14, 2, 2): return (k >> 9) & 1; /* CNTP_* */
+    case R(3, 3, 9, 13, 0): return !write;                               /* PMCCNTR_EL0 */
+    default: return 0;
+    }
+}
+
+/* Returns 0 and sets *v, or -1 if the register does not exist. */
+static int read_reg(HvCpu *cpu, uint32_t reg, uint64_t *v) {
+    uint64_t now = counter();
+    HvMachine *m = cpu->m;
+    if (m->sysreg_external && (is_id_group(reg) || is_timer_ctl(reg)))
+        return HV_SYSREG_EXTERNAL;
+    switch (reg) {
+    case R(3, 3, 4, 2, 0): *v = cpu->nzcv & 0xf0000000; return 0;
+    case R(3, 3, 4, 2, 1): *v = cpu->daif; return 0;
+    case R(3, 0, 4, 2, 2): *v = (uint64_t)cpu->el << 2; return 0;      /* CurrentEL */
+    case R(3, 0, 4, 2, 0): *v = cpu->spsel; return 0;
+    case R(3, 0, 4, 2, 3): *v = cpu->pstate_extra & (1u << 22); return 0; /* PAN */
+    case R(3, 0, 4, 2, 4): *v = cpu->pstate_extra & (1u << 23); return 0; /* UAO */
+    case R(3, 3, 4, 2, 5): *v = cpu->pstate_extra & (1u << 24); return 0; /* DIT */
+    case R(3, 3, 4, 2, 6): *v = cpu->pstate_extra & (1u << 12); return 0; /* SSBS */
+    /* FPCR/FPSR live in the host registers while the guest runs (hv_fp_enter). */
+    case R(3, 3, 4, 4, 0): __asm__ volatile("mrs %0, fpcr" : "=r"(*v)); return 0;
+    case R(3, 3, 4, 4, 1): __asm__ volatile("mrs %0, fpsr" : "=r"(*v)); return 0;
+    case R(3, 0, 4, 1, 0): *v = cpu->spsel ? cpu->sp_el0 : cpu->sp; return 0; /* SP_EL0 */
+    case R(3, 0, 4, 0, 0): *v = cpu->spsr_el1; return 0;
+    case R(3, 0, 4, 0, 1): *v = cpu->elr_el1; return 0;
+    case R(3, 0, 1, 0, 0): *v = cpu->sctlr_el1; return 0;
+    case R(3, 0, 1, 0, 1): *v = cpu->actlr_el1; return 0;
+    case R(3, 0, 1, 0, 2): *v = cpu->cpacr_el1; return 0;
+    case R(3, 0, 2, 0, 0): *v = cpu->ttbr0_el1; return 0;
+    case R(3, 0, 2, 0, 1): *v = cpu->ttbr1_el1; return 0;
+    case R(3, 0, 2, 0, 2): *v = cpu->tcr_el1; return 0;
+    case R(3, 0, 5, 1, 0): *v = cpu->afsr0_el1; return 0;
+    case R(3, 0, 5, 1, 1): *v = cpu->afsr1_el1; return 0;
+    case R(3, 0, 5, 2, 0): *v = cpu->esr_el1; return 0;
+    case R(3, 0, 6, 0, 0): *v = cpu->far_el1; return 0;
+    case R(3, 0, 7, 4, 0): *v = cpu->par_el1; return 0;
+    case R(3, 0, 10, 2, 0): *v = cpu->mair_el1; return 0;
+    case R(3, 0, 10, 3, 0): *v = cpu->amair_el1; return 0;
+    case R(3, 0, 12, 0, 0): *v = cpu->vbar_el1; return 0;
+    case R(3, 0, 12, 1, 0): /* ISR_EL1: interrupts pending at the CPU, masked or not */
+        *v = (hv_irq_line(cpu, 0) ? 1u << 7 : 0) | (hv_irq_line(cpu, 1) ? 1u << 6 : 0);
+        return 0;
+    case R(3, 0, 13, 0, 1): *v = cpu->contextidr_el1; return 0;
+    case R(3, 0, 13, 0, 4): *v = cpu->tpidr_el1; return 0;
+    case R(3, 3, 13, 0, 2): *v = cpu->tpidr_el0; return 0;
+    case R(3, 3, 13, 0, 3): *v = cpu->tpidrro_el0; return 0;
+    case R(3, 0, 14, 1, 0): *v = cpu->cntkctl_el1; return 0;
+    case R(2, 0, 0, 2, 2): *v = cpu->mdscr_el1; return 0;
+    case R(2, 0, 1, 1, 4): *v = 0x8; return 0;                           /* OSLSR_EL1: OS lock implemented, unlocked */
+    case R(3, 2, 0, 0, 0): *v = cpu->csselr_el1; return 0;
+
+    /* Identification */
+    case R(3, 0, 0, 0, 0): *v = MIDR; return 0;
+    case R(3, 0, 0, 0, 5): *v = cpu->mpidr; return 0;
+    case R(3, 0, 0, 0, 6): *v = 0; return 0;                             /* REVIDR */
+    case R(3, 0, 0, 4, 0): *v = ID_AA64PFR0; return 0;
+    case R(3, 0, 0, 5, 0): *v = ID_AA64DFR0; return 0;
+    case R(3, 0, 0, 6, 0): *v = ID_AA64ISAR0; return 0;
+    case R(3, 0, 0, 6, 1): *v = ID_AA64ISAR1; return 0;
+    case R(3, 0, 0, 7, 0): *v = ID_AA64MMFR0; return 0;
+    case R(3, 0, 0, 7, 1): *v = ID_AA64MMFR1; return 0;
+    case R(3, 3, 0, 0, 1): *v = CTR_EL0; return 0;
+    case R(3, 3, 0, 0, 7): *v = 4; return 0;                             /* DCZID: 64-byte DC ZVA */
+    case R(3, 1, 0, 0, 1): *v = CLIDR; return 0;
+    case R(3, 1, 0, 0, 7): *v = 0; return 0;                             /* AIDR */
+    case R(3, 1, 0, 0, 0):                                               /* CCSIDR for CSSELR's level */
+        *v = (cpu->csselr_el1 >> 1) == 0 ? (127u << 13 | 7u << 3 | 2) : (2047u << 13 | 15u << 3 | 2);
+        return 0;
+
+    /* Generic timer */
+    case R(3, 3, 14, 0, 0): *v = m->timer_freq ? m->timer_freq : CNTFRQ; return 0;
+    case R(3, 3, 14, 0, 1): case R(3, 3, 14, 0, 5): *v = guest_ticks(cpu); return 0;
+    case R(3, 3, 14, 0, 2): case R(3, 3, 14, 0, 6): *v = guest_ticks(cpu) - cpu->cntvoff; return 0;
+    case R(3, 3, 14, 2, 0): *v = (uint32_t)(cpu->cntp_cval - now); return 0;
+    case R(3, 3, 14, 2, 1): *v = timer_ctl(cpu->cntp_ctl, cpu->cntp_cval, now); return 0;
+    case R(3, 3, 14, 2, 2): *v = cpu->cntp_cval; return 0;
+    case R(3, 3, 14, 3, 0): *v = (uint32_t)(cpu->cntv_cval - (now - cpu->cntvoff)); return 0;
+    case R(3, 3, 14, 3, 1): *v = timer_ctl(cpu->cntv_ctl, cpu->cntv_cval, now - cpu->cntvoff); return 0;
+    case R(3, 3, 14, 3, 2): *v = cpu->cntv_cval; return 0;
+
+    /* PMU cycle counter: Windows 11 24H2 ntoskrnl calibrates against PMCCNTR_EL0 at boot. */
+    case R(3, 3, 9, 13, 0): *v = now * 128ull; return 0;                 /* ~3.072 GHz from 24 MHz counter */
+    }
+    /* GIC CPU interface (ICC_*_EL1): CRn 12, CRm 8..12, and ICC_PMR_EL1.
+       With a host that owns the GIC, hand the register over instead: the
+       icc_read hook is the *standalone* GIC's, and answering 0 from it when
+       nobody installed one is worse than refusing -- the guest concludes the
+       interface exists and is broken rather than absent. */
+    if (reg == R(3, 0, 4, 6, 0) || ((reg >> 14) == 3 && ((reg >> 11) & 7) == 0 && ((reg >> 7) & 15) == 12 && ((reg >> 3) & 15) >= 8)) {
+        if (m->icc_external) return HV_SYSREG_EXTERNAL;
+        *v = m->icc_read ? m->icc_read(m, cpu, reg) : 0; /* the GIC locks itself */
+        return 0;
+    }
+    /* The rest of the ID space reads as zero; so do debug, PMU (CRn 9 and CRn 14 CRm 8..15), LOR, and RAS registers. */
+    if ((reg >> 14) == 3 && ((reg >> 11) & 7) == 0 && ((reg >> 7) & 15) == 0 && ((reg >> 3) & 15) >= 1) {
+        *v = 0;
+        return 0;
+    }
+    if ((reg >> 14) == 2 ||
+        ((reg >> 14) == 3 && ((reg >> 7) & 15) == 9) ||
+        ((reg >> 14) == 3 && ((reg >> 11) & 7) == 3 && ((reg >> 7) & 15) == 14 && ((reg >> 3) & 15) >= 8) ||
+        ((reg >> 14) == 3 && ((reg >> 11) & 7) == 0 && ((reg >> 7) & 15) == 10 && ((reg >> 3) & 15) == 4) ||
+        ((reg >> 14) == 3 && ((reg >> 11) & 7) == 0 && ((reg >> 7) & 15) == 5 && ((reg >> 3) & 15) == 3) ||
+        reg == R(3, 0, 12, 1, 1)) {
+        *v = 0;
+        return 0;
+    }
+    /* Apple implementation-defined registers (op0 3, CRn 15). The vmapple
+       kernel reads error-status registers there (S3_6_C15_C0_0, S3_3_C15_C8_0..)
+       when it reports a machine error; zero means no error recorded. */
+    if ((reg >> 14) == 3 && ((reg >> 7) & 15) == 15) {
+        if (m->log) fprintf(stderr, "hengevm: read of implementation-defined S3_%u_C15_C%u_%u = 0\n", (reg >> 11) & 7,
+                            (reg >> 3) & 15, reg & 7);
+        *v = 0;
+        return 0;
+    }
+    return -1;
+}
+
+static int write_reg(HvCpu *cpu, uint32_t reg, uint64_t v) {
+    HvMachine *m = cpu->m;
+    if (m->sysreg_external && (is_id_group(reg) || is_timer_ctl(reg)))
+        return HV_SYSREG_EXTERNAL;
+    switch (reg) {
+    case R(3, 3, 4, 2, 0): cpu->nzcv = v & 0xf0000000; return 0;
+    case R(3, 3, 4, 2, 1): cpu->daif = v & HV_PSTATE_DAIF; return 0;
+    case R(3, 0, 4, 2, 0): hv_sp_switch(cpu, cpu->el, v & 1); return 0;
+    case R(3, 0, 4, 2, 3): hv_pstate_set(cpu, (hv_pstate_get(cpu) & ~(1ull << 22)) | (v & (1u << 22))); return 0;
+    case R(3, 0, 4, 2, 4): cpu->pstate_extra = (cpu->pstate_extra & ~(1ull << 23)) | (v & (1u << 23)); return 0;
+    case R(3, 3, 4, 2, 5): cpu->pstate_extra = (cpu->pstate_extra & ~(1ull << 24)) | (v & (1u << 24)); return 0;
+    case R(3, 3, 4, 2, 6): cpu->pstate_extra = (cpu->pstate_extra & ~(1ull << 12)) | (v & (1u << 12)); return 0;
+    case R(3, 3, 4, 4, 0): v &= 0x07ff9f00; __asm__ volatile("msr fpcr, %0" ::"r"(v)); return 0;
+    case R(3, 3, 4, 4, 1): v &= 0xf800009f; __asm__ volatile("msr fpsr, %0" ::"r"(v)); return 0;
+    case R(3, 0, 4, 1, 0):
+        if (!cpu->spsel) return -1; /* SP_EL0 is not accessible as a sysreg while it is the SP */
+        cpu->sp_el0 = v;
+        return 0;
+    case R(3, 0, 4, 0, 0): cpu->spsr_el1 = v; return 0;
+    case R(3, 0, 4, 0, 1): cpu->elr_el1 = v; return 0;
+    case R(3, 0, 1, 0, 0): { /* SCTLR: xnu flips the PAC enables (EnIA/IB/DA/DB) on every process switch */
+        uint64_t changed = cpu->sctlr_el1 ^ v;
+        cpu->sctlr_el1 = v;
+        if (changed & (1u | 1u << 19 | 1u << 24 | 1u << 25)) { /* M, WXN, E0E, EE: what translations depend on */
+            hv_tlb_flush(cpu);
+            __atomic_store_n(&cpu->exit_req, 1, __ATOMIC_RELAXED); /* the block's chained exit must not follow the old mapping */
+        }
+        return 0;
+    }
+    case R(3, 0, 1, 0, 1): cpu->actlr_el1 = v; return 0;
+    case R(3, 0, 1, 0, 2): cpu->cpacr_el1 = v; return 0;
+    case R(3, 0, 2, 0, 0): { /* a process switch */
+        uint64_t old = cpu->ttbr0_el1, old_ukey = hv_mmu_ukey(cpu);
+        cpu->ttbr0_el1 = v;
+        uint64_t new_ukey = hv_mmu_ukey(cpu);
+        if (old_ukey != new_ukey) hv_tlb_switch_user(cpu, old_ukey, new_ukey);
+        else if (old != v) hv_tlb_flush_user(cpu);
+        if (old != v) hv_ijc_switch(cpu);
+        return 0;
+    }
+    case R(3, 0, 2, 0, 1): { /* TTBR1: Windows switches TTBR1 per process (with TCR.A1 == 1) and on KVA shadow transitions */
+        uint64_t old = cpu->ttbr1_el1, old_ukey = hv_mmu_ukey(cpu);
+        cpu->ttbr1_el1 = v;
+        if (old != v) {
+            hv_tlb_flush_kernel(cpu);
+            hv_ijc_switch_kernel(cpu, v);
+        }
+        if ((cpu->tcr_el1 >> 22) & 1) {
+            uint64_t new_ukey = hv_mmu_ukey(cpu);
+            if (old_ukey != new_ukey) hv_tlb_switch_user(cpu, old_ukey, new_ukey);
+            else if ((old ^ v) >> 48) hv_tlb_flush_user(cpu);
+            if ((old ^ v) >> 48) hv_ijc_switch(cpu);
+        }
+        return 0;
+    }
+    case R(3, 0, 2, 0, 2):
+        if (cpu->tcr_el1 != v) {
+            cpu->tcr_el1 = v;
+            hv_tlb_flush(cpu);
+        }
+        return 0;
+    case R(3, 0, 5, 1, 0): cpu->afsr0_el1 = v; return 0;
+    case R(3, 0, 5, 1, 1): cpu->afsr1_el1 = v; return 0;
+    case R(3, 0, 5, 2, 0): cpu->esr_el1 = v; return 0;
+    case R(3, 0, 6, 0, 0): cpu->far_el1 = v; return 0;
+    case R(3, 0, 7, 4, 0): cpu->par_el1 = v; return 0;
+    case R(3, 0, 10, 2, 0):
+        if (cpu->mair_el1 != v) {
+            cpu->mair_el1 = v;
+            hv_tlb_flush(cpu);
+        }
+        return 0;
+    case R(3, 0, 10, 3, 0): cpu->amair_el1 = v; return 0;
+    case R(3, 0, 12, 0, 0): cpu->vbar_el1 = v & ~0x7ffull; return 0;
+    case R(3, 0, 13, 0, 1): cpu->contextidr_el1 = v; return 0;
+    case R(3, 0, 13, 0, 4): cpu->tpidr_el1 = v; return 0;
+    case R(3, 3, 13, 0, 2): cpu->tpidr_el0 = v; return 0;
+    case R(3, 3, 13, 0, 3): cpu->tpidrro_el0 = v; return 0;
+    case R(3, 0, 14, 1, 0): cpu->cntkctl_el1 = v; cpu->el0_cnt = (uint32_t)(v & 3); return 0;
+    case R(2, 0, 0, 2, 2): cpu->mdscr_el1 = v; return 0;
+    case R(3, 2, 0, 0, 0): cpu->csselr_el1 = v & 0xf; return 0;
+    case R(3, 3, 14, 2, 0):
+        cpu->cntp_cval = counter() + (uint64_t)(int64_t)(int32_t)v;
+        if (getenv("HV_CVAL_COUNT"))
+            fprintf(stderr, "henge-ptval: cpu%u val=%llx pc=%llx\n",
+                    cpu->index, (unsigned long long)v, (unsigned long long)cpu->pc);
+        break;
+    case R(3, 3, 14, 2, 1):
+        cpu->cntp_ctl = v & 3;
+        if (getenv("HV_CVAL_COUNT"))
+            fprintf(stderr, "henge-pctl: cpu%u ctl=%llx pc=%llx\n",
+                    cpu->index, (unsigned long long)cpu->cntp_ctl, (unsigned long long)cpu->pc);
+        break;
+    case R(3, 3, 14, 2, 2): cpu->cntp_cval = v; break;
+    case R(3, 3, 14, 3, 0):
+        cpu->cntv_cval = counter() - cpu->cntvoff + (uint64_t)(int64_t)(int32_t)v;
+        {
+            static int on = -1;
+            static unsigned n[HV_MAX_CPUS];
+            unsigned ci = cpu->index < HV_MAX_CPUS ? cpu->index : 0;
+            if (on < 0) on = getenv("HV_CVAL_COUNT") != NULL;
+            if (on && (n[ci]++ % 32) == 0)
+                fprintf(stderr, "henge-tval: cpu%u n=%u val=%llx pc=%llx\n",
+                        ci, n[ci], (unsigned long long)v, (unsigned long long)cpu->pc);
+        }
+        break;
+    case R(3, 3, 14, 3, 1):
+        cpu->cntv_ctl = v & 3;
+        if (getenv("HV_CVAL_COUNT"))
+            fprintf(stderr, "henge-ctl: cpu%u ctl=%llx pc=%llx\n",
+                    cpu->index, (unsigned long long)cpu->cntv_ctl, (unsigned long long)cpu->pc);
+        break;
+    case R(3, 3, 14, 3, 2):
+        cpu->cntv_cval = v;
+        {
+            static int on = -1;
+            static unsigned n[HV_MAX_CPUS];
+            unsigned ci = cpu->index < HV_MAX_CPUS ? cpu->index : 0;
+            if (on < 0) on = getenv("HV_CVAL_COUNT") != NULL;
+            if (on && (n[ci]++ % 32) == 0)
+                fprintf(stderr, "henge-cval: cpu%u n=%u val=%llx pc=%llx\n",
+                        ci, n[ci], (unsigned long long)v, (unsigned long long)cpu->pc);
+        }
+        break;
+    default: goto other;
+    }
+    /* Timer outputs follow their registers at once, as in hardware: a masked
+       timer must drop its line before the handler's EOI. */
+    if (m->tick) m->tick(m, cpu);
+    return 0;
+other:
+    /* PAuth key registers (CRn 2, CRm 1..3): kept, never used, since signing is a no-op. */
+    if ((reg >> 14) == 3 && ((reg >> 11) & 7) == 0 && ((reg >> 7) & 15) == 2 && ((reg >> 3) & 15) >= 1 &&
+        ((reg >> 3) & 15) <= 3)
+        return 0;
+    if (reg == R(3, 0, 4, 6, 0) ||
+        ((reg >> 14) == 3 && ((reg >> 11) & 7) == 0 && ((reg >> 7) & 15) == 12 && ((reg >> 3) & 15) >= 8)) {
+        /* Same seam as the read side: the host's GIC owns these. */
+        if (m->icc_external) return HV_SYSREG_EXTERNAL;
+        if (m->icc_write) m->icc_write(m, cpu, reg, v);
+        return 0;
+    }
+    /* Debug, PMU (CRn 9 and CRn 14 CRm 8..15 including PMCCFILTR_EL0), LOR, and RAS registers: ignored. */
+    if ((reg >> 14) == 2 ||
+        ((reg >> 14) == 3 && ((reg >> 7) & 15) == 9) ||
+        ((reg >> 14) == 3 && ((reg >> 11) & 7) == 3 && ((reg >> 7) & 15) == 14 && ((reg >> 3) & 15) >= 8) ||
+        ((reg >> 14) == 3 && ((reg >> 11) & 7) == 0 && ((reg >> 7) & 15) == 10 && ((reg >> 3) & 15) == 4) ||
+        ((reg >> 14) == 3 && ((reg >> 11) & 7) == 0 && ((reg >> 7) & 15) == 5 && ((reg >> 3) & 15) == 3) ||
+        reg == R(3, 0, 12, 1, 1))
+        return 0;
+    /* Apple implementation-defined registers (op0 3, CRn 15): ignored, see read_reg. */
+    if ((reg >> 14) == 3 && ((reg >> 7) & 15) == 15) {
+        if (m->log) fprintf(stderr, "hengevm: write to implementation-defined S3_%u_C15_C%u_%u ignored\n", (reg >> 11) & 7,
+                            (reg >> 3) & 15, reg & 7);
+        return 0;
+    }
+    return -1;
+}
+
+/* PAuth keys read back as zero. */
+static int is_pauth_key(uint32_t reg) {
+    return (reg >> 14) == 3 && ((reg >> 11) & 7) == 0 && ((reg >> 7) & 15) == 2 && ((reg >> 3) & 15) >= 1 &&
+           ((reg >> 3) & 15) <= 3;
+}
+
+/* Hand an unmodelled access to the host: leave the block with the instruction
+   still pending, pc unmoved, so the host can answer it and resume. */
+static int sysreg_external(HvCpu *cpu, uint32_t insn, uint64_t pc) {
+    cpu->exit_insn = insn;
+    cpu->pc = pc;
+    cpu->exit_reason = HV_EXIT_SYSREG_EXT;
+    return 1;
+}
+
+int hv_sysreg_mrs(HvCpu *cpu, uint32_t insn, uint64_t pc) {
+    uint32_t reg = (insn >> 5) & 0xffff;
+    int rt = insn & 0x1f;
+    if (cpu->el == 0 && !el0_allowed(cpu, reg, 0)) return undefined(cpu, pc);
+    uint64_t v;
+    if (is_pauth_key(reg)) v = 0;
+    else {
+        int r = read_reg(cpu, reg, &v);
+        if (r == HV_SYSREG_EXTERNAL) return sysreg_external(cpu, insn, pc);
+        if (r != 0)
+            return cpu->m->sysreg_external ? sysreg_external(cpu, insn, pc) : undefined(cpu, pc);
+    }
+    if (cpu->m->log >= 3)
+        fprintf(stderr, "mrs S%u_%u_C%u_C%u_%u = %llx pc %llx el%u\n", reg >> 14, (reg >> 11) & 7, (reg >> 7) & 15,
+                (reg >> 3) & 15, reg & 7, (unsigned long long)v, (unsigned long long)pc, cpu->el);
+    if (rt != 31) cpu->x[rt] = v;
+    return 0;
+}
+
+/* Blocks carry on after most MSRs (see the translator), so an interrupt this
+   write let through (unmasking, or a GIC register raising a line) must make
+   the block leave at its next exit for the dispatcher to take it. */
+static void irq_check(HvCpu *cpu) {
+    HvMachine *m = cpu->m;
+    HvPerCpu *p = cpu->pc_state;
+    (void)m;
+    if (p && ((hv_irq_line(cpu, 0) && !(cpu->daif & HV_PSTATE_I)) ||
+              (hv_irq_line(cpu, 1) && !(cpu->daif & HV_PSTATE_F)))) {
+        hv_irqtrace(cpu, HV_IT_UNMASK, cpu->pc, cpu->daif,
+                    (hv_irq_line(cpu, 0) ? 1 : 0) | (hv_irq_line(cpu, 1) ? 2 : 0), 0);
+        __atomic_store_n(&cpu->exit_req, 1, __ATOMIC_RELAXED);
+        if (m->stats_interval) m->stats.kick_src[4]++;
+    }
+}
+
+int hv_sysreg_msr(HvCpu *cpu, uint32_t insn, uint64_t pc) {
+    if (((insn >> 19) & 3) == 0) { /* MSR (immediate) to a PSTATE field */
+        uint32_t op1 = (insn >> 16) & 7, op2 = (insn >> 5) & 7, imm = (insn >> 8) & 0xf;
+        uint32_t field = op1 << 3 | op2;
+        if (cpu->el == 0 && field != 036 && field != 037 && field != 031 && field != 032) return undefined(cpu, pc);
+        if (cpu->el == 0 && (field == 036 || field == 037) && !((cpu->sctlr_el1 >> 9) & 1)) return undefined(cpu, pc);
+        switch (field) {
+        case 005: hv_sp_switch(cpu, cpu->el, imm & 1); break;                       /* SPSel */
+        case 036: cpu->daif |= (uint64_t)imm << 6; break;                           /* DAIFSet */
+        case 037: cpu->daif &= ~((uint64_t)imm << 6); break;                        /* DAIFClr */
+        case 004: write_reg(cpu, R(3, 0, 4, 2, 3), (uint64_t)(imm & 1) << 22); break; /* PAN */
+        case 003: write_reg(cpu, R(3, 0, 4, 2, 4), (uint64_t)(imm & 1) << 23); break; /* UAO */
+        case 032: write_reg(cpu, R(3, 3, 4, 2, 5), (uint64_t)(imm & 1) << 24); break; /* DIT */
+        case 031: write_reg(cpu, R(3, 3, 4, 2, 6), (uint64_t)(imm & 1) << 12); break; /* SSBS */
+        default: return undefined(cpu, pc);
+        }
+        irq_check(cpu);
+        return 0;
+    }
+    uint32_t reg = (insn >> 5) & 0xffff;
+    int rt = insn & 0x1f;
+    if (cpu->m->log >= 3)
+        fprintf(stderr, "msr S%u_%u_C%u_C%u_%u = %llx pc %llx el%u\n", reg >> 14, (reg >> 11) & 7, (reg >> 7) & 15,
+                (reg >> 3) & 15, reg & 7, (unsigned long long)(rt == 31 ? 0 : cpu->x[rt]), (unsigned long long)pc,
+                cpu->el);
+    if (cpu->el == 0 && !el0_allowed(cpu, reg, 1)) return undefined(cpu, pc);
+    {
+        int r = write_reg(cpu, reg, rt == 31 ? 0 : cpu->x[rt]);
+        if (r == HV_SYSREG_EXTERNAL) return sysreg_external(cpu, insn, pc);
+        if (r != 0)
+            return cpu->m->sysreg_external ? sysreg_external(cpu, insn, pc) : undefined(cpu, pc);
+    }
+    irq_check(cpu);
+    return 0;
+}
+
+static inline int tlbi_asid(const HvCpu *cpu, uint64_t xt) {
+    uint32_t mask = ((cpu->tcr_el1 >> 36) & 1) ? 0xffffu : 0xffu;
+    return (int)((xt >> 48) & mask);
+}
+
+/* One TLBI, applied to one CPU's TLB and indirect-branch cache. */
+void hv_tlbi_apply(HvCpu *cpu, uint32_t op1, uint32_t crn, uint32_t crm, uint32_t op2, uint64_t xt) {
+    uint64_t pc = cpu->pc;
+    int tasid = tlbi_asid(cpu, xt);
+    /* VAE1, VAAE1, VALE1, VAALE1 (and their IS/OS forms) name one page:
+       Xt[43:0] is VA[55:12]. Everything else (all, by ASID, ranges) drops it all. */
+    int by_va = crn == 8 && op1 == 0 && (crm == 1 || crm == 3 || crm == 7) && (op2 & 1);
+    int by_asid = crn == 8 && op1 == 0 && (crm == 1 || crm == 3 || crm == 7) && op2 == 2; /* ASIDE1: non-global (user) entries */
+    /* RVAE1, RVAAE1, RVALE1, RVAALE1 (IS/OS/local): xnu uses these for every
+       multi-page unmap. Xt: ASID[63:48], TG[47:46], SCALE[45:44], NUM[43:39],
+       BaseADDR[36:0] in granule units; (NUM+1) << (5*SCALE+1) granules. */
+    int by_range = crn == 8 && op1 == 0 && (crm == 2 || crm == 5 || crm == 6) && (op2 & 1);
+    if (by_range) {
+        uint32_t tg = (xt >> 46) & 3;
+        int shift = tg == 1 ? 12 : tg == 2 ? 14 : tg == 3 ? 16 : 0;
+        uint64_t pages = (((xt >> 39) & 31) + 1) << (5 * ((xt >> 44) & 3) + 1);
+        int all_asids = op2 == 3 || op2 == 7;
+        /* BaseADDR is VA[36+shift:shift], sign-extended so TTBR1 ranges come out as kernel VAs. */
+        uint64_t va = shift ? (uint64_t)((int64_t)((xt & 0x1fffffffffull) << (64 - 37)) >> (64 - 37 - shift)) : 0;
+        uint64_t len = shift ? pages << shift : 0;
+        if (!shift || len > (256ull << HV_TLB_PAGE_BITS)) {
+            /* Reserved granule: everything. A big range: what of that half lies in it. */
+            if (!shift) hv_tlb_flush(cpu);
+            else if ((va >> 55) & 1) hv_tlb_flush_kernel_range(cpu, va, len);
+            else {
+                hv_tlb_flush_user_range(cpu, va, len);
+                hv_tlb_stash_drop(cpu, all_asids ? -1 : tasid);
+                cpu->m->stats.reset_why[7]++;
+                hv_ijc_drop_range(cpu, va, len, all_asids ? -1 : tasid);
+            }
+        } else {
+            uint64_t first = va & ~((1ull << HV_TLB_PAGE_BITS) - 1);
+            for (uint64_t p = first; p < va + len; p += 1ull << HV_TLB_PAGE_BITS)
+                hv_tlb_flush_va_asid(cpu, p, all_asids ? -1 : tasid);
+        }
+        return;
+    }
+    if (by_va) {
+        uint64_t va = (uint64_t)((int64_t)((xt & 0xfffffffffffull) << 20) >> 8);
+        int all_asids = op2 == 3 || op2 == 7; /* VAAE1, VAALE1 */
+        hv_tlb_flush_va_asid(cpu, va, all_asids ? -1 : tasid);
+    } else if (by_asid) {
+        hv_tlb_flush_user(cpu);
+        hv_tlb_stash_drop(cpu, tasid);
+        hv_tlb_flush_kernel(cpu);
+        hv_ijc_reset(cpu, 1);
+        cpu->m->stats.reset_why[1]++;
+        hv_ijc_drop_asid(cpu, (uint16_t)tasid);
+    } else {
+        if (cpu->m->log >= 2)
+            fprintf(stderr, "tlbi-all S1_%u_C%u_C%u_%u pc %llx\n", op1, crn, crm, op2, (unsigned long long)pc);
+        hv_tlb_flush(cpu);
+    }
+}
+
+/* Translations are never out of date: CPU writes to code pages and device DMA drop them as
+   they happen. So IC IVAU has nothing to do, though xnu issues it for pages nobody wrote, and
+   dropping them there meant translating them all again and every CPU's branch cache starting
+   over. HV_IC_IVAU: as before. */
+int hv_ic_ivau_drops(void) {
+    static int v = -1;
+    if (v < 0) v = getenv("HV_IC_IVAU") != NULL;
+    return v;
+}
+
+int hv_sysreg_sys(HvCpu *cpu, uint32_t insn, uint64_t pc) {
+    uint32_t op1 = (insn >> 16) & 7, crn = (insn >> 12) & 0xf, crm = (insn >> 8) & 0xf, op2 = (insn >> 5) & 7;
+    int rt = insn & 0x1f;
+    uint64_t xt = rt == 31 ? 0 : cpu->x[rt];
+    if (crn == 7 && op1 == 3 && crm == 4 && op2 == 1) { /* DC ZVA */
+        if (cpu->el == 0 && !((cpu->sctlr_el1 >> 14) & 1)) return undefined(cpu, pc);
+        static const uint8_t zero[64];
+        return hv_vmem_xfer(cpu, xt & ~63ull, (void *)zero, 64, 1, cpu->el, pc);
+    }
+    if (crn == 7 && op1 == 3 && crm == 5 && op2 == 1) { /* IC IVAU: just the page holding the address */
+        if (!hv_ic_ivau_drops()) return 0;
+        HvWalk w;
+        hv_mmu_walk(cpu, xt, HV_ACC_READ, cpu->el, &w);
+        if (!w.fsc) hv_invalidate_code(cpu->m, w.pa);
+        return 0;
+    }
+    if (crn == 7 && (crm == 1 || crm == 5)) { /* IC IALLUIS, IALLU */
+        /* Translations are never out of date: CPU writes to code pages and device
+           DMA drop them as they happen. Dropping them all here cost a full round of
+           translating everything again, many times a boot. HV_IC_FLUSH: as before. */
+        static int flush = -1;
+        if (flush < 0) flush = getenv("HV_IC_FLUSH") != NULL;
+        cpu->m->stats.flush_ic++;
+        if (flush) cpu->m->flush_pending = 1;
+        return 0;
+    }
+    if (crn == 7 && crm == 8 && op1 == 0 && op2 <= 3) { /* AT S1E1R, S1E1W, S1E0R, S1E0W */
+        if (cpu->el == 0) return undefined(cpu, pc);
+        HvWalk w;
+        hv_mmu_walk(cpu, xt, (op2 & 1) ? HV_ACC_WRITE : HV_ACC_READ, op2 >= 2 ? 0 : 1, &w);
+        if (w.fsc) cpu->par_el1 = 1 | (uint64_t)w.fsc << 1 | (uint64_t)w.s1ptw << 9 | 1ull << 11;
+        else cpu->par_el1 = (w.pa & 0x0000fffffffff000ull) | (uint64_t)w.attr << 56 | 3u << 7;
+        return 0;
+    }
+    if (crn == 8 || crn == 9) { /* TLBI */
+        if (cpu->el == 0) return undefined(cpu, pc);
+        /* The shareable forms (IS, OS: CRm 1, 2, 3, 5) reach every CPU: each does
+           it to its own TLB, and this one waits until they have (a TLBI has
+           finished for everyone once the DSB after it completes). */
+        HvMachine *m = cpu->m;
+        hv_tlbi_apply(cpu, op1, crn, crm, op2, xt);
+        int broadcast = (crm == 1 || crm == 2 || crm == 3 || crm == 5) && m && m->ncpus > 1;
+        if (broadcast) {
+            /* One page or a small range (the common cases): the others' TLB
+               entries, stashed entries and cached branch targets for it go from
+               here (hv_tlbi_drop_remote_va), with nobody waited for unless a page
+               walk or cache fill of theirs raced; one that may be running code
+               from the page is made to leave its block. */
+            int by_va = crn == 8 && op1 == 0 && (crm == 1 || crm == 3) && (op2 & 1);
+            uint64_t va = (uint64_t)((int64_t)((xt & 0xfffffffffffull) << 20) >> 8);
+            int asid = op2 == 3 || op2 == 7 ? -1 : tlbi_asid(cpu, xt);
+            /* A small range (RVAE1IS and kin): page by page, the same way. */
+            uint64_t npages = 0;
+            int by_range = crn == 8 && op1 == 0 && (crm == 2 || crm == 5) && (op2 & 1);
+            uint32_t tg = (xt >> 46) & 3;
+            int rshift = tg == 1 ? 12 : tg == 2 ? 14 : tg == 3 ? 16 : 0;
+            if (by_range && rshift >= HV_TLB_PAGE_BITS) {
+                uint64_t gpages = (((xt >> 39) & 31) + 1) << (5 * ((xt >> 44) & 3) + 1);
+                va = (uint64_t)((int64_t)((xt & 0x1fffffffffull) << (64 - 37)) >> (64 - 37 - rshift));
+                npages = gpages << (rshift - HV_TLB_PAGE_BITS);
+                if (npages > 32) npages = 0;
+            } else if (by_va) {
+                npages = 1;
+            }
+            uint64_t seq[HV_MAX_CPUS] = {0};
+            for (int i = 0; i < m->ncpus; i++) {
+                HvCpu *c = m->cpus[i];
+                if (!c || c == cpu) continue;
+                /* Done from here entirely if it can be; else c does it, and we wait.
+                   A drop that raced a page walk or cache fill of c's (they are
+                   short) is tried again a few times first. */
+                int done = npages > 0, why = !npages ? (by_range ? 1 : 2) : 0;
+                for (uint64_t p = 0; done && p < npages; p++) {
+                    uint64_t pva = va + (p << HV_TLB_PAGE_BITS);
+                    int r = 0;
+                    for (int t = 0; t < 4 && (r = hv_tlbi_drop_remote_va(c, pva, asid)) == 0; t++)
+                        for (int s = 0; s < 64; s++) __asm__ volatile("yield");
+                    done = r == 1;
+                    if (r < 0) why = 3;
+                }
+                if (done) continue;
+                if (m->stats_interval) m->stats.posted_kind[why]++;
+                seq[i] = hv_cpu_post_tlbi(c, op1, crn, crm, op2, xt);
+            }
+            for (int i = 0; i < m->ncpus; i++)
+                if (seq[i]) hv_cpu_sync(cpu, m->cpus[i], seq[i]);
+        }
+        return 0;
+    }
+    if (crn == 7) return 0; /* other cache maintenance: caches are coherent here */
+    return undefined(cpu, pc);
+}
diff --git a/accel/henge/engine/core/sysreg.h b/accel/henge/engine/core/sysreg.h
