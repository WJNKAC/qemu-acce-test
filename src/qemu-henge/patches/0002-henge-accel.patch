+void henge_auth_setup_engine(HvMachine *m)
+{
+    static int setups;
+    setups++;
+    fprintf(stderr, "auth-setup: #%d m=%p\n", setups, (void *)m);
+    if (getenv("HENGE_STOP_WRAPPER")) {
+        m->stop_pc = 0xffff8000810a7400ull;
+        m->stop_hook = henge_wrapper_stop_hook;
+    }
+    hv_gicv3_create(m, 0x08000000, 0x080A0000);
+    g_auth_its = NULL;
+    if (m->gic && !getenv("HENGE_AUTH_NO_ITS"))
+        g_auth_its = hv_gicv3_its_create(m, m->gic, 0x08080000ull);
+    m->icc_external = 0;                 /* ICC 回引擎 */
+    m->sysreg_external = 1;              /* ID 组/PSCI/其它仍走 QEMU */
+    if (!getenv("HENGE_AUTH_NO_WAKE")) hv_engine_set_wake_hook(m, henge_wake_bridge, NULL);
+    if (!getenv("HENGE_AUTH_NO_TAPS")) {
+        g_auth_g = m->gic;
+        /* 三态里的第三态。不是"影子也开着"：影子仪器在 authority 下必须关，
+           henge_gic_instr_active() 只对 SHADOW 为真。 */
+        henge_gic_mode = HENGE_GIC_MODE_AUTHORITY;
+    }
+    fprintf(stderr, "henge: GIC AUTHORITY mode on (engine GIC at 0x08000000)\n");
+}
