+void hv_engine_dump_code(HvCpu *cpu, uint64_t va)
+{
+    if (!cpu) return;
+    for (int k = 0; k < 8; k++) {
+        uint64_t a = va + (uint64_t)k * 4;
+        HvWalk w;
+        uint32_t insn = 0;
+        memset(&w, 0, sizeof w);
+        hv_mmu_walk(cpu, a & ~3ull, HV_ACC_EXEC, cpu->el, &w);
+        if (!w.fsc && hv_phys_read(cpu->m, w.pa, &insn, 4) == 0)
+            fprintf(stderr, "  code[%llx] = %08x\n", (unsigned long long)a, insn);
+        else
+            fprintf(stderr, "  code[%llx] = ?? (fsc=%d)\n", (unsigned long long)a, w.fsc);
+    }
+}
+
+void hv_engine_note_irq(HvCpu *cpu, int irq, int level)
+{
+    if (!cpu) {
+        return;
+    }
+    __atomic_store_n(&cpu->exit_req, 1, __ATOMIC_RELEASE);
+    if (g_auth_g) {
+        /* 权威模式：线副本归引擎 GIC 所有。QEMU 的 GIC 已退役，它的边沿
+           （arm_cpu_set_irq -> 本函数）若继续写副本，会把权威 GIC 刚置的 1
+           压回 0——这正是"写者 1 / 读者 0"的真因。 */
+        return;
+    }
+    if (cpu->pc_state) {
+        if (irq) {
+            __atomic_store_n(&cpu->pc_state->fiq_line, level ? 1 : 0, __ATOMIC_RELEASE);
+        } else {
+            __atomic_store_n(&cpu->pc_state->irq_line, level ? 1 : 0, __ATOMIC_RELEASE);
+        }
+    }
+}
+
+void hv_engine_set_irq(HvCpu *cpu, int irq, int fiq)
+{
+    HvPerCpu *p;
+
+    if (!cpu || !(p = cpu->pc_state)) {
+        return;
+    }
+    __atomic_store_n(&p->irq_line, irq ? 1 : 0, __ATOMIC_RELEASE);
+    __atomic_store_n(&p->fiq_line, fiq ? 1 : 0, __ATOMIC_RELEASE);
+}
+
+int hv_engine_get_irq(HvCpu *cpu, int fiq)
+{
+    HvPerCpu *p;
+
+    if (!cpu || !(p = cpu->pc_state)) {
+        return -1;
+    }
+    /*
+     * Answer from the same place the dispatcher asks (irq_line_get), so the
+     * monitor shows the level the engine is actually acting on rather than a
+     * shadow that nothing refreshes any more.  Falls back to the byte for a
+     * standalone machine with no hook installed, which is authoritative there.
+     */
+    if (cpu->m && cpu->m->irq_line_get) {
+        return cpu->m->irq_line_get(cpu->m->irq_line_ctx, cpu->index, fiq);
+    }
+    return fiq ? __atomic_load_n(&p->fiq_line, __ATOMIC_ACQUIRE)
+               : __atomic_load_n(&p->irq_line, __ATOMIC_ACQUIRE);
+}
+
+void hv_engine_get_cpu_state(HvCpu *cpu, uint64_t *pc, uint64_t *daif,
+                             uint64_t *el)
+{
+    if (!cpu) {
+        *pc = *daif = *el = (uint64_t)-1;
+        return;
+    }
+    *pc = cpu->pc;
+    *daif = cpu->daif;
+    *el = cpu->el;
