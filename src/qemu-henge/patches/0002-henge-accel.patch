+int hv_gicv3_hppi(HvGic *g, int c);
+void hv_gicv3_hppi_inputs(HvGic *g, int c, int intid, int *pending, int *isen,
+                          int *grp, int *igrpen0, int *igrpen1, int *prio,
+                          uint64_t *pmr, int *hppi, uint64_t *evals);
+void henge_auth_ppi_detail(int ci, int intid, int *grp, int *prio, uint64_t *pmr,
+                           uint64_t *igrpen0, int *hppi)
+{
+    if (!g_auth_g || ci < 0 || ci >= HV_MAX_CPUS) return;
+    HvGicCpu *k = &g_auth_g->cpu[ci];
+    if (grp) *grp = k->group[intid];
+    if (prio) *prio = k->priority[intid];
+    if (pmr) *pmr = k->pmr;
