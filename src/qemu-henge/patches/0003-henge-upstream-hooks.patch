+static struct { int64_t deadline_us, enter_us; uint32_t irq; int armed, dumped; } henge_sgi_arm[8];
+/* 掩蔽段普查：Σ 时长 = 残差第一嫌疑人。 */
+static struct { uint64_t n, sum_us, max_us, hist[4]; } henge_sgi_census[8];
