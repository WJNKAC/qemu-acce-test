+void henge_shadow_init(HvMachine *real)
+{
+    /* 影子只在 OFF 态初始化：authority 已经自己建好权威 GIC，再建一台影子
+       就是第三份状态。 */
+    if (henge_gic_mode != HENGE_GIC_MODE_OFF || !getenv("HENGE_GIC_SHADOW")) {
+        return;
+    }
+    memset(&henge_shadow_m, 0, sizeof henge_shadow_m);
+    /* 继承真实 machine 的内存映射：ITS 的命令队列/表在客机内存里，影子要用
+       hv_phys_read 读同一份共享输入（只读；写路径不在影子侧）。 */
+    g_shadow_real = real;
+    if (real) {
+        memcpy(henge_shadow_m.ram, real->ram, sizeof henge_shadow_m.ram);
+        henge_shadow_m.nram = real->nram;
+    }
+    /* 影子 machine 的 ncpus 必须覆盖所有可能被镜像的 CPU：
+       真实 machine 的 ncpus 在第一个 vCPU 线程时可能还没 finalize，
+       用 HV_MAX_CPUS 兜底（多算几个空 CPU 无副作用）。 */
+    henge_shadow_m.ncpus = HV_MAX_CPUS;
+    fprintf(stderr, "henge-shadow: ncpus fallback HV_MAX_CPUS (%d) — shadow-period assertion\n",
+            HV_MAX_CPUS);
+    if (real) {
+        fprintf(stderr, "henge-shadow-ram: nram=%d", real->nram);
+        for (int i = 0; i < real->nram && i < 8; i++)
+            fprintf(stderr, " [%d pa=%llx size=%llx]", i,
+                    (unsigned long long)real->ram[i].pa,
+                    (unsigned long long)real->ram[i].size);
+        fprintf(stderr, "\n");
+    }
+    henge_shadow_m.shadow = 1;
+    /* SGI1R 的 affinity 解码需要真实 MPIDR；只读引用，wake 已被 shadow 标志屏蔽。 */
+    for (int i = 0; real && i < real->ncpus && i < HV_MAX_CPUS; i++) {
+        henge_shadow_m.cpus[i] = real->cpus[i];
+    }
+    henge_shadow_tap_only = getenv("HENGE_GIC_SHADOW_TAP") != NULL;
+    if (!henge_shadow_tap_only) {
+        henge_shadow_g = hv_gicv3_create(&henge_shadow_m, 0, 0);
+    if (henge_shadow_g) {
+        /* GITS 帧基址（virt: 0x08080000）；引擎 ITS 的 rdbase 解码目前依赖 virt 布局。 */
+        /* ITS 的客机内存读（命令队列/表）用真实 machine 指针：其 RAM 映射在
+           影子初始化之后仍会增长（nram 从 2 到 3），快照会漏区段。只读。 */
+        henge_shadow_its = hv_gicv3_its_create(real ? real : &henge_shadow_m,
+                                               henge_shadow_g, 0x08080000ull);
+    }
+    }
+    henge_gic_mode = (henge_shadow_g != NULL || henge_shadow_tap_only)
+                         ? HENGE_GIC_MODE_SHADOW : HENGE_GIC_MODE_OFF;
+    if (henge_gic_mode == HENGE_GIC_MODE_SHADOW) {
+        fprintf(stderr, "henge-shadow: engine GIC online (ncpus=%d), read-only\n",
+                henge_shadow_m.ncpus);
+    }
+}
+
+static void inflight_set(int ci, int intid)
+{
+    if (ci >= 0 && ci < 8) { g_inflight[ci] = 1; g_inflight_intid[ci] = intid; }
+}
+void henge_shadow_inflight_done(void)
+{
+    for (int i = 0; i < 8; i++) g_inflight[i] = 0;
+}
+int henge_shadow_inflight_any(int ci) { return (ci >= 0 && ci < 8) ? g_inflight[ci] : 0; }
+
+void henge_shadow_spi(int intid, int level)
+{
+    if (g_auth_g) { hv_gicv3_set_irq(g_auth_g, intid, level); return; }
+    g_in_spi++; g_tx[0]++;
+    for (int i = 0; i < 8; i++) inflight_set(i, intid);
+    ring_add(1, 0xffff00000000ull | (uint64_t)intid, (uint64_t)level);  /* cpu=-1: SPI */
+    if (intid >= 0 && intid < 128) g_intid[intid]++;
+    if (henge_shadow_g) { if (!henge_shadow_tap_only) { seq_begin(); hv_gicv3_set_irq(henge_shadow_g, intid, level); seq_end(); } g_rx[0]++; }
+}
+
+void henge_shadow_ppi(int cpu, int intid, int level)
+{
+    if (g_auth_g) {
+        if (getenv("HENGE_AUTH_TRACE") && intid == 27)
+            fprintf(stderr, "auth-tap: ppi27 cpu=%d level=%d\n", cpu, level);
+        hv_gicv3_set_ppi(g_auth_g, cpu, intid, level);
+        return;
+    }
+    g_in_ppi++; g_tx[1]++;
+    ring_add(1, ((uint64_t)cpu << 32) | (uint64_t)intid, (uint64_t)level);  /* cpu tag */
+    inflight_set(cpu, intid);
+    if (henge_shadow_g && cpu >= 0 && cpu < HV_MAX_CPUS) {
+        if (intid >= 0 && intid < 128) g_intid[intid]++;
+        if (!henge_shadow_tap_only) { seq_begin(); hv_gicv3_set_ppi(henge_shadow_g, cpu, intid, level); seq_end(); } g_rx[1]++;
+    }
+}
+
+void henge_shadow_dist(uint64_t off, uint64_t v, unsigned size)
+{
+    g_in_dist++; g_tx[2]++;
+    for (int i = 0; i < 8; i++) inflight_set(i, -1);
+    ring_add(2, off, v);
+    if (henge_shadow_g) { if (!henge_shadow_tap_only) { seq_begin(); hv_gicv3_dist_mmio(henge_shadow_g, off, v, size); seq_end(); } g_rx[2]++; }
+}
+
+void henge_shadow_redist(int cpu, int kind, uint64_t off, uint64_t v, unsigned size)
+{
+    shadow_sync_ram();
+    if (cpu >= 0 && cpu < 8) g_in_redist[cpu]++;
+    if (cpu >= 0 && cpu < 8 && kind == 0 && (off & ~3ull) == 0x78) {
+        /* PENDBASER 可能是 2×32-bit 写：按 slice 合并，别用整字覆盖丢掉 VALID。 */
+        if ((off & 7ull) == 0)
+            g_lpi_pendbase[cpu] = (g_lpi_pendbase[cpu] & ~0xffffffffull) | (v & 0xffffffffull);
+        else
+            g_lpi_pendbase[cpu] = (g_lpi_pendbase[cpu] & 0xffffffffull) | ((v & 0xffffffffull) << 32);
+    }
+    g_tx[3]++; inflight_set(cpu, -1);
+    ring_add(3, (uint64_t)(((uint64_t)cpu << 40) | ((uint64_t)kind << 32) | (off & 0xffffffff)), v);
+    if (henge_shadow_g) { if (!henge_shadow_tap_only) { seq_begin(); hv_gicv3_redist_mmio(henge_shadow_g, cpu, kind, off, v, size); seq_end(); } g_rx[3]++; }
+}
+
+void henge_shadow_icc(HvCpu *cpu, uint32_t reg, int write, uint64_t *v)
+{
+    if (!henge_shadow_g || !cpu) return;
+    if (write) {
+        unsigned crn = (reg >> 7) & 15, crm = (reg >> 3) & 15, op2 = reg & 7;
+        if (crn == 4 && crm == 6) g_in_icc_w_pmr++;
+        else if (crn == 12 && crm == 12 && op2 == 7) g_in_icc_w_igrpen++;
+        else if (crn == 12 && crm == 12 && op2 == 4) g_in_icc_w_ctlr++;
+        else g_in_icc_w_other++;
+        hv_gicv3_icc_write(henge_shadow_g, cpu, reg, *v);
+    } else {
+        g_in_icc_r++;
+        *v = hv_gicv3_icc_read(henge_shadow_g, cpu, reg);
+    }
+}
+
+void henge_shadow_diff(int ci, int qemu_level)
+{
+    if (!henge_shadow_g || ci < 0 || ci >= HV_MAX_CPUS) return;
+    int sh = henge_shadow_m.percpu[ci].irq_line ? 1 : 0;
+    if (g_shadow_last[ci] == 0 && sh == 1) g_line_rise[ci]++;
+    g_shadow_last[ci] = sh;
+    henge_shadow_n++; g_ed_n[ci]++;
+    if (sh != qemu_level) {
+        henge_shadow_bad++; g_ed_bad[ci]++;
+        if (qemu_level == 0 && sh == 1) g_dir_q0s1++; else g_dir_q1s0++;
+        g_bad_exit++;
+        if (henge_shadow_bad <= 8) {
+            fprintf(stderr, "henge-shadow: MISMATCH cpu%d qemu=%d shadow=%d (n=%llu)\n",
+                    ci, qemu_level, sh, (unsigned long long)henge_shadow_n);
+            ring_dump();
+            henge_shadow_bucket_dump();
+        }
+    }
+    henge_shadow_maybe_report();
+    if (0) {
+        fprintf(stderr, "henge-shadow: n_diffs=%llu mismatch=%llu (bb=%llu exit=%llu race=%llu) "
+                "settle n=%llu bad=%llu dir q0s1=%llu q1s0=%llu\n",
+                (unsigned long long)henge_shadow_n, (unsigned long long)henge_shadow_bad,
+                (unsigned long long)g_bad_bb, (unsigned long long)g_bad_exit,
+                (unsigned long long)g_bad_race,
+                (unsigned long long)g_settle_n, (unsigned long long)g_settle_bad,
+                (unsigned long long)g_dir_q0s1, (unsigned long long)g_dir_q1s0);
+        henge_shadow_report();
+        for (int c = 0; c < 2; c++) {
+            fprintf(stderr, "henge-shadow-pcpu: cpu%d settle=%llu/%llu bb=%llu/%llu edge=%llu/%llu\n",
+                    c, (unsigned long long)g_st_n[c], (unsigned long long)g_st_bad[c],
+                    (unsigned long long)g_bb_n[c], (unsigned long long)g_bb_bad[c],
+                    (unsigned long long)g_ed_n[c], (unsigned long long)g_ed_bad[c]);
+        }
+    }
+}
