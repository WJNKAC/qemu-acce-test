diff --git a/accel/henge/engine/compat/plat_linux.c b/accel/henge/engine/compat/plat_linux.c
new file mode 100644
index 0000000000..3ec0e343bc
--- /dev/null
+++ b/accel/henge/engine/compat/plat_linux.c
@@ -0,0 +1,126 @@
+/* Linux/Android 平台垫片：时基与 I-cache 维护。
+   引擎内部的时间单位是 24 MHz tick，见 compat/mach/mach_time.h 的说明。 */
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>   /* getenv: HV_CLOCK_CAL */
+#include <time.h>     /* clock_gettime: 启动自校准 */
+#include <unistd.h>   /* usleep: 启动自校准 */
+#include <sys/mman.h>
+
+#include "TargetConditionals.h"
+
+#define HV_TICK_HZ 24000000ull
+
+static uint64_t host_cntfrq = 1;   /* CNTFRQ_EL0，启动时读一次 */
+static uint64_t to24_mult = 1;     /* 24e6 << 32 / cntfrq */
+static uint32_t to24_shift = 32;
+
+/* Darwin 的 commpage：core/translate.c 在【翻译时】读 0xfffffc090 的一个字节，
+   据此决定 guest 的 CNTVCT 读指令该展开成"原生 mrs + 加一个偏移"还是走 helper。
+   这个地址在 Linux 上没人映射，读它就是 SIGSEGV——第一次跑内核时炸的正是这里。
+
+   这里在 0xfffffc000 铺一页零页，于是那个字节读到 0，translate_counter 走
+   "return 0"（不内联），指令落到通用 MRS helper，helper 再走 hv_counter()
+   → mach_absolute_time() → 我们换算到 24 MHz 的实现。数值口径完全一致，
+   代价是每次读计数器多一次 helper 调用（Linux 里主要是 sched_clock/delay，
+   不在最热路径上）。原树一个字都不用改。 */
+#define HV_COMMPAGE_SHIM_PA 0xfffffc000ull
+#define HV_COMMPAGE_SHIM_SZ 0x1000ull
+
+static void map_commpage_shim(void) {
+    void *want = (void *)(uintptr_t)HV_COMMPAGE_SHIM_PA;
+    void *p = mmap(want, HV_COMMPAGE_SHIM_SZ, PROT_READ | PROT_WRITE,
+                   MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (p != want) {
+        if (p != MAP_FAILED) munmap(p, HV_COMMPAGE_SHIM_SZ);
+        p = mmap(want, HV_COMMPAGE_SHIM_SZ, PROT_READ | PROT_WRITE,
+                 MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+    }
+    if (p != want)
+        fprintf(stderr, "hv-linux: warning: cannot map the commpage shim at %#llx; "
+                        "guest counter reads will fault while translating\n",
+                (unsigned long long)HV_COMMPAGE_SHIM_PA);
+}
+
+/*
+ * 启动自校准：分别量"裸计数器速率"和"引擎时间域速率"。
+ *
+ * 为什么必须量两个而不是一个（第一版这里量错了）：
+ *   第一版只测裸 cntvct_el0，得到 12.986 MHz，而 HV_TICK_HZ 是 24 MHz，
+ *   于是打印出 "dilution=1.8481x"。这是错的——代码里 to24_mult 就是
+ *   24e6<<32/13e6，hv_host_ticks_24mhz() 已经把 13 MHz 换算到 24 MHz 域。
+ *   直接比"假设值/原始频率"漏掉了换算这一步，得出的不是稀释。
+ *
+ * 正确的判据是：hv_host_ticks_24mhz() 的增速是否为 24e6/秒。
+ *   engine_ticks/秒 ≈ 24e6  → 换算正确，19.2 假设不成立，另找原因
+ *   engine_ticks/秒 ≈ 13e6  → 换算没生效，时间域被稀释 1.85 倍
+ *   engine_ticks/秒 ≈ 62.5e6 → 换算了两次
+ *
+ * 三个数并排打出来，谁也不糊涂：
+ *   raw = 裸 cntvct 速率（设备真实晶振）
+ *   frq = 内核报告的 CNTFRQ_EL0
+ *   eng = 引擎时间域的真实速率（这个才是 guest 看到的时间）
+ */
+uint64_t hv_host_ticks_24mhz(void);   /* 定义在本文件下方：非 static，勿加 */
+
+static void calibrate_report(void) {
+    struct timespec a, b;
+    uint64_t r0, r1, e0, e1;
+    double host_ns, raw_hz, eng_hz;
+
+    if (!getenv("HV_CLOCK_CAL")) {
+        return;
+    }
+    __asm__ volatile("isb; mrs %0, cntvct_el0" : "=r"(r0));
+    e0 = hv_host_ticks_24mhz();
+    clock_gettime(CLOCK_MONOTONIC, &a);
+    usleep(50000);                 /* 50 ms：长到足以压过读抖动 */
+    clock_gettime(CLOCK_MONOTONIC, &b);
+    e1 = hv_host_ticks_24mhz();
+    __asm__ volatile("isb; mrs %0, cntvct_el0" : "=r"(r1));
+
+    host_ns = (double)(b.tv_sec - a.tv_sec) * 1e9 + (double)(b.tv_nsec - a.tv_nsec);
+    if (host_ns <= 0) {
+        return;
+    }
+    raw_hz = (double)(r1 - r0) * 1e9 / host_ns;
+    eng_hz = (double)(e1 - e0) * 1e9 / host_ns;
+
+    fprintf(stderr,
+            "hv-clock: raw_cntvct=%.0f Hz | cntfrq_el0=%llu Hz | "
+            "engine_domain=%.0f Hz (want %llu) | ratio=%.4f\n",
+            raw_hz, (unsigned long long)host_cntfrq, eng_hz,
+            (unsigned long long)HV_TICK_HZ,
+            eng_hz > 0 ? (double)HV_TICK_HZ / eng_hz : 0.0);
+}
+
+__attribute__((constructor)) static void hv_plat_init(void) {
+    map_commpage_shim();
+    uint64_t frq;
+    __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(frq));
+    if (frq == 0) frq = HV_TICK_HZ;
+    host_cntfrq = frq;
+    if (frq == HV_TICK_HZ) {
+        to24_mult = 1;
+        to24_shift = 0;
+    } else {
+        /* 24e6/cntfrq 的定点表示：cntfrq 是 13/19.2/25/50 MHz 这类值，
+           32 位小数足够，误差远低于 1 tick/秒。 */
+        to24_mult = (HV_TICK_HZ << 32) / frq;
+        to24_shift = 32;
+    }
+    calibrate_report();
+}
+
+uint64_t hv_host_ticks_24mhz(void) {
+    uint64_t c;
+    __asm__ volatile("isb; mrs %0, cntvct_el0" : "=r"(c));
+    if (to24_shift == 0) return c;
+    return (uint64_t)(((__uint128_t)c * (__uint128_t)to24_mult) >> to24_shift);
+}
+
+uint64_t hv_host_cntfrq(void) { return host_cntfrq; }
+
+void sys_icache_invalidate(void *start, size_t len) {
+    __builtin___clear_cache((char *)start, (char *)start + len);
+}
diff --git a/accel/henge/engine/core/classify.c b/accel/henge/engine/core/classify.c
new file mode 100644
index 0000000000..f98dd9e743
--- /dev/null
+++ b/accel/henge/engine/core/classify.c
@@ -0,0 +1,124 @@
+#include "classify.h"
+
+/* Decoding follows the A64 top-level encoding table in the Arm ARM:
+   bits 28..25 pick the group, then each group is narrowed by mask and value. */
+
+static HvInsnKind classify_hint(uint32_t insn) {
+    /* HINT #imm: CRm in 11..8, op2 in 7..5. */
+    uint32_t crm = (insn >> 8) & 0xf;
+    uint32_t op2 = (insn >> 5) & 0x7;
+    uint32_t imm = (crm << 3) | op2;
+    switch (imm) {
+    case 2:  /* WFE */
+    case 3:  /* WFI */
+        return HV_INSN_WAIT;
+    case 7:  /* XPACLRI */
+    case 8: case 10: case 12: case 14:   /* PACIA1716, PACIB1716, AUTIA1716, AUTIB1716 */
+    case 24: case 25: case 26: case 27:  /* PACIAZ, PACIASP, PACIBZ, PACIBSP */
+    case 28: case 29: case 30: case 31:  /* AUTIAZ, AUTIASP, AUTIBZ, AUTIBSP */
+        return HV_INSN_PAC;
+    default:
+        /* NOP, YIELD, SEV, SEVL, ESB, PSB, CSDB, BTI and unallocated hints run as NOPs. */
+        return HV_INSN_COPY;
+    }
+}
+
+static HvInsnKind classify_system(uint32_t insn) {
+    uint32_t l = (insn >> 21) & 1;
+    uint32_t op0 = (insn >> 19) & 3;
+    uint32_t op1 = (insn >> 16) & 7;
+    uint32_t crn = (insn >> 12) & 0xf;
+
+    if (op0 == 0) {
+        if (l == 0 && crn == 2 && op1 == 3 && (insn & 0x1f) == 0x1f) return classify_hint(insn);
+        if (l == 0 && crn == 3 && op1 == 3 && (insn & 0x1f) == 0x1f) {
+            uint32_t op2 = (insn >> 5) & 7;
+            /* CLREX, DSB, DMB, ISB, SB and the DSB nXS forms. */
+            (void)op2;
+            return HV_INSN_BARRIER;
+        }
+        if (l == 0 && crn == 4) return HV_INSN_SYSREG; /* MSR (immediate) to PSTATE */
+        if (l == 0 && crn == 1 && op1 == 3 && (insn & 0x1f) == 0x1f) {
+            /* WFET, WFIT (FEAT_WFxT) live in CRn=1. */
+            return HV_INSN_WAIT;
+        }
+        return HV_INSN_UNDEFINED;
+    }
+    if (op0 == 1) return HV_INSN_SYS;     /* SYS, SYSL */
+    return HV_INSN_SYSREG;                /* MRS, MSR (register) */
+}
+
+static HvInsnKind classify_branch_group(uint32_t insn) {
+    if ((insn & 0x7c000000) == 0x14000000) return HV_INSN_BRANCH;   /* B, BL */
+    if ((insn & 0x7e000000) == 0x34000000) return HV_INSN_BRANCH;   /* CBZ, CBNZ */
+    if ((insn & 0x7e000000) == 0x36000000) return HV_INSN_BRANCH;   /* TBZ, TBNZ */
+    if ((insn & 0xff000000) == 0x54000000) return HV_INSN_BRANCH;   /* B.cond, BC.cond */
+    if ((insn & 0xff000000) == 0xd4000000) return HV_INSN_EXCEPTION;
+    if ((insn & 0xffc00000) == 0xd5000000) return classify_system(insn);
+    if ((insn & 0xfe000000) == 0xd6000000) {
+        uint32_t opc = (insn >> 21) & 0xf;
+        if (opc == 4) return HV_INSN_ERET;                          /* ERET, ERETAA, ERETAB */
+        if (opc == 5) return HV_INSN_UNDEFINED;                     /* DRPS: not at EL0/EL1 */
+        return HV_INSN_BRANCH_REG;                                  /* BR, BLR, RET and PAC forms */
+    }
+    return HV_INSN_UNDEFINED;
+}
+
+static HvInsnKind classify_memory(uint32_t insn) {
+    /* Load register (literal): bits 29..27 = 011, bit 24 = 0. */
+    if ((insn & 0x3b000000) == 0x18000000) {
+        uint32_t opc = insn >> 30;
+        uint32_t v = (insn >> 26) & 1;
+        if (opc == 3 && v == 0) return HV_INSN_PREFETCH;            /* PRFM (literal) */
+        return HV_INSN_LOAD_LITERAL;
+    }
+    /* PRFM (immediate) and PRFM (register), PRFUM: size=11, V=0, opc=10. */
+    if ((insn & 0xffc00000) == 0xf9800000) return HV_INSN_PREFETCH;            /* PRFM (unsigned offset) */
+    if ((insn & 0xffe00c00) == 0xf8a00800) return HV_INSN_PREFETCH;            /* PRFM (register) */
+    if ((insn & 0xffe00c00) == 0xf8800000) return HV_INSN_PREFETCH;            /* PRFUM */
+    return HV_INSN_MEMORY;
+}
+
+static HvInsnKind classify_dp_register(uint32_t insn) {
+    /* Data-processing (1 source) with opcode2 = 00001: PAC*, AUT*, XPAC*. */
+    if ((insn & 0xffff0000) == 0xdac10000) return HV_INSN_PAC;
+    /* PACGA: Data-processing (2 source), opcode 001100. */
+    if ((insn & 0xffe0fc00) == 0x9ac03000) return HV_INSN_PAC;
+    return HV_INSN_COPY;
+}
+
+HvInsnKind hv_classify(uint32_t insn) {
+    uint32_t op0 = (insn >> 25) & 0xf;
+    /* 00xx: UDF and SME (0000), SVE (0010), unallocated. None are exposed to the guest. */
+    if ((op0 & 0xc) == 0x0) return HV_INSN_UNDEFINED;
+    if ((op0 & 0xe) == 0x8) {                   /* 100x: data processing, immediate */
+        if ((insn & 0x1f000000) == 0x10000000) return HV_INSN_PCREL;
+        return HV_INSN_COPY;
+    }
+    if ((op0 & 0xe) == 0xa) return classify_branch_group(insn); /* 101x */
+    if ((op0 & 0x5) == 0x4) return classify_memory(insn);       /* x1x0 */
+    if ((op0 & 0x7) == 0x5) return classify_dp_register(insn);  /* x101 */
+    if ((op0 & 0x7) == 0x7) return HV_INSN_COPY;                /* x111: SIMD and FP */
+    return HV_INSN_UNDEFINED;
+}
+
+const char *hv_insn_kind_name(HvInsnKind kind) {
+    switch (kind) {
+    case HV_INSN_COPY: return "copy";
+    case HV_INSN_PCREL: return "pcrel";
+    case HV_INSN_BRANCH: return "branch";
+    case HV_INSN_BRANCH_REG: return "branch-reg";
+    case HV_INSN_ERET: return "eret";
+    case HV_INSN_LOAD_LITERAL: return "load-literal";
+    case HV_INSN_MEMORY: return "memory";
+    case HV_INSN_PREFETCH: return "prefetch";
+    case HV_INSN_EXCEPTION: return "exception";
+    case HV_INSN_SYSREG: return "sysreg";
+    case HV_INSN_SYS: return "sys";
+    case HV_INSN_BARRIER: return "barrier";
+    case HV_INSN_WAIT: return "wait";
+    case HV_INSN_PAC: return "pac";
+    case HV_INSN_UNDEFINED: return "undefined";
+    }
+    return "?";
+}
diff --git a/accel/henge/engine/core/classify.h b/accel/henge/engine/core/classify.h
new file mode 100644
index 0000000000..236a495d9e
--- /dev/null
+++ b/accel/henge/engine/core/classify.h
@@ -0,0 +1,28 @@
+#ifndef HENGEVM_CLASSIFY_H
+#define HENGEVM_CLASSIFY_H
+
+#include <stdint.h>
+
+/* What the translator has to do with one A64 instruction. */
+typedef enum {
+    HV_INSN_COPY,        /* runs unchanged (ALU, SIMD/FP, most hints) */
+    HV_INSN_PCREL,       /* ADR, ADRP: guest PC goes into the result */
+    HV_INSN_BRANCH,      /* B, BL, B.cond, CBZ/CBNZ, TBZ/TBNZ: direct, target known */
+    HV_INSN_BRANCH_REG,  /* BR, BLR, RET and their PAC forms: exit to the dispatcher */
+    HV_INSN_ERET,        /* ERET and its PAC forms */
+    HV_INSN_LOAD_LITERAL,/* LDR (literal), LDRSW (literal), PRFM (literal) */
+    HV_INSN_MEMORY,      /* every other load, store, atomic, or exclusive */
+    HV_INSN_PREFETCH,    /* PRFM / PRFUM: dropped */
+    HV_INSN_EXCEPTION,   /* SVC, HVC, SMC, BRK, HLT, DCPS */
+    HV_INSN_SYSREG,      /* MRS, MSR (register), MSR (immediate) to PSTATE */
+    HV_INSN_SYS,         /* SYS/SYSL: DC, IC, TLBI, AT */
+    HV_INSN_BARRIER,     /* DSB, DMB, ISB, CLREX, SB */
+    HV_INSN_WAIT,        /* WFI, WFE, WFIT, WFET */
+    HV_INSN_PAC,         /* PAC*, AUT*, XPAC*, PACGA: strip or no-op */
+    HV_INSN_UNDEFINED,
+} HvInsnKind;
+
+HvInsnKind hv_classify(uint32_t insn);
+const char *hv_insn_kind_name(HvInsnKind kind);
+
+#endif
diff --git a/accel/henge/engine/core/cpu.h b/accel/henge/engine/core/cpu.h
new file mode 100644
index 0000000000..47c9e90bcf
--- /dev/null
+++ b/accel/henge/engine/core/cpu.h
@@ -0,0 +1,314 @@
+#ifndef HENGEVM_CPU_H
+#define HENGEVM_CPU_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+struct HvMachine;
+
+/* One software TLB entry. host = guest VA + addend. The exec tag is the guest
+   VA of the 4 KB page. The read and write tags are that minus HV_TLB_ADJ, so
+   translated code checks "same page, and the access ends in it" for any access
+   of up to 16 bytes with one subtract and shift: VA - tag = offset + 15 must
+   be below 4 KB. (An access in a page's last 15 bytes takes the slow path.)
+   Invalid tags are HV_TLB_INVALID, which no address minus it brings near 0. */
+typedef struct HvTlbEntry {
+    uint64_t read_tag;
+    uint64_t write_tag;
+    uint64_t exec_tag;
+    int64_t addend;
+} HvTlbEntry;
+
+/* exec_tag is the page's VA and its addend in one word: a block chained across pages checks
+   the mapping is what it was with one comparison. Given the addend it gives the VA back. */
+static inline uint64_t hv_exec_key(uint64_t page_va, int64_t addend) {
+    return page_va ^ ((uint64_t)addend >> 20 | (uint64_t)addend << 44);
+}
+
+#define HV_TLB_PAGE_BITS 12
+#define HV_TLB_ADJ 15
+#define HV_TLB_INVALID 0x8080808080808080ull /* what memset(0x80) leaves */
+#define HV_TLB_BITS 14 /* 16384 entries per EL: 64 MB of 4 KB pages */
+#define HV_TLB_SIZE (1u << HV_TLB_BITS)
+#define HV_IJC_TABLES 16
+#define HV_RET_BITS 13 /* entries in a return table */
+#define HV_RET_TAB_BYTES ((1u << HV_RET_BITS) * 16)
+#define HV_CPU_RET_TAB 0x201000 /* just past the TLB */
+
+/* Guest CPU state. While a translated block runs, host x28 points here and the
+   guest's x0..x17, x19..x27, x29 and x30 live in the same host registers.
+   Guest x18, x28 and SP stay in this struct: Darwin reserves host x18, and the
+   translator owns host x28 and the host SP. */
+typedef struct HvCpu {
+    /* Fixed layout: translated code and host/enter.S address these by offset. */
+    uint64_t x[31];          /* 0x000 */
+    uint64_t sp;             /* 0x0f8: the guest SP for the current EL and SPSel */
+    uint64_t pc;             /* 0x100 */
+    uint64_t nzcv;           /* 0x108: N, Z, C, V in bits 31..28 */
+    uint64_t exit_routine;   /* 0x110: host address blocks branch to when they leave */
+    uint64_t spill[4];       /* 0x118: host scratch registers saved around a rewrite */
+    uint32_t exit_reason;    /* 0x138 */
+    uint32_t exit_insn;      /* 0x13c */
+    __uint128_t v[32];       /* 0x140 */
+    uint64_t fpcr;           /* 0x340 */
+    uint64_t fpsr;           /* 0x348 */
+    uint64_t helper_routine; /* 0x350: hv_helper_entry */
+    uint64_t helper_ret;     /* 0x358: where hv_helper_entry returns into the block */
+    /* System registers translated code reads and writes directly. */
+    uint64_t tpidr_el0;      /* 0x360 */
+    uint64_t tpidrro_el0;    /* 0x368 */
+    uint64_t tpidr_el1;      /* 0x370 */
+    uint64_t elr_el1;        /* 0x378 */
+    uint64_t spsr_el1;       /* 0x380 */
+    uint64_t sp_el0;         /* 0x388: banked SP_EL0 while SPSel is 1 */
+    uint64_t daif;           /* 0x390: D, A, I, F in bits 9..6, as in SPSR */
+    uint64_t sp_el1;         /* 0x398: banked SP_EL1 while SPSel is 0 */
+    uint64_t pstate_extra;   /* 0x3a0: PAN (bit 22), UAO (23), SSBS (12), DIT (24), TCO (25) */
+    uint64_t sctlr_el1;      /* 0x3a8 */
+    uint64_t esr_el1;        /* 0x3b0 */
+    uint64_t far_el1;        /* 0x3b8 */
+    uint32_t exit_req;       /* 0x3c0: set (by another thread too) to make chained blocks leave */
+    uint32_t el0_cnt;        /* 0x3c4: CNTKCTL_EL1 bits 1..0 (EL0VCTEN, EL0PCTEN), for translated counter reads */
+    uint64_t last_stub;      /* 0x3c8: slot of the unchained exit just taken, or 0 */
+    uint64_t ijc;            /* 0x3d0: indirect-branch cache, HV_IJC_TABLES tables of {tag, entry} */
+    uint64_t ijc_salt[2];    /* 0x3d8: tags are VA ^ salt, [0] for user (EL0) tables, [1] kernel (see hv_ijc_* in mmu.c) */
+    uint64_t miss_site;      /* 0x3e8: --stats: guest PC of the branch whose cache lookup just missed */
+    uint64_t excl_addr;      /* 0x3f0: exclusive monitor: guest VA, or ~0 when clear */
+    uint32_t excl_size;      /* 0x3f8: bytes the LDXR read */
+    uint32_t spsel;          /* 0x3fc: SPSel (translated MSR SPSel writes it) */
+    uint64_t excl_val[2];    /* 0x400: what it read (a pair's two halves) */
+    uint64_t host_sp;        /* 0x410: the host's stack while blocks run: they keep the guest SP in the SP register */
+    uint64_t lines_ptr;      /* 0x418: &pc_state->irq_line (irq, then fiq: one 8-byte load sees both) */
+    uint64_t helper_thunk;   /* 0x420: hv_helper_thunk (blocks reach it through a register: it may be out of BL range) */
+    uint64_t chain_thunk;    /* 0x428: hv_chain_thunk */
+    uint64_t ijc_thunk;      /* 0x430: hv_ijc_thunk */
+    uint64_t refill_ret;     /* 0x438: where it goes back to */
+    uint64_t ijc_tab[16];    /* 0x440: each flags value's branch-cache table (ijc + flags * table size) */
+    uint64_t gaddend[4];     /* 0x4c0: host addends of the pages groups of accesses on one base register were checked in (translate_mem) */
+    uint64_t xjump_thunk;    /* 0x4e0: hv_xjump_thunk */
+    /* 0x500: what tags in the return tables (ret_tab) are xored with, [0] user, [1] kernel.
+       Bits 63..48, as ijc_salt; a new value empties that half of the tables. */
+    uint64_t ret_salt[2] __attribute__((aligned(128)));
+    uint64_t helper_came_from; /* 0x510: where hv_helper_entry was called from, to tell if it goes back there */
+    uint64_t ttbr0_el1;        /* 0x518 */
+    uint64_t ttbr1_el1;        /* 0x520 */
+    uint64_t vbar_el1;         /* 0x528 */
+    uint64_t contextidr_el1;   /* 0x530 */
+    uint64_t mdscr_el1;        /* 0x538 */
+    /* 0x580: [0] EL0 and unprivileged accesses, [1] EL1, [2] EL1 with PSTATE.PAN set,
+       so toggling PAN (the kernel does it around every user copy) flushes nothing.
+       [slot][EL0, EL1, EL1 with PAN, unused]: a slot's three in one 128-byte cache line. */
+    HvTlbEntry tlb[HV_TLB_SIZE * 4] __attribute__((aligned(128))); /* four tables; where an entry is: hv_tlb_code */
+    /* Each flags value's return table: {tag, host address} of the code after a call, by the
+       return address's low bits (see put_call). At a multiple of 4 KB from the HvCpu, as the
+       translated code adds it with one ADD. */
+    char ret_pad[HV_CPU_RET_TAB - 0x580 - (HV_TLB_SIZE * 4 * 32)];
+    uint8_t ret_tab[HV_IJC_TABLES][HV_RET_TAB_BYTES];
+
+    /* The rest is only touched by C. */
+    struct HvMachine *m;
+    uint32_t el;
+
+    /* Interrupts injected into this CPU, as a monotonic counter.
+     *
+     * Exposed to the host through hv_engine_get_irq_injections() so it can tell
+     * when QEMU's CPU_INTERRUPT_HARD latch has been consumed.  Per CPU on
+     * purpose: m->stats.interrupts counts the whole machine, and using that
+     * would let one CPU's injection drop another CPU's still-pending bit. */
+    uint64_t irq_injected;
+
+    /* The exclusive monitor is excl_addr, excl_size and excl_val above: STXR is a
+       compare-and-swap against the value the LDXR saw, the way QEMU does it, so
+       another CPU's store in between makes it fail. */
+
+    uint64_t tcr_el1;
+    uint64_t mair_el1;
+    uint64_t amair_el1;
+    uint64_t par_el1;
+    uint64_t afsr0_el1, afsr1_el1;
+    uint64_t cpacr_el1;
+    uint64_t csselr_el1;
+    uint64_t cntkctl_el1;
+    uint64_t actlr_el1;
+    uint64_t sctlr_seen;     /* MMU/FP state the current TLB contents were filled under */
+    uint64_t asid0_ttbr0;    /* TTBR0 BADDR last bound to ASID 0 (guards ASID-less guests) */
+    int asid0_used;          /* whether any user IJC entry filled under ASID 0 */
+    uint64_t timer_due;      /* host time this CPU's timer next fires (the dispatcher's last tick said), 0: none */
+    /* TLB slots (table << HV_TLB_BITS | index) filled with user addresses since the
+       last user flush, so a context switch clears those instead of scanning all
+       three tables. More than HV_USER_FILLS means: scan. */
+#define HV_USER_FILLS 2048
+    uint16_t user_fills[HV_USER_FILLS];
+    uint32_t nuser_fills;
+#define HV_KERNEL_FILLS 4096
+    uint16_t kernel_fills[HV_KERNEL_FILLS];
+    uint32_t nkernel_fills;
+#define HV_KTTBR_SLOTS 64
+    struct { uint64_t ttbr1; uint16_t kgen; } kttbr_map[HV_KTTBR_SLOTS];
+    uint32_t kttbr_next, kttbr_count;
+    /* Indirect-branch cache salts live in bits 63..48, which no user VA sets and
+       every kernel VA has all ones in, so each salt value names a distinct set
+       of tags. User salts are per ASID (asid_cid[ASID], 0 = none yet), so a
+       process switch keeps every process's entries; dropping one means giving
+       its ASID a fresh id. Ids only grow until they run out, then the tables
+       are cleared. */
+    uint16_t asid_cid[65536];
+    uint16_t cid_asid[65536]; /* --stats: the ASID a user id was given to (to tell live tags from dead ones) */
+    uint32_t next_cid, kernel_gen;
+
+    /* Generic timer: physical and virtual. The counter is host time scaled to 24 MHz. */
+    uint64_t cntv_ctl, cntv_cval;
+    uint64_t cntp_ctl, cntp_cval;
+    uint64_t cntvoff;
+
+    uint64_t mpidr;
+    uint32_t index;          /* which CPU: m->percpu[index] holds its caches and interrupt lines */
+    struct HvPerCpu *pc_state;
+    uint64_t icount;         /* blocks entered, for tests and stats */
+    int halted;              /* SYSTEM_OFF / SYSTEM_RESET / guest panic: the machine stops */
+    int off;                 /* PSCI: powered off (a secondary not started yet, or CPU_OFF) until CPU_ON */
+    int parked_off;          /* off, and its thread is waiting (so CPU_ON may reset it) */
+} HvCpu;
+
+#define HV_CPU_X(n)        ((n) * 8)
+#define HV_CPU_SP          0x0f8
+#define HV_CPU_PC          0x100
+#define HV_CPU_NZCV        0x108
+#define HV_CPU_EXIT        0x110
+#define HV_CPU_SPILL(n)    (0x118 + (n) * 8)
+#define HV_CPU_REASON      0x138
+#define HV_CPU_V           0x140
+#define HV_CPU_FPCR        0x340
+#define HV_CPU_FPSR        0x348
+#define HV_CPU_HELPER      0x350
+#define HV_CPU_HELPER_RET  0x358
+#define HV_CPU_TPIDR_EL0   0x360
+#define HV_CPU_TPIDRRO_EL0 0x368
+#define HV_CPU_TPIDR_EL1   0x370
+#define HV_CPU_ELR_EL1     0x378
+#define HV_CPU_SPSR_EL1    0x380
+#define HV_CPU_SP_EL0      0x388
+#define HV_CPU_DAIF        0x390
+#define HV_CPU_PSTATE_EXTRA 0x3a0
+#define HV_CPU_SCTLR_EL1   0x3a8
+#define HV_CPU_ESR_EL1     0x3b0
+#define HV_CPU_FAR_EL1     0x3b8
+#define HV_CPU_EXIT_REQ    0x3c0
+#define HV_CPU_EL0_CNT     0x3c4
+#define HV_CPU_LAST_STUB   0x3c8
+#define HV_CPU_IJC         0x3d0
+#define HV_CPU_IJC_SALT    0x3d8
+#define HV_CPU_MISS_SITE   0x3e8
+#define HV_CPU_EXCL_ADDR   0x3f0
+#define HV_CPU_EXCL_SIZE   0x3f8
+#define HV_CPU_EXCL_VAL    0x400
+#define HV_CPU_HOST_SP     0x410
+#define HV_CPU_LINES_PTR   0x418
+#define HV_CPU_HELPER_THUNK 0x420
+#define HV_CPU_CHAIN_THUNK 0x428
+#define HV_CPU_IJC_THUNK   0x430
+#define HV_CPU_REFILL_RET  0x438
+#define HV_CPU_SPSEL       0x3fc
+#define HV_CPU_SP_EL1      0x398
+#define HV_CPU_IJC_TAB     0x440
+#define HV_CPU_TLB         0x580
+#define HV_CPU_RET_SALT    0x500
+#define HV_CPU_TTBR0_EL1   0x518
+#define HV_CPU_TTBR1_EL1   0x520
+#define HV_CPU_VBAR_EL1    0x528
+#define HV_CPU_CONTEXTIDR_EL1 0x530
+#define HV_CPU_MDSCR_EL1   0x538
+#define HV_CPU_GADDEND     0x4c0
+#define HV_CPU_XJUMP_THUNK 0x4e0
+
+/* Indirect-branch cache: one table per block-flags value, 64K entries of 16 bytes,
+   indexed by ((va ^ va >> 16) >> 2) so code at the same offset in different pages spreads out. */
+#define HV_IJC_BITS 18
+#define HV_UCODE_BITS 18
+#define HV_IJC_TABLE_BYTES ((1u << HV_IJC_BITS) * 16)
+#define HV_CPU_TLB_EL      32 /* between a slot's tables */
+
+_Static_assert(offsetof(HvCpu, sp) == HV_CPU_SP, "HvCpu layout");
+_Static_assert(offsetof(HvCpu, pc) == HV_CPU_PC, "HvCpu layout");
+_Static_assert(offsetof(HvCpu, nzcv) == HV_CPU_NZCV, "HvCpu layout");
