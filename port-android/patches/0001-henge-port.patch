++   only means something to whoever owns the clock that will expire it: under a
++   host that runs its own gtimer, that is the host.  Forwarding them also keeps
++   CVAL and CNTVCT in one tick domain, which is the whole point of #2. */
++static int is_timer_ctl(uint32_t reg) {
++    if ((reg >> 14) != 3 || ((reg >> 11) & 7) != 3 || ((reg >> 7) & 15) != 14)
++        return 0;
++    unsigned crm = (reg >> 3) & 15;
++    return crm == 2 || crm == 3;          /* CNTP_* and CNTV_* */
++}
++
+ static int undefined(HvCpu *cpu, uint64_t pc) {
+     hv_raise_undef(cpu, pc);
+     return 1;
+@@ -72,6 +121,8 @@
