+                    (unsigned long long)used, (unsigned long long)stale, (unsigned long long)maxlen,
+                    m->nblocks ? (double)sumsq / m->nblocks : 0.0);
+            int k = 0;
+            for (HvBlock *b = m->hash[worst]; b && k < 6; b = b->next, k++)
